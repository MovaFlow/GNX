+
+/// GNX-FRAMES: frame counts per phase for a mod cell that runs the vanilla base scene scripts.
+/// arg0 = the cell's physical struct (what GNX stores), arg1 = the whole cell JSON, arg2 = cell name
+/// (for messages), arg3 = human_spr mode, arg4 = base_body, arg5 = the cell's "sprites" block.
+/// Stores in arg0:
+///   gnx_phase_frames - one entry per phase number of scr_set_slot_spr_part (0 start, 1 idle, 2 loop,
+///                      3 ej, 4 birth, 5 unused), -1 = vanilla count. The base scene scripts play these
+///                      frames at the vanilla speed per frame, so a longer strip plays longer;
+/// Monsters use the same counts as the captive: their strips are checked here (gnx_frames_check_strips).
+/// Without physical.frames nothing is stored and the cell plays as before.
+function gnx_frames_register(arg0, arg1, arg2, arg3, arg4, arg5)
+{
+    var _phys = arg1.physical;
+    var _fr = _phys.frames;
+    
+    if (!is_struct(_fr))
+    {
+        gnx_report_mod_error("Cell '" + string(arg2) + "': physical.frames must be {\"idle\": n, \"loop\": n, ...}, ignored");
+        exit;
+    }
+    
+    var _keys = ["start", "idle", "loop", "ej", "birth"];
+    var _val = [-1, -1, -1, -1, -1];
+    var _any = false;
+    
+    for (var i = 0; i < 5; i++)
+    {
+        if (!variable_struct_exists(_fr, _keys[i]))
+            continue;
+        
+        var _raw = variable_struct_get(_fr, _keys[i]);
+        var _v = gnx_json_num(_raw, -1);
+        
+        // >= 1: a phase needs at least one frame; 64 keeps a typo from making a huge strip index
+        if (_v >= 1)
+        {
+            _val[i] = min(64, floor(_v));
+            _any = true;
+        }
+        else
+        {
+            gnx_report_mod_error("Cell '" + string(arg2) + "': frames." + _keys[i] + " must be a number from 1 (" + string(_raw) + "), the vanilla count is used");
+        }
+    }
+    
+    if (!_any)
+        exit;
+    
+    // only the cell's own art (fixed / class_map) is drawn from strips the modder made for these counts
+    if (arg3 != "fixed" && arg3 != "class_map")
+    {
+        gnx_report_mod_error("Cell '" + string(arg2) + "': physical.frames needs human_spr mode fixed or class_map; with mode " + string(arg3) + " the captive comes from the class sheets, so the frames are ignored");
+        exit;
+    }
+    
+    // the vanilla draw scripts with monsters or frame checks inside (gang, drink, giant...) count on the
+    // vanilla frame count, so the frames work with the two scripts that only draw the cell's layers
+    var _draw = _phys.scr_draw;
+    
+    if (_draw != "scr_draw_slot_gnx" && _draw != "scr_draw_slot_parts")
+    {
+        gnx_report_mod_error("Cell '" + string(arg2) + "': physical.frames works with scr_draw scr_draw_slot_gnx or scr_draw_slot_parts, not " + string(_draw) + "; the frames are ignored");
+        exit;
+    }
+    
+    // only the base scene scripts read the own counts; the others (tentacle, gang, milk...) have vanilla frame numbers inside
+    var _base = ["scr_slot_h_big_start", "scr_slot_h_base_start", "scr_slot_h_base_wait", "scr_slot_h_base_sloop", "scr_slot_h_base_floop", "scr_slot_h_base_ej", "scr_slot_h_base_ej_2", "scr_slot_h_gnx_places"];
+    var _other = (_phys.scr_idle != "scr_slot_h_state_idle") ? string(_phys.scr_idle) : "";
+    
+    for (var i = 0; i < array_length(_phys.scr_h); i++)
+    {
+        if (!array_contains(_base, _phys.scr_h[i]))
+            _other += ((_other == "") ? "" : ", ") + string(_phys.scr_h[i]);
+    }
+    
+    if (_other != "")
+    {
+        gnx_report_mod_error("Cell '" + string(arg2) + "': physical.frames works with scr_slot_h_state_idle and the base scene scripts (big/base start, base wait, sloop, floop, ej, ej_2), not " + _other + "; the frames are ignored");
+        exit;
+    }
+    
+    var _pf = [-1, -1, -1, -1, -1, -1];
+    _pf[1] = _val[1];
+    _pf[2] = _val[2];
+    _pf[4] = _val[4];
+    
+    // vanilla scene scripts draw ej (3) with the loop art (phase_2), so ej shows the loop's frames
+    _pf[3] = _val[2];
+    
+    // outside big cells the start (0) is drawn with the idle art (phase_1)
+    _pf[0] = (arg4 == "big") ? _val[0] : _val[1];
+    
+    var _l = gnx_log_open();
+    
+    if (_val[3] != -1 && _val[3] != _val[2])
+        gnx_log_write(_l, "[GNX-FRAMES] " + string(arg2) + ": frames.ej ignored, ej is drawn with the loop art and uses frames.loop\n");
+    
+    if (_val[0] != -1 && arg4 != "big")
+        gnx_log_write(_l, "[GNX-FRAMES] " + string(arg2) + ": frames.start ignored, this cell's start is drawn with the idle art and uses frames.idle\n");
+    
+    arg0.gnx_phase_frames = _pf;
+    
+    // the counts every strip of a phase must have per row: own count, or the vanilla one when the JSON leaves it out
+    var _van = [2, 2, 5, 5, 2, 2];
+    var _eff = [0, 0, 0, 0, 0];
+    
+    for (var i = 0; i < 5; i++)
+        _eff[i] = (_pf[i] >= 1) ? _pf[i] : _van[i];
+    
+    gnx_log_write(_l, "[GNX-FRAMES] " + string(arg2) + ": frames per phase (start, idle, loop, ej, birth) = " + string(_eff) + "\n");
+    gnx_log_close(_l);
+    gnx_frames_check_strips(arg1, arg2, arg5, _eff, false, arg4);
+}
+
+
+/// GNX-FRAMES: checks that every strip of the cell has the frame count of its phase (arg3 = counts per
+/// phase 0-4), the captive's (human_spr phase_0 ... phase_4) and the monsters' (mon_spr... start, loop,
+/// ej). A strip may hold several rows (skins, placements); frames left over after the last full row are
+/// only logged (a strip can be shared with a longer phase), fewer frames than one row is an error.
+/// arg0 = cell JSON, arg1 = cell name, arg2 = "sprites" block, arg4 = true for an underground cell (its
+/// tent_spr per phase is checked too; milk_spr fits any count, see gnx_milk_clock), arg5 = base_body. Only tables the game draws are
+/// checked: outside underground cells phase_3 is drawn for the ej with the loop's count, and phase_0 only in
+/// big cells (other cells start with the idle art). A 1-frame strip is a still image and always fits.
+/// Every problem is one mod error that names the strip and the count it needs; the game goes on (a wrong
+/// strip only shows wrong frames).
+function gnx_frames_check_strips(arg0, arg1, arg2, arg3, arg4, arg5)
+{
+    var _bad = 0;
+    // phases whose captive tables are drawn: [start, idle, loop, ej, birth]
+    // (GNX-EJ: a phase_3 table is drawn for the ej, with the loop's count, see gnx_ej_own_art)
+    var _used = arg4 ? [true, true, true, true, true] : [arg5 == "big", true, true, true, true];
+    
+    // captive: every phase_N table anywhere in human_spr (fixed, by_class, class_map entries, default)
+    if (variable_struct_exists(arg0, "human_spr"))
+        _bad += gnx_frames_check_phase_tables(arg0.human_spr, arg1, arg2, arg3, _used);
+    
+    // underground: a phase without its own table is drawn with another one (start with idle, ej with
+    // loop), so both phases must then have the same frame count
+    if (arg4 && variable_struct_exists(arg0, "human_spr"))
+    {
+        var _fbp = [[0, 1, "start", "idle", "phase_0"], [3, 2, "ej", "loop", "phase_3"]];
+        
+        for (var f = 0; f < 2; f++)
+        {
+            var _fb = _fbp[f];
+            
+            // ... unless every strip of the table it falls back to is marked loop (then it loops in any length)
+            if (!gnx_json_has_key(arg0.human_spr, _fb[4]) && arg3[_fb[0]] != arg3[_fb[1]] && !gnx_frames_tables_loop(arg0.human_spr, "phase_" + string(_fb[1]), arg2))
+            {
+                gnx_report_mod_error("Cell '" + string(arg1) + "': the " + _fb[2] + " has " + string(arg3[_fb[0]]) + " frames but no " + _fb[4] + " table, so it is drawn with the " + _fb[3] + " art (" + string(arg3[_fb[1]]) + " frames); add " + _fb[4] + ", give both the same count, or mark those strips \"loop\": true");
+                _bad++;
+            }
+        }
+    }
+    
+    // underground: tentacle overlay per phase (start 0, idle 1, loop 2, ej 3, birth 4). The milking
+    // overlay is not checked: a milk strip with another frame count runs on the milk's own clock.
+    if (arg4)
+    {
+        var _ovk = ["start", "idle", "loop", "ej", "birth"];
+        var _ovs = ["tent_spr"];
+        
+        for (var o = 0; o < 1; o++)
+        {
+            if (!variable_struct_exists(arg0, _ovs[o]) || !is_struct(variable_struct_get(arg0, _ovs[o])))
+                continue;
+            
+            var _ov = variable_struct_get(arg0, _ovs[o]);
+            
+            for (var k = 0; k < 5; k++)
+            {
+                if (variable_struct_exists(_ov, _ovk[k]))
+                    _bad += gnx_frames_check_refs(variable_struct_get(_ov, _ovk[k]), arg3[k], arg1, _ovs[o] + "." + _ovk[k], arg2, false);
+            }
+        }
+    }
+    
+    // monsters: one set per type and placement; start = phase 0, loop = 2, ej = 3 (drawn with loop frames)
+    var _max_mon = (variable_struct_exists(arg0.physical, "max_mon_num")) ? gnx_json_num(arg0.physical.max_mon_num, 0) : 0;
+    
+    if (_max_mon <= 0)
+    {
+        gnx_frames_report_bad(arg1, _bad);
+        exit;
+    }
+    
+    var _sets = ["mon_spr", "mon_spr_hob", "mon_spr_ogr"];
+    var _all = [];
+    
+    for (var s = 0; s < 3; s++)
+    {
+        array_push(_all, _sets[s]);
+        
+        for (var p = 0; p < 3; p++)
+            array_push(_all, _sets[s] + "_p" + string(p));
+    }
+    
+    var _ph = ["start", "loop", "ej"];
+    var _phn = [0, 2, 3];
+    
+    for (var s = 0; s < array_length(_all); s++)
+    {
+        if (!variable_struct_exists(arg0, _all[s]) || !is_struct(variable_struct_get(arg0, _all[s])))
+            continue;
+        
+        var _set = variable_struct_get(arg0, _all[s]);
+        
+        for (var p = 0; p < 3; p++)
+        {
+            if (variable_struct_exists(_set, _ph[p]))
+                _bad += gnx_frames_check_refs(variable_struct_get(_set, _ph[p]), arg3[_phn[p]], arg1, _all[s] + "." + _ph[p], arg2, false);
+        }
+    }
+    
+    // a monster type without its own start or loop strips is drawn from the vanilla sheets (2 / 5 frames)
+    var _types = variable_struct_exists(arg0, "mon_types") ? arg0.mon_types : [0, 1, 2, 3];
+    var _tname = ["goblin", "hobgoblin", "tentacle", "ogre"];
+    
+    for (var m = 0; m < array_length(_types); m++)
+    {
+        var _t = gnx_json_num(_types[m], -1);
+        
+        if (_t < 0 || _t > 3)
+            continue;
+        
+        // as in scr_set_mon_spr_data: hobgoblin and ogre sets, else the goblin set (mon_spr)
+        var _key = (_t == 1) ? "mon_spr_hob" : ((_t == 3) ? "mon_spr_ogr" : "mon_spr");
+        
+        if (!variable_struct_exists(arg0, _key))
+            _key = "mon_spr";
+        
+        var _set = variable_struct_exists(arg0, _key) ? variable_struct_get(arg0, _key) : undefined;
+        
+        for (var p = 0; p < 2; p++)
+        {
+            var _need = arg3[_phn[p]];
+            var _vanilla = (p == 0) ? 2 : 5;
+            
+            if (_need != _vanilla && (!is_struct(_set) || !variable_struct_exists(_set, _ph[p])))
+            {
+                gnx_report_mod_error("Cell '" + string(arg1) + "': the " + _ph[p] + " has " + string(_need) + " frames but " + _tname[_t] + "s have no " + _ph[p] + " strips in mon_spr (the vanilla ones have " + string(_vanilla) + ")");
+                _bad++;
+            }
+        }
+    }
+    
+    gnx_frames_report_bad(arg1, _bad);
+}
+
+
+/// GNX-LOOP-STRIP: true when every "gnx:" strip under the tables named arg1 (anywhere in human_spr arg0)
+/// is marked loop in the "sprites" block arg2, and there is at least one.
+function gnx_frames_tables_loop(arg0, arg1, arg2)
+{
+    var _refs = [];
+    gnx_frames_collect_tables(arg0, arg1, _refs);
+    
+    if (array_length(_refs) == 0 || !is_struct(arg2))
+        return false;
+    
+    for (var i = 0; i < array_length(_refs); i++)
+    {
+        var _k = _refs[i];
+        
+        if (!variable_struct_exists(arg2, _k))
+            return false;
+        
+        var _d = variable_struct_get(arg2, _k);
+        
+        if (!is_struct(_d) || !variable_struct_exists(_d, "loop") || (is_numeric(_d.loop) && _d.loop == 0))
+            return false;
+    }
+    
+    return true;
+}
+
+
+/// GNX-LOOP-STRIP: adds to list arg2 the names of the "gnx:" strips under every key arg1 inside arg0.
+function gnx_frames_collect_tables(arg0, arg1, arg2)
+{
+    if (is_array(arg0))
+    {
+        for (var i = 0; i < array_length(arg0); i++)
+            gnx_frames_collect_tables(arg0[i], arg1, arg2);
+        
+        exit;
+    }
+    
+    if (!is_struct(arg0))
+        exit;
+    
+    var _names = variable_struct_get_names(arg0);
+    
+    for (var i = 0; i < array_length(_names); i++)
+    {
+        var _v = variable_struct_get(arg0, _names[i]);
+        
+        if (_names[i] == arg1)
+            gnx_frames_collect_refs(_v, arg2);
+        else
+            gnx_frames_collect_tables(_v, arg1, arg2);
+    }
+}
+
+
+/// GNX-LOOP-STRIP: adds to list arg1 the names (without "gnx:") of every "gnx:" string inside arg0.
+function gnx_frames_collect_refs(arg0, arg1)
+{
+    if (is_string(arg0))
+    {
+        if (string_copy(arg0, 1, 4) == "gnx:")
+            array_push(arg1, string_delete(arg0, 1, 4));
+        
+        exit;
+    }
+    
+    if (is_array(arg0))
+    {
+        for (var i = 0; i < array_length(arg0); i++)
+            gnx_frames_collect_refs(arg0[i], arg1);
+    }
+    else if (is_struct(arg0))
+    {
+        var _names = variable_struct_get_names(arg0);
+        
+        for (var i = 0; i < array_length(_names); i++)
+        {
+            var _v = variable_struct_get(arg0, _names[i]);
+            
+            // GNX-FIX: the hand (place 3) holds poses, not frames of the phase: left out, as in the check
+            if ((_names[i] == "spr_array" || _names[i] == "spr_c_array") && is_array(_v))
+            {
+                for (var j = 0; j < array_length(_v); j++)
+                {
+                    if (j != 3)
+                        gnx_frames_collect_refs(_v[j], arg1);
+                }
+                
+                continue;
+            }
+            
+            gnx_frames_collect_refs(_v, arg1);
+        }
+    }
+}
+
+
+/// GNX-FRAMES: one log line with the number of strips (arg1) of cell arg0 that do not fit their phase.
+function gnx_frames_report_bad(arg0, arg1)
+{
+    if (arg1 <= 0)
+        exit;
+    
+    var _l = gnx_log_open();
+    gnx_log_write(_l, "[GNX-FRAMES] " + string(arg0) + ": " + string(arg1) + " strip(s) do not match the frame counts, see the mod errors\n");
+    gnx_log_close(_l);
+}
