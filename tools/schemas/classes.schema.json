        "carry_base_spr": {
          "description": "Ogre carry body: one sprite, or one per leg pose leg_0 / leg_1 / leg_2 (guide 6.5).",
          "if": {
            "type": [
              "string",
              "integer"
            ]
          },
          "then": {},
          "else": {
            "type": "object",
            "properties": {
              "leg_0": {
                "$ref": "#/definitions/spr"
              },
              "leg_1": {
                "$ref": "#/definitions/spr"
              },
              "leg_2": {
                "$ref": "#/definitions/spr"
              }
            },
            "patternProperties": {
              "^_": {}
            },
            "additionalProperties": false
          }
        },
        "raid_spawns": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "stage": {
                "description": "A vanilla raid stage 0-4, or a mod stage \"folder.ID\" (raids.json).",
                "oneOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 4
                  },
                  {
                    "type": "string",
                    "pattern": "^[^.]+\\.[^.]+$"
                  }
                ]
              },
              "level": {
                "type": "integer",
                "minimum": 0,
                "description": "Encounter level: 0-2 on a vanilla stage, any level of a mod stage."
              },
              "weight": {
                "type": "number",
                "minimum": 0
              },
              "min_lvl": {
                "type": "integer",
                "minimum": 0,
                "maximum": 7
              },
              "max_lvl": {
                "type": "integer",
                "minimum": 0,
                "maximum": 7
              },
              "condition": {
                "$ref": "common.schema.json#/definitions/condition"
              },
              "max_per_encounter": {
                "type": "integer",
                "minimum": 0
              },
              "ap_override": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "number"
                },
                "description": "[HP, AP] the unit adds instead of fap_mul / bap_mul. Ignored in the Tower."
              }
            },
            "patternProperties": {
              "^_": {}
            },
            "additionalProperties": false,
            "description": "Adds the class to one raid pool (guide 13.2).",
            "required": [
              "stage",
              "level"
            ],
            "if": {
              "properties": {
                "stage": {
                  "type": "integer"
                }
              },
              "required": [
                "stage"
              ]
            },
            "then": {
              "properties": {
                "level": {
                  "maximum": 2
                }
              }
            }
          }
        },
        "trade_stage": {
          "description": "The trader sells the class from that raid stage on (guide 13.5): 0-4, or a stage name (a mod stage adds no trader slot).",
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 4
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        },
