+// GNX: multi-map travel: maps, selector, carry, troops
+// (moved out of s_initials.gml; the functions are global, callable from any script)
+
+// The mod list entry for a folder / mod id, or undefined
+// A map's name for players: its travel label when its mod is loaded, else the name of the mod that made it
+// (from a save's mod record, arg1), else the map id
+function gnx_map_display_name(arg0, arg1)
+{
+    if (arg0 == "vanilla")
+        return "Village";
+    
+    for (var _i = 0; _i < array_length(global.gnx_travel_locations); _i++)
+    {
+        if (global.gnx_travel_locations[_i].target == arg0)
+            return gnx_tr(global.gnx_travel_locations[_i].label);
+    }
+    
+    if (is_array(arg1))
+    {
+        for (var _i = 0; _i < array_length(arg1); _i++)
+        {
+            if (is_struct(arg1[_i]) && variable_struct_exists(arg1[_i], "maps") && gnx_array_has(arg1[_i].maps, arg0))
+                return arg1[_i].name;
+        }
+    }
+    
+    return arg0;
+}
