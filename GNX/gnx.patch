+            for (var _ui = 0; _ui < ds_list_size(global.unit_list); _ui++)
+            {
+                var _u = ds_list_find_value(global.unit_list, _ui);
+                if (is_struct(_u))
+                    scr_gnx_check_voice(_u);
+            }
+        }
+
+        // GNX sound: ensure settings fields exist on old saves
+        try
+        {
+            if (!variable_struct_exists(global.val, "moan_vol"))   global.val.moan_vol   = 0.5;
+            if (!variable_struct_exists(global.val, "moan_frq"))   global.val.moan_frq   = 15;
+            if (!variable_struct_exists(global.val, "orgasm_frq")) global.val.orgasm_frq = 5;
+            if (!variable_struct_exists(global.val, "plap_vol"))   global.val.plap_vol   = 0.5;
+            if (!variable_struct_exists(global.val, "ej_vol"))     global.val.ej_vol     = 0.5;
+            if (!variable_struct_exists(global.val, "bj_vol"))     global.val.bj_vol     = 0.5;
+        }
+        catch (_e)
+        {
+            global.val.moan_vol   = 0.5;
+            global.val.moan_frq   = 15;
+            global.val.orgasm_frq = 5;
+            global.val.plap_vol   = 0.5;
+            global.val.ej_vol     = 0.5;
+            global.val.bj_vol     = 0.5;
+        }
+
+        // GNX: fix unlock arrays - remove stale mod h_types, re-add current ones
+        scr_gnx_migrate_unlocks();
+
+        // GNX multi-map: restore active map name + inactive map snapshots from save.
+        // Skip when loading from gnx_travel_data (travel sets these globals directly).
+        if (!_gnx_travel)
+        {
+            if (variable_struct_exists(_load_data, "gnx_active_map"))
+                global.gnx_active_map = _load_data.gnx_active_map;
+            else
+                global.gnx_active_map = "vanilla";
+
+            if (variable_struct_exists(_load_data, "gnx_maps"))
+                global.gnx_inactive_maps = _load_data.gnx_maps;
+            else
+                global.gnx_inactive_maps = {};
+        }
+    }
+
+    return _load;
+}
+
+function scr_delete_save(arg0)
+{
+    var _load_type;
+    
+    switch (arg0)
+    {
+        case 0:
+            _load_type = "save_file_a.json";
+            break;
+        
+        case 1:
+            _load_type = "save_file_1.json";
+            break;
+        
+        case 2:
+            _load_type = "save_file_2.json";
+            break;
+        
+        case 3:
+            _load_type = "save_file_3.json";
+            break;
+    }
+    
+    file_delete(_load_type);
+}
+
+function scr_create_menu_load_page()
+{
+    with (obj_np)
+    {
+        for (var i = 0; i < 4; i++)
+        {
+            with (instance_create_depth(240, 48 + (50 * i), depth - 1, obj_window))
+            {
+                gui = true;
+                interact_type = UnknownEnum.Value_11;
+                scr_window_draw = scr_draw_load_file;
+                source_id = other.id;
+
+                if (i > 0)
+                    y += 13;
+
+                scr_create_load_file(i);
+            }
+        }
+
+        scr_create_button(292, 250, 0, spr_button_long, UnknownEnum.Value_52, id, scr_create_menu_back_button, -1, scr_draw_back_menu, 2, 4);
+    }
+}
