+function scr_gnx_scn_assert(arg0)
+{
+    var _what = arg0.assert;
+
+    switch (_what)
+    {
+        case "same_as":
+            var _was = variable_struct_get(global.gnx_scn.snaps, arg0.snapshot);
+
+            if (_was == undefined)
+            {
+                scr_gnx_scn_check("same_as", false, "no snapshot '" + string(arg0.snapshot) + "'");
+                break;
+            }
+
+            var _now = scr_gnx_scn_state();
+            var _keys = variable_struct_exists(arg0, "keys") ? arg0.keys : variable_struct_get_names(_was);
+            var _diff = "";
+
+            for (var _i = 0; _i < array_length(_keys); _i++)
+            {
+                var _a = variable_struct_get(_was, _keys[_i]);
+                var _b = variable_struct_get(_now, _keys[_i]);
+
+                if (string(_a) != string(_b))
+                    _diff += (_keys[_i] + ": " + string(_a) + " -> " + string(_b) + "; ");
+            }
+
+            if (variable_struct_exists(arg0, "differs") && arg0.differs)  // {"differs": true}: must have changed
+                scr_gnx_scn_check("same_as", _diff != "", "'" + arg0.snapshot + "' " + ((_diff == "") ? "unchanged (want a change)" : "changed: " + _diff));
+            else
+                scr_gnx_scn_check("same_as", _diff == "", "'" + arg0.snapshot + "' " + ((_diff == "") ? string(array_length(_keys)) + " keys equal" : _diff));
+            break;
+
+        case "follow_sync":
+            var _fb = scr_gnx_scn_follow_bad();
+            scr_gnx_scn_check("follow_sync", _fb[0] == 0, (_fb[0] == 0) ? "all followers in place" : string(_fb[0]) + " out of place, e.g. " + _fb[1]);
+            break;
+
+        case "prisoner_buttons":
+            // every occupied cell must keep a unit button (interact_type 20) following it
+            var _missing = 0;
+            var _total = 0;
+            var _mex = "";
+
+            with (obj_slot)
+            {
+                if (is_struct(unit_data))
+                {
+                    _total++;
+                    var _sid = id;
+                    var _has = false;
+
+                    with (obj_button)
+                    {
+                        if (interact_type == 20 && follow && source_id == _sid)
+                        {
+                            _has = true;
+                            break;
+                        }
+                    }
+
+                    if (!_has)
+                    {
+                        _missing++;
+                        _mex = "floor " + string(slot_data.slot_floor) + " y=" + string(y);
+                    }
+                }
+            }
+
+            scr_gnx_scn_check("prisoner_buttons", _missing == 0 && _total > 0, string(_total - _missing) + "/" + string(_total) + " occupied cells have their unit button" + ((_missing > 0) ? ", e.g. missing at " + _mex : ""));
+            break;
+
+        case "val":
+            // {"assert": "val", "key": "money", "is": 100, "tol": 0.5}  (global.val field; numbers compare within tol, default 0.01)
+            var _vv = variable_struct_exists(global.val, arg0.key) ? variable_struct_get(global.val, arg0.key) : undefined;
+            var _vok;
+
+            if (is_numeric(_vv) && is_numeric(arg0.is))
+                _vok = abs(_vv - arg0.is) <= (variable_struct_exists(arg0, "tol") ? arg0.tol : 0.01);
+            else
+                _vok = string(_vv) == string(arg0.is);
+
+            scr_gnx_scn_check("val", _vok, arg0.key + "=" + string(_vv) + " want " + string(arg0.is));
+            break;
+
+        case "progressed":
