+function gnx_tool_resolve_class(arg0, arg1)
+{
+    if (is_string(arg0))
+    {
+        var _dot = string_pos(".", arg0);
+        var _cname = (_dot > 0) ? string_copy(arg0, _dot + 1, string_length(arg0) - _dot) : arg0;
+        var _k = ds_map_find_first(global.class_registry);
+        
+        while (_k != undefined)
+        {
+            var _cr = ds_map_find_value(global.class_registry, _k);
+            
+            if (variable_struct_exists(_cr, "name") && variable_struct_exists(_cr, "mod_name"))
+            {
+                if ((_cr.mod_name + "." + _cr.name) == arg0)
+                    return _k;
+                
+                if (_cr.mod_name == arg1 && _cr.name == _cname)
+                    return _k;
+            }
+            
+            _k = ds_map_find_next(global.class_registry, _k);
+        }
+        
+        var _wlog = file_text_open_append("gnx_debug.txt");
+        file_text_write_string(_wlog, "[GNX-WARN] tool class ref '" + arg0 + "' not found (mod=" + string(arg1) + ")\n");
+        file_text_close(_wlog);
+        return -1;
+    }
+    
+    return arg0;
+}
