{
  "about": "Fresh vanilla game, travel to the minimal harness_map mod's map and back. The vanilla nest must come back unchanged and the modded map must offer a return entry (T69's modded-map branch).",
  "mods": ["tools/scenarios/mods/harness_map"],
  "steps": [
    {"wait": 30},
    {"do": {"type": "add_floor"}},
    {"wait": 10},
    {"assert": "active_map", "is": "vanilla"},
    {"snapshot": "vanilla"},
    {"travel": "harness_map"},
    {"wait": 30},
    {"assert": "active_map", "is": "harness_map"},
    {"assert": "return_entry"},
    {"assert": "follow_sync"},
    {"travel": "vanilla"},
    {"wait": 30},
    {"assert": "active_map", "is": "vanilla"},
    {"assert": "same_as", "snapshot": "vanilla", "keys": ["active_map", "floor", "slots", "cells", "units"]},
    {"assert": "follow_sync"}
  ]
}
