+/// GNX-PROP: runs in a prop: draws its counter (arg0 = the counter struct, arg1 = the number) with the
+/// game font (the font the game set for its language, as its +3 pop-ups use) or with the digits sprite.
+/// arg2 = where the prop's sprite is drawn this frame (gnx_fx_transform) when the counter follows the
+/// prop's fx, undefined = the prop's own place. The anchor (x, y) is a point on the sprite: it is mirrored
+/// and scaled with the sprite and turned with it around the sprite's origin, so it stays on the plaque.
+function gnx_prop_draw_counter(arg0, arg1, arg2)
+{
+    var _ox = x;
+    var _oy = y;
+    var _xs = image_xscale;
+    var _ys = image_yscale;
+    var _pang = image_angle;
+    var _alpha = image_alpha;
+    
+    if (is_struct(arg2))
+    {
+        _ox = arg2.x;
+        _oy = arg2.y;
+        _xs = arg2.xs;
+        _ys = arg2.ys;
+        _pang = arg2.ang;
+        _alpha = arg2.alpha;
+    }
+    
+    // the anchor on the sprite: mirrored and scaled like its pixels (_xs carries the mirror's - sign),
+    // then turned by the sprite's angle around its origin. dcos / dsin take degrees; GameMaker turns
+    // counter-clockwise with y pointing down, hence + sin for x and - sin for y
+    var _dx = arg0.x * _xs;
+    var _dy = arg0.y * _ys;
+    var _ax = (_ox + (_dx * dcos(_pang))) + (_dy * dsin(_pang));
+    var _ay = (_oy - (_dx * dsin(_pang))) + (_dy * dcos(_pang));
+    // the number's size grows with the sprite's (pulse); abs = without the mirror's sign
+    var _sc = arg0.scale * abs(_ys);
+    // its tilt: mirrored with the prop (a plaque tilted left becomes tilted right), plus the sprite's turn
+    var _ang = (arg0.angle * ((_xs < 0) ? -1 : 1)) + _pang;
+    
+    if (arg0.digits == -1)
+    {
+        var _txt = arg0.prefix + gnx_int_text(arg1, arg0.pad) + arg0.suffix;
+        
+        // GNX-PROP: once per game: how big the game font's digits are, so a mod can size its sign
+        // (string_height = the font's line height, a little more than the digits themselves)
+        if (!variable_global_exists("gnx_counter_font_logged"))
+        {
+            global.gnx_counter_font_logged = true;
+            var _fl = gnx_log_open();
+            gnx_log_write(_fl, "[GNX] counter font: line height " + string(string_height("0123456789")) + " px, digit width " + string(string_width("0")) + " px (scale 1)\n");
+            gnx_log_close(_fl);
+        }
+        
+        // the draw settings are shared by everything the game draws: keep them and put them back after
+        var _ha = draw_get_halign();
+        var _va = draw_get_valign();
+        var _col = draw_get_colour();
+        var _al = draw_get_alpha();
+        // the text turns around its alignment point, which is the anchor
+        draw_set_halign((arg0.align < 0) ? fa_left : ((arg0.align > 0) ? fa_right : fa_center));
+        draw_set_valign((arg0.valign < 0) ? fa_top : ((arg0.valign > 0) ? fa_bottom : fa_middle));
+        draw_set_alpha(_alpha);
+        
+        // outline: the text 1 px (times the scale) to each side in the outline colour, under the text
+        if (arg0.outline != -1)
+        {
+            var _o = max(1, round(_sc));
+            draw_set_colour(arg0.outline);
+            draw_text_transformed(_ax - _o, _ay, _txt, _sc, _sc, _ang);
+            draw_text_transformed(_ax + _o, _ay, _txt, _sc, _sc, _ang);
+            draw_text_transformed(_ax, _ay - _o, _txt, _sc, _sc, _ang);
+            draw_text_transformed(_ax, _ay + _o, _txt, _sc, _sc, _ang);
+        }
+        
+        draw_set_colour(arg0.color);
+        draw_text_transformed(_ax, _ay, _txt, _sc, _sc, _ang);
+        draw_set_halign(_ha);
+        draw_set_valign(_va);
+        draw_set_colour(_col);
+        draw_set_alpha(_al);
+        exit;
+    }
+    
+    var _txt = gnx_int_text(arg1, arg0.pad);
+    var _n = string_length(_txt);
+    // one digit's place: its width plus the space after it, all times the scale
+    var _step = (arg0.dig_w + arg0.spacing) * _sc;
+    var _w = ((_n * arg0.dig_w) + ((_n - 1) * arg0.spacing)) * _sc;
+    var _h = arg0.dig_h * _sc;
+    // the number's box around the anchor, before the tilt: left edge and top edge
+    var _left = 0;
+    var _top = -_h;
+    
+    if (arg0.align == 0)
+        _left = -floor(_w * 0.5);
+    else if (arg0.align > 0)
+        _left = -_w;
+    
+    if (arg0.valign == 0)
+        _top = -floor(_h * 0.5);
+    else if (arg0.valign < 0)
+        _top = 0;
+    
+    var _ca = dcos(_ang);
+    var _sa = dsin(_ang);
+    // pass 0: the outline (every digit's shape in the outline colour, 1 px times the scale to each side),
+    // pass 1: the digits on top; two passes, so no outline is drawn over a digit next to it
+    var _o = max(1, round(_sc));
+    
+    for (var _pass = ((arg0.outline != -1) ? 0 : 1); _pass <= 1; _pass++)
+    {
+        if (_pass == 0)
+            gpu_set_fog(true, arg0.outline, 0, 0);
+        
+        for (var i = 0; i < _n; i++)
+        {
+            // ord gives the character code: "0" is 48, so - 48 is the digit and the frame
+            var _d = ord(string_char_at(_txt, i + 1)) - 48;
+            // where this digit's origin goes in the untilted box, then turned around the anchor like the sprite
+            var _lx = (_left + (i * _step)) + (arg0.dig_xo * _sc);
+            var _ly = _top + (arg0.dig_yo * _sc);
+            var _px = (_ax + (_lx * _ca)) + (_ly * _sa);
+            var _py = (_ay - (_lx * _sa)) + (_ly * _ca);
+            // turn_digits false: upright digits on whole pixels, stepping along the tilted line
+            var _dang = arg0.turn_digits ? _ang : 0;
+            
+            if (!arg0.turn_digits)
+            {
+                _px = round(_px);
+                _py = round(_py);
+            }
+            
+            if (_pass == 0)
+            {
+                gnx_draw_sprite_ext(arg0.digits, _d, _px - _o, _py, _sc, _sc, _dang, arg0.outline, _alpha);
+                gnx_draw_sprite_ext(arg0.digits, _d, _px + _o, _py, _sc, _sc, _dang, arg0.outline, _alpha);
+                gnx_draw_sprite_ext(arg0.digits, _d, _px, _py - _o, _sc, _sc, _dang, arg0.outline, _alpha);
+                gnx_draw_sprite_ext(arg0.digits, _d, _px, _py + _o, _sc, _sc, _dang, arg0.outline, _alpha);
+            }
+            else
+            {
+                gnx_draw_sprite_ext(arg0.digits, _d, _px, _py, _sc, _sc, _dang, arg0.color, _alpha);
+            }
+        }
+        
+        if (_pass == 0)
+            gpu_set_fog(false, c_white, 0, 0);
+    }
+}
