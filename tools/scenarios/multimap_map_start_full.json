{
  "about": "map_start's newer fields on a first visit: troops of several types and kinds (an unknown type is skipped), prisoners into the free prison places (the rest skipped), unlock_cells and cells given by name. Unlocks are shared, so a vanilla cell unlocked by map_start reaches the village too; the map mod's own cell does not.",
  "mods": [
    "tools/scenarios/mods/harness_map_start"
  ],
  "steps": [
    {
      "wait": 30
    },
    {
      "assert": "fn",
      "name": "gnx_cell_unlocked",
      "args": [
        2
      ],
      "is": false,
      "why": "WALL 2 is not unlocked in a fresh village"
    },
    {
      "travel": "harness_start"
    },
    {
      "wait": 30
    },
    {
      "assert": "active_map",
      "is": "harness_start"
    },
    {
      "assert": "mons",
      "type": 0,
      "class": 0,
      "is": 2,
      "why": "goblins: 2"
    },
    {
      "assert": "mons",
      "type": 1,
      "class": 0,
      "is": 4
    },
    {
      "assert": "mons",
      "type": 3,
      "class": 0,
      "is": 2
    },
    {
      "assert": "mons",
      "type": 0,
      "class": 1,
      "is": 6,
      "why": "a goblin kind other than the basic one"
    },
    {
      "assert": "prison",
      "is": 5,
      "why": "3 + 2 of the 10: a new map's prison holds 5"
    },
    {
      "assert": "has_cell",
      "h_type": 9020,
      "why": "placed through its name"
    },
    {
      "assert": "fn",
      "name": "gnx_cell_unlocked",
      "args": [
        9021
      ],
      "is": true,
      "why": "unlocked through its name"
    },
    {
      "assert": "fn",
      "name": "gnx_cell_unlocked",
      "args": [
        2
      ],
      "is": true
    },
    {
      "assert": "val",
      "key": "money",
      "is": 300
    },
    {
      "travel": "vanilla"
    },
    {
      "wait": 30
    },
    {
      "assert": "fn",
      "name": "gnx_cell_unlocked",
      "args": [
        2
      ],
      "is": true,
      "why": "unlocks are shared by every map"
    },
    {
      "assert": "fn",
      "name": "gnx_cell_unlocked",
      "args": [
        9021
      ],
      "is": false,
      "why": "the map mod's own cell stays on its map"
    }
  ]
}