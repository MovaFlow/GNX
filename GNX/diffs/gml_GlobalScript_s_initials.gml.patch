+        variable_struct_set(_seen, _key, true);
+
+        if (_a.kind == "panel")
+            _pan = _a;
+        else
+            array_push(_r, _a);
+    }
+
+    for (var _i = 0; _i < array_length(_r); _i++)
+    {
+        var _a = _r[_i];
+
+        if (_a.x0 < _pan.x0 - 0.5 || _a.y0 < _pan.y0 - 0.5 || _a.x1 > _pan.x1 + 0.5 || _a.y1 > _pan.y1 + 0.5)
