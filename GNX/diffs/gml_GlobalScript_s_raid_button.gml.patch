+// GNX-TYPES: a raid category page arrow (interact 9065), with its layout_check box; the previous arrow also
+// records the head drop zone (x 49..162, y 45..149) so an arrow on it is a layout problem
+function scr_gnx_draw_raid_page_arrow()
+{
+    scr_draw_hover_button();
+
+    if (is_array(global.gnx_ui_rects))
+    {
+        var _xa = x - (sprite_get_xoffset(sprite_index) * image_xscale);
+        var _xb = _xa + (sprite_get_width(sprite_index) * image_xscale);
+        var _y0 = y - sprite_get_yoffset(sprite_index);
+        gnx_ui_rect("leaf", min(_xa, _xb), _y0, max(_xa, _xb), _y0 + sprite_get_height(sprite_index), "raid page arrow " + string(button_num));
+
+        if (button_num == 0)
+            gnx_ui_rect("leaf", 49, 45, 162, 149, "raid drop zone");
+    }
