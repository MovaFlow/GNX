+function scr_gnx_travel_selector_activate()
+{
+    if (!instance_exists(source_id) || source_id.interact_type != 9060)
+        exit;
+
+    var _w = source_id;
+
+    if (button_num == 20)  // CANCEL
+    {
+        global.w_spd = _w.prev_w_spd;
+
+        if (_w.reopen_raid)
+            obj_np.obj_raid.trans = true;
+
+        with (obj_window)
+        {
+            if (interact_type == 1)
+                visible = true;
+
+            if (interact_type == 3)  // an open number pad
+                instance_destroy();
+        }
+
+        with (obj_button)
+        {
+            if (interact_type == 9061)
+                instance_destroy();
+        }
+
+        with (_w)
+            instance_destroy();
+
+        exit;
+    }
+
+    if (button_num == 21)  // TRAVEL
+    {
+        if (array_length(_w.captives) > _w.dest_free)
+        {
+            scr_gnx_pop_up_create("Not enough free prison slots at " + _w.target_label + ".");
+            exit;
+        }
+
+        with (_w)
+            scr_gnx_travel_selector_enter();
+
+        exit;
+    }
+
+    if (button_num >= 40 && button_num <= 42)  // tabs
+    {
+        _w.tab = button_num - 40;
+
+        with (_w)
+            scr_gnx_travel_selector_buttons();
+
+        exit;
+    }
+
+    if (button_num == 30 || button_num == 31 || (button_num >= 50 && button_num <= 55))  // BASIC rows
+    {
+        var _d = 0;
+
+        if (button_num >= 50)
+        {
+            var _steps = [-100, -10, -1, 1, 10, 100];
+            _d = _steps[button_num - 50];
+        }
+
+        switch (travel_row)
+        {
+            case 0:
+                _w.carry_gold = (button_num == 30) ? _w.max_gold : ((button_num == 31) ? 0 : clamp(_w.carry_gold + _d, 0, _w.max_gold));
+                break;
+
+            case 1:
+                _w.carry_food = (button_num == 30) ? _w.max_food : ((button_num == 31) ? 0 : clamp(_w.carry_food + _d, 0, _w.max_food));
+                break;
+
+            case 2:
+                _w.carry_goblins = (button_num == 30) ? _w.max_goblins : ((button_num == 31) ? 0 : clamp(_w.carry_goblins + _d, 0, _w.max_goblins));
+                break;
+        }
+
+        exit;
+    }
+
+    if (button_num >= 70 && button_num <= 85)  // take n of a kind (70 + type * 4 + class): the game's number pad
+    {
+        var _typ = floor((button_num - 70) / 4);
+        var _cls = (button_num - 70) mod 4;
+        var _info = { save_num: gnx_party_num(_w.party, _typ, _cls), max_num: gnx_mon_have(_typ, _cls), sel: _w, type: _typ, class: _cls };
+        scr_create_window_num_sel(x, y - 35, id, _w.depth - 50, true, _info, -1, scr_gnx_travel_num_enter, -1);
+        exit;
+    }
+
+    if (button_num == 90 || button_num == 91)  // captives page
+    {
+        var _pages = max(1, ceil(array_length(gnx_prisoner_indices()) / 18));
+        _w.cap_page = clamp(_w.cap_page + ((button_num == 90) ? -1 : 1), 0, _pages - 1);
+        exit;
+    }
+}
