+
+/// GNX-UG: the child species of a pregnancy in an underground cell for class arg0 (the class's
+/// preg_mon_type_override, otherwise tentacle 2), as gnx_ug_child_type() does for the captive in the cell.
+function gnx_ug_child_type_for(arg0)
+{
+    var _rc = ds_map_find_value(global.class_registry, arg0);
+    
+    // GNX-FIX: the class loader already checks the value; gnx_json_num keeps this safe for anything else
+    if (_rc != undefined && variable_struct_exists(_rc, "preg_mon_type_override"))
+        return clamp(floor(gnx_json_num(_rc.preg_mon_type_override, 2)), 0, 3);
+    
+    return 2;
+}
+
+
+// Numer na koncu nazwy pliku ("spr_x_12.png" -> 12); -1 gdy nazwa nie konczy sie cyfra
+function gnx_trailing_number(arg0)
+{
+    var _base = filename_change_ext(arg0, "");
+    var _len = string_length(_base);
+    var _p = _len;
+
+    // string_digits zostawia same cyfry - pusty wynik = ten znak nie jest cyfra
+    while (_p > 0 && string_digits(string_char_at(_base, _p)) != "")
+        _p--;
+
+    if (_p == _len)
+        return -1;
+
+    return real(string_copy(_base, _p + 1, _len - _p));
+}
