+// "ok" when the prison is in sort order arg0 (gnx_prison_sort_key never goes down), empty places come last,
+// and it holds exactly the prisoners gnx_scn_prison_mark saw, each once; else what is wrong
+function gnx_scn_prison_check(arg0)
+{
+    var _seen = [];
+    var _last = -1;
+    var _empty = false;
+
+    for (var i = 0; i < ds_list_size(global.unit_list); i++)
+    {
+        var _v = ds_list_find_value(global.unit_list, i);
+
+        if (!is_struct(_v))
+        {
+            _empty = true;
+            continue;
+        }
+
+        if (_empty)
+            return "prisoner after an empty place at " + string(i);
+
+        var _k = gnx_prison_sort_key(_v, arg0);
+
+        if (_k < _last)
+            return "out of order at " + string(i);
+
+        _last = _k;
+
+        if (array_contains(_seen, _v))
+            return "prisoner twice at " + string(i);
+
+        if (!array_contains(global.gnx_scn_prison, _v))
+            return "unknown prisoner at " + string(i);
+
+        array_push(_seen, _v);
+    }
+
+    if (array_length(_seen) != array_length(global.gnx_scn_prison))
+        return string(array_length(global.gnx_scn_prison) - array_length(_seen)) + " prisoner(s) lost";
+
+    return "ok";
+}
