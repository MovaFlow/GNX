{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/MovaFlow/GNX/main/tools/schemas/cells.schema.json",
  "title": "GNX cells.json",
  "description": "New cells and patches of vanilla cells. Modding guide sections 8-12, 22-24.",
  "if": {
    "type": "array"
  },
  "then": {
    "items": {
      "$ref": "#/definitions/cell"
    }
  },
  "else": {
    "type": "object",
    "properties": {
      "$schema": {
        "type": "string"
      },
      "cells": {
        "type": "array",
        "items": {
          "$ref": "#/definitions/cell"
        }
      }
    },
    "patternProperties": {
      "^_": {}
    },
    "additionalProperties": false
  },
  "definitions": {
    "spr": {
      "type": [
        "string",
        "integer"
      ],
      "description": "\"gnx:<key>\", a vanilla sprite name, or -1 for none."
    },
    "cell": {
      "type": "object",
      "properties": {
        "h_type": {
          "type": [
            "integer",
            "string"
          ],
          "description": "The cell's ID; a vanilla number makes the entry a patch (guide 8.3, 12)."
        },
        "name": {
          "type": "string",
          "description": "Cell name: references (\"my_mod.ALTAR\"), the hash ID, the build menu."
        },
        "category": {
          "enum": [
            "breed",
            "utility",
            "pleasure",
            "b_breed",
            "b_utility",
            "b_other",
            "t_breed",
            "t_utility",
            "xl_breed",
            "ug_breed"
          ],
          "description": "Build menu tab and cell size (guide 8.4)."
        },
        "locked": {
          "type": [
            "boolean",
            "integer"
          ],
          "description": "Not in the build menu until unlocked."
        },
        "mon_types": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3
          },
          "description": "Which monsters come: 0 goblin, 1 hobgoblin, 2 tentacle, 3 ogre (guide 8.5)."
        },
        "slot_type": {
          "type": "integer",
          "description": "Only affects the default base_body (guide 8.4)."
        },
        "price": {
          "type": "number"
        },
        "code_text": {
          "type": "string"
        },
        "spawn_info": {
          "type": "object",
          "properties": {
            "coin": {
              "type": "number"
            },
            "mood": {
              "type": "number"
            },
            "coin_mul": {
              "type": [
                "boolean",
                "integer"
              ]
            },
            "mood_mul": {
              "type": [
                "boolean",
                "integer"
              ]
            }
          },
          "patternProperties": {
            "^_": {}
          },
          "additionalProperties": false,
          "description": "Gold and mood (guide 8.6)."
        },
        "physical": {
          "type": "object",
          "properties": {
            "allow_preg": {
              "type": [
                "boolean",
                "integer"
              ],
              "description": "Captives can get pregnant here."
            },
            "max_mon_num": {
              "type": "integer",
              "description": "How many monsters fit."
            },
            "anal": {
              "type": [
                "boolean",
                "integer"
              ],
              "description": "-1 = never, or true / false (guide 9.2)."
            },
            "slot_dirt_init": {
              "type": "number"
            },
            "layers": {
              "type": "array",
              "description": "What gets drawn (guide 9.4)."
            },
            "scr_idle": {
              "type": "string",
              "description": "Idle scene script (guide 9.5)."
            },
            "scr_h": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Scene scripts in order (guide 9.5)."
            },
            "scr_draw": {
              "type": "string",
              "description": "Draw script (guide 9.6)."
            },
            "hand_x": {
              "type": "array"
            },
            "hand_y": {
              "type": "array"
            },
            "hand_xscale": {
              "type": "array"
            },
            "hand_angle": {
              "type": "array"
            },
            "hand_frames": {
              "type": "object",
