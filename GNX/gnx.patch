+        
+        // monsters: underground scenes have none
+        var _max_mon = variable_struct_exists(arg0, "physical") && variable_struct_exists(arg0.physical, "max_mon_num") ? gnx_json_num(arg0.physical.max_mon_num, 0) : 0;
+        
+        if (arg5 || _max_mon <= 0)
+            continue;
+        
+        var _sets = ["mon_spr", "mon_spr_hob", "mon_spr_ogr"];
+        var _any = false;
+        // frames of the monster strips used instead: the start ones, else loop / ej (both loop frames)
+        var _mf = (arg7[k] == 0) ? arg4[k] : arg4[1];
+        
+        for (var s = 0; s < 3; s++)
+        {
+            for (var p = -1; p < 3; p++)
+            {
+                var _sk = (p == -1) ? _sets[s] : (_sets[s] + "_p" + string(p));
+                
+                if (!variable_struct_exists(arg0, _sk) || !is_struct(variable_struct_get(arg0, _sk)))
+                    continue;
+                
+                _any = true;
+                var _set = variable_struct_get(arg0, _sk);
+                
+                if (variable_struct_exists(_set, _names[k]))
+                    _bad += gnx_frames_check_refs(variable_struct_get(_set, _names[k]), _f, arg1, _sk + "." + _names[k], arg2, false);
+                else if (_f != _mf)
+                {
+                    gnx_report_mod_error("Cell '" + string(arg1) + "': intermission " + _names[k] + " has " + string(_f) + " frames but " + _sk + " has no " + _names[k] + " strips, so its monsters use their " + _mk[k] + " strips (" + string(_mf) + " frames); add " + _sk + "." + _names[k] + " or give both the same count");
+                    _bad++;
+                }
+            }
+        }
+        
+        // no monster strips at all: monsters come from the vanilla sheets of the next phase
+        if (!_any && _f != ((arg7[k] == 0) ? 2 : 5))
+        {
+            gnx_report_mod_error("Cell '" + string(arg1) + "': intermission " + _names[k] + " has " + string(_f) + " frames but the cell has no mon_spr, so its monsters use the vanilla " + _mk[k] + " sheets (" + string((arg7[k] == 0) ? 2 : 5) + " frames)");
+            _bad++;
+        }
+    }
+    
+    gnx_frames_report_bad(arg1, _bad);
+}
+
+
+/// GNX-UG: checks the strips under every key named arg1 anywhere in arg0 (a human_spr block) against arg2
+/// frames per row; captive strips may loop. arg3 = cell name, arg4 = "sprites" block. Returns the problems.
+function gnx_frames_check_named_tables(arg0, arg1, arg2, arg3, arg4)
+{
+    var _bad = 0;
+    
+    if (is_array(arg0))
+    {
+        for (var i = 0; i < array_length(arg0); i++)
+            _bad += gnx_frames_check_named_tables(arg0[i], arg1, arg2, arg3, arg4);
+        
+        return _bad;
+    }
+    
+    if (!is_struct(arg0))
+        return 0;
+    
+    var _names = variable_struct_get_names(arg0);
+    
+    for (var i = 0; i < array_length(_names); i++)
+    {
+        var _v = variable_struct_get(arg0, _names[i]);
+        
+        // == arg1: the table we look for; anything else may hold it further down
+        if (_names[i] == arg1)
+            _bad += gnx_frames_check_refs(_v, arg2, arg3, "human_spr." + arg1, arg4, true);
+        else
+            _bad += gnx_frames_check_named_tables(_v, arg1, arg2, arg3, arg4);
+    }
+    
+    return _bad;
+}
+
+
+/// GNX-FRAMES: walks a human_spr block (arg0) and checks the strips under every key phase_0 ... phase_4
+/// with that phase's count (arg3), skipping phases the cell never draws (arg4[phase] false).
+/// arg1 = cell name, arg2 = "sprites" block. Returns the number of problems.
+function gnx_frames_check_phase_tables(arg0, arg1, arg2, arg3, arg4)
+{
+    var _bad = 0;
+    
+    if (is_array(arg0))
+    {
+        for (var i = 0; i < array_length(arg0); i++)
+            _bad += gnx_frames_check_phase_tables(arg0[i], arg1, arg2, arg3, arg4);
+        
+        return _bad;
+    }
+    
+    if (!is_struct(arg0))
+        return 0;
+    
+    var _names = variable_struct_get_names(arg0);
+    
+    for (var i = 0; i < array_length(_names); i++)
+    {
+        var _k = _names[i];
+        var _v = variable_struct_get(arg0, _k);
+        
+        // string_copy(text, 1, 6) = the first 6 characters; "phase_" + one digit 0-4
+        if (string_length(_k) == 7 && string_copy(_k, 1, 6) == "phase_" && string_digits(_k) != "" && real(string_digits(_k)) <= 4)
+        {
+            var _pn = real(string_digits(_k));
+            
+            // a table the cell never draws cannot show wrong frames
+            if (arg4[_pn])
+                _bad += gnx_frames_check_refs(_v, arg3[_pn], arg1, "human_spr." + _k, arg2, true);
+        }
+        else
+        {
+            _bad += gnx_frames_check_phase_tables(_v, arg1, arg2, arg3, arg4);
+        }
+    }
+    
+    return _bad;
+}
+
+
+/// GNX-FRAMES: checks every "gnx:<name>" sprite under arg0 against arg1 frames per row. arg2 = cell name,
+/// arg3 = where it is (for the message), arg4 = "sprites" block. Game sprites (no "gnx:") are not checked.
+/// Fewer frames than one row = mod error; frames left over after the last full row = log line only.
+/// arg5 = true for the captive's strips: those may be marked "loop" (they loop their own frames inside
+/// the phase, so any count fits). Monsters and the tentacle / milk overlays have no loop: they always
+/// need the phase's count. Returns the number of strips with too few frames.
+function gnx_frames_check_refs(arg0, arg1, arg2, arg3, arg4, arg5)
+{
+    var _bad = 0;
+    
+    if (is_string(arg0))
+    {
+        if (string_copy(arg0, 1, 4) != "gnx:" || !is_struct(arg4))
+            return 0;
+        
+        var _name = string_delete(arg0, 1, 4);
+        
+        if (!variable_struct_exists(arg4, _name))
+            return 0;
+        
+        var _def = variable_struct_get(arg4, _name);
+        var _n = -1;
+        
+        // "frames": a number (frames in the strip) or a list (atlas frames); a single image has 1
+        if (is_struct(_def) && variable_struct_exists(_def, "frames"))
+            _n = is_array(_def.frames) ? array_length(_def.frames) : floor(gnx_json_num(_def.frames, -1));
+        else if (is_struct(_def) || is_string(_def))
+            _n = 1;
+        
+        // GNX-LOOP-STRIP: a looping captive strip fits any phase length
+        var _is_loop = is_struct(_def) && variable_struct_exists(_def, "loop") && !(is_numeric(_def.loop) && _def.loop == 0);  // GNX: false arrives as 0
+        
+        if (_is_loop && arg5)
+            return 0;
+        
+        if (_is_loop && _n > 1 && _n < arg1)
+        {
+            gnx_report_mod_error("Cell '" + string(arg2) + "': strip '" + _name + "' (" + arg3 + ") is marked loop, but only the captive's strips can loop: it needs " + string(arg1) + " frames per row, like the captive's phase");
+            return 1;
+        }
+        
+        // too few frames for one row: the animation would run past the strip -> mod error
+        // (1 frame = a still image, it always fits)
+        if (_n > 1 && _n < arg1)
+        {
+            gnx_report_mod_error("Cell '" + string(arg2) + "': strip '" + _name + "' (" + arg3 + ") has " + string(_n) + " frames, it needs " + string(arg1) + " per row");
+            return 1;
+        }
+        
+        // % = remainder: 10 frames are 2 full rows of 5 (10 % 5 == 0); 12 leave 2 frames that are never
+        // shown. That can be on purpose (a strip shared with a longer phase), so it is only a log line.
+        if (_n > 1 && (_n % arg1) != 0)
+        {
+            var _wl = gnx_log_open();
+            gnx_log_write(_wl, "[GNX-FRAMES] " + string(arg2) + ": strip '" + _name + "' (" + arg3 + ") has " + string(_n) + " frames, the phase uses " + string(arg1) + " per row; the last " + string(_n % arg1) + " are not shown\n");
+            gnx_log_close(_wl);
+        }
+        
+        return 0;
+    }
+    
+    if (is_array(arg0))
+    {
+        for (var i = 0; i < array_length(arg0); i++)
+            _bad += gnx_frames_check_refs(arg0[i], arg1, arg2, arg3, arg4, arg5);
+    }
+    else if (is_struct(arg0))
+    {
+        var _names = variable_struct_get_names(arg0);
+        
+        for (var i = 0; i < array_length(_names); i++)
+        {
+            var _v = variable_struct_get(arg0, _names[i]);
+            
+            // GNX-FIX: in a captive table the hand (place 3 of spr_array / spr_c_array) is no animation:
+            // its strip holds hand poses per skin (hand_frames picks them), so its frame count is not the
+            // phase's. Every other place is checked.
+            if ((_names[i] == "spr_array" || _names[i] == "spr_c_array") && is_array(_v))
+            {
+                for (var j = 0; j < array_length(_v); j++)
+                {
+                    if (j != 3)
+                        _bad += gnx_frames_check_refs(_v[j], arg1, arg2, arg3, arg4, arg5);
+                }
+                
+                continue;
+            }
+            
+            _bad += gnx_frames_check_refs(_v, arg1, arg2, arg3, arg4, arg5);
+        }
+    }
+    
+    return _bad;
+}
+
+
+/// GNX-PLACES: whether a cell runs independent places: its scene list (arg0, the names from the JSON) holds
+/// "scr_slot_h_gnx_places". arg1 = max_mon_num, arg2 = the cell's name for mod errors. Other entries next to
+/// it are a mod error and are not run: the caller then keeps the places script alone (audit 25), so the cell
+/// never runs a half places, half vanilla scene. A cell without room for a monster is a mod error (it gets
+/// no monsters, so no scene ever starts).
+function gnx_places_check(arg0, arg1, arg2)
+{
+    if (!is_array(arg0))
+        return false;
+    
+    var _hits = 0;
+    
+    for (var i = 0; i < array_length(arg0); i++)
+    {
+        // == : this entry is the places script
+        if (is_string(arg0[i]) && arg0[i] == "scr_slot_h_gnx_places")
+            _hits++;
+    }
+    
+    if (_hits == 0)
+        return false;
+    
+    // < 1: no room for a monster, so no place to run (the cell calls no monster, its scene never starts)
+    if (gnx_json_num(arg1, 0) < 1)
+    {
+        gnx_report_mod_error("Cell '" + string(arg2) + "': scr_slot_h_gnx_places needs max_mon_num 1 or more; the cell gets no monsters");
+        return false;
+    }
+    
+    // != 1: the places script runs the whole scene; the other entries are left out by the caller
+    if (array_length(arg0) != 1)
+        gnx_report_mod_error("Cell '" + string(arg2) + "': scr_slot_h_gnx_places runs the whole scene, so it must be the only entry of scr_h; the other entries are left out");
+    
+    return true;
+}
+
+
+/// GNX-FIX: runs in a cell: which of its places 0 .. arg0 - 1 a monster of h_unit_list holds, as a list of
+/// true / false. Monsters that are gone or have no place (-1) are skipped, so nothing is written outside
+/// the list.
+function gnx_places_taken(arg0)
+{
+    var _t = array_create(max(0, arg0), false);
+    
+    if (!is_array(h_unit_list))
+        return _t;
+    
+    for (var i = 0; i < array_length(h_unit_list); i++)
+    {
+        var _u = h_unit_list[i];
+        
+        if (!gnx_is_live_inst(_u) || !variable_instance_exists(_u, "mon_data") || !is_struct(_u.mon_data))
+            continue;
+        
+        var _pn = _u.mon_data.placement_num;
+        
+        // >= 0 && < arg0: a place inside the list
+        if (_pn >= 0 && _pn < arg0)
+            _t[_pn] = true;
+    }
+    
+    return _t;
+}
+
+
+/// GNX-UG: fills what an underground cell (category "ug_breed") leaves out with GNX's own values:
+/// scene scripts, layers with the GNX tentacle and floor, default frames, a 75 px underground part and
+/// no squirt or drip effects. arg0 = the cell's JSON, arg1 = mod folder. Keys the mod wrote stay as written.
+function gnx_ug_fill_defaults(arg0, arg1)
+{
+    if (!variable_struct_exists(arg0, "physical") || !is_struct(arg0.physical))
+        arg0.physical = {};
+    
+    var _p = arg0.physical;
+    var _def = 
+    {
+        allow_preg: true,
+        max_mon_num: 0,
+        anal: -1,
+        slot_dirt_init: 0,
+        character_row: 0,
+        underground: 75,
+        // 5 px of extra ground between the bottom of the cell and the next floor's ceiling
+        underground_gap: 5,
+        frames: {},
+        layers: [[8, -1, false, -1, false], [6, -1, false, -1, false], [10, -1, -2, -1, false, -1], [21, "spr_empty", false, -1], [20, "spr_gnx_ug_tent_ready", false, -1], [0, "spr_gnx_ug_floor", false, -1]],
+        scr_idle: "scr_slot_h_gnx_ug_idle",
+        scr_h: ["scr_slot_h_gnx_ug_start", "scr_slot_h_gnx_ug_loop", "scr_slot_h_gnx_ug_ej", "scr_slot_h_gnx_ug_birth", "scr_slot_h_gnx_ug_milk"],
+        scr_draw: "scr_draw_slot_gnx",
+        hand_x: [],
+        hand_y: [],
+        hand_xscale: [],
+        hand_angle: [],
+        sq_x: -1,
+        sq_y: [0],
+        sp_x: -1,
+        sp_y: [0],
+        sp_anim_x: 0,
+        sp_anim_y: 0,
+        // GNX-FX: the vanilla splash, as in the tentacle cells (drawn only when sp_x is set)
+        sp_spr: "spr_sp_v_start"
+    };
+    var _keys = variable_struct_get_names(_def);
+    
+    for (var i = 0; i < array_length(_keys); i++)
+    {
+        // ! = not: only keys the mod did not write
+        if (!variable_struct_exists(_p, _keys[i]))
+            variable_struct_set(_p, _keys[i], variable_struct_get(_def, _keys[i]));
+    }
+    
+    // GNX-UG: say once which GNX graphics are missing. The installer names each PNG of GNX_assets
+    // spr_<file name>, so gnx_ug_floor.png becomes spr_gnx_ug_floor; any other file name is not found.
+    if (!variable_global_exists("gnx_ug_assets_logged") || !global.gnx_ug_assets_logged)
+    {
+        global.gnx_ug_assets_logged = true;
+        var _ga = global.gnx_ug_assets;
+        var _gn = [_ga.wall, _ga.wall2, _ga.top, _ga.tent, _ga.band];
+        var _gf = ["gnx_ug_wall_1", "gnx_ug_wall_2", "gnx_ug_floor", "gnx_ug_tent_ready", "gnx_ug_band"];
+        var _gu = ["first wall behind the cell", "second wall (swap button)", "cell floor", "tentacle in an empty cell", "floor band"];
+        var _gl = gnx_log_open();
+        
+        for (var _gi = 0; _gi < 5; _gi++)
+        {
+            if (_gn[_gi] == -1)
+                gnx_log_write(_gl, "[GNX-UG] spr_" + _gf[_gi] + " is not in the game: put " + _gf[_gi] + ".png into GNX_assets (the installer names each PNG spr_<file name>); the " + _gu[_gi] + " is not drawn\n");
+        }
+        
+        gnx_log_close(_gl);
+    }
+    
+    // GNX-FX: GNX cannot know where the captive is drawn, so squirt, drips and splash stay off until the
+    // mod gives their place: x from the left edge of the strip, y from the floor line (pixel row - yorig)
+    if (_p.sq_x == -1 && _p.sp_x == -1)
+    {
+        var _fxl = gnx_log_open();
+        gnx_log_write(_fxl, "[GNX-UG] mod '" + string(arg1) + "': underground cell '" + string(variable_struct_exists(arg0, "name") ? arg0.name : "?") + "' has no sq_x / sp_x - no squirt, drips or splash; set sq_x, sq_y, sp_x, sp_y in physical\n");
+        gnx_log_close(_fxl);
+    }
+    
+    // GNX-FIX: the payout at the end of a scene reads spawn_info; without it the game stopped after
+    // the first ej. Default = the vanilla tentacle wall cells (mood only, no gold).
+    if (!variable_struct_exists(arg0, "spawn_info"))
+        arg0.spawn_info = { coin: 0, mood: 2, coin_mul: false, mood_mul: false };
+    
+    // the GNX tentacle ("ready") shows only in an empty cell unless the mod gives phase sprites
+    if (!variable_struct_exists(arg0, "tent_spr"))
+        arg0.tent_spr = { start: "spr_empty", idle: "spr_empty", loop: "spr_empty", ej: "spr_empty", birth: "spr_empty", milk: "spr_empty" };
+    
+    if (variable_struct_exists(arg0, "human_spr") && is_struct(arg0.human_spr))
+    {
+        if (!variable_struct_exists(arg0.human_spr, "base_body"))
+            arg0.human_spr.base_body = "big";
+        
+        // fixed sprites draw the same captive for every class, so the cell should name its class
+        if (variable_struct_exists(arg0.human_spr, "mode") && arg0.human_spr.mode == "fixed" && !variable_struct_exists(_p, "required_class"))
+        {
+            var _l = gnx_log_open();
+            gnx_log_write(_l, "[GNX-WARN] mod '" + string(arg1) + "': underground cell '" + string(variable_struct_exists(arg0, "name") ? arg0.name : "?") + "' uses fixed sprites without required_class - every class can enter\n");
+            gnx_log_close(_l);
+        }
+    }
+}
+
+
+/// GNX-UG: gnx_floor_off for every floor (index = floor), used to move things when the bands change.
+function gnx_ug_floor_offsets()
+{
+    var _n = global.val.floor + 1;
+    var _out = array_create(_n, 0);
+    var _o = 0;
+    
+    for (var i = 0; i < _n; i++)
+    {
+        _out[i] = _o;
+        _o += 140 + gnx_floor_extra(i);
+    }
+    
+    return _out;
+}
