{
  "about": "F52: a manifest's \"cells\" may be a list of files. harness_cells_list names cells_a.json and more/cells_b.json; both cells are registered.",
  "mods": [
    "tools/scenarios/mods/harness_cells_list"
  ],
  "steps": [
    {
      "wait": 30
    },
    {
      "assert": "cell_registered",
      "name": "LIST CELL A",
      "is": true,
      "why": "first file"
    },
    {
      "assert": "cell_registered",
      "name": "LIST CELL B",
      "is": true,
      "why": "second file, in a subfolder"
    }
  ]
}
