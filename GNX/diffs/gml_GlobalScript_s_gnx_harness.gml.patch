+
+// Transfer cages (h_type 17) and hobgoblins currently carrying (mon_state 7-9)
+function scr_gnx_scn_carry_stats()
+{
+    var _st = { cells: 0, carrying_mons: 0, hobgoblins: 0, hob_nest_num: global.val.nest_num[2] };
+    // owned hobgoblins (every class) and the birth counter: births are the only honest way the owned count grows
+    _st.hob_owned = 0;
+
+    for (var _hc = 0; _hc < array_length(global.val.hobgoblin.num); _hc++)
+        _st.hob_owned += max(0, global.val.hobgoblin.num[_hc]);
+
+    _st.births = global.val.birth_num;
+    _st.last_cage_sweep = variable_global_exists("gnx_last_cage_sweep") ? global.gnx_last_cage_sweep : -1;  // [kept, restarted, dismissed]
+
+    with (obj_mon)
+    {
+        if (mon_data.mon_type == 1)
+            _st.hobgoblins++;
+    }
+
+    with (obj_slot)
+    {
+        if (variable_struct_exists(slot_data, "h_type") && slot_data.h_type == 17)
+            _st.cells++;
+    }
+
+    _st.bad_carriers = 0;
+
+    with (obj_mon)
+    {
+        // states 7-9 are carry states only for hobgoblins (mon_type 1)
+        if (mon_data.mon_type == 1 && mon_data.mon_state >= 7 && mon_data.mon_state <= 9 && variable_struct_exists(mon_data, "carry_start_id"))
+        {
+            _st.carrying_mons++;
+        }
+    }
+
+    // hobgoblins in carry states per cage (their slot_id); a cage normally has one team of 2
+    var _per = {};
+    _st.max_carriers_per_cage = 0;
+
+    with (obj_mon)
+    {
+        if (mon_data.mon_type == 1 && mon_data.mon_state >= 7 && mon_data.mon_state <= 9 && gnx_is_live_inst(mon_data.slot_id))
+        {
+            var _key = string(mon_data.slot_id);
+            var _n = (variable_struct_exists(_per, _key) ? variable_struct_get(_per, _key) : 0) + 1;
+            variable_struct_set(_per, _key, _n);
+            _st.max_carriers_per_cage = max(_st.max_carriers_per_cage, _n);
+        }
+    }
+
+    // any monster drawn with the carry routine while its carried unit is missing (scr_draw_hobgoblin_carry reads slot_id.unit_data.skin)
+    with (obj_mon)
+    {
+        if (scr_mon_draw != scr_draw_hobgoblin_carry || !variable_struct_exists(mon_data, "carry_start_id"))
+            continue;
+
+        if (mon_data.carry_start_id == -1 && mon_data.carry_end_id != -1 && !(gnx_is_live_inst(mon_data.slot_id) && is_struct(mon_data.slot_id.unit_data)))
+            _st.bad_carriers++;
+    }
+
+    return _st;
+}
+
+
+// Transfer cages (h_type 17) whose spawned hobgoblins (h_unit_list) are down to exactly one live one, as {id: true}
+function scr_gnx_scn_lone_cages()
+{
+    var _out = {};
+
+    with (obj_slot)
+    {
+        if (!variable_struct_exists(slot_data, "h_type") || slot_data.h_type != 17 || !is_array(h_unit_list))
+            continue;
+
+        var _live = 0;
+
+        for (var _li = 0; _li < array_length(h_unit_list); _li++)
+        {
+            if (gnx_is_live_inst(h_unit_list[_li]))
+                _live++;
+        }
+
+        if (_live == 1)
+            variable_struct_set(_out, string(id), true);
+    }
+
+    return _out;
+}
