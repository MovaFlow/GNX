{
  "about": "Custom types P1: every bad monsters.json entry is a mod error and is left out; the good one (imp) still registers; a name another mod declared first stays with that mod; a cell's mon_types number 4 is a mod error, a type name is kept.",
  "mods": ["tools/scenarios/mods/harness_type_a", "tools/scenarios/mods/harness_type_bad"],
  "check_boot_suite": false,
  "expect_dialog": "Mod 'harness_type_bad' monsters.json",
  "expect_mod_errors": [
    "'goblin': a game monster", "'wolf': already declared by 'harness_type_a'", "'hob': reserved name",
    "'Bad Name': names use a-z, 0-9 and _", "'nolike': needs \"like\"", "'squid': like 'tentacle'",
    "'dragon': like 'dragon'", "'glutton': food", "'weak': stat", "'slow': speed", "'typo': unknown key 'colour'",
    "'notobj': must be an object", "'badrange': range must be 4 lists", "'badskill': skills must be 4 skill ids", "mon_types entry 4 is no monster"
  ],
  "steps": [
    {"wait": 20},
    {"assert": "fn", "name": "gnx_scn_type_ids", "args": [], "is": "wolf=4/0 badart=5/0 badrange=6/0 badskill=7/0 imp=8/0"},
    {"assert": "fn", "name": "gnx_mon_type_id", "args": ["dragon"], "is": -1},
    {"assert": "fn", "name": "gnx_mon_like", "args": [3], "is": 3},
    {"assert": "fn", "name": "gnx_scn_cell_mon_types", "args": [{"cell": "harness_type_bad.TYPE BAD CELL"}], "is": "8", "why": "4 is left out (a mod error), the name imp is kept"}
  ]
}
