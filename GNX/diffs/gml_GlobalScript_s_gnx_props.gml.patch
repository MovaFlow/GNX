+/// GNX-PROP: the number of a prop named in a quest or tool (arg0) for mod arg1: a number stays as it is
+/// (vanilla props 0-47, mod props 100-9999); text is a mod prop's name, "Mod.id", or just "id" for a prop
+/// of mod arg1. Returns -1 (with a mod error) for a name no loaded mod has.
+function gnx_prop_resolve_id(arg0, arg1 = "")
+{
+    // is_numeric: a number (also true / false, which are no props but keep the old behaviour)
+    if (is_numeric(arg0))
+        return arg0;
+    
+    if (!is_string(arg0))
+    {
+        gnx_report_mod_error("prop_id must be a number or a prop name (\"Mod.id\"), not " + string(arg0));
+        return -1;
+    }
+    
+    // a number written as text ("112") is a number too
+    var _num = gnx_json_num(arg0, -1234567);
+    
+    if (_num != -1234567)
+        return _num;
+    
+    var _full = (string_pos(".", arg0) == 0 && arg1 != "") ? (string(arg1) + "." + arg0) : arg0;
+    
+    if (variable_global_exists("gnx_prop_name_to_id") && is_struct(global.gnx_prop_name_to_id) && variable_struct_exists(global.gnx_prop_name_to_id, _full))
+        return variable_struct_get(global.gnx_prop_name_to_id, _full);
+    
+    gnx_report_mod_error("prop '" + _full + "' is not a prop of any loaded mod (props.json \"id\", named \"Mod.id\")");
+    return -1;
+}
