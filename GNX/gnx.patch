+        return _bad;
+    }
+
+    if (is_array(arg0))
+    {
+        for (var _i = 0; _i < array_length(arg0); _i++)
+        {
+            if (!scr_gnx_spr_ok(arg0[_i]))
+                _bad += arg1 + "[" + string(_i) + "] ";
+        }
+
+        return _bad;
+    }
+
+    if (!is_struct(arg0))
