+// names of the mods a row requires, joined
+function gnx_req_names(arg0, arg1)
+{
+    var _t = "";
+
+    for (var _r = 0; _r < array_length(arg1.requires); _r++)
+    {
+        var _req = string(arg1.requires[_r]);
+        var _nm = _req;
+
+        for (var _k = 0; _k < array_length(arg0.rows); _k++)
+        {
+            if (arg0.rows[_k].folder == _req || arg0.rows[_k].mod_id == _req)
+                _nm = arg0.rows[_k].name;
+        }
+
+        _t += ((_r > 0) ? ", " : "") + _nm;
+    }
+
+    return _t;
+}
+
+
+// the name of a required mod that will not be on after APPLY ("" = none). arg0 = page window, arg1 = row
+function gnx_mod_row_missing_req(arg0, arg1)
+{
+    for (var _r = 0; _r < array_length(arg1.requires); _r++)
+    {
+        var _req = string(arg1.requires[_r]);
+        var _ok = false;
+        var _nm = _req;
+
+        for (var _k = 0; _k < array_length(arg0.rows); _k++)
+        {
+            var _o = arg0.rows[_k];
+
+            if (_o.folder == _req || _o.mod_id == _req)
+            {
+                _nm = _o.name;
+
+                if (gnx_mod_row_on(arg0, _o))
+                    _ok = true;
+            }
+        }
+
+        if (!_ok)
+            return _nm;
+    }
+
+    return "";
+}
