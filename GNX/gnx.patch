+    if (array_length(variable_struct_get_names(_r.on)) == 0)
+    {
+        gnx_report_mod_error(gnx_err_who(arg1) + ": react has no usable event; ignored");
+        return undefined;
+    }
+    
+    // "play": "next_stop" without stops plays to the end of the strip each time: most likely forgotten stops
+    var _uses_stop = false;
+    var _on_n = variable_struct_get_names(_r.on);
+    
+    for (var i = 0; i < array_length(_on_n); i++)
+    {
+        if (variable_struct_get(_r.on, _on_n[i]).play_stop)
+            _uses_stop = true;
+    }
+    
+    if (_uses_stop && array_length(_r.stops) == 0)
+        gnx_report_mod_error(gnx_err_who(arg1) + ": react uses \"play\": \"next_stop\" but has no stops; it plays to the end of the strip");
