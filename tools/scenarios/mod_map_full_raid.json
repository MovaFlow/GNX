{
  "about": "A full raid on a mod map, through the raid window's own code: clear the fixture's saved formation, pick stage 0 (stage button), put 40 goblins in the front row and 20 goblins of class 1 in the back (drop + number window, as a drag does), Go, then the fight, the cart's return and the rewards run in the game's code. Only the cart animation is fast-forwarded (it is a sequence that plays in real time, minutes per raid). Then collect captives and loot, save and reload on the map. Screenshots in harness_game/screens/mod_map_full_raid/.",
  "fixture": "modded",
  "fixture_on_map": "harness_map",
  "mods": [
    "tools/scenarios/mods/harness_map"
  ],
  "seed": 3,
  "timeout": 120,
  "steps": [
    {
      "wait": 60
    },
    {
      "assert": "active_map",
      "is": "harness_map"
    },
    {
      "assert": "raid",
      "state": 0
    },
    {
      "open_raid": true
    },
    {
      "wait": 5
    },
    {
      "raid_stage": 0
    },
    {
      "wait": 10
    },
    {
      "assert": "raid",
      "state": 0,
      "stage": 0
    },
    {
      "raid_clear_formation": true
    },
    {
      "wait": 2
    },
    {
      "assert": "raid",
      "troops": 0,
      "why": "the fixture comes with a saved formation"
    },
    {
      "raid_formation": {
        "front": [
          [
            0,
            40
          ]
        ],
        "back": [
          [
            1,
            20
          ]
        ]
      }
    },
    {
      "wait": 3
    },
    {
      "assert": "raid",
      "troops": 60
    },
    {
      "screenshot": "formation"
    },
    {
      "raid_go": true
    },
    {
      "wait": 5
    },
    {
      "assert": "raid",
      "state": 1
    },
    {
      "screenshot": "raiding"
    },
    {
      "raid_finish": 1200
    },
    {
      "wait": 5
    },
    {
      "assert": "raid",
      "state": 0,
      "cage_min": 1,
      "why": "60 goblins win stage 0: captives in the cage"
    },
    {
      "screenshot": "back_home"
    },
    {
      "press": {
        "type": 47,
        "num": 1
      }
    },
    {
      "press": {
        "type": 47,
        "num": 0
      }
    },
    {
      "wait": 5
    },
    {
      "screenshot": "collected"
    },
    {
      "assert": "raid",
      "cage": 0,
      "loot": 0,
      "why": "captives and loot moved to the nest"
    },
    {
      "save": 9
    },
    {
      "reload": 9
    },
    {
      "wait": 30
    },
    {
      "assert": "active_map",
      "is": "harness_map"
    },
    {
      "assert": "raid",
      "state": 0
    }
  ]
}