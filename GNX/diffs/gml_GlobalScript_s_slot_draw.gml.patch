+                with (obj_particle_single)
+                {
+                    if (x >= _fx_x0 && x <= _fx_x1 && y >= _fx_y0 && y <= _fx_y1)
+                        draw_sprite_ext(sprite_index, image_index, x, y, image_xscale, image_yscale, image_angle, image_blend, image_alpha);
+                }
+
+                with (obj_empty)
+                {
+                    // obj_empty is used for many things; only the splash drips (spr_sp_drip_*)
+                    if ((sprite_index == spr_sp_drip_1 || sprite_index == spr_sp_drip_2 || sprite_index == spr_sp_drip_1_end || sprite_index == spr_sp_drip_2_end) && x >= _fx_x0 && x <= _fx_x1 && y >= _fx_y0 && y <= _fx_y1)
+                        draw_sprite_ext(sprite_index, image_index, x, y, image_xscale, image_yscale, image_angle, image_blend, image_alpha);
+                }
+            }
+        }
+    }
