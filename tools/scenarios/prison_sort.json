{
  "about": "Prison sorting (sort button 9088 in the prison window): each press sorts the prison by the next order (class, level, milk ready, fertility) and wraps; the order holds, empty places come last, and no prisoner is lost or doubled. Fixture mid (full prison).",
  "fixture": "mid",
  "check_boot_suite": false,
  "steps": [
    {
      "wait": 30
    },
    {
      "call": "gnx_scn_prison_vary",
      "why": "mixed levels, milk and pregnancies left, so every order moves prisoners"
    },
    {
      "call": "gnx_scn_prison_mark"
    },
    {
      "camera_y": 0
    },
    {
      "press": {
        "type": 19,
        "num": 0
      },
      "why": "the prison button: opens the prison window"
    },
    {
      "wait": 40
    },
    {
      "assert": "fn",
      "name": "gnx_scn_button_count",
      "args": [
        9088
      ],
      "is": 1,
      "why": "the sort button"
    },
    {
      "screenshot": "prison"
    },
    {
      "press": {
        "type": 9088,
        "num": 0
      },
      "why": "sort by class"
    },
    {
      "wait": 10
    },
    {
      "assert": "global",
      "name": "gnx_prison_sort",
      "is": 0
    },
    {
      "assert": "fn",
      "name": "gnx_scn_prison_check",
      "args": [
        0
      ],
      "is": "ok",
      "why": "class order, nobody lost"
    },
    {
      "assert": "fn",
      "name": "gnx_scn_prison_monotone",
      "args": [
        "class",
        1,
        ""
      ],
      "is": "ok",
      "why": "read from the prisoners' class"
    },
    {
      "assert": "fn",
      "name": "gnx_scn_button_count",
      "args": [
        9088
      ],
      "is": 1,
      "why": "the rebuilt window keeps its sort button"
    },
    {
      "press": {
        "type": 9088,
        "num": 0
      },
      "why": "sort by level"
    },
    {
      "wait": 10
    },
    {
      "assert": "global",
      "name": "gnx_prison_sort",
      "is": 1
    },
    {
      "assert": "fn",
      "name": "gnx_scn_prison_check",
      "args": [
        1
      ],
      "is": "ok",
      "why": "level order, nobody lost"
    },
    {
      "assert": "fn",
      "name": "gnx_scn_prison_monotone",
      "args": [
        "lvl",
        -1,
        ""
      ],
      "is": "ok",
      "why": "read from the prisoners' lvl"
    },
    {
      "assert": "fn",
      "name": "gnx_scn_button_count",
      "args": [
        9088
      ],
      "is": 1,
      "why": "the rebuilt window keeps its sort button"
    },
    {
      "press": {
        "type": 9088,
        "num": 0
      },
      "why": "sort by milk"
    },
    {
      "wait": 10
    },
    {
      "assert": "global",
      "name": "gnx_prison_sort",
      "is": 2
    },
    {
      "assert": "fn",
      "name": "gnx_scn_prison_check",
      "args": [
        2
      ],
      "is": "ok",
      "why": "milk order, nobody lost"
    },
    {
      "assert": "fn",
      "name": "gnx_scn_prison_monotone",
      "args": [
        "milk",
        -1,
        ""
      ],
      "is": "ok",
      "why": "read from the prisoners' milk"
    },
    {
      "assert": "fn",
      "name": "gnx_scn_button_count",
      "args": [
        9088
      ],
      "is": 1,
      "why": "the rebuilt window keeps its sort button"
    },
    {
      "press": {
        "type": 9088,
        "num": 0
      },
      "why": "sort by fertility"
    },
    {
      "wait": 10
    },
    {
      "assert": "global",
      "name": "gnx_prison_sort",
      "is": 3
    },
    {
      "assert": "fn",
      "name": "gnx_scn_prison_check",
      "args": [
        3
      ],
      "is": "ok",
      "why": "fertility order, nobody lost"
    },
    {
      "assert": "fn",
      "name": "gnx_scn_prison_monotone",
      "args": [
        "preg_c",
        -1,
        "fertile"
      ],
      "is": "ok",
      "why": "read from the prisoners' preg_c"
    },
    {
      "assert": "fn",
      "name": "gnx_scn_button_count",
      "args": [
        9088
      ],
      "is": 1,
      "why": "the rebuilt window keeps its sort button"
    },
    {
      "screenshot": "sorted"
    },
    {
      "press": {
        "type": 9088,
        "num": 0
      },
      "why": "wraps back to class"
    },
    {
      "wait": 10
    },
    {
      "assert": "global",
      "name": "gnx_prison_sort",
      "is": 0
    }
  ]
}