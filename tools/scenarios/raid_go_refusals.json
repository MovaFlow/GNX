{
  "about": "The raid (Go) button's refusals, as the mouse handler applies them: empty formation, a force too weak for the stage, captives left in the cage, loot left in storage. Once everything is collected Go works again. Limit: the refusal is computed by the harness's copy of the Go button's checks (gnx_scn_raid_go_refusal), because the real checks in scr_mouse_click read the physical mouse; this scenario proves the copy and the scenario agree, and that Go starts the raid once nothing refuses it, not that the game's own guard refuses.",
  "fixture": "mid",
  "seed": 5,
  "timeout": 120,
  "steps": [
    {
      "wait": 60
    },
    {
      "open_raid": true
    },
    {
      "wait": 5
    },
    {
      "raid_stage": 4
    },
    {
      "wait": 10
    },
    {
      "raid_clear_formation": true
    },
    {
      "raid_go": {
        "expect_refused": 1
      },
      "why": "empty formation"
    },
    {
      "raid_formation": {
        "front": [
          [
            0,
            2
          ]
        ]
      }
    },
    {
      "raid_go": {
        "expect_refused": 32
      },
      "why": "2 goblins are too weak for stage 4"
    },
    {
      "assert": "raid",
      "state": 0
    },
    {
      "raid_stage": 0
    },
    {
      "wait": 10
    },
    {
      "raid_clear_formation": true
    },
    {
      "raid_formation": {
        "front": [
          [
            0,
            300
          ]
        ],
        "back": [
          [
            1,
            150
          ]
        ]
      }
    },
    {
      "raid_go": true
    },
    {
      "wait": 5
    },
    {
      "raid_finish": 1200
    },
    {
      "wait": 5
    },
    {
      "assert": "raid",
      "state": 0,
      "cage_min": 1
    },
    {
      "raid_go": {
        "expect_refused": 2
      },
      "why": "captives still in the cage"
    },
    {
      "press": {
        "type": 47,
        "num": 1
      }
    },
    {
      "wait": 3
    },
    {
      "raid_go": {
        "expect_refused": 3
      },
      "why": "loot still waiting"
    },
    {
      "press": {
        "type": 47,
        "num": 0
      }
    },
    {
      "wait": 3
    },
    {
      "raid_go": true,
      "why": "everything collected: Go is accepted again"
    },
    {
      "wait": 5
    },
    {
      "assert": "raid",
      "state": 1
    },
    {
      "raid_finish": 1200
    },
    {
      "wait": 5
    },
    {
      "assert": "raid",
      "state": 0
    }
  ]
}
