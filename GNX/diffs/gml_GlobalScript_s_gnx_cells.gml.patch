+/// GNX-PROP: the shared clock of mod props in seconds of game time (advanced once per step in
+/// scr_main_end_step, stops while paused); 0 before the first step
+function gnx_scene_time()
+{
+    return variable_global_exists("gnx_scene_t") ? global.gnx_scene_t : 0;
+}
+
+
+// Vanilla sprite fallback for a class's sprite tables (clothing_* / naked_*). arg0 = the resolved table,
+// arg1 = its JSON definition, arg2 = the vanilla table to take from. Fills keys the mod left out, and
+// sprites whose "gnx:" reference did not load (missing file); an explicit -1 stays -1 (no layer on purpose).
+// A mod's leg_any is kept: the dispatch prefers leg_0/1/2 over it, so those are not added next to it.
+// arg3 = also add keys the mod left out (overrides of a vanilla class; a new class only gets unloadable refs
+// replaced). Returns how many entries came from vanilla.
+function gnx_fill_from_vanilla(arg0, arg1, arg2, arg3)
+{
+    if (!is_struct(arg0) || !is_struct(arg2))
+        return 0;
+
+    var _n = 0;
+    var _keys = variable_struct_get_names(arg2);
+    var _has_any = variable_struct_exists(arg0, "leg_any");
+
+    for (var _i = 0; _i < array_length(_keys); _i++)
+    {
+        var _k = _keys[_i];
+        var _bv = variable_struct_get(arg2, _k);
+
+        if (!variable_struct_exists(arg0, _k))
+        {
+            if (!arg3)
+                continue;
+            
+            if (_has_any && (_k == "leg_0" || _k == "leg_1" || _k == "leg_2"))
+                continue;
+
+            variable_struct_set(arg0, _k, _bv);
+            _n++;
+            continue;
+        }
+
+        var _rv = variable_struct_get(arg0, _k);
+        var _dv = (is_struct(arg1) && variable_struct_exists(arg1, _k)) ? variable_struct_get(arg1, _k) : undefined;
+
+        if (is_struct(_rv) && is_struct(_bv))
+        {
+            _n += gnx_fill_from_vanilla(_rv, _dv, _bv, arg3);
+        }
+        else if (is_string(_dv) && (_rv == -1 || !scr_gnx_spr_ok(_rv)) && !is_struct(_bv))  // -1 = the ref did not load
+        {
+            variable_struct_set(arg0, _k, _bv);
+            _n++;
+        }
+    }
+
+    return _n;
+}
+
+
+/// GNX-UG: true when the TRANSFER cell's hobgoblins must leave cell type arg0 alone: no captive is taken
+/// out of it and none is brought in (underground cells, or physical "transfer": false).
+function gnx_cell_no_transfer(arg0)
+{
+    var _c = ds_map_find_value(global.cell_registry, arg0);
+    // != undefined: arg0 is a registered mod cell (vanilla cells and -1 are not in the map)
+    return _c != undefined && variable_struct_exists(_c.physical, "gnx_no_transfer") && _c.physical.gnx_no_transfer;
+}
+
+
+/// GNX-UG: true when cell type arg0 runs the underground scene (the scr_slot_h_gnx_ug_* scripts).
+function gnx_cell_is_ug(arg0)
+{
+    var _c = ds_map_find_value(global.cell_registry, arg0);
+    return _c != undefined && variable_struct_exists(_c.physical, "gnx_frames");
+}
+
+
+/// GNX-UG: the child species of a pregnancy in an underground cell for class arg0 (the class's
+/// preg_mon_type_override, otherwise tentacle 2), as gnx_ug_child_type() does for the captive in the cell.
+function gnx_ug_child_type_for(arg0)
+{
+    var _rc = ds_map_find_value(global.class_registry, arg0);
+    
+    // GNX-FIX: the class loader already checks the value; gnx_json_num keeps this safe for anything else
+    if (_rc != undefined && variable_struct_exists(_rc, "preg_mon_type_override"))
+        return clamp(floor(gnx_json_num(_rc.preg_mon_type_override, 2)), 0, 3);
+    
+    return 2;
+}
+
+
+// Numer na koncu nazwy pliku ("spr_x_12.png" -> 12); -1 gdy nazwa nie konczy sie cyfra
+function gnx_trailing_number(arg0)
+{
+    var _base = filename_change_ext(arg0, "");
+    var _len = string_length(_base);
+    var _p = _len;
+
+    // string_digits zostawia same cyfry - pusty wynik = ten znak nie jest cyfra
+    while (_p > 0 && string_digits(string_char_at(_base, _p)) != "")
+        _p--;
+
+    if (_p == _len)
+        return -1;
+
+    return real(string_copy(_base, _p + 1, _len - _p));
+}
+
+
+// Porownanie do array_sort: rosnaco po numerze klatki
+function gnx_cmp_frame_num(arg0, arg1)
+{
+    return arg0.num - arg1.num;
+}
+
+
+function gnx_get_carry_base(arg0, arg1, arg2)
+{
+    if (!ds_map_exists(global.class_registry, arg0))
+        return arg2;
+    
+    var _rc = ds_map_find_value(global.class_registry, arg0);
+    
+    if (!variable_struct_exists(_rc, "carry_base_spr"))
+        return arg2;
+    
+    var _cbs = _rc.carry_base_spr;
+    
+    // Mav (1.4.7.5): an atlas sprite is a struct too: a leg map is a struct that is NOT a sprite
+    if (is_struct(_cbs) && !is_sprref(_cbs))
+    {
+        var _k = (arg1 == 0) ? "leg_0" : ((arg1 == 2) ? "leg_2" : "leg_1");
+        
+        if (variable_struct_exists(_cbs, _k) && gnx_sprite_exists(variable_struct_get(_cbs, _k)))
+            return variable_struct_get(_cbs, _k);
+        
+        return arg2;
+    }
+    
+    if (gnx_sprite_exists(_cbs))
+        return _cbs;
+    
+    return arg2;
+}
