+        gnx_log_write(_wl, "[GNX-WARN] underground birth h=" + string(slot_data.h_type) + " class=" + string(unit_data.class) + ": newborn data was lost (no saved data, no prop); the child was rebuilt from the mother (species " + string(gnx_ug_child_type()) + ")\n");
