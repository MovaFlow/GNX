+function scr_gnx_deferred_resolve_class_map()
+{
+    var _key = ds_map_find_first(global.cell_registry);
+    
+    repeat (ds_map_size(global.cell_registry))
+    {
+        var _cell = ds_map_find_value(global.cell_registry, _key);
+        
+        if (is_struct(_cell) && variable_struct_exists(_cell, "human_spr"))
+        {
+            var _hspr = _cell.human_spr;
+            
+            if (is_struct(_hspr) && variable_struct_exists(_hspr, "mode") && _hspr.mode == "class_map" && variable_struct_exists(_hspr, "classes"))
+            {
+                var _cls = _hspr.classes;
+                var _cls_keys = variable_struct_get_names(_cls);
+                var _needs_remap = false;
+                var _ci = 0;
+                
+                repeat (array_length(_cls_keys))
+                {
+                    var _ck = _cls_keys[_ci++];
+                    
+                    if (string_pos(".", _ck) > 0)
+                    {
+                        var _rid = ds_map_find_value(global.gnx_class_name_to_id, _ck);
+                        
+                        if (_rid != undefined)
+                        {
+                            var _val = variable_struct_get(_cls, _ck);
+                            variable_struct_remove(_cls, _ck);
+                            variable_struct_set(_cls, string(_rid), _val);
+                            _needs_remap = true;
+                        }
+                        else
+                        {
+                            var _log = gnx_log_open();
+                            gnx_log_write(_log, "[GNX-WARN] class_map h=" + string(_key) + " unresolved ref: " + _ck + "\n");
+                            gnx_log_close(_log);
+                        }
+                    }
+                }
+                
+                if (_needs_remap)
+                {
+                    var _log = gnx_log_open();
+                    gnx_log_write(_log, "[GNX] class_map h=" + string(_key) + " deferred refs resolved\n");
+                    gnx_log_close(_log);
+                }
+                
+                // GNX-UG: an underground cell takes only the classes it has sprites for
+                // (no "default" entry and no required_class of its own)
+                if (variable_struct_exists(_cell.physical, "gnx_ug_depth") && !variable_struct_exists(_cell.physical, "required_class") && !variable_struct_exists(_cls, "default"))
+                {
+                    var _ids = [];
+                    var _ug_keys = variable_struct_get_names(_cls);
+                    
+                    for (var _uk = 0; _uk < array_length(_ug_keys); _uk++)
+                    {
+                        // string_digits keeps only digits: equal means the key is a class id
+                        if (string_digits(_ug_keys[_uk]) == _ug_keys[_uk] && _ug_keys[_uk] != "")
+                            array_push(_ids, real(_ug_keys[_uk]));
+                    }
+                    
+                    if (array_length(_ids) > 0)
+                        _cell.physical.required_class = _ids;
+                }
+            }
+        }
+        
+        _key = ds_map_find_next(global.cell_registry, _key);
+    }
+}
