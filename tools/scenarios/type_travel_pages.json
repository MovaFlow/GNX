{
  "about": "Custom types P3: the travel selector's TROOPS tab pages its type sections, 4 per page (goblin hobgoblin tentacle ogre | wolf bear boar fox). Page 1's take buttons keep the numbers 70 + slot*4 + class and take that page's type (button 83 = slot 3 class 1 = fox, not the ogre of page 0); arrows 92/93 change the page; the captive pager 90/91 never shows on TROOPS.",
  "mods": ["tools/scenarios/mods/harness_map_c", "tools/scenarios/mods/harness_type_a", "tools/scenarios/mods/harness_type_b", "tools/scenarios/mods/harness_type_c"],
  "timeout": 120,
  "steps": [
    {"wait": 30},
    {"do": {"type": "spawn_mon", "species": "wolf", "amount": 10, "class": 1}},
    {"do": {"type": "spawn_mon", "species": "bear", "amount": 10, "class": 1}},
    {"do": {"type": "spawn_mon", "species": "boar", "amount": 10, "class": 1}},
    {"do": {"type": "spawn_mon", "species": "fox", "amount": 10, "class": 1}},
    {"wait": 3},
    {"assert": "fn", "name": "gnx_scn_kept_num", "args": ["fox"], "is": 10},
    {"open_selector": "harness_c"},
    {"wait": 3},
    {"press_travel_button": {"num": 41}, "why": "TROOPS tab"},
    {"wait": 3},
    {"assert": "fn", "name": "gnx_scn_offered_types", "args": [], "is": "goblin hobgoblin tentacle ogre wolf bear boar fox", "why": "vanilla four, then the unlocked custom types the destination loads"},
    {"assert": "fn", "name": "gnx_scn_troop_page", "args": [], "is": 0},
    {"assert": "fn", "name": "gnx_scn_sel_has", "args": [93], "is": 1, "why": "more than 4 types: the next-page arrow"},
    {"press_travel_button": {"num": 93}, "why": "next page"},
    {"wait": 3},
    {"assert": "fn", "name": "gnx_scn_troop_page", "args": [], "is": 1},
    {"assert": "fn", "name": "gnx_scn_sel_has", "args": [83], "is": 1, "why": "fox (slot 3) class 1 take button"},
    {"layout_check": "troops_p1"},
    {"screenshot": "troops_p1"},
    {"press_travel_button": {"num": 83}, "why": "take fox class 1: the number pad"},
    {"wait": 3},
    {"press": {"type": 29, "num": 3}, "why": "+10"},
    {"press": {"type": 29, "num": 4}, "why": "OK"},
    {"wait": 3},
    {"assert": "fn", "name": "gnx_scn_party_types", "args": [], "is": "fox", "why": "a page 1 button takes page 1's type"},
    {"assert": "selector", "party": 10},
    {"assert": "fn", "name": "gnx_scn_troop_page", "args": [], "is": 1, "why": "the number pad rebuild keeps the page"},
    {"screenshot": "troops_p1_party"},
    {"press_travel_button": {"num": 92}, "why": "previous page"},
    {"wait": 3},
    {"assert": "fn", "name": "gnx_scn_troop_page", "args": [], "is": 0},
    {"layout_check": "troops_p0"},
    {"screenshot": "troops_p0"},
    {"assert": "fn", "name": "gnx_scn_sel_has", "args": [90], "is": 0, "why": "no captive pager on TROOPS"},
    {"assert": "fn", "name": "gnx_scn_sel_has", "args": [91], "is": 0},
    {"press_travel_button": {"num": 20}},
    {"wait": 3},
    {"assert": "selector", "open": false}
  ]
}
