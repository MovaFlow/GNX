{
  "about": "A cell turned off with the on/off row of its window (last row, the giant breeding icon) keeps its captive but no monster comes in; turned on again, monsters come. The setting is saved with the cell. Fixture mid; the test cell is an empty vanilla breeding cell given a captive. Utility cells (drink, milk, birth, transfer...) show a power icon on that row instead, breed and pleasure cells the giant's breeding icon (the cell's build category is its tag).",
  "fixture": "mid",
  "check_boot_suite": false,
  "steps": [
    {
      "wait": 30
    },
    {
      "occupy": {
        "h_type": 9,
        "class": 0,
        "level": 1
      }
    },
    {
      "call": "gnx_scn_open_occupied_window"
    },
    {
      "wait": 3
    },
    {
      "screenshot": "window"
    },
    {
      "assert": "fn",
      "name": "gnx_scn_off_icon",
      "args": [],
      "is": "spr_mod_icon",
      "why": "a breed cell: the giant's breeding icon"
    },
    {
      "assert": "fn",
      "name": "gnx_scn_press_cell_off",
      "args": [],
      "is": 1,
      "why": "off: the window's last row"
    },
    {
      "assert": "fn",
      "name": "gnx_scn_occupied_off",
      "args": [],
      "is": 1
    },
    {
      "wait": 3
    },
    {
      "screenshot": "window_off"
    },
    {
      "wait": 1200
    },
    {
      "assert": "fn",
      "name": "gnx_scn_occupied_mons",
      "args": [],
      "is": 0,
      "why": "nobody called while off"
    },
    {
      "save": 9
    },
    {
      "reload": 9
    },
    {
      "wait": 30
    },
    {
      "call": "gnx_scn_refind_occupied",
      "args": []
    },
    {
      "assert": "fn",
      "name": "gnx_scn_occupied_off",
      "args": [],
      "is": 1,
      "why": "saved with the cell"
    },
    {
      "call": "gnx_scn_open_occupied_window"
    },
    {
      "wait": 3
    },
    {
      "assert": "fn",
      "name": "gnx_scn_press_cell_off",
      "args": [],
      "is": 1,
      "why": "on: the window's last row"
    },
    {
      "assert": "fn",
      "name": "gnx_scn_occupied_off",
      "args": [],
      "is": 0
    },
    {
      "wait": 900
    },
    {
      "assert": "fn",
      "name": "gnx_scn_occupied_called",
      "args": [],
      "is": 1,
      "why": "monsters come again"
    },
    {
      "assert": "fn",
      "name": "gnx_cell_off_power",
      "args": [
        11
      ],
      "is": true,
      "why": "DRINK: utility"
    },
    {
      "assert": "fn",
      "name": "gnx_cell_off_power",
      "args": [
        17
      ],
      "is": true,
      "why": "TRANSFER: big utility"
    },
    {
      "assert": "fn",
      "name": "gnx_cell_off_power",
      "args": [
        1
      ],
      "is": false,
      "why": "a breed cell"
    },
    {
      "assert": "fn",
      "name": "gnx_cell_off_power",
      "args": [
        3
      ],
      "is": false,
      "why": "a pleasure cell"
    },
    {
      "assert": "fn",
      "name": "gnx_scn_open_cell_window",
      "args": [
        30
      ],
      "is": 1,
      "why": "an occupied tentacle utility cell"
    },
    {
      "wait": 3
    },
    {
      "assert": "fn",
      "name": "gnx_scn_off_icon",
      "args": [],
      "is": "spr_gnx_power_icon"
    },
    {
      "screenshot": "power_row"
    }
  ]
}