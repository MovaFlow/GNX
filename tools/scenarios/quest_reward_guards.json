{
  "about": "Quest rewards missing a field (amount, h_type, prop_id, type) give nothing and a mod error instead of a GameMaker error when the quest is completed.",
  "check_boot_suite": false,
  "steps": [
    {
      "wait": 10
    },
    {
      "assert": "fn",
      "name": "gnx_scn_reward_type",
      "args": [
        {
          "type": "gold",
          "amount": 5
        }
      ],
      "is": 5,
      "why": "a complete reward"
    },
    {
      "assert": "fn",
      "name": "gnx_scn_reward_type",
      "args": [
        {
          "type": "gold"
        }
      ],
      "is": 0,
      "why": "gold without amount: nothing, no crash"
    },
    {
      "assert": "fn",
      "name": "gnx_scn_reward_type",
      "args": [
        {
          "type": "food"
        }
      ],
      "is": 1000,
      "why": "food without amount"
    },
    {
      "assert": "fn",
      "name": "gnx_scn_reward_type",
      "args": [
        {
          "type": "blueprint"
        }
      ],
      "is": 0,
      "why": "blueprint without h_type"
    },
    {
      "assert": "fn",
      "name": "gnx_scn_reward_type",
      "args": [
        {
          "type": "blueprint",
          "h_type": 1
        }
      ],
      "is": 5001,
      "why": "blueprint of cell 1"
    },
    {
      "assert": "fn",
      "name": "gnx_scn_reward_type",
      "args": [
        {
          "type": "prop"
        }
      ],
      "is": 0,
      "why": "prop without prop_id"
    },
    {
      "assert": "fn",
      "name": "gnx_scn_reward_type",
      "args": [
        {
          "amount": 3
        }
      ],
      "is": 0,
      "why": "no type"
    }
  ],
  "expect_mod_errors": [
    "a blueprint reward needs \"h_type\"",
    "prop_id must be a number or a prop name"
  ]
}