+    
+    if (variable_struct_exists(arg0, "outline"))
+        _c.outline = gnx_json_color(arg0.outline, c_black, arg1, "counter.outline");
+    
+    if (variable_struct_exists(arg0, "spacing"))
+        _c.spacing = floor(gnx_json_num_in(arg0.spacing, 1, 0, 16, arg1, "counter.spacing"));
