+            gnx_log_write(_log, "[GNX-WARN] mod '" + arg0 + "': " + _data_files[_wi] + " exists but is not declared in manifest.json\n");
+            gnx_log_close(_log);
+        }
+    }
+    
+    if (is_array(global.gnx_loaded_mods))
+        array_push(global.gnx_loaded_mods, arg0);
+}
