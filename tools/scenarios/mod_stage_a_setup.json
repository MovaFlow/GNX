{
  "about": "Mod raid stages, part 1 of 3: two mods with a stage each get stage numbers 5 and 6 in load order; markers on each (their selected level) are saved. Part 2 loads the save without harness_raid_a, part 3 with both again.",
  "mods": [
    "tools/scenarios/mods/harness_raid_a",
    "tools/scenarios/mods/harness_raid_b"
  ],
  "save_fixture_as": "mod_stage_ab",
  "steps": [
    {
      "wait": 30
    },
    {
      "assert": "fn",
      "name": "gnx_stage_index",
      "args": [
        "harness_raid_a.CRYPT"
      ],
      "is": 5,
      "why": "first mod's stage is 5"
    },
    {
      "assert": "fn",
      "name": "gnx_stage_index",
      "args": [
        "harness_raid_b.BOG"
      ],
      "is": 6,
      "why": "second mod's stage is 6"
    },
    {
      "assert": "fn",
      "name": "gnx_scn_stage_lens",
      "args": [],
      "is": "7 7 7 7 7 2 0",
      "why": "every stage array has the 2 mod stages"
    },
    {
      "assert": "fn",
      "name": "gnx_stage_max_lvl",
      "args": [
        6
      ],
      "is": 2,
      "why": "BOG has 3 levels"
    },
    {
      "assert": "fn",
      "name": "gnx_stage_max_lvl",
      "args": [
        5
      ],
      "is": 1,
      "why": "CRYPT has 2 levels"
    },
    {
      "assert": "fn",
      "name": "gnx_stage_max_lvl",
      "args": [
        2
      ],
      "is": 2,
      "why": "vanilla stage"
    },
    {
      "call": "gnx_scn_set_stage_sel",
      "args": [
        "harness_raid_a.CRYPT",
        1
      ]
    },
    {
      "call": "gnx_scn_set_stage_sel",
      "args": [
        "harness_raid_b.BOG",
        2
      ]
    },
    {
      "save": 9
    }
  ]
}