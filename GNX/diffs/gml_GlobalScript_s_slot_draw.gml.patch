+/// GNX-UG: draws every underground cell on screen again, clipped to the rows from the floor tile down,
+/// so its part below the floor line covers the floor band. The newborn of the cell is drawn the same way.
+/// Called from obj_fg after the floor tiles; only cells drawn by scr_draw_slot_gnx are handled.
+function gnx_ug_draw_below_floor()
+{
+    var _vy = camera_get_view_y(view_camera[0]);
+    var _vh = camera_get_view_height(view_camera[0]);
+    
+    with (obj_slot)
+    {
+        // && = and (GameMaker stops at the first false part, so h_type is read only where it exists)
+        if (y >= (_vy - 200) && y <= (_vy + _vh + 200) && variable_struct_exists(slot_data, "h_type") && slot_data.h_type != -1)
+        {
+            var _c = ds_map_find_value(global.cell_registry, slot_data.h_type);
+            
+            if (_c != undefined && variable_struct_exists(_c.physical, "gnx_ug_depth"))
+            {
+                // one line in gnx_debug.txt the first time an underground part is drawn
+                if (!global.gnx_ug_logged)
+                {
+                    global.gnx_ug_logged = true;
+                    var _ul = gnx_log_open();
+                    gnx_log_write(_ul, "[GNX-UG] drawing below the floor: h=" + string(slot_data.h_type) + " y=" + string(y) + " band=+" + string(gnx_floor_extra(slot_data.slot_floor)) + "\n");
+                    gnx_log_close(_ul);
+                }
+                
+                // y - 1 = top row of the vanilla floor tile (174 + floor * floor height)
+                global.gnx_clip_top = y - 1;
+                scr_draw_slot();
+                var _pn = array_length(slot_data.prop);
+                
+                for (var _p = 0; _p < _pn; _p++)
+                {
+                    var _pid = slot_data.prop[_p].prop_id;
+                    
+                    if (instance_exists(_pid))
+                    {
+                        with (_pid)
+                        {
+                            if (visible && variable_instance_exists(id, "gnx_birth_spr") && gnx_birth_spr != -1)
+                                gnx_draw_sprite_ext(gnx_birth_spr, image_index, x, y, image_xscale, image_yscale, image_angle, image_blend, image_alpha);
+                        }
+                    }
+                }
+
+                global.gnx_clip_top = undefined;
+                // GNX-FX: squirt drops and splash drips inside the cell below the floor line were drawn
+                // under the floor band, so draw them again on top (only those in this cell's pit:
+                // x across the 77 px cell, y from the floor tile down to the cell bottom)
+                var _fx_x0 = x - 4;
+                var _fx_x1 = x + 81;
+                var _fx_y0 = y - 1;
+                var _fx_y1 = y + _c.physical.gnx_ug_depth + 4;
