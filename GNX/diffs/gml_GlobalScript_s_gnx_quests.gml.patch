+
+/// GNX-UNIT: puts captive arg0 (unit data) into the first free place of the prison and refreshes the prison
+/// window when it is open. false when the prison is full (nothing changes).
+function gnx_unit_to_prison(arg0)
+{
+    for (var i = 0; i < ds_list_size(global.unit_list); i++)
+    {
+        // == -1: a free place
+        if (ds_list_find_value(global.unit_list, i) == -1)
+        {
+            ds_list_set(global.unit_list, i, arg0);
+            
+            // && = and: the prison window is open
+            if (variable_instance_exists(obj_np, "unit_button") && obj_np.unit_button.child_window != -1)
+                scr_reset_unit_window(-1);
+            
+            return true;
+        }
+    }
+    
+    return false;
+}
