+// World map: the map-selector button (travel menu) is the only travel control. Per-map buttons ("flags")
+// were removed in 1.4.8; map_button.x / y are no longer used.
+function scr_gnx_create_travel_buttons()
+{
+    if (!global.gnx_multimap_enabled)
+        exit;
+    
+    scr_gnx_create_travel_menu_button();
+}
