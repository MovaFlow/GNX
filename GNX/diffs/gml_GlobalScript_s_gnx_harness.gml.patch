+function gnx_ui_spr(arg0, arg1, arg2, arg3, arg4, arg5)  // kind, sprite, frame, x, y, label
+{
+    draw_sprite(arg1, arg2, arg3, arg4);
+    var _x0 = arg3 - sprite_get_xoffset(arg1);
+    var _y0 = arg4 - sprite_get_yoffset(arg1);
+    gnx_ui_rect(arg0, _x0, _y0, _x0 + sprite_get_width(arg1), _y0 + sprite_get_height(arg1), arg5);
+}
