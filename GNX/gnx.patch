+/// GNX-PROP: frame position arg0 kept on a strip of arg1 frames: arg2 = true (at_end "hold") stops at the
+/// first and the last frame, false wraps round (one step after the last frame is the first).
+function gnx_prop_wrap(arg0, arg1, arg2)
+{
+    // <= 1: a 1-frame sprite has only frame 0
+    if (arg1 <= 1)
+        return 0;
+    
+    if (arg2)
+        return clamp(arg0, 0, arg1 - 1);
+    
+    // mod keeps the sign in GML (-1 mod 6 = -1), so + arg1 and mod again: one step back from frame 0 is the last
+    return ((arg0 mod arg1) + arg1) mod arg1;
