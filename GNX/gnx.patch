+			"GM_project_filename": GM_project_filename,
+			"GM_is_sandboxed": GM_is_sandboxed,
+		});
+		//expose globl depending on exposure level
+		exposeConstants({
+			"global": (_expose_level == GMLC_EXPOSURE.FULL) ? global : {},
+		});
