+// ---------------------------------------------------------------------------
+// Scenario runner (tools/gnx_test.py --scenario NAME, launches with -gnx-scenario NAME).
+// Reads <game dir>/GNX_scenarios/NAME.json, plays its steps from scr_main_end_step,
+// writes [GNX-SCN] lines to gnx_scenario.txt (gnx_debug.txt is truncated on travel),
+// then game_end(). Uses save slot 9 (gnx_harness_save.json) so player saves are never touched.
+// ---------------------------------------------------------------------------
+
+// Click the calling button through the game's own handler, so the whole dispatch runs as for a mouse click
+function gnx_scn_click()
+{
+    trigger = true;
+    curve_pos = 1;
+    scr_button_type_activate_data();
+}
+
+
+function gnx_scn_prison_free()
+{
+    var _n = 0;
+    
+    for (var i = 0; i < ds_list_size(global.unit_list); i++)
+    {
+        if (ds_list_find_value(global.unit_list, i) == -1)
+            _n++;
+    }
+    
+    return _n;
+}
+
+
+// The checks scr_mouse_action makes before a click on the raid (Go) button reaches its handler (vanilla
+// s_mouse_action, obj_button / Value_41). Returns the refusal popup, or -1 and stores ap_save like a real click.
+function gnx_scn_raid_go_refusal()
+{
+    var _raid = obj_np.obj_raid;
+    
+    if (_raid.raid_data.stage == -1)
+        return 5;
+    
+    if (ds_list_size(global.front_row) == 0 && ds_list_size(global.back_row) == 0)
+        return 1;
+    
+    var _stage_lvl = min(global.val.stage_lvl_sel[_raid.raid_data.stage], gnx_stage_max_lvl(_raid.raid_data.stage));
+    var _data = global.val.stage_info[_raid.raid_data.stage].info[_stage_lvl];
+    var _md = scr_calculate_mood_rate();
+    
+    if ((_raid.raid_data.ap[0] * _md.md_rate) < _data.en_ap[0] || (_raid.raid_data.ap[1] * _md.md_rate) < _data.en_ap[1])
+        return 32;
+    
+    for (var i = 0; i < array_length(global.val.cage); i++)
+    {
+        if (global.val.cage[i] != -1)
+            return 2;  // vanilla reports captives over loot
+    }
+    
+    if (ds_list_size(global.raid_inv_list) > 0)
+        return 3;
+    
+    _raid.ap_save = [_raid.raid_data.ap[0] * _md.md_rate, _raid.raid_data.ap[1] * _md.md_rate];
+    return -1;
+}
