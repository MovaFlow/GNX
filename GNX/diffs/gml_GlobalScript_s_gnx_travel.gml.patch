+            if (interact_type == 3)  // an open number pad
+                instance_destroy();
+        }
+
+        with (obj_button)
+        {
+            if (interact_type == 9061)
+                instance_destroy();
+        }
+
+        with (_w)
+            instance_destroy();
+
+        exit;
+    }
+
+    if (button_num == 21)  // TRAVEL
