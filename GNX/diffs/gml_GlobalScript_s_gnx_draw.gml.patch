+function scr_gnx_draw_scrollbar()
+{
+    // pasek niewidoczny = brak obszaru; ponizej ustawiany, gdy pasek jest rysowany
+    global.gnx_scrollbar_rect = -1;
+
+    // POPRAWKA: puszczony przycisk zawsze konczy przeciaganie (takze gdy pasek akurat sie nie rysuje)
+    if (global.gnx_scrollbar_dragging && !mouse_check_button(global.val.select_click))
+        global.gnx_scrollbar_dragging = false;
+
+    if (!instance_exists(obj_camera))
+        exit;
+    
+    if (global.camera_lock)
+        exit;
+    
+    var _floor = global.val.floor;
+    var _total_h = 270 + gnx_floor_off(_floor);
+    var _cam_h = obj_camera.cam_height;
+    
+    if (_cam_h >= _total_h)
+        exit;
+    
+    var _cam_y = obj_camera.y;
+    var _start_y = max(0, obj_camera.zoom_num - 2) * -40;
+    var _max_y = max(1, (_total_h - _cam_h) + (50 * max(0, sign(_floor - 1))));
+    var _track_x = 466;
+    var _track_w = 6;
+    var _track_top = 56;
+    var _track_bot = 230;
+    var _track_h = _track_bot - _track_top;
+    var _ratio = _cam_h / _total_h;
+    var _thumb_h = max(20, floor(_track_h * _ratio));
+    var _scroll_frac = clamp((_cam_y - _start_y) / _max_y, 0, 1);
+    var _thumb_y = _track_top + floor((_track_h - _thumb_h) * _scroll_frac);
+    var _mx = device_mouse_x_to_gui(0);
+    var _my = device_mouse_y_to_gui(0);
+    var _in_thumb = _mx >= _track_x && _mx <= (_track_x + _track_w) && _my >= _thumb_y && _my <= (_thumb_y + _thumb_h);
+    var _in_track = _mx >= _track_x && _mx <= (_track_x + _track_w) && _my >= _track_top && _my <= _track_bot;
+    
+    // zapamietaj obszar paska, zeby klik w niego nie trafial tez w gre (gnx_scrollbar_blocks_click)
+    global.gnx_scrollbar_rect = [_track_x - 2, _track_top, _track_x + _track_w + 2, _track_bot];
+
+    // POPRAWKA: przycisk wyboru z ustawien gry (po zamianie przyciskow myszy nie lewy na sztywno)
+    // POPRAWKA: przycisk GUI pod kursorem (np. strzalki okna ustawien przy prawej krawedzi) ma pierwszenstwo przed paskiem
+    if (mouse_check_button_pressed(global.val.select_click) && !gnx_gui_under_mouse())
+    {
+        if (_in_thumb)
+        {
+            global.gnx_scrollbar_dragging = true;
+            global.gnx_scrollbar_drag_offset = _my - _thumb_y;
+        }
+        else if (_in_track)
+        {
+            var _click_frac = clamp((_my - _track_top - (_thumb_h * 0.5)) / (_track_h - _thumb_h), 0, 1);
+            obj_camera.y = _start_y + (_click_frac * _max_y);
+            global.gnx_scrollbar_dragging = true;
+            global.gnx_scrollbar_drag_offset = _thumb_h * 0.5;
+        }
+    }
+    
+    if (global.gnx_scrollbar_dragging)
+    {
+        if (mouse_check_button(global.val.select_click))
+        {
+            var _drag_top = _my - global.gnx_scrollbar_drag_offset;
+            var _drag_frac = clamp((_drag_top - _track_top) / (_track_h - _thumb_h), 0, 1);
+            obj_camera.y = _start_y + (_drag_frac * _max_y);
+        }
+        else
+        {
+            global.gnx_scrollbar_dragging = false;
+        }
+    }
+    
+    var _thumb_alpha = (_in_thumb || global.gnx_scrollbar_dragging) ? 0.9 : 0.5;
+    draw_set_alpha(0.15);
+    draw_set_color(c_black);
+    draw_rectangle(_track_x, _track_top, _track_x + _track_w, _track_bot, false);
+    draw_set_alpha(_thumb_alpha);
+    draw_set_color(make_color_rgb(139, 110, 80));
+    draw_rectangle(_track_x, _thumb_y, _track_x + _track_w, _thumb_y + _thumb_h, false);
+    draw_set_color(make_color_rgb(90, 65, 45));
+    draw_rectangle(_track_x, _thumb_y, _track_x + _track_w, _thumb_y + _thumb_h, true);
+    draw_set_alpha(1);
+    draw_set_color(c_white);
+}
