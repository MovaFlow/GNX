+// sprite button with a centred text label (`text`); frame 1 drawn dim
+function scr_gnx_draw_label_button()
+{
+    scr_draw_hover_button();
+    draw_set_halign(fa_center);
+    draw_set_font(fnt_base_font_eng);
+    draw_set_color((image_index % 2 == 1) ? make_color_rgb(150, 120, 110) : c_white);
+    draw_text(x + 1, y - 3, text);
+    draw_set_color(c_white);
+    draw_set_halign(fa_left);
+}
+
+
+function scr_gnx_init_label_button()
+{
+    scr_create_gui_base_button();
+    spr_sel = (sprite_index == spr_button_long) ? spr_button_bar_sel : -1;
+    image_index = 0;
+    text = "";
+}
+
+
+function scr_gnx_open_mod_menu()
+{
+    with (obj_button)
+        instance_destroy();
+
+    with (obj_window)
+    {
+        if (interact_type == 9071 || interact_type == 9076)
+            instance_destroy();
+    }
+
+    if (instance_exists(obj_menu))
+    {
+        obj_menu.title = false;
+        obj_menu.bg = false;
+    }
+
+    var _w = instance_create_depth(0, 0, -100, obj_window);
+
+    with (_w)
+    {
+        interact_type = 9071;
+        gui = true;
+        sprite_index = spr_pixel;
+        image_xscale = 1;
+        image_yscale = 1;
+        scr_window_draw = scr_gnx_draw_mod_menu;
+        page = 0;
+        pending = scr_gnx_read_mods_off();
+        dirty = false;
+        rows = scr_gnx_mod_menu_rows();
+        scr_gnx_mod_menu_buttons();
+    }
+
+    return _w;
+}
+
+
+function gnx_mod_row_on(arg0, arg1)  // arg0 = page window, arg1 = row: on after APPLY?
+{
+    return arg1.installed && arg1.status != "bad" && !gnx_array_has(arg0.pending, arg1.folder);
+}
+
+
+function scr_gnx_mod_menu_buttons()
+{
+    with (obj_button)
+    {
+        if (interact_type >= 9072 && interact_type <= 9075)
+            instance_destroy();
+    }
+
+    var _n = array_length(rows);
+    var _pages = max(1, ceil(_n / gnx_mods_per_page()));
+    page = clamp(page, 0, _pages - 1);
+
+    for (var _i = page * gnx_mods_per_page(); _i < min(_n, (page + 1) * gnx_mods_per_page()); _i++)
+    {
+        var _row = rows[_i];
+
+        if (!_row.installed || _row.status == "bad")
+            continue;
+
+        var _y = 46 + ((_i - (page * gnx_mods_per_page())) * 22);
+        var _b = scr_create_button(90, _y, depth - 1, spr_button_long, 9072, id, scr_gnx_init_label_button, -1, scr_gnx_draw_label_button, _i, 0);
+
+        if (_b != -1)
+        {
+            var _on = gnx_mod_row_on(id, _row);
+            _b.image_index = _on ? 0 : 1;
+            _b.text = _on ? "ON" : "OFF";
+        }
+    }
+
+    if (_pages > 1)
+    {
+        scr_create_button(210, 197, depth - 1, spr_button_arrow, 9073, id, scr_gnx_create_tool_page_button, -1, scr_draw_hover_button, 0, 0);
