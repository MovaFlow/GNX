--- gml_138/gml_GlobalScript_s_gnx_mods.gml	1970-01-01 01:00:00.000000000 +0100
+++ gml/gml_GlobalScript_s_gnx_mods.gml	1970-01-01 01:00:00.000000000 +0100
@@ -0,0 +1,2493 @@
+// GNX: mod loading, per-mod state, mod menu, save mod records
+// (moved out of s_initials.gml; the functions are global, callable from any script)
+
+// ---------------------------------------------------------------------------
+// Mod menu (main menu > MODS). The off-list (save folder, gnx_mods_off.json: folder names) is a game-wide
+// setting: listed mods stay in GNX_mods but are not loaded. A manifest's "requires": ["mod_id", ...] names
+// mods it needs; when one of them is off or missing the mod is skipped and reported.
+// ---------------------------------------------------------------------------
+
+function scr_gnx_read_mods_off()
+{
+    var _off = [];
+    
+    if (!file_exists("gnx_mods_off.json"))
+        return _off;
+    
+    var _f = file_text_open_read("gnx_mods_off.json");
+    var _raw = "";
+    
+    while (!file_text_eof(_f))
+        _raw += file_text_readln(_f);
+    
+    file_text_close(_f);
+    
+    try
+    {
+        var _d = json_parse(_raw);
+        
+        if (is_array(_d))
+            _off = _d;
+    }
+    catch (_e)
+    {
+        _off = [];
+    }
+    
+    return _off;
+}
+
+
+function scr_gnx_write_mods_off(arg0)
+{
+    var _f = file_text_open_write("gnx_mods_off.json");
+    file_text_write_string(_f, json_stringify(arg0));
+    file_text_close(_f);
+}
+
+
+// [{folder, mod_id, name, version, requires, status, why}] for every folder in GNX_mods (arg0, sorted).
+// status: "on" (loads), "off" (off-list), "needs" (a required mod is off or missing), "bad" (manifest
+// unreadable). Off-list entries whose folder is gone are dropped, so a reinstalled mod comes back on.
+function scr_gnx_build_mod_list(arg0)
+{
+    var _off = scr_gnx_read_mods_off();
+    var _kept = [];
+    
+    for (var _i = 0; _i < array_length(_off); _i++)
+    {
+        if (gnx_array_has(arg0, _off[_i]))
+            array_push(_kept, _off[_i]);
+    }
+    
+    if (array_length(_kept) != array_length(_off))
+        scr_gnx_write_mods_off(_kept);
+    
+    var _list = [];
+    
+    for (var _i = 0; _i < array_length(arg0); _i++)
+    {
+        var _e = { folder: arg0[_i], mod_id: arg0[_i], name: arg0[_i], version: "?", requires: [], status: "on", why: "" };
+        var _f = file_text_open_read(global.gnx_mods_root + arg0[_i] + "/manifest.json");
+        var _raw = "";
+        
+        while (!file_text_eof(_f))
+            _raw += file_text_readln(_f);
+        
+        file_text_close(_f);
+        
+        try
+        {
+            var _m = json_parse(_raw);
+            
+            if (variable_struct_exists(_m, "mod_id"))
+                _e.mod_id = string(_m.mod_id);
+            
+            if (variable_struct_exists(_m, "name"))
+                _e.name = string(_m.name);
+            
+            if (variable_struct_exists(_m, "version"))
+                _e.version = string(_m.version);
+            
+            if (variable_struct_exists(_m, "requires") && is_array(_m.requires))
+                _e.requires = _m.requires;
+            
+            if (variable_struct_exists(_m, "map"))
+                _e.map = string(_m.map);
+            
+            if (variable_struct_exists(_m, "description"))
+                _e.description = string(_m.description);
+            
+            if (variable_struct_exists(_m, "author"))
+                _e.author = string(_m.author);
+
+            // "min_gnx_version": "1.5.0": a mod that uses newer GNX keys is not loaded by an older GNX (those keys
+            // would do nothing) and the player is told to update GNX
+            if (variable_struct_exists(_m, "min_gnx_version") && gnx_version_less(global.gnx_version, _m.min_gnx_version))
+            {
+                _e.status = "bad";
+                _e.why = "needs GNX " + string(_m.min_gnx_version) + " (this is " + string(global.gnx_version) + ")";
+                gnx_report_mod_error("Mod '" + _e.folder + "' " + _e.why + "; not loaded. Update GNX to use it");
+            }
+        }
+        catch (_ex)
+        {
+            _e.status = "bad";
+            _e.why = "manifest.json unreadable";
+        }
+        
+        if (_e.status == "on" && gnx_array_has(_kept, _e.folder))
+            _e.status = "off";
+        
+        array_push(_list, _e);
+    }
+    
+    // a mod whose required mod is not loading is skipped; repeat until stable (chains of requirements)
+    var _changed = true;
+    
+    while (_changed)
+    {
+        _changed = false;
+        
+        for (var _i = 0; _i < array_length(_list); _i++)
+        {
+            var _e = _list[_i];
+            
+            if (_e.status != "on")
+                continue;
+            
+            for (var _r = 0; _r < array_length(_e.requires); _r++)
+            {
+                var _req = string(_e.requires[_r]);
+                var _found = undefined;
+                
+                for (var _j = 0; _j < array_length(_list); _j++)
+                {
+                    if (_list[_j].mod_id == _req || _list[_j].folder == _req)
+                        _found = _list[_j];
+                }
+                
+                if (_found == undefined || _found.status != "on")
+                {
+                    _e.status = "needs";
+                    _e.why = "needs '" + _req + "' (" + ((_found == undefined) ? "not installed" : "off") + ")";
+                    if (_found == undefined)  // turned off in the mod menu: shown there, no popup
+                        gnx_report_mod_error("Mod '" + _e.folder + "' " + _e.why + "; not loaded");
+                    _changed = true;
+                    break;
+                }
+            }
+        }
+    }
+    
+    var _log = gnx_log_open();
+    
+    for (var _i = 0; _i < array_length(_list); _i++)
+    {
+        if (_list[_i].status != "on")
+            gnx_log_write(_log, "[GNX] mod '" + _list[_i].folder + "' not loaded: " + _list[_i].status + ((_list[_i].why != "") ? " - " + _list[_i].why : "") + chr(10));
+    }
+    
+    gnx_log_close(_log);
+    return _list;
+}
+
+
+// Count, per mod, what a save-format struct (a save, or a stored map's snapshot) uses: cells (h_type of a
+// mod cell) and characters (units of a mod class in cells, the prison list and the cage).
+// arg1 = {mod folder: {cells, units, maps}}
+function scr_gnx_count_mod_usage(arg0, arg1)
+{
+    var _units = [];
+
+    if (variable_struct_exists(arg0, "slot_list") && is_array(arg0.slot_list))
+    {
+        for (var _i = 0; _i < array_length(arg0.slot_list); _i++)
+        {
+            var _s = arg0.slot_list[_i];
+
+            if (!is_struct(_s))
+                continue;
+
+            if (variable_struct_exists(_s, "slot_data") && is_struct(_s.slot_data) && variable_struct_exists(_s.slot_data, "h_type"))
+            {
+                var _h = _s.slot_data.h_type;
+
+                if (is_real(_h) && _h >= 43 && ds_map_exists(global.cell_registry, _h))
+                {
+                    var _cm = ds_map_find_value(global.cell_registry, _h);
+
+                    if (is_struct(_cm) && variable_struct_exists(_cm, "mod_name"))
+                        gnx_usage_add(arg1, _cm.mod_name, "cells");
+                }
+            }
+
+            if (variable_struct_exists(_s, "unit_data") && is_struct(_s.unit_data))
+                array_push(_units, _s.unit_data);
+        }
+    }
+
+    if (variable_struct_exists(arg0, "global_list") && is_struct(arg0.global_list))
+    {
+        var _g = arg0.global_list;
+
+        if (variable_struct_exists(_g, "unit_list") && is_array(_g.unit_list))
+        {
+            for (var _i = 0; _i < array_length(_g.unit_list); _i++)
+            {
+                if (is_struct(_g.unit_list[_i]))
+                    array_push(_units, _g.unit_list[_i]);
+            }
+        }
+
+        if (variable_struct_exists(_g, "val") && is_struct(_g.val) && variable_struct_exists(_g.val, "cage") && is_array(_g.val.cage))
+        {
+            for (var _i = 0; _i < array_length(_g.val.cage); _i++)
+            {
+                if (is_struct(_g.val.cage[_i]))
+                    array_push(_units, _g.val.cage[_i]);
+            }
+        }
+    }
+
+    for (var _i = 0; _i < array_length(_units); _i++)
+    {
+        var _c = variable_struct_exists(_units[_i], "class") ? _units[_i].class : -1;
+
+        if (is_real(_c) && _c >= 14 && ds_map_exists(global.class_registry, _c))
+        {
+            var _cr = ds_map_find_value(global.class_registry, _c);
+
+            if (is_struct(_cr) && variable_struct_exists(_cr, "mod_name"))
+                gnx_usage_add(arg1, _cr.mod_name, "units");
+        }
+    }
+}
+
+
+// arg0 usage struct, arg1 mod folder, arg2 "cells" / "units" / "" (only make sure the entry exists)
+function gnx_usage_add(arg0, arg1, arg2)
+{
+    if (!variable_struct_exists(arg0, arg1))
+        variable_struct_set(arg0, arg1, { cells: 0, units: 0, maps: [] });
+
+    var _u = variable_struct_get(arg0, arg1);
+
+    if (arg2 != "")
+        variable_struct_set(_u, arg2, variable_struct_get(_u, arg2) + 1);
+
+    return _u;
+}
+
+
+// The save's mod record: [{id, name, version, cells, units, maps}] for every loaded mod, with what the save
+// (active map + every stored map) uses from it. A stored map whose mod is not loaded now keeps the entry it
+// had in the save it was loaded from (global.gnx_loaded_mod_record), so the warning survives re-saving.
+function scr_gnx_save_mod_record(arg0)
+{
+    var _use = {};
+    scr_gnx_count_mod_usage(arg0, _use);
+    var _maps = (variable_struct_exists(arg0, "gnx_maps") && is_struct(arg0.gnx_maps)) ? arg0.gnx_maps : {};
+    var _mk = variable_struct_get_names(_maps);
+
+    for (var _i = 0; _i < array_length(_mk); _i++)
+    {
+        var _snap = variable_struct_get(_maps, _mk[_i]);
+
+        if (is_struct(_snap))
+            scr_gnx_count_mod_usage(_snap, _use);
+    }
+
+    // map mods: the save holds that map's state (as the active map or a stored one)
+    var _active = variable_struct_exists(arg0, "gnx_active_map") ? arg0.gnx_active_map : "vanilla";
+    var _owned = variable_struct_get_names(global.gnx_map_owner);
+
+    for (var _i = 0; _i < array_length(_owned); _i++)
+    {
+        var _map = _owned[_i];
+
+        if (_map == _active || variable_struct_exists(_maps, _map))
+            array_push(gnx_usage_add(_use, variable_struct_get(global.gnx_map_owner, _map), "").maps, _map);
+    }
+
+    var _rec = [];
+
+    for (var _i = 0; _i < array_length(global.gnx_mod_list); _i++)
+    {
+        var _e = global.gnx_mod_list[_i];
+
+        if (_e.status != "on")
+            continue;
+
+        var _u = variable_struct_exists(_use, _e.folder) ? variable_struct_get(_use, _e.folder) : { cells: 0, units: 0, maps: [] };
+        array_push(_rec, { id: _e.folder, name: _e.name, version: _e.version, cells: _u.cells, units: _u.units, maps: _u.maps });
+    }
+
+    if (variable_global_exists("gnx_loaded_mod_record") && is_array(global.gnx_loaded_mod_record))
+    {
+        for (var _i = 0; _i < array_length(global.gnx_loaded_mod_record); _i++)
+        {
+            var _old = global.gnx_loaded_mod_record[_i];
+
+            if (!is_struct(_old) || !variable_struct_exists(_old, "maps") || !is_array(_old.maps))
+                continue;
+
+            var _kept = false;
+
+            for (var _j = 0; _j < array_length(_rec); _j++)
+            {
+                if (_rec[_j].id == _old.id)
+                    _kept = true;
+            }
+
+            if (_kept)
+                continue;
+
+            for (var _m = 0; _m < array_length(_old.maps); _m++)
+            {
+                if (variable_struct_exists(_maps, _old.maps[_m]))
+                {
+                    array_push(_rec, _old);
+                    break;
+                }
+            }
+        }
+    }
+
+    return _rec;
+}
+
+
+// ---------------------------------------------------------------------------
+// Mod menu UI (main menu > MODS) and save warnings.
+// interact types: 9070 MODS button, 9071 mod page window, 9072 row toggle (button_num = row), 9073 page
+// arrow (0 prev / 1 next), 9074 APPLY, 9075 BACK, 9076 confirm window, 9077 confirm button (0 yes / 1 cancel
+// / 2 open the mod page).
+// ---------------------------------------------------------------------------
+
+// What a save file says about mods. {exists, rec (array or -1 for saves made before the mod menu), data}
+function scr_gnx_read_save_mod_info(arg0)
+{
+    var _info = { exists: false, rec: -1, data: -1 };
+
+    if (!file_exists(arg0))
+        return _info;
+
+    var _buff = buffer_load(arg0);
+    var _json = buffer_read(_buff, buffer_text);
+    buffer_delete(_buff);
+
+    try
+    {
+        _info.data = json_parse(_json);
+        _info.exists = true;
+
+        if (variable_struct_exists(_info.data, "gnx_mods") && is_array(_info.data.gnx_mods))
+            _info.rec = _info.data.gnx_mods;
+    }
+    catch (_e)
+    {
+        _info.exists = false;
+    }
+
+    return _info;
+}
+
+
+function gnx_mod_entry(arg0)
+{
+    for (var _i = 0; _i < array_length(global.gnx_mod_list); _i++)
+    {
+        var _e = global.gnx_mod_list[_i];
+
+        if (_e.folder == arg0 || _e.mod_id == arg0)
+            return _e;
+    }
+
+    return undefined;
+}
+
+
+// Mods a save needs that are not loaded right now: [{id, name, why ("off" / "not installed" / "needs ..."),
+// cells, units, maps}]. arg0 = the parsed save. Saves made before the mod menu have no record: their content
+// that no installed mod owns is counted instead, as one entry named "unknown mods".
+function scr_gnx_save_missing(arg0)
+{
+    var _out = [];
+
+    if (!is_struct(arg0))
+        return _out;
+
+    if (variable_struct_exists(arg0, "gnx_mods") && is_array(arg0.gnx_mods))
+    {
+        for (var _i = 0; _i < array_length(arg0.gnx_mods); _i++)
+        {
+            var _r = arg0.gnx_mods[_i];
+
+            if (!is_struct(_r) || !variable_struct_exists(_r, "id"))
+                continue;
+
+            var _used = _r.cells + _r.units + array_length(_r.maps);
+            var _e = gnx_mod_entry(_r.id);
+
+            if (_used <= 0 || (_e != undefined && _e.status == "on"))
+                continue;
+
+            var _why = (_e == undefined) ? "not installed" : ((_e.status == "off") ? "off" : _e.why);
+            array_push(_out, { id: _r.id, name: _r.name, why: _why, cells: _r.cells, units: _r.units, maps: _r.maps });
+        }
+
+        return _out;
+    }
+
+    // no record: count what no installed mod owns
+    var _cells = 0;
+    var _units = 0;
+    var _structs = [arg0];
+
+    if (variable_struct_exists(arg0, "gnx_maps") && is_struct(arg0.gnx_maps))
+    {
+        var _mk = variable_struct_get_names(arg0.gnx_maps);
+
+        for (var _i = 0; _i < array_length(_mk); _i++)
+        {
+            var _snap = variable_struct_get(arg0.gnx_maps, _mk[_i]);
+
+            if (is_struct(_snap))
+                array_push(_structs, _snap);
+        }
+    }
+
+    for (var _si = 0; _si < array_length(_structs); _si++)
+    {
+        var _sv = _structs[_si];
+
+        if (!variable_struct_exists(_sv, "slot_list") || !is_array(_sv.slot_list))
+            continue;
+
+        for (var _i = 0; _i < array_length(_sv.slot_list); _i++)
+        {
+            var _s = _sv.slot_list[_i];
+
+            if (!is_struct(_s))
+                continue;
+
+            if (variable_struct_exists(_s, "slot_data") && is_struct(_s.slot_data) && variable_struct_exists(_s.slot_data, "h_type") && is_real(_s.slot_data.h_type) && _s.slot_data.h_type >= 43 && !ds_map_exists(global.cell_registry, _s.slot_data.h_type))
+                _cells++;
+
+            if (variable_struct_exists(_s, "unit_data") && is_struct(_s.unit_data) && variable_struct_exists(_s.unit_data, "class") && is_real(_s.unit_data.class) && _s.unit_data.class >= 14 && !ds_map_exists(global.class_registry, _s.unit_data.class))
+                _units++;
+        }
+    }
+
+    if (_cells + _units > 0)
+        array_push(_out, { id: "", name: "unknown mods", why: "saved before GNX 1.4.8, or a mod was removed", cells: _cells, units: _units, maps: [] });
+
+    return _out;
+}
+
+
+// One line per missing mod, for the load page and the confirm dialog
+function gnx_missing_line(arg0)
+{
+    var _t = arg0.name + " (" + arg0.why + ")";
+    var _parts = [];
+
+    if (arg0.cells > 0)
+        array_push(_parts, string(arg0.cells) + " cell" + ((arg0.cells == 1) ? "" : "s"));
+
+    if (arg0.units > 0)
+        array_push(_parts, string(arg0.units) + " character" + ((arg0.units == 1) ? "" : "s"));
+
+    if (array_length(arg0.maps) > 0)
+        array_push(_parts, "its map");
+
+    if (array_length(_parts) > 0)
+    {
+        _t += ": ";
+
+        for (var _i = 0; _i < array_length(_parts); _i++)
+            _t += ((_i > 0) ? ", " : "") + _parts[_i];
+    }
+
+    return _t;
+}
