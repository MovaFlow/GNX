+
+/// GNX-LOOP: length of one loop part (arg0 = vanilla length in game frames, 360-420 = 6-7 s). A cell with
+/// physical.loop_scale true gets it longer in proportion to its loop frames: loop frames / 5 (the vanilla
+/// count), so it plays as many loop cycles as vanilla. 10 frames = twice as long. Otherwise arg0 as it is.
+function gnx_loop_time(arg0)
+{
+    var _cell = ds_map_find_value(global.cell_registry, slot_data.h_type);
+    
+    // ! = not: no cell, no switch, or the switch is off -> vanilla length
+    if (_cell == undefined || !variable_struct_exists(_cell.physical, "gnx_loop_scale") || !_cell.physical.gnx_loop_scale)
+        return arg0;
