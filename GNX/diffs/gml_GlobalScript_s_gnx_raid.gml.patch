+// GNX: raid encounter pools, post-raid escape, no-capture encounters
+// (moved out of s_initials.gml; the functions are global, callable from any script)
+
+// GNX-NOCAP: map_info.no_capture of mod arg1 (arg0 = its map_info): a list of {"stage": 0-4, "level": 0-2}, the
+// raid encounters of that mod's map that can be fought and won (loot, quests) but capture nobody. Returns the
+// valid entries as "stage_level" texts; anything else is a mod error and left out.
+function gnx_parse_no_capture(arg0, arg1)
+{
+    var _out = [];
+
+    if (!variable_struct_exists(arg0, "no_capture"))
+        return _out;
+
+    var _l = arg0.no_capture;
+
+    if (!is_array(_l))
+    {
+        gnx_report_mod_error("Mod '" + arg1 + "': map_info.no_capture must be a list of {\"stage\", \"level\"}; ignored");
+        return _out;
+    }
+
+    for (var i = 0; i < array_length(_l); i++)
+    {
+        var _e = _l[i];
+        var _st = (is_struct(_e) && variable_struct_exists(_e, "stage")) ? gnx_json_num(_e.stage, -1) : -1;
+        var _lv = (is_struct(_e) && variable_struct_exists(_e, "level")) ? gnx_json_num(_e.level, -1) : -1;
+
+        if (_st < 0 || _st > 4 || _lv < 0 || _lv > 2 || _st != floor(_st) || _lv != floor(_lv))
+        {
+            gnx_report_mod_error("Mod '" + arg1 + "': map_info.no_capture entry " + string(i) + " needs \"stage\" 0-4 and \"level\" 0-2; ignored");
+            continue;
+        }
+
+        array_push(_out, string(_st) + "_" + string(_lv));
+    }
+
+    return _out;
+}
+
+
+// GNX-NOCAP: index in encounter unit list arg0 of a vanilla boss (classes 8-12: capturing one records the boss's
+// defeat), else -1
+function gnx_raid_boss_index(arg0)
+{
+    for (var i = 0; i < array_length(arg0); i++)
+    {
+        if (arg0[i].class >= 8 && arg0[i].class <= 12)
+            return i;
+    }
+
+    return -1;
+}
+
+
+// GNX-NOCAP: the raid encounter (stage arg0, encounter level arg1) of the map the player is on captures nobody
+function gnx_no_capture_here(arg0, arg1)
+{
+    // GNX-STAGE: a mod stage's level says it itself
+    var _sdef = gnx_stage_def(arg0);
+
+    if (_sdef != undefined)
+        return _sdef.levels[clamp(arg1, 0, array_length(_sdef.levels) - 1)].no_capture;
+
+    if (!variable_global_exists("gnx_travel_locations") || !is_array(global.gnx_travel_locations))
+        return false;
+
+    for (var i = 0; i < array_length(global.gnx_travel_locations); i++)
+    {
+        var _tl = global.gnx_travel_locations[i];
+
+        if (_tl.target == global.gnx_active_map && variable_struct_exists(_tl, "no_capture"))
+            return array_contains(_tl.no_capture, string(arg0) + "_" + string(arg1));
+    }
+
+    return false;
+}
