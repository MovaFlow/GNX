+    for (var _i = 0; _i < array_length(_k); _i++)
+    {
+        var _c = ds_map_find_value(global.cell_registry, _k[_i]);
+
+        if (is_struct(_c) && variable_struct_exists(_c, "mod_name") && _c.mod_name == arg0.folder)
