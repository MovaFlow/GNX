+    
+    gnx_fx_check_keys(arg0, ["x", "y", "align", "valign", "angle", "follow_fx", "turn_digits", "color", "scale", "max", "at_max", "pad", "show", "prefix", "suffix", "outline", "digits", "spacing"], arg1, "counter");
