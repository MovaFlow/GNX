+        if (array_length(_h.used) > 0 && (_h.cells + _h.units) > 0)
+            _l2 = ((_l2 != "") ? _l2 + "  -  " : "") + "in saves: " + string(_h.cells) + " cells, " + string(_h.units) + " characters";
