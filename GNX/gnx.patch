+        var _raw = [];
+        
+        if (is_array(_st))
+        {
+            for (var i = 0; i < array_length(_st); i++)
+                array_push(_raw, floor(gnx_json_num_in(_st[i], 1, 1, max(1, arg2 - 1), arg1, "react.stops[" + string(i) + "]")));
+        }
+        else if (is_struct(_st))
+        {
+            gnx_fx_check_keys(_st, ["every", "until"], arg1, "react.stops");
+            var _ev = variable_struct_exists(_st, "every") ? floor(gnx_json_num_in(_st.every, 1, 1, 999, arg1, "react.stops.every")) : 1;
+            // "until" is a GML word (do ... until), so the key is read by name, not as _st.until
+            var _un = variable_struct_exists(_st, "until") ? floor(gnx_json_num_in(variable_struct_get(_st, "until"), arg2 - 1, 1, max(1, arg2 - 1), arg1, "react.stops.until")) : (arg2 - 1);
