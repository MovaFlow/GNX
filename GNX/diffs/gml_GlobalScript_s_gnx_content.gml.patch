+/// GNX-FIX: birth_classes after its names were resolved (arg0 = list, arg1 = class id for the log).
+/// scr_mon_birth reads entry [monster type] as the monster class 0-3, so the list is made 4 long
+/// (missing entries 0) and every entry that is not a number 0-3 (a class id, an unknown name) becomes 0.
+function gnx_birth_list_fix(arg0, arg1)
+{
+    var _out = [0, 0, 0, 0];
+    var _bad = "";
+    
+    if (!is_array(arg0))
+        _bad = "not a list";
+    else if (array_length(arg0) != 4)
+        _bad = string(array_length(arg0)) + " entries instead of 4";
+    
+    for (var i = 0; i < 4; i++)
+    {
+        if (!is_array(arg0) || i >= array_length(arg0))
+            continue;
+        
+        var _v = gnx_json_num(arg0[i], -1);
+        
+        // a monster class is 0-3; a class id (14+) or text that is no number does not fit
+        if (_v >= 0 && _v <= 3)
+            _out[i] = floor(_v);
+        else
+            _bad += ((_bad == "") ? "" : ", ") + "entry " + string(i) + " = " + string(arg0[i]);
+    }
+    
+    if (_bad != "")
+    {
+        var _l = gnx_log_open();
+        gnx_log_write(_l, "[GNX-WARN] class " + string(arg1) + " birth_classes: " + _bad + " (entries are monster classes 0-3); now " + string(_out) + "\n");
+        gnx_log_close(_l);
+    }
+    
+    return _out;
+}
