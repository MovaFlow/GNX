+// ===== TEST EKONOMII (ECON PROBE) =====
+// Zdjecie stanu ekonomii: zloto, jedzenie, populacja potworow oraz ile cel z postacia jest w pasie, ktory dziala przy cullingu.
+function gnx_econ_snapshot()
+{
+    var _s =
+    {
+        money: global.val.money,
+        food: global.val.food,
+        day: global.val.day,
+        pop: 0,
+        cells: 0,
+        in_band: 0,
+        pregnant: 0,
+        t: current_time
+    };
+
+    // populacja: suma potworow wszystkich typow (-1 = typ zablokowany)
+    for (var _i = 0; _i < array_length(global.val.mon_num); _i++)
+    {
+        if (global.val.mon_num[_i] > 0)
+            _s.pop += global.val.mon_num[_i];
+    }
+
+    var _vy = camera_get_view_y(view_camera[0]);
+    var _vh = camera_get_view_height(view_camera[0]);
+
+    with (obj_slot)
+    {
+        if (!is_struct(unit_data))
+            continue;
+
+        _s.cells++;
+
+        // ten sam pas co culling krokow w obj_slot Step
+        if (y >= (_vy - 400) && y <= (_vy + _vh + 400))
+            _s.in_band++;
+
+        if (variable_struct_exists(unit_data, "preg") && unit_data.preg != -1)
+            _s.pregnant++;
+    }
+
+    return _s;
+}
+
+// Zapis jednej linii raportu do gnx_debug.txt
+function gnx_econ_log(arg0)
+{
+    var _f = file_text_open_append("gnx_debug.txt");
+    file_text_write_string(_f, arg0);
+    file_text_writeln(_f);
+    file_text_close(_f);
+}
+
+// Wywolywane co klatke. Po wlaczeniu ECON PROBE: start, raport po kazdym dniu gry, podsumowanie po wylaczeniu.
+function gnx_econ_probe_tick()
+{
+    if (!global.gnx_econ_on)
+    {
+        // wylaczono w trakcie pomiaru -> podsumowanie calego testu
+        if (is_struct(global.gnx_econ))
+        {
+            var _e = global.gnx_econ;
+            var _d = max(1, _e.days);
+            gnx_econ_log("[ECON] SUMMARY cull=" + (_e.cull ? "ON" : "OFF") + " days=" + string(_e.days) + " gold/day=" + string(round(_e.gold_sum / _d)) + " food/day=" + string(round(_e.food_sum / _d)) + " pop/day=" + string(_e.pop_sum / _d) + " avg_in_band=" + string(round(_e.band_sum / _d)) + "%");
+            global.gnx_econ = -1;
+        }
+
+        exit;
+    }
+
+    if (!instance_exists(obj_camera) || !instance_exists(obj_slot) || !variable_struct_exists(global.val, "day"))
+        exit;
+
+    var _cull = !global.gnx_cull_step_off;
+
+    if (!is_struct(global.gnx_econ))
+    {
+        var _s0 = gnx_econ_snapshot();
+        global.gnx_econ =
+        {
+            last: _s0,
+            days: 0,
+            cull: _cull,
+            gold_sum: 0,
+            food_sum: 0,
+            pop_sum: 0,
+            band_sum: 0
+        };
+        gnx_econ_log("[ECON] START cull=" + (_cull ? "ON" : "OFF") + " day=" + string(_s0.day) + " floors=" + string(global.val.floor + 1) + " cells_with_unit=" + string(_s0.cells) + " in_band=" + string(_s0.in_band) + " (" + string(round((_s0.in_band / max(1, _s0.cells)) * 100)) + "%) cam_y=" + string(round(camera_get_view_y(view_camera[0]))) + " zoom=" + string(obj_camera.zoom_num) + " speed=" + string(global.w_spd));
+        exit;
+    }
+
+    var _e = global.gnx_econ;
+
+    // zmiana przelacznika cullingu w trakcie psuje porownanie - zaczynamy pomiar od nowa
+    if (_e.cull != _cull)
+    {
+        gnx_econ_log("[ECON] culling toggled during probe - restarting measurement");
+        global.gnx_econ = -1;
+        exit;
+    }
+
+    if (global.val.day == _e.last.day)
+        exit;
+
+    var _now = gnx_econ_snapshot();
+    var _l = _e.last;
+    var _gold = _now.money - _l.money;
+    var _food = _now.food - _l.food;
+    var _pop = _now.pop - _l.pop;
+    var _band = round((_now.in_band / max(1, _now.cells)) * 100);
+    gnx_econ_log("[ECON] day " + string(_l.day) + "->" + string(_now.day) + " cull=" + (_cull ? "ON" : "OFF") + " gold=" + string(_gold) + " food=" + string(_food) + " pop=" + string(_pop) + " pregnant=" + string(_now.pregnant) + " cells_with_unit=" + string(_now.cells) + " in_band=" + string(_now.in_band) + " (" + string(_band) + "%) real_s=" + string(round((_now.t - _l.t) / 1000)) + " fps=" + string(round(fps_real)));
+    _e.days++;
+    _e.gold_sum += _gold;
+    _e.food_sum += _food;
+    _e.pop_sum += _pop;
+    _e.band_sum += _band;
+    _e.last = _now;
+}
+
+// true, gdy kursor jest nad widocznym paskiem przewijania albo pasek jest przeciagany
+function gnx_scrollbar_blocks_click()
+{
+    if (global.gnx_scrollbar_dragging)
+    {
+        if (mouse_check_button(global.val.select_click))
+            return true;
+
+        // przycisk puszczony - koniec przeciagania (inaczej flaga mogla zostac na zawsze i blokowac kazdy klik)
+        global.gnx_scrollbar_dragging = false;
+    }
+
+    if (!is_array(global.gnx_scrollbar_rect) || global.camera_lock)
+        return false;
+
+    // obj_gui jest niewidoczny przy zoomie 0.5 - wtedy pasek sie nie rysuje
+    if (!instance_exists(obj_gui) || !obj_gui.visible)
+        return false;
+
+    var _mx = device_mouse_x_to_gui(0);
+    var _my = device_mouse_y_to_gui(0);
+    var _r = global.gnx_scrollbar_rect;
+
+    if (!(_mx >= _r[0] && _mx <= _r[2] && _my >= _r[1] && _my <= _r[3]))
+        return false;
+
+    // przycisk GUI pod kursorem ma pierwszenstwo - nie blokujemy go
+    return !gnx_gui_under_mouse();
+}
+
+// true, gdy pod kursorem jest aktywny element GUI (przycisk, okno)
+function gnx_gui_under_mouse()
+{
+    var _ui = scr_mouse_least_depth_obj(device_mouse_x_to_gui(0), device_mouse_y_to_gui(0), -1);
+    return _ui != -1 && _ui.gui;
+}
