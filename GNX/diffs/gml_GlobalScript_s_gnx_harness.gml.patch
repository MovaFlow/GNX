+function gnx_ui_text(arg0, arg1, arg2)
+{
+    draw_text(arg0, arg1, arg2);
+
+    if (is_array(global.gnx_ui_rects))
+    {
+        var _w = string_width(arg2);
+        var _x0 = arg0;
+
+        if (draw_get_halign() == fa_center)
+            _x0 = arg0 - (_w / 2);
+        else if (draw_get_halign() == fa_right)
+            _x0 = arg0 - _w;
+
+        gnx_ui_rect("leaf", _x0, arg1, _x0 + _w, arg1 + string_height(arg2), arg2);
+    }
+}
