+// gives the prisoners mixed levels (1-4), milk (every third) and pregnancies left (0-5), in a pattern that
+// is not already in any sort order, so every order of prison_sort has to move them
+function gnx_scn_prison_vary()
+{
+    var _k = 0;
+    
+    for (var i = 0; i < ds_list_size(global.unit_list); i++)
+    {
+        var _v = ds_list_find_value(global.unit_list, i);
+        
+        if (!is_struct(_v))
+            continue;
+        
+        _v.lvl = 1 + ((_k * 3) mod 4);
+        _v.milk = (_k mod 3) == 1;
+        _v.preg_c = (_k * 5) mod 6;
+        _k++;
+    }
