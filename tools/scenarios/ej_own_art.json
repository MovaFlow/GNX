{
  "about": "Own ej art (F5): a mod cell without physical.frames whose human_spr has phase_3 draws the ej with it instead of the loop art (fixed EJ CELL h9052; class_map EJ MAP CELL h9053, default entry with phase_3, Shaman entry without). Test mod harness_scenes.",
  "mods": [
    "tools/scenarios/mods/harness_scenes"
  ],
  "check_boot_suite": false,
  "steps": [
    {
      "wait": 30
    },
    {
      "do": {
        "type": "spawn_mon",
        "species": 0,
        "amount": 8
      }
    },
    {
      "do": {
        "type": "unlock_cell",
        "h_type": 1
      }
    },
    {
      "open_build_menu": -1
    },
    {
      "wait": 2
    },
    {
      "press": {
        "type": 0,
        "num": 0
      },
      "why": "NEW"
    },
    {
      "wait": 2
    },
    {
      "press": {
        "type": 1,
        "num": 5
      },
      "why": "CUSTOM"
    },
    {
      "wait": 20
    },
    {
      "press": {
        "type": 95,
        "num": 9052
      }
    },
    {
      "wait": 10
    },
    {
      "assert": "has_cell",
      "h_type": 9052,
      "count": 1
    },
    {
      "open_build_menu": -1
    },
    {
      "wait": 2
    },
    {
      "press": {
        "type": 0,
        "num": 0
      },
      "why": "NEW"
    },
    {
      "wait": 2
    },
    {
      "press": {
        "type": 1,
        "num": 5
      },
      "why": "CUSTOM"
    },
    {
      "wait": 20
    },
    {
      "press": {
        "type": 95,
        "num": 9053
      }
    },
    {
      "wait": 10
    },
    {
      "assert": "has_cell",
      "h_type": 9053,
      "count": 1
    },
    {
      "occupy": {
        "h_type": 9052,
        "class": 0
      }
    },
    {
      "trace": 9052
    },
    {
      "until_phase": {
        "phase": 2,
        "max_frames": 4000
      }
    },
    {
      "wait": 5
    },
    {
      "assert": "fn",
      "name": "gnx_scn_captive_table",
      "args": [
        9052
      ],
      "is": "phase_2",
      "why": "loop: the loop art"
    },
    {
      "until_phase": {
        "phase": 3,
        "max_frames": 4000
      }
    },
    {
      "wait": 5
    },
    {
      "assert": "fn",
      "name": "gnx_scn_captive_table",
      "args": [
        9052
      ],
      "is": "phase_3",
      "why": "ej: the cell's own ej art"
    },
    {
      "occupy": {
        "h_type": 9053,
        "class": 2
      }
    },
    {
      "trace": 9053
    },
    {
      "until_phase": {
        "phase": 3,
        "max_frames": 4000
      }
    },
    {
      "wait": 5
    },
    {
      "assert": "fn",
      "name": "gnx_scn_captive_table",
      "args": [
        9053
      ],
      "is": "phase_2",
      "why": "class_map entry without phase_3: ej keeps the loop art"
    },
    {
      "swap_unit": {
        "h_type": 9053,
        "class": 0
      }
    },
    {
      "trace": 9053
    },
    {
      "until_phase": {
        "phase": 3,
        "max_frames": 4000
      }
    },
    {
      "wait": 5
    },
    {
      "assert": "fn",
      "name": "gnx_scn_captive_table",
      "args": [
        9053
      ],
      "is": "phase_3",
      "why": "class_map default entry with phase_3"
    }
  ]
}