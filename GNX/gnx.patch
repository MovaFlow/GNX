+/// GNX-PROP: runs in a prop while the mouse is over its passage: outlines the cell(s) it listens to, so
+/// the player sees what it is linked with (arg0 = the prop's react struct).
+function gnx_prop_draw_link(arg0)
+{
+    var _p = slot_id;
+    
+    if (!instance_exists(_p) || !is_array(global.slot_list))
+        exit;
+    
+    var _fl = _p.slot_data.slot_floor;
+    
+    if (_fl < 0 || _fl >= array_length(global.slot_list))
+        exit;
+    
+    var _list = global.slot_list[_fl];
+    var _i = ds_list_find_index(_list, _p);
+    
+    if (_i < 0)
+        exit;
+    
+    var _want = arg0.side;
+    
+    if (_want == 2)
+        _want = (image_xscale < 0) ? -1 : 1;
+    
+    for (var d = -1; d <= 1; d += 2)
+    {
+        var _j = _i + d;
+        
+        if (_j < 0 || _j >= ds_list_size(_list))
+            continue;
+        
+        var _c = ds_list_find_value(_list, _j);
+        
+        if (!instance_exists(_c) || !variable_instance_exists(_c, "slot_data") || !is_struct(_c.slot_data))
+            continue;
+        
+        // only cells: slot types 0 (cell), 1 (big), 2 (tentacle) and 6 (XL); the entrance (3) never sends events
+        var _st = _c.slot_data.slot_type;
+        
+        if (_st != 0 && _st != 1 && _st != 2 && _st != 6)
+            continue;
+        
+        var _side = (_c.x > _p.x) ? 1 : -1;
+        
+        if (_want != 0 && _want != _side)
+            continue;
+        
+        // the cell's box: image_xscale wide, and image_yscale (negative) tall above its floor line y
+        var _x1 = _c.x;
+        var _x2 = (_c.x + abs(_c.image_xscale)) - 1;
+        var _y1 = _c.y - abs(_c.image_yscale);
+        var _y2 = _c.y - 1;
+        // a faint yellow fill (added light) and a clearer outline, like the vanilla hover yellow (65535)
+        gpu_set_blendmode(bm_add);
+        draw_set_alpha(0.08);
+        draw_rectangle_colour(_x1, _y1, _x2, _y2, 65535, 65535, 65535, 65535, false);
+        gpu_set_blendmode(bm_normal);
+        draw_set_alpha(0.6);
+        draw_rectangle_colour(_x1, _y1, _x2, _y2, 65535, 65535, 65535, 65535, true);
+        draw_set_alpha(1);
+    }
+}
+
+
+/// GNX-PROP: reads a prop's "counter" block (arg0): a number drawn on the prop, changed by the count /
+/// count_set actions of its react block. arg1 = who (for mod errors), arg2 / arg3 = the props file's
+/// sprites and folder (for "digits"), arg4 = the prop's sprite (for the default height). Keys:
+///   x, y      the number's anchor point, from the prop's origin in sprite pixels (default: 2 px above
+///             the sprite); it is mirrored, scaled and turned with the prop
+///   align     "center" (default), "left" or "right": which way the number grows from the anchor
+///   valign    "bottom" (default: the anchor is the number's bottom edge), "middle" or "top"
+///   angle     tilt in degrees, -180..180 (0), counter-clockwise as in GameMaker, around the anchor
+///   follow_fx true (default): moves with the prop's fx (float, pulse, rotate); false = stays put
+///   turn_digits (digits only) true (default) turns each digit; false keeps them upright and only puts
+///             them along the tilted line (for digits drawn already slanted in the PNG: pixel-sharp)
+///   color     tint ("#RRGGBB" or [r, g, b], white)      scale  1 (0.5-4)
+///   max       highest number (1-999999999, 9999)        at_max "hold" (stays) or "loop" (back to 0)
+///   pad       at least this many digits, leading zeros (0-9, 0)
+///   show      "always" (default) or "hover" (only with the mouse over the passage)
+///   outline   colour of a 1 px outline round the number (game font and digits)
+///   game font only: prefix, suffix (text around the number)
+///   digits    a sprite of the props file with frames 0-9 = the digits 0-9: drawn instead of the game
+///             font; spacing = px between digits (0-16, 1)
+function gnx_counter_parse(arg0, arg1, arg2, arg3, arg4)
+{
+    if (!is_struct(arg0))
+    {
+        gnx_report_mod_error(gnx_err_who(arg1) + ": counter must be an object like { \"y\": -14 }; ignored");
+        return undefined;
+    }
+    
+    gnx_fx_check_keys(arg0, ["x", "y", "align", "valign", "angle", "follow_fx", "turn_digits", "color", "scale", "max", "at_max", "pad", "show", "prefix", "suffix", "outline", "digits", "spacing"], arg1, "counter");
+    // y default: 2 px above the top of the sprite (yoffset = how far the origin is below its top)
+    var _y_def = (arg4 != -1) ? (-gnx_sprite_get_yoffset(arg4) - 2) : -12;
+    // align: -1 left, 0 center, 1 right; valign: -1 top, 0 middle, 1 bottom; outline -1 = none; digits -1 = the game font; max_n = the JSON
+    // "max" (a field cannot be called max, the name of a function)
+    var _c = 
+    {
+        x: 0,
+        y: _y_def,
+        align: 0,
+        valign: 1,
+        angle: 0,
+        follow_fx: true,
+        turn_digits: true,
+        color: c_white,
+        scale: 1,
+        max_n: 9999,
+        loop: false,
+        pad: 0,
+        show_hover: false,
+        prefix: "",
+        suffix: "",
+        outline: -1,
+        digits: -1,
+        spacing: 1,
+        dig_w: 0,
+        dig_h: 0,
+        dig_xo: 0,
+        dig_yo: 0
+    };
+    
+    if (variable_struct_exists(arg0, "x"))
+        _c.x = floor(gnx_json_num_in(arg0.x, 0, -64, 64, arg1, "counter.x"));
+    
+    if (variable_struct_exists(arg0, "y"))
+        _c.y = floor(gnx_json_num_in(arg0.y, _y_def, -128, 64, arg1, "counter.y"));
+    
+    if (variable_struct_exists(arg0, "align"))
+    {
+        var _al = string(arg0.align);
+        
+        if (_al == "left")
+            _c.align = -1;
+        else if (_al == "right")
+            _c.align = 1;
+        else if (_al != "center")
+            gnx_report_mod_error(gnx_err_who(arg1) + ": counter.align must be \"left\", \"center\" or \"right\", not " + _al + "; \"center\" is used");
+    }
+    
+    if (variable_struct_exists(arg0, "valign"))
+    {
+        var _va = string(arg0.valign);
+        
+        if (_va == "top")
+            _c.valign = -1;
+        else if (_va == "middle")
+            _c.valign = 0;
+        else if (_va != "bottom")
+            gnx_report_mod_error(gnx_err_who(arg1) + ": counter.valign must be \"top\", \"middle\" or \"bottom\", not " + _va + "; \"bottom\" is used");
+    }
+    
+    if (variable_struct_exists(arg0, "angle"))
+        _c.angle = gnx_json_num_in(arg0.angle, 0, -180, 180, arg1, "counter.angle");
+    
+    // GNX-FIX: true / false through gnx_json_bool (JSON true arrives as 1)
+    if (variable_struct_exists(arg0, "follow_fx"))
+        _c.follow_fx = gnx_json_bool(arg0.follow_fx, true, arg1, "counter.follow_fx");
+    
+    if (variable_struct_exists(arg0, "turn_digits"))
+        _c.turn_digits = gnx_json_bool(arg0.turn_digits, true, arg1, "counter.turn_digits");
+    
+    if (variable_struct_exists(arg0, "color"))
+        _c.color = gnx_json_color(arg0.color, c_white, arg1, "counter.color");
+    
+    if (variable_struct_exists(arg0, "scale"))
+        _c.scale = gnx_json_num_in(arg0.scale, 1, 0.5, 4, arg1, "counter.scale");
+    
+    if (variable_struct_exists(arg0, "max"))
+        _c.max_n = floor(gnx_json_num_in(arg0.max, 9999, 1, 999999999, arg1, "counter.max"));
+    
+    if (variable_struct_exists(arg0, "at_max"))
+    {
+        var _am = string(arg0.at_max);
+        
+        if (_am == "loop")
+            _c.loop = true;
+        else if (_am != "hold")
+            gnx_report_mod_error(gnx_err_who(arg1) + ": counter.at_max must be \"hold\" or \"loop\", not " + _am + "; \"hold\" is used");
+    }
+    
+    if (variable_struct_exists(arg0, "pad"))
+        _c.pad = floor(gnx_json_num_in(arg0.pad, 0, 0, 9, arg1, "counter.pad"));
+    
+    if (variable_struct_exists(arg0, "show"))
+    {
+        var _sh = string(arg0.show);
+        
+        if (_sh == "hover")
+            _c.show_hover = true;
+        else if (_sh != "always")
+            gnx_report_mod_error(gnx_err_who(arg1) + ": counter.show must be \"always\" or \"hover\", not " + _sh + "; \"always\" is used");
+    }
+    
+    if (variable_struct_exists(arg0, "prefix"))
+        _c.prefix = string(arg0.prefix);
+    
+    if (variable_struct_exists(arg0, "suffix"))
+        _c.suffix = string(arg0.suffix);
+    
+    if (variable_struct_exists(arg0, "outline"))
+        _c.outline = gnx_json_color(arg0.outline, c_black, arg1, "counter.outline");
+    
+    if (variable_struct_exists(arg0, "spacing"))
+        _c.spacing = floor(gnx_json_num_in(arg0.spacing, 1, 0, 16, arg1, "counter.spacing"));
+    
+    // GNX-PROP: own digits: a sprite of the props file, as for "sprite" ("gnx:name" or "name")
+    if (variable_struct_exists(arg0, "digits"))
+    {
+        var _ref = arg0.digits;
+        var _ds = -1;
+        
+        if (is_string(_ref) && arg2 != undefined)
+        {
+            // string_pos == 1: it starts with "gnx:", string_delete takes those 4 characters off
+            if (string_pos("gnx:", _ref) == 1)
+                _ref = string_delete(_ref, 1, 4);
+            
+            _ds = gnx_resolve_sprite(arg2, _ref, arg3, -1);
+        }
+        
+        if (_ds == -1)
+        {
+            gnx_report_mod_error(gnx_err_who(arg1) + ": counter.digits '" + string(arg0.digits) + "' was not found in the props file's \"sprites\"; the game font is used");
+        }
+        else if (gnx_sprite_get_number(_ds) < 10)
+        {
+            gnx_report_mod_error(gnx_err_who(arg1) + ": counter.digits needs 10 frames (0-9), it has " + string(gnx_sprite_get_number(_ds)) + "; the game font is used");
+        }
+        else
+        {
+            _c.digits = _ds;
+            
+            // every digit gets the same width (the widest of 0-9), so the number does not jump about
+            for (var i = 0; i < 10; i++)
+            {
+                _c.dig_w = max(_c.dig_w, gnx_sprite_get_width(_ds, i));
+                _c.dig_h = max(_c.dig_h, gnx_sprite_get_height(_ds, i));
+            }
+            
+            _c.dig_xo = gnx_sprite_get_xoffset(_ds);
+            _c.dig_yo = gnx_sprite_get_yoffset(_ds);
+            
+            // || = or: these keys belong to the game font (outline works with digits too)
+            if (_c.prefix != "" || _c.suffix != "")
+                gnx_report_mod_error(gnx_err_who(arg1) + ": counter prefix and suffix work with the game font only; with digits they are left out");
+        }
+    }
+    
+    return _c;
+}
+
+
+/// GNX-PROP: runs in a prop: draws its counter (arg0 = the counter struct, arg1 = the number) with the
+/// game font (the font the game set for its language, as its +3 pop-ups use) or with the digits sprite.
+/// arg2 = where the prop's sprite is drawn this frame (gnx_fx_transform) when the counter follows the
+/// prop's fx, undefined = the prop's own place. The anchor (x, y) is a point on the sprite: it is mirrored
+/// and scaled with the sprite and turned with it around the sprite's origin, so it stays on the plaque.
+function gnx_prop_draw_counter(arg0, arg1, arg2)
+{
+    var _ox = x;
+    var _oy = y;
+    var _xs = image_xscale;
+    var _ys = image_yscale;
+    var _pang = image_angle;
+    var _alpha = image_alpha;
+    
+    if (is_struct(arg2))
+    {
+        _ox = arg2.x;
+        _oy = arg2.y;
+        _xs = arg2.xs;
+        _ys = arg2.ys;
+        _pang = arg2.ang;
+        _alpha = arg2.alpha;
+    }
+    
+    // the anchor on the sprite: mirrored and scaled like its pixels (_xs carries the mirror's - sign),
+    // then turned by the sprite's angle around its origin. dcos / dsin take degrees; GameMaker turns
+    // counter-clockwise with y pointing down, hence + sin for x and - sin for y
+    var _dx = arg0.x * _xs;
+    var _dy = arg0.y * _ys;
+    var _ax = (_ox + (_dx * dcos(_pang))) + (_dy * dsin(_pang));
+    var _ay = (_oy - (_dx * dsin(_pang))) + (_dy * dcos(_pang));
+    // the number's size grows with the sprite's (pulse); abs = without the mirror's sign
+    var _sc = arg0.scale * abs(_ys);
+    // its tilt: mirrored with the prop (a plaque tilted left becomes tilted right), plus the sprite's turn
+    var _ang = (arg0.angle * ((_xs < 0) ? -1 : 1)) + _pang;
+    
+    if (arg0.digits == -1)
+    {
+        var _txt = arg0.prefix + gnx_int_text(arg1, arg0.pad) + arg0.suffix;
+        
+        // GNX-PROP: once per game: how big the game font's digits are, so a mod can size its sign
+        // (string_height = the font's line height, a little more than the digits themselves)
+        if (!variable_global_exists("gnx_counter_font_logged"))
+        {
+            global.gnx_counter_font_logged = true;
+            var _fl = gnx_log_open();
+            gnx_log_write(_fl, "[GNX] counter font: line height " + string(string_height("0123456789")) + " px, digit width " + string(string_width("0")) + " px (scale 1)\n");
+            gnx_log_close(_fl);
+        }
+        
+        // the draw settings are shared by everything the game draws: keep them and put them back after
+        var _ha = draw_get_halign();
+        var _va = draw_get_valign();
+        var _col = draw_get_colour();
+        var _al = draw_get_alpha();
+        // the text turns around its alignment point, which is the anchor
+        draw_set_halign((arg0.align < 0) ? fa_left : ((arg0.align > 0) ? fa_right : fa_center));
+        draw_set_valign((arg0.valign < 0) ? fa_top : ((arg0.valign > 0) ? fa_bottom : fa_middle));
+        draw_set_alpha(_alpha);
+        
+        // outline: the text 1 px (times the scale) to each side in the outline colour, under the text
+        if (arg0.outline != -1)
+        {
+            var _o = max(1, round(_sc));
+            draw_set_colour(arg0.outline);
+            draw_text_transformed(_ax - _o, _ay, _txt, _sc, _sc, _ang);
+            draw_text_transformed(_ax + _o, _ay, _txt, _sc, _sc, _ang);
+            draw_text_transformed(_ax, _ay - _o, _txt, _sc, _sc, _ang);
+            draw_text_transformed(_ax, _ay + _o, _txt, _sc, _sc, _ang);
+        }
+        
+        draw_set_colour(arg0.color);
+        draw_text_transformed(_ax, _ay, _txt, _sc, _sc, _ang);
+        draw_set_halign(_ha);
+        draw_set_valign(_va);
+        draw_set_colour(_col);
+        draw_set_alpha(_al);
+        exit;
+    }
+    
+    var _txt = gnx_int_text(arg1, arg0.pad);
+    var _n = string_length(_txt);
+    // one digit's place: its width plus the space after it, all times the scale
+    var _step = (arg0.dig_w + arg0.spacing) * _sc;
+    var _w = ((_n * arg0.dig_w) + ((_n - 1) * arg0.spacing)) * _sc;
+    var _h = arg0.dig_h * _sc;
+    // the number's box around the anchor, before the tilt: left edge and top edge
+    var _left = 0;
+    var _top = -_h;
+    
+    if (arg0.align == 0)
+        _left = -floor(_w * 0.5);
+    else if (arg0.align > 0)
+        _left = -_w;
+    
+    if (arg0.valign == 0)
+        _top = -floor(_h * 0.5);
+    else if (arg0.valign < 0)
+        _top = 0;
+    
+    var _ca = dcos(_ang);
+    var _sa = dsin(_ang);
+    // pass 0: the outline (every digit's shape in the outline colour, 1 px times the scale to each side),
+    // pass 1: the digits on top; two passes, so no outline is drawn over a digit next to it
+    var _o = max(1, round(_sc));
+    
+    for (var _pass = ((arg0.outline != -1) ? 0 : 1); _pass <= 1; _pass++)
+    {
+        if (_pass == 0)
+            gpu_set_fog(true, arg0.outline, 0, 0);
+        
+        for (var i = 0; i < _n; i++)
+        {
+            // ord gives the character code: "0" is 48, so - 48 is the digit and the frame
+            var _d = ord(string_char_at(_txt, i + 1)) - 48;
+            // where this digit's origin goes in the untilted box, then turned around the anchor like the sprite
+            var _lx = (_left + (i * _step)) + (arg0.dig_xo * _sc);
+            var _ly = _top + (arg0.dig_yo * _sc);
+            var _px = (_ax + (_lx * _ca)) + (_ly * _sa);
+            var _py = (_ay - (_lx * _sa)) + (_ly * _ca);
+            // turn_digits false: upright digits on whole pixels, stepping along the tilted line
+            var _dang = arg0.turn_digits ? _ang : 0;
+            
+            if (!arg0.turn_digits)
+            {
+                _px = round(_px);
+                _py = round(_py);
+            }
+            
+            if (_pass == 0)
+            {
+                gnx_draw_sprite_ext(arg0.digits, _d, _px - _o, _py, _sc, _sc, _dang, arg0.outline, _alpha);
+                gnx_draw_sprite_ext(arg0.digits, _d, _px + _o, _py, _sc, _sc, _dang, arg0.outline, _alpha);
+                gnx_draw_sprite_ext(arg0.digits, _d, _px, _py - _o, _sc, _sc, _dang, arg0.outline, _alpha);
+                gnx_draw_sprite_ext(arg0.digits, _d, _px, _py + _o, _sc, _sc, _dang, arg0.outline, _alpha);
+            }
+            else
+            {
+                gnx_draw_sprite_ext(arg0.digits, _d, _px, _py, _sc, _sc, _dang, arg0.color, _alpha);
+            }
+        }
+        
+        if (_pass == 0)
+            gpu_set_fog(false, c_white, 0, 0);
+    }
+}
+
+
+/// GNX-PROP: the number of a prop named in a quest or tool (arg0) for mod arg1: a number stays as it is
+/// (vanilla props 0-47, mod props 100-9999); text is a mod prop's name, "Mod.id", or just "id" for a prop
+/// of mod arg1. Returns -1 (with a mod error) for a name no loaded mod has.
+function gnx_prop_resolve_id(arg0, arg1 = "")
+{
+    // is_numeric: a number (also true / false, which are no props but keep the old behaviour)
+    if (is_numeric(arg0))
+        return arg0;
+    
+    if (!is_string(arg0))
+    {
+        gnx_report_mod_error("prop_id must be a number or a prop name (\"Mod.id\"), not " + string(arg0));
+        return -1;
+    }
+    
+    // a number written as text ("112") is a number too
+    var _num = gnx_json_num(arg0, -1234567);
+    
+    if (_num != -1234567)
+        return _num;
+    
+    var _full = (string_pos(".", arg0) == 0 && arg1 != "") ? (string(arg1) + "." + arg0) : arg0;
+    
+    if (variable_global_exists("gnx_prop_name_to_id") && is_struct(global.gnx_prop_name_to_id) && variable_struct_exists(global.gnx_prop_name_to_id, _full))
+        return variable_struct_get(global.gnx_prop_name_to_id, _full);
+    
+    gnx_report_mod_error("prop '" + _full + "' is not a prop of any loaded mod (props.json \"id\", named \"Mod.id\")");
+    return -1;
+}
+
+
+// prop numbers use the cell hash (same djb2, same 100-9999 range)
+function gnx_hash_prop_id(arg0)
+{
+    return gnx_hash_cell_id(arg0);
+}
+
+
+// Called at the end of scr_main_end_step, i.e. once per frame in rm_game after the load finished
+// removes every prop of type arg1 from the prop array arg0 (in place, back to front); returns how many are left
+function gnx_prop_array_remove_type(arg0, arg1)
+{
+    for (var _i = array_length(arg0) - 1; _i >= 0; _i--)
+    {
+        if (arg0[_i].prop_type == arg1)
+            array_delete(arg0, _i, 1);
+    }
+
+    return array_length(arg0);
+}
+
+
+/// GNX-FX: px below the floor line where squirt drops and drips of the calling slot's cell land
+/// (physical.fx_floor; underground cells land on their own floor). 0 = the floor line, as in vanilla.
+/// Called by the effect scripts with self = the slot (or a monster that shares its slot_data).
+function gnx_fx_floor()
+{
+    // ! = not, || = or: anything that is not a slot with a cell gets the vanilla line
+    if (!variable_instance_exists(id, "slot_data") || !is_struct(slot_data) || !variable_struct_exists(slot_data, "h_type"))
+        return 0;
+    
+    var _c = ds_map_find_value(global.cell_registry, slot_data.h_type);
+    return (_c != undefined && variable_struct_exists(_c.physical, "gnx_fx_floor")) ? _c.physical.gnx_fx_floor : 0;
+}
+
+
+enum UnknownEnum
+{
+    Value_0,
+    Value_1,
+    Value_2,
+    Value_3,
+    Value_4,
+    Value_5,
+    Value_7 = 7,
+    Value_12 = 12,
+    Value_33 = 33,
+    Value_40 = 40,
+    Value_56 = 56
+}
