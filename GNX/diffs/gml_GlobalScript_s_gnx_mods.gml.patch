+// main menu corner: " - 12 mods on" (+ ", 2 off")
+function gnx_mods_on_text()
+{
+    if (!variable_global_exists("gnx_mod_list") || !is_array(global.gnx_mod_list))
+        return " enabled";
+    
+    var _on = 0;
+    var _off = 0;
+    
+    for (var _i = 0; _i < array_length(global.gnx_mod_list); _i++)
+    {
+        if (global.gnx_mod_list[_i].status == "on")
+            _on++;
+        else
+            _off++;
+    }
