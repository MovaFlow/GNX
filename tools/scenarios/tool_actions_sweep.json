{
  "about": "Every debug-tool action type, once, through scr_gnx_exec_tool_action with documented arguments, on a fresh game. Effects are checked where they can be observed (gold, food, orbs, milk, items, blueprints, troops, prisoners, cage, unlocks, floors, day, speed, mood, popup); every other action at least must not crash. A crash names the last 'do' line in the scenario log. Added after give_item / give_blueprint turned out to give nothing.",
  "timeout": 120,
  "steps": [
    {
      "wait": 30
    },
    {
      "do": {
        "type": "set_val",
        "key": "money",
        "value": 0
      }
    },
    {
      "do": {
        "type": "add_gold",
        "amount": 150
      }
    },
    {
      "assert": "val",
      "key": "money",
      "is": 150
    },
    {
      "do": {
        "type": "add_gold",
        "amount": -500
      }
    },
    {
      "assert": "val",
      "key": "money",
      "is": 0,
      "why": "negative amounts clamp to 0"
    },
    {
      "do": {
        "type": "set_val",
        "key": "food",
        "value": 0
      }
    },
    {
      "do": {
        "type": "add_food",
        "amount": 40
      }
    },
    {
      "assert": "val",
      "key": "food",
      "is": 40
    },
    {
      "do": {
        "type": "set_val",
        "key": "orb_num",
        "value": 0
      }
    },
    {
      "do": {
        "type": "add_orbs",
        "amount": 3
      }
    },
    {
      "assert": "val",
      "key": "orb_num",
      "is": 3
    },
    {
      "do": {
        "type": "add_milk",
        "rarity": 1,
        "amount": 4
      }
    },
    {
      "assert": "inv",
      "item_type": 4,
      "total": 4
    },
    {
      "do": {
        "type": "give_item",
        "item_type": 3,
        "data": 1,
        "level": 0
      }
    },
    {
      "assert": "inv",
      "item_type": 3,
      "count": 1
    },
    {
      "do": {
        "type": "give_blueprint",
        "h_type": 2,
        "fragment": true,
        "lvl": 1
      }
    },
    {
      "assert": "inv",
      "item_type": 5,
      "count": 1
    },
    {
      "do": {
        "type": "give_blueprint",
        "h_type": 3
      }
    },
    {
      "assert": "fn",
      "name": "gnx_cell_unlocked",
      "args": [
        3
      ],
      "is": true
    },
    {
      "do": {
        "type": "spawn_mon",
        "species": 1,
        "amount": 5,
        "class": 0
      }
    },
    {
      "assert": "mons",
      "type": 1,
      "class": 0,
      "min": 5
    },
    {
      "do": {
        "type": "spawn_mon",
        "species": 0,
        "amount": 2
      }
    },
    {
      "do": {
        "type": "set_troop_level",
        "species": 0,
        "class": 0,
        "value": 3
      }
    },
    {
      "do": {
        "type": "add_troop_exp",
        "species": 0,
        "class": 0,
        "amount": 50
      }
    },
    {
      "do": {
        "type": "set_skill_level",
        "species": 0,
        "class": 0,
        "value": 2
      }
    },
    {
      "do": {
        "type": "set_troop_size",
        "value": 3
      }
    },
    {
      "assert": "val",
      "key": "troop_size",
      "is": 3
    },
    {
      "do": {
        "type": "create_unit",
        "class_id": 1,
        "level": 2
      }
    },
    {
      "assert": "prison",
      "is": 1
    },
    {
      "do": {
        "type": "create_unit_cage",
        "class_id": 1,
        "level": 1
      }
    },
    {
      "assert": "raid",
      "cage_min": 1
    },
    {
      "do": {
        "type": "unlock_boss",
        "index": 0
      }
    },
    {
      "do": {
        "type": "unlock_stage_next",
        "stage": 0
      }
    },
    {
      "do": {
        "type": "unlock_breeds"
      }
    },
    {
      "do": {
        "type": "unlock_cell",
        "h_type": 4
      }
    },
    {
      "assert": "fn",
      "name": "gnx_cell_unlocked",
      "args": [
        4
      ],
      "is": true
    },
    {
      "do": {
        "type": "give_prop",
        "prop_id": 40
      }
    },
    {
      "do": {
        "type": "unlock_prop",
        "prop_id": 41
      }
    },
    {
      "do": {
        "type": "unlock_raid"
      }
    },
    {
      "do": {
        "type": "unlock_all_cells"
      }
    },
    {
      "assert": "fn",
      "name": "gnx_cell_unlocked",
      "args": [
        20
      ],
      "is": true
    },
    {
      "do": {
        "type": "add_floor"
      }
    },
    {
      "assert": "val",
      "key": "floor",
      "is": 1
    },
    {
      "do": {
        "type": "set_day",
        "value": 7
      }
    },
    {
      "assert": "val",
      "key": "day",
      "is": 7
    },
    {
      "do": {
        "type": "add_day_time",
        "amount": 100
      }
    },
    {
      "do": {
        "type": "set_speed",
        "target": "world",
        "value": 2
      }
    },
    {
      "assert": "global",
      "name": "w_spd",
      "is": 2
    },
    {
      "do": {
        "type": "set_speed",
        "target": "world",
        "value": 1
      }
    },
    {
      "do": {
        "type": "swap_mouse"
      }
    },
    {
      "do": {
        "type": "swap_mouse"
      }
    },
    {
      "do": {
        "type": "show_debug_overlay",
        "enable": false
      }
    },
    {
      "do": {
        "type": "set_val",
        "key": "mood",
        "value": 70
      }
    },
    {
      "assert": "val",
      "key": "mood",
      "is": 70
    },
    {
      "do": {
        "type": "set_var",
        "key": "gnx_debug_verbose",
        "value": 0
      }
    },
    {
      "do": {
        "type": "reroll_shop"
      }
    },
    {
      "do": {
        "type": "reroll_trade"
      }
    },
    {
      "do": {
        "type": "reroll_encounters"
      }
    },
    {
      "do": {
        "type": "set_state",
        "key": "flag",
        "value": 1
      }
    },
    {
      "do": {
        "type": "set_continuous",
        "key": "flag",
        "value": 1
      }
    },
    {
      "do": {
        "type": "fire_event",
        "event_id": "no_such_event"
      }
    },
    {
      "do": {
        "type": "fire_trigger",
        "hook": "cell_built"
      }
    },
    {
      "do": {
        "type": "popup",
        "text": "sweep popup"
      }
    },
    {
      "wait": 2
    },
    {
      "assert": "popup_shown",
      "contains": "sweep popup"
    },
    {
      "do": {
        "type": "play_sfx",
        "sfx_type": 0
      }
    },
    {
      "do": {
        "type": "travel_map",
        "target": "vanilla"
      }
    },
    {
      "do": {
        "type": "gml"
      }
    },
    {
      "wait": 10
    },
    {
      "save": 9
    },
    {
      "reload": 9
    },
    {
      "wait": 30
    },
    {
      "assert": "val",
      "key": "day",
      "is": 7,
      "why": "the game survives a save and reload after all of it"
    }
  ]
}
