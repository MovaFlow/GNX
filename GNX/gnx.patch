+    {
+        gnx_report_mod_error(gnx_err_who(arg1) + ": react must be an object like { \"side\": \"right\", \"on\": { \"mon_exit\": { \"step\": 1 } } }; ignored");
+        return undefined;
+    }
+    
+    gnx_fx_check_keys(arg0, ["side", "speed", "at_end", "stops", "on"], arg1, "react");
+    // side: -1 left, 1 right, 0 both, 2 facing; frames = some event moves the frame
+    var _r = 
+    {
+        side: 0,
+        speed: 8,
+        hold: false,
+        on: {},
+        frames: false,
+        counts: false,
+        stops: []
+    };
+    var _side = variable_struct_exists(arg0, "side") ? string(arg0.side) : "both";
+    
+    switch (_side)
+    {
+        case "left":
+            _r.side = -1;
+            break;
+        
+        case "right":
+            _r.side = 1;
+            break;
+        
+        case "both":
+            _r.side = 0;
+            break;
+        
+        case "facing":
+            _r.side = 2;
+            break;
+        
+        default:
+            gnx_report_mod_error(gnx_err_who(arg1) + ": react.side must be \"left\", \"right\", \"both\" or \"facing\", not " + _side + "; \"both\" is used");
