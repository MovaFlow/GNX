{
  "about": "map_info.vanilla_stages on a map mod's own map: the Mountain hidden (no button, never Nyx's target), the Forest moved to a new place with its own route (the GNX cart replaces its sequence), its vanilla enemy pool replaced (only mods' raid_spawns remain) and its win reward replaced; the Forest has its own button picture. Back in the village nothing of it applies.",
  "fixture": "mid",
  "fixture_on_map": "harness_vs",
  "seed": 3,
  "timeout": 120,
  "check_boot_suite": false,
  "mods": [
    "tools/scenarios/mods/harness_map_vstages"
  ],
  "steps": [
    {
      "wait": 60
    },
    {
      "assert": "active_map",
      "is": "harness_vs"
    },
    {
      "assert": "fn",
      "name": "gnx_vstage_hidden",
      "args": [
        1
      ],
      "is": 1,
      "why": "the Mountain is hidden here"
    },
    {
      "assert": "fn",
      "name": "gnx_scn_stage_reward",
      "args": [
        "vanilla.FOREST",
        0
      ],
      "is": "77 7",
      "why": "the Forest's reward replaced, every level"
    },
    {
      "assert": "fn",
      "name": "gnx_scn_stage_reward",
      "args": [
        "vanilla.FOREST",
        2
      ],
      "is": "77 7",
      "why": ""
    },
    {
      "assert": "fn",
      "name": "gnx_scn_route",
      "args": [
        "vanilla.FOREST",
        0.5
      ],
      "is": "213 78",
      "why": "the Forest's route: nest -> (215,80) -> its new place"
    },
    {
      "assert": "fn",
      "name": "gnx_scn_nyx_picks",
      "args": [
        1,
        300
      ],
      "is": 0,
      "why": "Nyx never picks the hidden Mountain"
    },
    {
      "call": "scr_set_stage_data",
      "args": [
        2,
        1,
        false
      ]
    },
    {
      "assert": "fn",
      "name": "gnx_scn_enc_count",
      "args": [
        "vanilla.FOREST",
        1,
        1
      ],
      "is": 0,
      "why": "no vanilla Elf in the replaced pool"
    },
    {
      "assert": "fn",
      "name": "gnx_scn_enc_count",
      "args": [
        "vanilla.FOREST",
        1,
        2
      ],
      "is": 0,
      "why": "no Knight"
    },
    {
      "assert": "fn",
      "name": "gnx_scn_enc_count",
      "args": [
        "vanilla.FOREST",
        1,
        3
      ],
      "is": 0,
      "why": "no Cleric"
    },
    {
      "assert": "fn",
      "name": "gnx_scn_enc_count",
      "args": [
        "vanilla.FOREST",
        1,
        0
      ],
      "is": 0,
      "why": "no fallback peasants either: the WISP (raid_spawns) fills the pool"
    },
    {
      "open_raid": true
    },
    {
      "wait": 10
    },
    {
      "assert": "fn",
      "name": "gnx_scn_button_num",
      "args": [
        43,
        1
      ],
      "is": 0,
      "why": "no Mountain button"
    },
    {
      "assert": "button_var",
      "type": 43,
      "num": 2,
      "field": "x",
      "is": 230,
      "why": "the Forest button at its new place"
    },
    {
      "assert": "button_var",
      "type": 43,
      "num": 2,
      "field": "y",
      "is": 60
    },
    {
      "assert": "fn",
      "name": "gnx_scn_button_picture",
      "args": [
        43,
        2
      ],
      "is": "own 2",
      "why": "the Forest's own button picture (vanilla_stages icon, two frames)"
    },
    {
      "assert": "fn",
      "name": "gnx_scn_button_picture",
      "args": [
        43,
        0
      ],
      "is": "vanilla 0",
      "why": "control: the Village keeps its button"
    },
    {
      "call": "gnx_scn_set_stage_sel",
      "args": [
        "vanilla.FOREST",
        0
      ]
    },
    {
      "call": "scr_set_stage_data",
      "args": [
        2,
        0,
        false
      ]
    },
    {
      "raid_stage": 2
    },
    {
      "wait": 10
    },
    {
      "raid_clear_formation": true
    },
    {
      "wait": 2
    },
    {
      "raid_formation": {
        "front": [
          [
            0,
            40
          ]
        ],
        "back": [
          [
            1,
            20
          ]
        ]
      }
    },
    {
      "wait": 3
    },
    {
      "raid_go": true
    },
    {
      "wait": 5
    },
    {
      "assert": "raid",
      "state": 1
    },
    {
      "call": "gnx_scn_raid_clock",
      "args": [
        0.5
      ]
    },
    {
      "assert": "fn",
      "name": "gnx_scn_cart_pos",
      "args": [],
      "is": "213 78",
      "why": "the GNX cart takes the Forest's new route"
    },
    {
      "wait": 20
    },
    {
      "screenshot": "forest_moved"
    },
    {
      "raid_finish": 1200
    },
    {
      "wait": 5
    },
    {
      "assert": "raid",
      "state": 0
    },
    {
      "open_raid": false
    },
    {
      "wait": 5
    },
    {
      "travel": "vanilla"
    },
    {
      "wait": 40
    },
    {
      "assert": "active_map",
      "is": "vanilla"
    },
    {
      "assert": "fn",
      "name": "gnx_vstage_hidden",
      "args": [
        1
      ],
      "is": 0,
      "why": "the village keeps its Mountain"
    },
    {
      "assert": "fn",
      "name": "gnx_scn_stage_reward",
      "args": [
        "vanilla.FOREST",
        0
      ],
      "is": "28 20",
      "why": "and the vanilla Forest reward"
    },
    {
      "call": "scr_set_stage_data",
      "args": [
        2,
        0,
        false
      ]
    },
    {
      "open_raid": true
    },
    {
      "wait": 10
    },
    {
      "assert": "fn",
      "name": "gnx_scn_button_picture",
      "args": [
        43,
        2
      ],
      "is": "vanilla 2",
      "why": "back in the village the Forest's vanilla button"
    },
    {
      "open_raid": false
    }
  ]
}