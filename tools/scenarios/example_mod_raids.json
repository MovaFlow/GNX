{
  "about": "The reference mod's raids.json and map_info.vanilla_stages on its own map: the Witch Hut is open from the start (no unlock), Siren Cove opens once the Witch Hut's second level is, the Mountain is hidden and the Castle pays the mod's reward. Loads without mod errors.",
  "mods": [
    "GNX/example_mod"
  ],
  "check_boot_suite": false,
  "steps": [
    {
      "wait": 30
    },
    {
      "travel": "example_mod"
    },
    {
      "wait": 60
    },
    {
      "assert": "active_map",
      "is": "example_mod"
    },
    {
      "assert": "fn",
      "name": "gnx_scn_stage_exp",
      "args": [
        "example_mod.WITCH HUT"
      ],
      "is": "0 0",
      "why": "the Witch Hut is there from the start"
    },
    {
      "assert": "fn",
      "name": "gnx_scn_stage_exp",
      "args": [
        "example_mod.SIREN COVE"
      ],
      "is": "-1",
      "why": "Siren Cove is not yet"
    },
    {
      "assert": "fn",
      "name": "gnx_vstage_hidden",
      "args": [
        1
      ],
      "is": 1,
      "why": "the Mountain is hidden on this map"
    },
    {
      "assert": "fn",
      "name": "gnx_scn_stage_reward",
      "args": [
        "vanilla.CASTLE",
        1
      ],
      "is": "150 50",
      "why": "the Castle's reward per level"
    },
    {
      "assert": "fn",
      "name": "gnx_scn_mod_error_count",
      "args": [
        "example_mod"
      ],
      "is": 0,
      "why": "no mod errors"
    },
    {
      "do": {
        "type": "unlock_stage_next",
        "stage": "example_mod.WITCH HUT"
      }
    },
    {
      "wait": 70
    },
    {
      "assert": "fn",
      "name": "gnx_scn_stage_exp",
      "args": [
        "example_mod.SIREN COVE"
      ],
      "is": "0 0",
      "why": "Siren Cove discovered once the Witch Hut's second level is open"
    },
    {
      "wait": 10
    },
    {
      "screenshot": "after_discover"
    },
    {
      "open_raid": true
    },
    {
      "wait": 25
    },
    {
      "screenshot": "raid_map"
    }
  ]
}