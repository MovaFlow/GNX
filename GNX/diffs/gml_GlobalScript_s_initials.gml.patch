+        if (y >= (_vy - 400) && y <= (_vy + _vh + 400))
+            _s.in_band++;
+
+        if (variable_struct_exists(unit_data, "preg") && unit_data.preg != -1)
+            _s.pregnant++;
+    }
+
+    return _s;
+}
