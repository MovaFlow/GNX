{
  "about": "A mod's folder depends on how it was installed: a class or cell written with the mod's mod_id or manifest name still resolves. A class that does not exist in an installed mod is a mod error, one of a mod that is not installed is only logged, and a class condition naming a cell of its own mod (no cell exists yet while classes load) is not an error.",
  "mods": [
    "tools/scenarios/mods/harness_ref_folder"
  ],
  "steps": [
    {
      "wait": 5
    },
    {
      "assert": "fn",
      "name": "gnx_scn_quest_ref_ok",
      "args": [
        "harness_ref_folder.by_folder",
        "class"
      ],
      "is": true,
      "why": "class named by the folder"
    },
    {
      "assert": "fn",
      "name": "gnx_scn_quest_ref_ok",
      "args": [
        "harness_ref_folder.by_id",
        "class"
      ],
      "is": true,
      "why": "class named by mod_id"
    },
    {
      "assert": "fn",
      "name": "gnx_scn_quest_ref_ok",
      "args": [
        "harness_ref_folder.by_name",
        "class"
      ],
      "is": true,
      "why": "class named by manifest name"
    },
    {
      "assert": "fn",
      "name": "gnx_scn_quest_ref_ok",
      "args": [
        "harness_ref_folder.by_bare",
        "class"
      ],
      "is": true,
      "why": "class named by no prefix"
    },
    {
      "assert": "fn",
      "name": "gnx_scn_quest_ref_ok",
      "args": [
        "harness_ref_folder.cell_by_id",
        "h_type"
      ],
      "is": true,
      "why": "cell named by mod_id"
    },
    {
      "assert": "fn",
      "name": "gnx_scn_quest_ref_ok",
      "args": [
        "harness_ref_folder.wrong_class",
        "class"
      ],
      "is": false,
      "why": "no such class"
    }
  ],
  "expect_dialog": "NO SUCH GIRL"
}