+// GNX_ATLAS_WRAPPERS_BEGIN
+// ============================================================================
+// GNX ATLAS WRAPPERS — SprRef abstraction + draw/query wrappers
+// ============================================================================
+// New file: to be integrated into s_initials.gml or as a separate GML script.
+// Purpose: allow GNX mods to ship either legacy strip-per-sprite format OR
+// packed-atlas format, with a uniform API for draw and sprite queries.
+//
+// Data model:
+//   SprRef struct = one of:
+//     {kind: "legacy", spr: <sprite_index>}
+//         Wraps an ordinary sprite_add result. All subimages live on that sprite.
+//     {kind: "atlas", atlas: <sprite_index>, frames: [{x,y,w,h}, ...], xo, yo}
+//         atlas = single sprite created from a packed atlas PNG (1 texture page).
+//         frames[i] = pixel-space rect in the atlas for subimage i.
+//         xo,yo = origin, applied at draw.
+//
+// Rule: any registry field that USED to hold a raw sprite_index now holds a
+// SprRef struct. Loader path (legacy strips or atlas mode) constructs the right
+// kind. All draw sites in GNX-touched paths must call gnx_draw_sprite_ext /
+// gnx_draw_sprite_general instead of raw draw_sprite_ext / draw_sprite_general.
+// ============================================================================
+
+// ---------------------------------------------------------------------------
+// Constructors
+// ---------------------------------------------------------------------------
+
+/// Wrap a sprite_index in a legacy SprRef.
+function sprref_legacy(_spr) {
+    return { kind: "legacy", spr: _spr };
+}
+
+/// Build an atlas SprRef from a single atlas sprite + frame UV list.
+///   _atlas_spr : sprite_index of the atlas PNG (loaded via sprite_add(path, 1, ...))
+///   _frames    : array of {x,y,w,h} pixel rects, indexed by subimage number
+///   _xo,_yo    : origin (drawn from top-left of frame minus origin)
+function sprref_atlas(_atlas_spr, _frames, _xo, _yo) {
+    return {
+        kind: "atlas",
+        atlas: _atlas_spr,
+        frames: _frames,
+        xo: _xo,
+        yo: _yo
+    };
+}
+
+/// Build an atlas SprRef with per-frame atlas index (for multi-atlas mods).
+///   _atlas_sprites : array of sprite_index (one per atlas PNG)
+///   _frames        : array of {atlas: int, x, y, w, h}
+///   _xo, _yo       : origin
+function sprref_atlas_multi(_atlas_sprites, _frames, _xo, _yo) {
+    return {
+        kind: "atlas",
+        atlas: _atlas_sprites[0],
+        atlas_sprites: _atlas_sprites,
+        frames: _frames,
+        xo: _xo,
+        yo: _yo,
+        multi: true
+    };
+}
+
+/// Return true if value is a SprRef struct (either kind).
+function is_sprref(_v) {
+    return is_struct(_v) && variable_struct_exists(_v, "kind")
+        && (_v.kind == "legacy" || _v.kind == "atlas");
+}
+
+// ---------------------------------------------------------------------------
+// Query wrappers (drop-in replacements for sprite_get_*)
+// ---------------------------------------------------------------------------
+
+function gnx_sprite_exists(_s) {
+    if (is_sprref(_s)) {
+        return (_s.kind == "legacy") ? sprite_exists(_s.spr) : sprite_exists(_s.atlas);
+    }
+    // Raw sprite_index fallback (vanilla or un-migrated call site)
+    return sprite_exists(_s);
+}
+
+function gnx_sprite_get_number(_s) {
+    if (is_sprref(_s)) {
+        return (_s.kind == "legacy") ? sprite_get_number(_s.spr) : array_length(_s.frames);
+    }
+    return sprite_get_number(_s);
+}
+
+function gnx_sprite_get_width(_s, _subimg = 0) {
+    if (is_sprref(_s)) {
+        if (_s.kind == "legacy") return sprite_get_width(_s.spr);
+        var _i = _subimg mod array_length(_s.frames);
+        return _s.frames[_i].w;
+    }
+    return sprite_get_width(_s);
+}
+
+function gnx_sprite_get_height(_s, _subimg = 0) {
+    if (is_sprref(_s)) {
+        if (_s.kind == "legacy") return sprite_get_height(_s.spr);
+        var _i = _subimg mod array_length(_s.frames);
+        return _s.frames[_i].h;
+    }
+    return sprite_get_height(_s);
+}
+
+function gnx_sprite_get_xoffset(_s) {
+    if (is_sprref(_s)) {
+        return (_s.kind == "legacy") ? sprite_get_xoffset(_s.spr) : _s.xo;
+    }
+    return sprite_get_xoffset(_s);
+}
+
+function gnx_sprite_get_yoffset(_s) {
+    if (is_sprref(_s)) {
+        return (_s.kind == "legacy") ? sprite_get_yoffset(_s.spr) : _s.yo;
+    }
+    return sprite_get_yoffset(_s);
+}
+
+// ---------------------------------------------------------------------------
+// Draw wrappers (drop-in replacements for draw_sprite* on SprRef values)
+// ---------------------------------------------------------------------------
+
+/// Equivalent of draw_sprite_ext(sprref, subimg, x, y, xs, ys, rot, col, alpha).
+/// Handles both kinds. For atlas: dispatches to draw_sprite_part_ext (no rot)
+/// or draw_sprite_general (with rot).
+function gnx_draw_sprite_ext(_s, _subimg, _x, _y, _xs, _ys, _rot, _col, _alpha) {
+    if (is_sprref(_s)) {
+        if (_s.kind == "legacy") {
+            draw_sprite_ext(_s.spr, _subimg, _x, _y, _xs, _ys, _rot, _col, _alpha);
+            return;
+        }
+        // atlas
+        var _n = array_length(_s.frames);
+        if (_n == 0) return;
+        var _i = _subimg mod _n;
+        if (_i < 0) _i += _n;
+        var _f = _s.frames[_i];
+        // Skip empty frames (used as animation timing pauses, marked "empty" in uv.json)
+        if (_f.w <= 0 || _f.h <= 0) return;
+        // Resolve the correct atlas sprite for this frame (multi-atlas support)
+        var _atlas_spr = variable_struct_exists(_s, "multi") ? _s.atlas_sprites[_f.atlas] : _s.atlas;
+        // Origin offset from atlas-frame top-left: (xo, yo) shifts the draw pos
+        // so that (_x,_y) means the sprite's origin, matching vanilla semantics.
+        var _dx = _x - (_s.xo * _xs);
+        var _dy = _y - (_s.yo * _ys);
+        if (_rot == 0) {
+            draw_sprite_part_ext(_atlas_spr, 0, _f.x, _f.y, _f.w, _f.h, _dx, _dy, _xs, _ys, _col, _alpha);
+        } else {
+            // draw_sprite_general applies rot around (_x,_y), which is what we want
+            // after origin adjustment. Colors passed as uniform _col to all corners.
+            draw_sprite_general(_atlas_spr, 0, _f.x, _f.y, _f.w, _f.h, _dx, _dy, _xs, _ys, _rot, _col, _col, _col, _col, _alpha);
+        }
+        return;
+    }
+    // Raw sprite_index fallback
+    draw_sprite_ext(_s, _subimg, _x, _y, _xs, _ys, _rot, _col, _alpha);
+}
+
+/// Equivalent of draw_sprite(sprref, subimg, x, y).
+function gnx_draw_sprite(_s, _subimg, _x, _y) {
+    gnx_draw_sprite_ext(_s, _subimg, _x, _y, 1, 1, 0, c_white, 1);
+}
+
+/// Equivalent of draw_sprite_part(sprref, subimg, l, t, w, h, x, y).
+/// For atlas: l/t/w/h are RELATIVE to the frame's own rect.
+function gnx_draw_sprite_part_ext(_s, _subimg, _l, _t, _w, _h, _x, _y, _xs, _ys, _col, _alpha) {
+    if (is_sprref(_s) && _s.kind == "atlas") {
+        var _n = array_length(_s.frames);
+        if (_n == 0) return;
+        var _i = _subimg mod _n;
+        if (_i < 0) _i += _n;
+        var _f = _s.frames[_i];
+        if (_f.w <= 0 || _f.h <= 0) return;
+        var _atlas_spr = variable_struct_exists(_s, "multi") ? _s.atlas_sprites[_f.atlas] : _s.atlas;
+        // Clamp requested part to the frame's rect (avoids bleeding into neighbors)
+        var _al = clamp(_l, 0, _f.w);
+        var _at = clamp(_t, 0, _f.h);
+        var _aw = clamp(_w, 0, _f.w - _al);
+        var _ah = clamp(_h, 0, _f.h - _at);
+        draw_sprite_part_ext(_atlas_spr, 0, _f.x + _al, _f.y + _at, _aw, _ah, _x, _y, _xs, _ys, _col, _alpha);
+        return;
+    }
+    if (is_sprref(_s) && _s.kind == "legacy") {
+        draw_sprite_part_ext(_s.spr, _subimg, _l, _t, _w, _h, _x, _y, _xs, _ys, _col, _alpha);
+        return;
+    }
+    draw_sprite_part_ext(_s, _subimg, _l, _t, _w, _h, _x, _y, _xs, _ys, _col, _alpha);
+}
+
+// ---------------------------------------------------------------------------
+// Atlas resolver — called from gnx_resolve_sprite prologue in atlas mode
+// ---------------------------------------------------------------------------
+
+/// Given a sprite dict entry _s (from classes.json / cells.json sprites map),
+/// extract the base name and look it up in the mod's atlas UV table.
+/// Returns SprRef struct on hit, undefined on miss (caller falls through to
+/// legacy sprite_add path).
+function gnx_atlas_resolve_ref(_mod_id, _s) {
+    if (!variable_global_exists("gnx_mod_atlases")) return undefined;
+    if (!ds_map_exists(global.gnx_mod_atlases, _mod_id)) return undefined;
+    var _atlas = ds_map_find_value(global.gnx_mod_atlases, _mod_id);
+    if (_atlas == undefined) return undefined;
+
+    var _stem = "";
+    if (is_struct(_s)) {
+        if (variable_struct_exists(_s, "strip"))
+            _stem = _s.strip;
+        else if (variable_struct_exists(_s, "path"))
+            _stem = _s.path;
+        else if (variable_struct_exists(_s, "frames") && is_array(_s.frames) && array_length(_s.frames) > 0)
+            _stem = _s.frames[0];
+        else
+            return undefined;
+    } else {
+        _stem = string(_s);
+    }
+    // Strip any directory prefix and extension
+    // (e.g. "strips/spr_h_frieren_idle_head.png" -> "spr_h_frieren_idle_head")
+    _stem = filename_change_ext(filename_name(_stem), "");
+
+    if (!variable_struct_exists(_atlas.sprrefs, _stem))
+        return undefined;
+    return variable_struct_get(_atlas.sprrefs, _stem);
+}
+
+// ---------------------------------------------------------------------------
+// Atlas mod loader
+// ---------------------------------------------------------------------------
+
+/// Load an atlas-mode mod's sprites. Called after manifest parsing detects
+/// atlas/uv.json in the mod folder.
+///   _mod_root : path to the mod folder (ending with /)
+///   _mod_id   : mod identifier (folder name)
+/// Returns a struct:
+///   {
+///     atlas_sprites: [sprite_index, ...],  // one per atlas PNG
+///     sprrefs: { "spr_key_name": SprRef, ... }
+///   }
+/// The returned sprrefs values are what the class/cell loaders should store
+/// in place of the previous raw sprite_index.
+function gnx_load_atlas_mod(_mod_root, _mod_id) {
+    var _atlas_dir = _mod_root + "atlas/";
+    var _uv_path = _atlas_dir + "uv.json";
+    if (!file_exists(_uv_path)) {
+        show_debug_message("[GNX-ATLAS] no uv.json at " + _uv_path);
+        return undefined;
+    }
+
+    // Read + parse uv.json (buffer_load is O(N), file_text loop was O(N^2))
+    var _t_read = get_timer();
+    var _buf = buffer_load(_uv_path);
+    if (_buf == -1) {
+        show_debug_message("[GNX-ATLAS] failed to buffer_load " + _uv_path);
+        return undefined;
+    }
+    var _content = buffer_read(_buf, buffer_text);
+    buffer_delete(_buf);
+    var _t_parse = get_timer();
+    var _uv = json_parse(_content);
+    var _t_after_parse = get_timer();
+    var _tl_r = file_text_open_append(GNX_LOG);
+    file_text_write_string(_tl_r, "[GNX-TIME] " + _mod_id + " uv.json read = " + string((_t_parse - _t_read)/1000) + " ms, parse = " + string((_t_after_parse - _t_parse)/1000) + " ms\n");
+    file_text_close(_tl_r);
+
+    var _atlas_sprites = [];
+    var _files = _uv.atlas_files;
+    for (var _i = 0; _i < array_length(_files); _i++) {
+        var _atlas_path = _atlas_dir + _files[_i];
+        var _t_pre_add = get_timer();
+        var _spr = sprite_add(_atlas_path, 1, false, false, 0, 0);
+        var _t_add_ms = (get_timer() - _t_pre_add) / 1000;
+        if (_spr == -1) {
+            show_debug_message("[GNX-ATLAS] failed to load " + _atlas_path);
+            continue;
+        }
+        var _tl = file_text_open_append(GNX_LOG);
+        file_text_write_string(_tl, "[GNX-TIME] sprite_add " + _files[_i] + " = " + string(_t_add_ms) + " ms\n");
+        file_text_close(_tl);
+        array_push(_atlas_sprites, _spr);
+        array_push(global.gnx_runtime_sprites, _spr);
+    }
+
+    // Build SprRef per entry (per-frame atlas index for multi-atlas mods)
+    var _t_build = get_timer();
+    var _sprrefs = {};
+    var _entries = _uv.entries;
+    var _keys = variable_struct_get_names(_entries);
+    for (var _k = 0; _k < array_length(_keys); _k++) {
+        var _key = _keys[_k];
+        var _entry = variable_struct_get(_entries, _key);
+        var _frames_raw = _entry.frames;
+        var _frames = [];
+        for (var _fi = 0; _fi < array_length(_frames_raw); _fi++) {
+            var _fr = _frames_raw[_fi];
+            array_push(_frames, { atlas: _fr.atlas, x: _fr.x, y: _fr.y, w: _fr.w, h: _fr.h });
+        }
+        // Origin default (0,0) — read from entry.xo/yo if declared
+        var _xo = variable_struct_exists(_entry, "xo") ? _entry.xo : 0;
+        var _yo = variable_struct_exists(_entry, "yo") ? _entry.yo : 0;
+        var _sref = sprref_atlas_multi(_atlas_sprites, _frames, _xo, _yo);
+        variable_struct_set(_sprrefs, _key, _sref);
+    }
+
+    var _tl_b = file_text_open_append(GNX_LOG); file_text_write_string(_tl_b, "[GNX-TIME] " + _mod_id + " sprref build = " + string((get_timer() - _t_build)/1000) + " ms\n"); file_text_close(_tl_b);
+    show_debug_message("[GNX-ATLAS] loaded " + _mod_id + ": " + string(array_length(_atlas_sprites)) + " atlas(es), " + string(array_length(_keys)) + " sprite entries");
+    return {
+        atlas_sprites: _atlas_sprites,
+        sprrefs: _sprrefs
+    };
+}
+
+// ---------------------------------------------------------------------------
+// Integration points (to be wired in during Phase 4/5)
+// ---------------------------------------------------------------------------
+//
+// 1. In scr_gnx_load_mod (s_initials.gml): after manifest parse, check for
+//    file_exists(mod_root + "atlas/uv.json"). If yes, call gnx_load_atlas_mod
+//    and stash result in a per-mod global (e.g. global.gnx_mod_atlases[mod_id]).
+//    The mod's classes.json/cells.json still runs, but gnx_resolve_sprite is
+//    replaced by a lookup into the mod's sprrefs table when the mod is in
+//    atlas mode.
+//
+// 2. gnx_resolve_sprite: add a branch at the top that checks if the current
+//    mod is atlas-mode and, if so, returns the SprRef from the mod's sprrefs
+//    table (keyed by the sprite dict entry's path/strip name). Returns a raw
+//    sprite_index for legacy mode (unchanged behavior).
+//
+// 3. All GNX call sites that previously did draw_sprite_ext(_spr, ...) on a
+//    value that came from the class/cell registry must be swapped to
+//    gnx_draw_sprite_ext(_spr, ...). Similarly sprite_get_width/height.
+//    Vanilla-only call sites (that only draw vanilla sprite_ids) can remain
+//    unchanged.
+//
+// 4. Test suite scr_gnx_test_suite: gnx_spr_ok(spr) should accept SprRef via
+//    is_sprref check + gnx_sprite_exists.
+
+
+/// Wrapper for draw_sprite_general(sprite, subimg, left, top, width, height, x, y, xscale, yscale, rot, c1, c2, c3, c4, alpha)
+function gnx_draw_sprite_general(_s, _subimg, _l, _t, _w, _h, _x, _y, _xs, _ys, _rot, _c1, _c2, _c3, _c4, _alpha) {
+    if (is_sprref(_s) && _s.kind == "atlas") {
+        var _n = array_length(_s.frames);
+        if (_n == 0) return;
+        var _i = _subimg mod _n;
+        if (_i < 0) _i += _n;
+        var _f = _s.frames[_i];
+        if (_f.w <= 0 || _f.h <= 0) return;
+        var _atlas_spr = variable_struct_exists(_s, "multi") ? _s.atlas_sprites[_f.atlas] : _s.atlas;
+        var _al = clamp(_l, 0, _f.w);
+        var _at = clamp(_t, 0, _f.h);
+        var _aw = clamp(_w, 0, _f.w - _al);
+        var _ah = clamp(_h, 0, _f.h - _at);
+        draw_sprite_general(_atlas_spr, 0, _f.x + _al, _f.y + _at, _aw, _ah, _x, _y, _xs, _ys, _rot, _c1, _c2, _c3, _c4, _alpha);
+        return;
+    }
+    if (is_sprref(_s) && _s.kind == "legacy") {
+        draw_sprite_general(_s.spr, _subimg, _l, _t, _w, _h, _x, _y, _xs, _ys, _rot, _c1, _c2, _c3, _c4, _alpha);
