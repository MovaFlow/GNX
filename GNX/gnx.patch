+        {
+            var _max = (variable_instance_exists(id, "gnx_prop_counter") && is_struct(gnx_prop_counter)) ? gnx_prop_counter.max_n : 999999999;
+            gnx_prop_count = clamp(floor(gnx_json_num(prop_data.gnx_count, 0)), 0, _max);
+        }
+    }
+}
