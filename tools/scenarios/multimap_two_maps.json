{
  "about": "Two map mods with different maps installed together: the village offers both travel buttons, each map gets its own map_start and only its own mod's content, and all three maps keep their state independently.",
  "mods": ["tools/scenarios/mods/harness_map", "tools/scenarios/mods/harness_map_b"],
  "steps": [
    {"wait": 30},
    {"do": {"type": "add_gold", "amount": 999}},
    {"wait": 5},
    {"snapshot": "vanilla"},
    {"assert": "travel_location", "to": "harness_map"},
    {"assert": "travel_location", "to": "harness_map_b"},
    {"assert": "cell_registered", "name": "HARNESS WALL", "is": false},
    {"assert": "cell_registered", "name": "B WALL", "is": false},
    {"travel": "harness_map"},
    {"wait": 30},
    {"assert": "val", "key": "money", "is": 1234},
    {"assert": "cell_registered", "name": "HARNESS WALL", "is": true},
    {"assert": "cell_registered", "name": "B WALL", "is": false, "why": "map B's content must not load on map A"},
    {"assert": "has_cell", "h_type": 9001},
    {"assert": "travel_location", "to": "vanilla"},
    {"do": {"type": "add_floor"}},
    {"wait": 5},
    {"snapshot": "map_a"},
    {"travel": "vanilla"},
    {"wait": 30},
    {"travel": "harness_map_b"},
    {"wait": 30},
    {"assert": "val", "key": "money", "is": 4321},
    {"assert": "cell_registered", "name": "B WALL", "is": true},
    {"assert": "cell_registered", "name": "HARNESS WALL", "is": false, "why": "map A's content must not load on map B"},
    {"assert": "has_cell", "h_type": 9002},
    {"assert": "travel_location", "to": "vanilla"},
    {"snapshot": "map_b"},
    {"travel": "vanilla"},
    {"wait": 30},
    {"assert": "same_as", "snapshot": "vanilla", "keys": ["active_map", "floor", "slots", "cells", "money"]},
    {"travel": "harness_map"},
    {"wait": 30},
    {"assert": "same_as", "snapshot": "map_a", "keys": ["active_map", "floor", "slots", "cells", "money"]},
    {"travel": "vanilla"},
    {"wait": 30},
    {"travel": "harness_map_b"},
    {"wait": 30},
    {"assert": "same_as", "snapshot": "map_b", "keys": ["active_map", "floor", "slots", "cells", "money"]}
  ]
}
