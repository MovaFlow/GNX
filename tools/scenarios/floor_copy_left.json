{
  "about": "COPY DOWN of a floor built partly to the left (NEW on the entrance with the build side on the left puts cells before the entrance; NEW on the entrance with the build side on the right puts them before the start slot): the floor below gets the same layout, cells included (also a cell in the start slot), for the price of building it by hand. Fresh game; add_floor makes the floors.",
  "check_boot_suite": false,
  "steps": [
    {
      "wait": 30
    },
    {
      "call": "gnx_scn_set_gold",
      "args": [
        100000
      ]
    },
    {
      "do": {
        "type": "add_floor"
      }
    },
    {
      "wait": 5
    },
    {
      "call": "gnx_scn_build_left",
      "args": [
        0,
        1
      ],
      "why": "a small cell left of the entrance"
    },
    {
      "call": "gnx_scn_build_left",
      "args": [
        1,
        -1
      ],
      "why": "an empty big slot left of the entrance"
    },
    {
      "call": "gnx_scn_build_on_last",
      "args": [
        2
      ],
      "why": "and one on the right"
    },
    {
      "assert": "fn",
      "name": "gnx_scn_last_floor_types",
      "args": [],
      "is": "5 0 5 1 4 3 5 2 5"
    },
    {
      "do": {
        "type": "add_floor"
      }
    },
    {
      "wait": 5
    },
    {
      "call": "gnx_scn_gold_mark"
    },
    {
      "call": "gnx_scn_open_slot_menu",
      "args": [
        -1,
        false
      ],
      "why": "the entrance of the floor above the deepest"
    },
    {
      "wait": 5
    },
    {
      "press": {
        "type": 0,
        "num": 4
      },
      "why": "FLOOR"
    },
    {
      "wait": 5
    },
    {
      "press": {
        "type": 2,
        "num": 5
      },
      "why": "COPY DOWN"
    },
    {
      "wait": 10
    },
    {
      "assert": "fn",
      "name": "gnx_scn_floor_copy_same",
      "args": [],
      "is": "same",
      "why": "the same layout, left part included"
    },
    {
      "assert": "fn",
      "name": "gnx_scn_paid_build_cost",
      "args": [],
      "is": 1
    },
    {
      "screenshot": "copied"
    }
  ]
}