+// Mav (1.4.7.5): a copy of an atlas sprite with another origin. The shared atlas entry is left alone,
+// so two JSON entries using the same file with different origins no longer clash.
+function gnx_sprref_with_origin(arg0, arg1, arg2)
+{
+    var _c =
+    {
+        kind: "atlas",
+        atlas: arg0.atlas,
+        frames: arg0.frames,
+        xo: arg1,
+        yo: arg2
+    };
+    if (variable_struct_exists(arg0, "multi"))
+    {
+        _c.atlas_sprites = arg0.atlas_sprites;
+        _c.multi = true;
+    }
+    return _c;
+}
+
+// Mav (1.4.7.5): turns an atlas sprite into a normal GameMaker sprite (frames copied through a surface).
+// Needed where the game requires a real sprite: sprite_index, click mask, frame count.
+// The result is cached in "baked", so each sprite is baked once. -1 = failed.
+function gnx_sprref_bake(arg0)
+{
+    if (!is_sprref(arg0))
+        return arg0;
+    if (arg0.kind == "legacy")
+        return arg0.spr;
+    if (variable_struct_exists(arg0, "baked") && sprite_exists(arg0.baked))
+        return arg0.baked;
+    var _n = array_length(arg0.frames);
+    if (_n == 0)
+        return -1;
+    var _w = 1;
+    var _h = 1;
+    for (var _i = 0; _i < _n; _i++)
+    {
+        _w = max(_w, arg0.frames[_i].w);
+        _h = max(_h, arg0.frames[_i].h);
+    }
+    var _surf = surface_create(_w, _h);
+    if (!surface_exists(_surf))
+        return -1;
+    var _spr = -1;
+    gpu_push_state();
+    // bm_one, bm_zero: copy pixels with their alpha, no blending
+    gpu_set_blendmode_ext(bm_one, bm_zero);
+    for (var _i = 0; _i < _n; _i++)
+    {
+        var _f = arg0.frames[_i];
+        var _aspr = variable_struct_exists(arg0, "multi") ? arg0.atlas_sprites[_f.atlas] : arg0.atlas;
+        surface_set_target(_surf);
+        draw_clear_alpha(c_black, 0);
+        // the _ext version with white and alpha 1, so draw_set_alpha from other events cannot leak in
+        if (sprite_exists(_aspr) && _f.w > 0 && _f.h > 0)
+            draw_sprite_part_ext(_aspr, 0, _f.x, _f.y, _f.w, _f.h, 0, 0, 1, 1, c_white, 1);
+        surface_reset_target();
+        if (_spr == -1)
+            _spr = sprite_create_from_surface(_surf, 0, 0, _w, _h, false, false, arg0.xo, arg0.yo);
+        else
+            sprite_add_from_surface(_spr, _surf, 0, 0, _w, _h, false, false);
+    }
+    gpu_pop_state();
+    surface_free(_surf);
+    if (_spr != -1)
+    {
+        array_push(global.gnx_runtime_sprites, _spr);
+        arg0.baked = _spr;
+    }
+    return _spr;
+}
+
+function gnx_sprite_exists(arg0)
+{
+    if (is_sprref(arg0))
+    {
+        if (arg0.kind == "legacy")
+            return sprite_exists(arg0.spr);
+        
+        // GNX-FIX: a multi-page atlas sprite exists only when every frame points into a loaded page and
+        // lies inside it (before, only the first frame's page was checked, so a sprite with a missing
+        // second page counted as fine and drew nothing). The full frame check runs once per sprite
+        // (gnx_chk); after that only the pages it uses are checked, because this runs while drawing.
+        if (variable_struct_exists(arg0, "multi"))
+        {
+            if (!variable_struct_exists(arg0, "gnx_chk"))
+                arg0.gnx_chk = gnx_atlas_check(arg0);
+            
+            if (!arg0.gnx_chk.ok)
+                return false;
+            
+            var _pg = arg0.gnx_chk.pages;
+            
+            for (var i = 0; i < array_length(_pg); i++)
+            {
+                if (!sprite_exists(arg0.atlas_sprites[_pg[i]]))
+                    return false;
+            }
+            
+            return true;
+        }
+        
+        // Mav (1.4.7.5): with several pages, the page of the first frame counts
+        return sprite_exists(arg0.atlas);
+    }
+    
+    return sprite_exists(arg0);
+}
+
+
