+function scr_gnx_load_deferred_map_mods()
+{
+    if (!global.gnx_multimap_enabled)
+        exit;
+    
+    if (global.gnx_active_map == "vanilla")
+        exit;
+    
+    if (array_length(global.gnx_map_deferred_mods) == 0)
+        exit;
+    
+    var _log = gnx_log_open();
+    gnx_log_write(_log, "[GNX-MAP] deferred load: active_map='" + global.gnx_active_map + "', " + string(array_length(global.gnx_map_deferred_mods)) + " deferred mod(s)\n");
+    gnx_log_close(_log);
+    // Mav (1.4.7.5): the name maps from boot stay: create them only if missing
+    if (!variable_global_exists("gnx_class_name_to_id") || !ds_exists(global.gnx_class_name_to_id, ds_type_map))
+    global.gnx_class_name_to_id = ds_map_create();
+    if (!variable_global_exists("gnx_cell_name_to_id") || !ds_exists(global.gnx_cell_name_to_id, ds_type_map))
+    global.gnx_cell_name_to_id = ds_map_create();
+    var _loaded = 0;
+    var _gnx_dlist = [];
+    
+    for (var _i = 0; _i < array_length(global.gnx_map_deferred_mods); _i++)
+    {
+        var _mod_name = global.gnx_map_deferred_mods[_i];
+        var _mod_map = variable_struct_get(global.gnx_mod_map_decl, _mod_name);
+        
+        if (gnx_map_decl_has(_mod_map, global.gnx_active_map))
+        {
+            array_push(_gnx_dlist, _mod_name);
+            _loaded++;
+        }
+    }
+    
+    // Mav (1.4.7.5): these mods load in phases too (classes -> cells -> the rest)
+    scr_gnx_load_mod_list(_gnx_dlist);
+    _log = gnx_log_open();
+    gnx_log_write(_log, "[GNX-MAP] deferred load: " + string(_loaded) + " mod(s) loaded\n");
+    gnx_log_close(_log);
+    
+    if (_loaded > 0)
+    {
+        scr_gnx_resolve_birth_classes();
+        scr_gnx_deferred_resolve_class_map();
+        scr_gnx_apply_unlocks();
+        scr_gnx_apply_prop_unlocks();
+        scr_gnx_register_goblin_sprites();
+        gnx_loot_resolve();  // the map mods' raid loot (items.json, raids.json) is resolved like the boot mods'
+    }
+    
+    // Mav (1.4.7.5): the name maps stay for later trips
+    var _rx = 200;
+    var _ry = 80;
+    var _rl = "Return";
+    
+    for (var _ti = 0; _ti < array_length(global.gnx_travel_locations); _ti++)
+    {
+        if (global.gnx_travel_locations[_ti].target == global.gnx_active_map)
+        {
+            _rx = global.gnx_travel_locations[_ti].return_x;
+            _ry = global.gnx_travel_locations[_ti].return_y;
+            _rl = global.gnx_travel_locations[_ti].return_label;
+            global.gnx_map_sprite = global.gnx_travel_locations[_ti].map_sprite;
+            break;
+        }
+    }
+    
+    var _ret = {};
+    _ret.target = "vanilla";
+    _ret.show_on = global.gnx_active_map;
+    _ret.label = _rl;
+    _ret.x = _rx;
+    _ret.y = _ry;
+    _ret.mod_name = "_gnx";
+    _ret.map_sprite = -1;
+    array_push(global.gnx_travel_locations, _ret);
+}
+
+
+// a captive of class arg0 at level arg1 (clamped like the create_unit tool) into the first free prison place;
+// false when the prison is full
+function gnx_add_prisoner(arg0, arg1)
+{
+    var _lvl = arg1;
+    var _cr = ds_map_find_value(global.class_registry, arg0);
+
+    if (is_struct(_cr) && variable_struct_exists(_cr, "is_special") && _cr.is_special)
+    {
+        if (_lvl != 6 && _lvl != 7)
+            _lvl = 5;
+    }
+    else if (_lvl != 6 && _lvl > 4)
+    {
+        _lvl = 4;
+    }
+
+    for (var _ui = 0; _ui < ds_list_size(global.unit_list); _ui++)
+    {
+        if (ds_list_find_value(global.unit_list, _ui) == -1)
+        {
+            ds_list_set(global.unit_list, _ui, scr_create_unit_base(arg0, max(0, _lvl)));
+            return true;
+        }
+    }
+
+    return false;
+}
+
+
+function scr_gnx_apply_map_start(arg0)
+{
+    if (!variable_struct_exists(global.gnx_map_start_decl, arg0))
+        exit;
+    
+    var _ms = variable_struct_get(global.gnx_map_start_decl, arg0);
+    var _owner = variable_struct_exists(global.gnx_map_owner, arg0) ? variable_struct_get(global.gnx_map_owner, arg0) : "";  // for "Name" refs
+    
+    // GNX-FIX: every number of map_start goes through gnx_json_num, so "400" works and a typo is skipped
+    if (variable_struct_exists(_ms, "money") && gnx_json_num(_ms.money, undefined) != undefined)
+        global.val.money = gnx_json_num(_ms.money, 0);
+    
+    if (variable_struct_exists(_ms, "food") && gnx_json_num(_ms.food, undefined) != undefined)
+        global.val.food = gnx_json_num(_ms.food, 0);
+    
+    if (variable_struct_exists(_ms, "mood") && gnx_json_num(_ms.mood, undefined) != undefined)
+        global.val.mood = gnx_json_num(_ms.mood, 0);
+    
+    var _floors = variable_struct_exists(_ms, "floors") ? max(0, floor(gnx_json_num(_ms.floors, 0))) : 0;
+    
+    for (var _f = 0; _f < _floors; _f++)
+    {
+        global.val.floor++;
+        array_push(global.slot_x, -1);
+        array_push(global.slot_list, ds_list_create());
+        var _sid = scr_create_slot(4, global.val.floor, 0, false);
+        
+        with (_sid)
+            scr_create_slot(3, global.val.floor, 1, true);
+    }
+    
+    var _ncells = 0;
+    
+    if (variable_struct_exists(_ms, "cells") && is_array(_ms.cells))
+    {
+        var _cells = _ms.cells;
+        
+        for (var _c = 0; _c < array_length(_cells); _c++)
+        {
+            var _cd = _cells[_c];
+            
+            if (!is_struct(_cd) || !variable_struct_exists(_cd, "h_type"))
+                continue;
+
+            var _cht = gnx_tool_resolve_cell(_cd.h_type, _owner);  // a number, or "mod.CELL NAME"
+
+            if (_cht == -1)
+                continue;
+            
+            // GNX-FIX: a cell number that no cell has would make a cell without data
+            if (!ds_map_exists(global.cell_registry, _cht))
+            {
+                gnx_report_mod_error("map_start of '" + arg0 + "': cell " + string(_cd.h_type) + " does not exist, skipped");
+                continue;
+            }
+            
+            var _st = variable_struct_exists(_cd, "slot_type") ? floor(gnx_json_num(_cd.slot_type, 0)) : 0;
+            var _fl = variable_struct_exists(_cd, "floor") ? floor(gnx_json_num(_cd.floor, 0)) : 0;
+            
+            if (_fl < 0 || _fl >= array_length(global.slot_list))
+                continue;
+            
+            var _ix = ds_list_size(global.slot_list[_fl]);
+            var _sep = scr_create_slot(_st, _fl, _ix, true);
+
+            // with arg3=true scr_create_slot returns the separator it adds after the cell; the cell sits right before it
+            var _sep_pos = ds_list_find_index(global.slot_list[_fl], _sep);
+            var _slot = (_sep_pos > 0) ? ds_list_find_value(global.slot_list[_fl], _sep_pos - 1) : -1;
+
+            if (_slot != -1)
+            {
+                scr_set_slot_h_data(_slot, _cht);
+                _ncells++;
+            }
+        }
+    }
+    
+    var _goblins = variable_struct_exists(_ms, "goblins") ? floor(gnx_json_num(_ms.goblins, 5)) : 5;
+    
+    if (_goblins > 0)
+    {
+        scr_mon_num_edit(0, 0, _goblins, true);
+        global.val.nest_num[0] = scr_all_mon_num_cal();
+    }
+    
+    // troops: [{"type": "hobgoblin", "kind": 0, "num": 3}], type a name or 0-3, kind 0-3 (default 0)
+    var _ntroops = 0;
+
+    if (variable_struct_exists(_ms, "troops") && is_array(_ms.troops))
+    {
+        for (var _t = 0; _t < array_length(_ms.troops); _t++)
+        {
+            var _td = _ms.troops[_t];
+
+            if (!is_struct(_td) || !variable_struct_exists(_td, "type") || !variable_struct_exists(_td, "num"))
+                continue;
+
+            var _tt = gnx_mon_type_ref(_td.type);
+            var _tk = variable_struct_exists(_td, "kind") ? clamp(floor(gnx_json_num(_td.kind, 0)), 0, 3) : 0;
+            var _tn = floor(gnx_json_num(_td.num, 0));
+            
+            if (_tt == -1 || _tn <= 0)
+                continue;
+            
+            gnx_add_mons(_tt, _tk, _tn);
+            _ntroops += _tn;
+        }
+    }
+    
+    // prisoners: [{"class": 3 | "mod.NAME", "level": 2, "num": 1}] into free prison places
+    var _npris = 0;
+
+    if (variable_struct_exists(_ms, "prisoners") && is_array(_ms.prisoners))
+    {
+        for (var _p = 0; _p < array_length(_ms.prisoners); _p++)
+        {
+            var _pd = _ms.prisoners[_p];
+
+            if (!is_struct(_pd) || !variable_struct_exists(_pd, "class"))
+                continue;
+
+            var _pc = gnx_tool_resolve_class(_pd.class, _owner);
+
+            if (_pc < 0 || !ds_map_exists(global.class_registry, _pc))
+                continue;
+            
+            var _pn = variable_struct_exists(_pd, "num") ? floor(gnx_json_num(_pd.num, 1)) : 1;
+            var _plv = variable_struct_exists(_pd, "level") ? floor(gnx_json_num(_pd.level, 0)) : 0;
+            
+            for (var _pi = 0; _pi < _pn; _pi++)
+            {
+                if (!gnx_add_prisoner(_pc, _plv))
+                    break;
+
+                _npris++;
+            }
+        }
+    }
+
+    // unlock_cells: [h_type | "mod.CELL NAME"] added to the build menu (like a blueprint, without the notice)
+    var _nunl = 0;
+
+    if (variable_struct_exists(_ms, "unlock_cells") && is_array(_ms.unlock_cells))
+    {
+        for (var _u = 0; _u < array_length(_ms.unlock_cells); _u++)
+        {
+            var _uh = gnx_tool_resolve_cell(_ms.unlock_cells[_u], _owner);
+
+            if (_uh == -1 || !ds_map_exists(global.cell_registry, _uh) || gnx_cell_unlocked(_uh))
+                continue;
+
+            scr_add_new_slot_h_type(_uh, false);
+            _nunl++;
+        }
+    }
+
+    var _log = gnx_log_open();
+    gnx_log_write(_log, "[GNX-MAP] map_start applied for '" + arg0 + "' (floors+=" + string(_floors) + " cells=" + string(_ncells) + " goblins=" + string(_goblins) + " troops=" + string(_ntroops) + " prisoners=" + string(_npris) + " unlocked=" + string(_nunl) + ")\n");
+    gnx_log_close(_log);
+}
