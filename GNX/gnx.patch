+            _a.flash_col = variable_struct_exists(_fl, "color") ? gnx_json_color(_fl.color, c_white, arg1, arg2 + ".flash.color") : c_white;
+            _a.flash_a = variable_struct_exists(_fl, "alpha") ? gnx_json_num_in(_fl.alpha, 0.6, 0, 1, arg1, arg2 + ".flash.alpha") : 0.6;
+        }
+        else
+        {
+            _a.flash_t = gnx_json_num_in(_fl, 0.4, 0.05, 10, arg1, arg2 + ".flash");
+        }
+    }
+    
+    if (variable_struct_exists(arg0, "chance"))
+        _a.chance = gnx_json_num_in(arg0.chance, 1, 0, 1, arg1, arg2 + ".chance");
+    
+    // GNX-PROP: the counter (count_set -1 = leave it as it is)
+    if (variable_struct_exists(arg0, "count"))
+        _a.count = floor(gnx_json_num_in(arg0.count, 1, -999999, 999999, arg1, arg2 + ".count"));
