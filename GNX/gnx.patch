+            break;
+        
+        case "give_prop":
+            // GNX-PROP: prop_id may be a name ("Mod.id", or "id" of this mod, arg1)
+            var _gpid = gnx_prop_resolve_id(arg0.prop_id, arg1);
+            
+            if (_gpid != -1)
