{
  "about": "MODS menu: a mod with active_dates cycles SEASON -> ALL YEAR -> OFF; ALL YEAR (gnx_mods_all_year.json) replaces its sprites outside its dates too, and survives APPLY.",
  "start": "menu",
  "mods": [
    "tools/scenarios/mods/harness_replace",
    "tools/scenarios/mods/harness_replace_season"
  ],
  "expect_dialog": "is not a game sprite",
  "expect_mod_errors": [
    "is 5 x 10, the game sprite 7 x 7",
    "'spr_not_a_game_sprite' is not a game sprite"
  ],
  "timeout": 120,
  "check_boot_suite": false,
  "steps": [
    {
      "menu_continue": 600
    },
    {
      "wait": 5
    },
    {
      "press": {
        "type": 9070
      }
    },
    {
      "wait": 3
    },
    {
      "assert": "fn",
      "name": "gnx_scn_mod_row_text",
      "args": [
        "harness_replace_season"
      ],
      "is": "SEASON",
      "why": "a mod with active_dates shows SEASON when on"
    },
    {
      "assert": "fn",
      "name": "gnx_scn_mod_row_text",
      "args": [
        "harness_replace"
      ],
      "is": "ON",
      "why": "a mod without dates: plain ON"
    },
    {
      "mod_toggle": "harness_replace_season"
    },
    {
      "wait": 2
    },
    {
      "assert": "fn",
      "name": "gnx_scn_mod_row_text",
      "args": [
        "harness_replace_season"
      ],
      "is": "ALL YEAR"
    },
    {
      "screenshot": "all_year"
    },
    {
      "press": {
        "type": 9074
      }
    },
    {
      "wait": 120
    },
    {
      "menu_continue": 600
    },
    {
      "wait": 5
    },
    {
      "press": {
        "type": 9070
      }
    },
    {
      "wait": 3
    },
    {
      "assert": "fn",
      "name": "gnx_scn_mod_row_text",
      "args": [
        "harness_replace_season"
      ],
      "is": "ALL YEAR",
      "why": "kept after APPLY"
    },
    {
      "assert": "fn",
      "name": "gnx_scn_sprite_replaced",
      "args": [
        "spr_slot_giant_extra"
      ],
      "is": 1,
      "why": "ALL YEAR: replaced outside its dates (today is not in 12-01..01-06)"
    },
    {
      "mod_toggle": "harness_replace_season"
    },
    {
      "wait": 2
    },
    {
      "assert": "fn",
      "name": "gnx_scn_mod_row_text",
      "args": [
        "harness_replace_season"
      ],
      "is": "OFF"
    },
    {
      "mod_toggle": "harness_replace_season"
    },
    {
      "wait": 2
    },
    {
      "assert": "fn",
      "name": "gnx_scn_mod_row_text",
      "args": [
        "harness_replace_season"
      ],
      "is": "SEASON",
      "why": "back to its dates"
    },
    {
      "press": {
        "type": 9074
      }
    },
    {
      "wait": 120
    },
    {
      "menu_continue": 600
    },
    {
      "wait": 5
    },
    {
      "assert": "fn",
      "name": "gnx_scn_sprite_replaced",
      "args": [
        "spr_slot_giant_extra"
      ],
      "is": 0,
      "why": "SEASON again: off outside its dates"
    }
  ]
}