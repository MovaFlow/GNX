+// Why travel is not possible right now, as a player-facing reason ("" = travel allowed). Logs the cause.
+// Checked before the pre-travel selector opens (it would otherwise take the chosen goods first).
+function scr_gnx_travel_blocked()
+{
+    var _why = "";
+    var _log_why = "";
+    var _raid_state = 0;
+    
+    with (obj_np.obj_raid)
+        _raid_state = raid_data.raid_state;
+    
+    if (_raid_state != 0)
+    {
+        _why = "Can't travel while a raid is out.";
+        _log_why = "raid active";
+    }
+    else
+    {
+        var _blocking_types = "";
+        
+        with (obj_window)
+        {
+            if (interact_type == 2 || interact_type == 3 || interact_type == 5 || interact_type == 11 || interact_type == 28)
+                _blocking_types += (string(interact_type) + " ");
+        }
+        
+        if (_blocking_types != "")
+        {
+            _why = "Close the open window before travelling.";
+            _log_why = "window types=" + _blocking_types;
+        }
+        else if (obj_control.hold_id != -1)
+        {
+            _why = "Drop what you're holding before travelling.";
+            _log_why = "drag in progress";
+        }
+        else if (variable_global_exists("gnx_trigger_load") && global.gnx_trigger_load)
+        {
+            _why = "Already travelling.";
+            _log_why = "load already pending";
+        }
+    }
+    
+    if (_log_why != "")
+    {
+        var _l = gnx_log_open();
+        gnx_log_write(_l, "[GNX-MAP] travel blocked: " + _log_why + "\n");
+        gnx_log_close(_l);
+    }
+    
+    return _why;
+}
