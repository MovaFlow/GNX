{
  "about": "Mods removed entirely, and old saves. harness_map is not installed: save 1 (made with it) shows it as a 'not installed' row on the mod page and in its load warning. Save 2 is the rich 'modded' fixture, saved before GNX recorded mods and missing 14 mods: its warning counts their content as 'unknown mods'.",
  "start": "menu",
  "mods": [
    "tools/scenarios/mods/harness_req_base",
    "tools/scenarios/mods/harness_req_child"
  ],
  "player_slots": {
    "1": {
      "fixture": "with_harness_map"
    },
    "2": {
      "fixture": "modded"
    }
  },
  "timeout": 120,
  "steps": [
    {
      "menu_continue": 600
    },
    {
      "wait": 5
    },
    {
      "press": {
        "type": 9070
      }
    },
    {
      "wait": 3
    },
    {
      "assert": "mod_row",
      "folder": "harness_map",
      "installed": false,
      "used": 1,
      "why": "a removed mod the saves still use"
    },
    {
      "screenshot": "mod_page_missing"
    },
    {
      "press": {
        "type": 9075
      }
    },
    {
      "wait": 3
    },
    {
      "press": {
        "type": 51,
        "num": 1
      }
    },
    {
      "wait": 5
    },
    {
      "assert": "load_missing",
      "slot": 1,
      "has": "harness_map/GNX Harness Map (not installed)"
    },
    {
      "assert": "load_missing",
      "slot": 2,
      "has": "unknown mods"
    },
    {
      "screenshot": "load_page"
    },
    {
      "load_page_press": 2
    },
    {
      "wait": 2
    },
    {
      "assert": "confirm",
      "contains": "unknown mods"
    },
    {
      "screenshot": "old_save_confirm"
    },
    {
      "press": {
        "type": 9077,
        "num": 0
      },
      "why": "load anyway: the sanitizer replaces the missing content"
    },
    {
      "wait": 60
    },
    {
      "assert": "registry_ok"
    }
  ]
}