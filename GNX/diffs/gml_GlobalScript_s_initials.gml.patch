+function scr_gnx_apply_map_start(arg0)
+{
+    if (!variable_struct_exists(global.gnx_map_start_decl, arg0))
+        exit;
+    
+    var _ms = variable_struct_get(global.gnx_map_start_decl, arg0);
+    
+    if (variable_struct_exists(_ms, "money"))
+        global.val.money = _ms.money;
+    
+    if (variable_struct_exists(_ms, "food"))
+        global.val.food = _ms.food;
+    
+    if (variable_struct_exists(_ms, "mood"))
+        global.val.mood = _ms.mood;
+    
+    var _floors = variable_struct_exists(_ms, "floors") ? _ms.floors : 0;
+    
+    for (var _f = 0; _f < _floors; _f++)
+    {
+        global.val.floor++;
+        array_push(global.slot_x, -1);
+        array_push(global.slot_list, ds_list_create());
+        var _sid = scr_create_slot(4, global.val.floor, 0, false);
+        
+        with (_sid)
+            scr_create_slot(3, global.val.floor, 1, true);
+    }
+    
+    var _ncells = 0;
+    
+    if (variable_struct_exists(_ms, "cells") && is_array(_ms.cells))
+    {
+        var _cells = _ms.cells;
+        
+        for (var _c = 0; _c < array_length(_cells); _c++)
+        {
+            var _cd = _cells[_c];
+            
+            if (!is_struct(_cd) || !variable_struct_exists(_cd, "h_type"))
+                continue;
+            
+            var _st = variable_struct_exists(_cd, "slot_type") ? _cd.slot_type : 0;
+            var _fl = variable_struct_exists(_cd, "floor") ? _cd.floor : 0;
+            
+            if (_fl < 0 || _fl >= array_length(global.slot_list))
+                continue;
+            
+            var _ix = ds_list_size(global.slot_list[_fl]);
+            var _slot = scr_create_slot(_st, _fl, _ix, true);
+            
+            if (_slot != -1)
+            {
+                scr_set_slot_h_data(_slot, _cd.h_type);
+                _ncells++;
+            }
+        }
+    }
+    
+    var _goblins = variable_struct_exists(_ms, "goblins") ? _ms.goblins : 5;
+    
+    if (_goblins > 0)
+    {
+        scr_mon_num_edit(0, 0, _goblins, true);
+        global.val.nest_num[0] = scr_all_mon_num_cal();
+    }
+    
+    var _log = file_text_open_append("gnx_debug.txt");
+    file_text_write_string(_log, "[GNX-MAP] map_start applied for '" + arg0 + "' (floors+=" + string(_floors) + " cells=" + string(_ncells) + " goblins=" + string(_goblins) + ")\n");
+    file_text_close(_log);
+}
