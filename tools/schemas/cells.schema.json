            },
            "sq_x": {
              "type": "number"
            },
            "sq_y": {
              "type": "array"
            },
            "sp_x": {
              "type": "number"
            },
            "sp_y": {
              "type": "array"
            },
            "sp_anim_x": {
              "type": "number"
            },
            "sp_anim_y": {
              "type": "number"
            },
            "sp_spr": {
              "$ref": "#/definitions/spr"
            },
            "fx_floor": {
              "type": "number"
            },
            "character_row": {
              "type": "number",
              "description": "Row of the captive's strips (guide 9.3)."
            },
            "required_class": {
              "type": [
                "number",
                "string",
                "array"
              ],
              "description": "Classes allowed in (guide 9.9)."
            },
            "slot_range": {
              "type": "number"
            },
            "range_draw_func": {
              "type": "string"
            },
            "scr_unoccupy": {
              "type": "string"
            },
            "sign_y_base": {
              "type": "number"
            },
            "sign_y_jitter": {
              "type": "number"
            },
            "mon_placements": {
              "type": "array",
              "description": "Places for several monsters (guide 11.1)."
            },
            "mon_positions": {
              "type": "array",
              "description": "Where each place is drawn (guide 11.3)."
            },
            "transfer": {
              "type": [
                "boolean",
                "integer"
              ]
            },
            "frames": {
              "type": [
                "object",
                "number",
                "array"
              ],
              "description": "Frame counts per phase (guide 22.1)."
            },
            "start_loops": {
              "type": [
                "number",
                "array"
              ]
            },
            "ej_start": {
              "type": "number"
            },
            "ej_hold": {
              "type": "number"
            },
            "ej_holds": {
              "type": [
                "number",
                "array"
              ]
            },
            "ej_return": {
              "type": "number",
              "description": "Frame the ej goes back to for its next hold (default ej_start), counted from 0."
            },
            "join_skip": {
              "type": [
                "boolean",
                "integer"
              ],
              "description": "Independent places: a monster coming in later starts where the captive is."
            },
            "loop_scale": {
              "type": [
                "boolean",
                "integer"
              ]
            },
            "intermissions": {
              "type": "object",
              "description": "One-shot sub-phases (guide 23)."
