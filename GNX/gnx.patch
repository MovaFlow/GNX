+        if (!scr_gnx_spr_ok(arg0))
+            _bad += arg1 + " ";
+
+        return _bad;
+    }
+
+    var _names = variable_struct_get_names(arg0);
+
+    for (var _i = 0; _i < array_length(_names); _i++)
+    {
+        var _v = variable_struct_get(arg0, _names[_i]);
