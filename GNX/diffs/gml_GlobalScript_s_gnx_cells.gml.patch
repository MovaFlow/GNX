+/// GNX-BYCLASS: the milk tables to draw for a captive of class arg1 in cell arg0 (a cell_registry
+/// entry). A class_map cell: her class's own (milk_spr in her human_spr.classes entry), else the default
+/// entry's, else no milk; the cell's own milk_spr is never lent to a class there (it is only read by a
+/// GNX without per-class milk). Any other cell: the cell's own. Returns { spr, clock, n }.
+function gnx_milk_for(arg0, arg1)
+{
+    // && = and: a class_map cell (set at registration)
+    if (variable_struct_exists(arg0, "gnx_milk_cmap") && arg0.gnx_milk_cmap)
+    {
+        // variable_struct_get gives undefined when there is no such entry
+        var _e = variable_struct_get(arg0.gnx_milk_bc, string(arg1));
+
+        if (_e == undefined)
+            _e = variable_struct_get(arg0.gnx_milk_bc, "default");
+
+        return (_e != undefined) ? _e : arg0.gnx_milk_none;
+    }
+
+    if (variable_struct_exists(arg0, "gnx_milk_def"))
+        return arg0.gnx_milk_def;
+
+    return { spr: arg0.gnx_milk_spr, clock: arg0.gnx_milk_clock, n: arg0.gnx_milk_n };
+}
