+    for (var _mi = 0; _mi < array_length(global.gnx_tool_registry); _mi++)
+    {
+        var _reg = global.gnx_tool_registry[_mi];
+        
+        for (var _ci = 0; _ci < array_length(_reg.categories); _ci++)
