diff -uN gml_138/gml_GlobalScript_s_gnx_props.gml gml/gml_GlobalScript_s_gnx_props.gml
--- gml_138/gml_GlobalScript_s_gnx_props.gml	1970-01-01 01:00:00.000000000 +0100
