+// Mav (1.4.7.5): CUSTOM build list: is the cell from a mod (vanilla cells are 1-42)
+function gnx_is_mod_cell(arg0)
+{
+    return is_real(arg0) && arg0 > 42;
+}
+
+// Mav (1.4.7.5): CUSTOM build list: copy of an unlock list without mod cells (those are only in CUSTOM)
+function gnx_unlock_vanilla(arg0)
+{
+    var _out = [];
+
+    if (!is_array(arg0))
+        return _out;
+
+    for (var i = 0; i < array_length(arg0); i++)
+    {
+        if (!gnx_is_mod_cell(arg0[i]))
+            array_push(_out, arg0[i]);
+    }
+
+    return _out;
+}
+
+// Mav (1.4.7.5): CUSTOM build list: slot size for a cell: 0 small, 1 big, 2 tentacle, 6 XL, -1 = not unlocked
+function gnx_custom_cell_slot_type(arg0)
+{
+    var _u = global.unlock;
+
+    if (array_contains(_u.breed, arg0) || array_contains(_u.utility, arg0) || array_contains(_u.pleasure, arg0))
+        return 0;
+
+    if (array_contains(_u.b_breed, arg0) || array_contains(_u.b_utility, arg0) || array_contains(_u.b_other, arg0))
+        return 1;
+
+    if (array_contains(_u.t_breed, arg0) || array_contains(_u.t_utility, arg0))
+        return 2;
+
+    if (array_contains(_u.xl_breed, arg0))
+        return 6;
+    
+    // GNX-UG: underground cells are built on a big (77 px) slot
+    if (variable_struct_exists(_u, "ug_breed") && array_contains(_u.ug_breed, arg0))
+        return 1;
+    
+    return -1;
+}
+
+// Mav (1.4.7.5): CUSTOM build list: unlocked mod cells (small, big, tentacle, XL, in that order).
+// arg0 = the pillar the menu was opened from; XL cells are left out when the floor has no room for one
+function gnx_custom_cells_list(arg0)
+{
+    var _u = global.unlock;
+    // GNX-UG: underground cells are listed last (index 9)
+    var _src = [_u.breed, _u.utility, _u.pleasure, _u.b_breed, _u.b_utility, _u.b_other, _u.t_breed, _u.t_utility, _u.xl_breed, variable_struct_exists(_u, "ug_breed") ? _u.ug_breed : []];
+    var _xl_room = true;
+
+    if (arg0 != -1 && instance_exists(arg0))
+        _xl_room = (global.slot_x[arg0.slot_data.slot_floor] + 162) <= room_width;
+
+    var _out = [];
+
+    for (var a = 0; a < array_length(_src); a++)
+    {
+        var _arr = _src[a];
+
+        for (var i = 0; i < array_length(_arr); i++)
+        {
+            var _h = _arr[i];
+
+            if (!gnx_is_mod_cell(_h) || array_contains(_out, _h))
+                continue;
+
+            if (a == 8 && !_xl_room)
+                continue;
+
+            array_push(_out, _h);
+        }
+    }
+
+    return _out;
+}
+
+// unlocked mod cells that fit the empty slot arg0 (its slot_type: 0 small, 1 big, 2 tentacle, 6 XL), for the
+// CUSTOM entry of an empty slot's category menu (the cell goes into this slot; no new slot is built)
+function gnx_custom_cells_for_slot(arg0)
+{
+    var _out = [];
+
+    if (arg0 == -1 || !instance_exists(arg0))
+        return _out;
+
+    var _all = gnx_custom_cells_list(-1);
+
+    for (var i = 0; i < array_length(_all); i++)
+    {
+        if (gnx_custom_cell_slot_type(_all[i]) == arg0.slot_data.slot_type)
+            array_push(_out, _all[i]);
+    }
+
+    return _out;
+}
+
+// the empty slot's category menu: one more entry (CUSTOM) when mod cells fit it
+function gnx_slot_menu_extra(arg0)
+{
+    return (array_length(gnx_custom_cells_for_slot(arg0)) > 0) ? 1 : 0;
+}
+
+// Mav (1.4.7.5): CUSTOM build list: a list button = the usual cell button (name, income info)
+// + the price of a slot of its size, because the cell is built together with a new slot
+function scr_create_gnx_custom_cell_button()
+{
+    scr_create_slot_type_button();
+    var _st = gnx_custom_cell_slot_type(button_num);
+
+    if (_st != -1)
+    {
+        var _sd = scr_slot_type_price_data(_st);
+        price += _sd.price;
+    }
+}
