+        var _e = _cp.mon_placements[p];
+        var _ok = [];
+        
+        if (is_array(_e))
+        {
+            for (var i = 0; i < array_length(_e); i++)
+            {
+                var _v = gnx_json_num(_e[i], -1);
+                
+                if (!(_v >= 0 && _v <= 3 && _v == floor(_v)))
+                    gnx_report_mod_error("Cell '" + string(arg1) + "': mon_placements[" + string(p) + "] entry " + string(_e[i]) + " is no species (0-3); left out");
+                else if (is_array(_mt) && !array_contains(_mt, _v))
+                    gnx_report_mod_error("Cell '" + string(arg1) + "': mon_placements[" + string(p) + "] has species " + string(_v) + ", which is not in mon_types (it would be invisible); left out");
+                else
+                    array_push(_ok, _v);
+            }
+        }
+        
+        if (array_length(_ok) == 0)
+        {
+            _ok = is_array(_mt) ? _mt : [0];
+            gnx_report_mod_error("Cell '" + string(arg1) + "': mon_placements[" + string(p) + "] has no species; " + string(_ok) + " is used");
+        }
+        
+        array_push(_mp, _ok);
+    }
+    
+    var _max = max(0, floor(gnx_json_num(_cp.max_mon_num, 1)));
+    
+    // GNX-FIX: exactly one place per monster the cell takes: places past max_mon_num were chosen but never
+    // counted as arrived (scr_mon_contact counts 0 .. max_mon_num - 1), so the cell could wait for good;
+    // missing places get mon_types (or goblins). Both said in the log (audit 16, B)
+    if (array_length(_mp) != _max)
+    {
+        var _was = array_length(_mp);
+        
+        if (_was > _max)
+            array_resize(_mp, _max);
+        
+        while (array_length(_mp) < _max)
+            array_push(_mp, is_array(_mt) ? _mt : [0]);
+        
+        var _l = gnx_log_open();
+        gnx_log_write(_l, "[GNX-WARN] cell '" + _who + "': mon_placements has " + string(_was) + " places, max_mon_num is " + string(_max) + "; " + ((_was > _max) ? ("places " + string(_max) + "-" + string(_was - 1) + " are left out") : ("places " + string(_was) + "-" + string(_max - 1) + " take " + string(is_array(_mt) ? _mt : [0]))) + "\n");
+        gnx_log_close(_l);
+    }
+    
+    _cp.mon_placements = _mp;
+}
+
+
+/// GNX-FIX: a true / false from JSON (arg0). This game's json_parse gives JSON true and false as the
+/// numbers 1 and 0, not as GML booleans, so is_bool() is false for them; this accepts a boolean, 1 / 0, or
+/// the text "true" / "false". Anything else is a mod error naming arg2 (who) and arg3 (key) and gives arg1.
+function gnx_json_bool(arg0, arg1, arg2, arg3)
+{
+    // is_numeric is also true for a GML boolean; == 1 / == 0 then match true / false
+    if (is_numeric(arg0))
+    {
+        if (arg0 == 1)
+            return true;
+        
+        if (arg0 == 0)
+            return false;
+    }
+    else if (is_string(arg0))
+    {
+        var _l = string_lower(arg0);
+        
+        if (_l == "true")
+            return true;
+        
+        if (_l == "false")
+            return false;
+    }
+    
+    gnx_report_mod_error(gnx_err_who(arg2) + ": " + string(arg3) + " must be true or false, not " + string(arg0) + "; " + (arg1 ? "true" : "false") + " is used");
+    return arg1;
+}
+
+
+/// GNX-FIX: reads a number from a JSON value. A number stays as it is, a number written as text
+/// ("5", "-2.5") becomes a number, anything else (other text, a list, a struct, undefined) gives arg1.
+/// Used wherever a mod JSON value goes into arithmetic, so a typo logs instead of stopping the game.
+function gnx_json_num(arg0, arg1)
+{
+    // is_numeric = a real, an int or a bool; real() turns it into a plain number
+    if (is_numeric(arg0))
+        return real(arg0);
+    
+    // ! = not: anything that is not text has no number in it
+    if (!is_string(arg0))
+        return arg1;
+    
+    var _n = string_length(arg0);
+    var _digits = 0;
+    var _dots = 0;
+    
+    for (var i = 1; i <= _n; i++)
+    {
+        var _c = string_char_at(arg0, i);
+        
+        // || = or: a minus sign is allowed only as the first character
+        if (_c == "-" && i == 1)
+            continue;
+        
+        if (_c == ".")
+        {
+            _dots++;
+            continue;
+        }
+        
+        if (ord(_c) < ord("0") || ord(_c) > ord("9"))
+            return arg1;
+        
+        _digits++;
+    }
+    
+    // && = and: at least one digit and at most one dot, otherwise real() would stop the game
+    if (_digits > 0 && _dots <= 1)
+        return real(arg0);
+    
+    return arg1;
+}
