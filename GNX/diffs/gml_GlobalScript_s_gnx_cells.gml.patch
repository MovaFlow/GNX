+
+/// GNX-FIX: runs in a cell: which of its places 0 .. arg0 - 1 a monster of h_unit_list holds, as a list of
+/// true / false. Monsters that are gone or have no place (-1) are skipped, so nothing is written outside
+/// the list.
+function gnx_places_taken(arg0)
+{
+    var _t = array_create(max(0, arg0), false);
+    
+    if (!is_array(h_unit_list))
+        return _t;
+    
+    for (var i = 0; i < array_length(h_unit_list); i++)
+    {
+        var _u = h_unit_list[i];
+        
+        if (!gnx_is_live_inst(_u) || !variable_instance_exists(_u, "mon_data") || !is_struct(_u.mon_data))
+            continue;
+        
+        var _pn = _u.mon_data.placement_num;
+        
+        // >= 0 && < arg0: a place inside the list
+        if (_pn >= 0 && _pn < arg0)
+            _t[_pn] = true;
+    }
+    
+    return _t;
+}
