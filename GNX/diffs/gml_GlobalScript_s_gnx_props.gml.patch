+/// GNX-FX: px below the floor line where squirt drops and drips of the calling slot's cell land
+/// (physical.fx_floor; underground cells land on their own floor). 0 = the floor line, as in vanilla.
+/// Called by the effect scripts with self = the slot (or a monster that shares its slot_data).
+function gnx_fx_floor()
+{
+    // ! = not, || = or: anything that is not a slot with a cell gets the vanilla line
+    if (!variable_instance_exists(id, "slot_data") || !is_struct(slot_data) || !variable_struct_exists(slot_data, "h_type"))
+        return 0;
+    
+    var _c = ds_map_find_value(global.cell_registry, slot_data.h_type);
+    return (_c != undefined && variable_struct_exists(_c.physical, "gnx_fx_floor")) ? _c.physical.gnx_fx_floor : 0;
+}
