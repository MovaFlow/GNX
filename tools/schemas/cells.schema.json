            "death_fix_inc": {
              "type": [
                "boolean",
                "integer"
              ]
            },
            "del_item_type": {
              "type": "number"
            }
          },
          "patternProperties": {
            "^_": {}
          },
          "additionalProperties": false,
          "description": "How the cell behaves (guide 9)."
        },
        "human_spr": {
          "type": "object",
          "description": "How the captive is drawn (guide 10.1): mode base+class (with base_body), fixed (phase tables) or class_map (default + classes).",
