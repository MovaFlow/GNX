+                    }
+                    
+                    break;
+                
+                case 11:
+                    if (_spr != -1 && _index == 0)
+                        gnx_draw_sprite(_spr, _final_index, x, y);
+                    
+                    break;
+                
+                case 12:
+                    if (_spr != -1 && slot_data.slot_dirt > 0)
+                    {
+                        var _slot_dirt = ceil(slot_data.slot_dirt) - 1;
+                        gnx_draw_sprite(_spr, _slot_dirt, x, y);
+                    }
+                    
+                    break;
+            }
+        }
+    }
+    
+    if (slot_data.sp_x != -1 && slot_data.anim_struct.sp_state != -1)
+        gnx_draw_sprite(sp_spr, slot_data.anim_struct.sp_index, x + slot_data.sp_x + (floor(slot_data.anim_struct.index) * slot_data.sp_anim_x), y + slot_data.sp_y[max(0, slot_data.anal)] + (floor(slot_data.anim_struct.index) * slot_data.sp_anim_y));
 }
