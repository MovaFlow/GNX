+// what is wrong with one frame of recorded GNX UI boxes: outside the "panel", two leaves overlapping,
+// or a box that only partly covers something (a box may hold others whole)
+function gnx_ui_layout_problems(arg0)
+{
+    var _out = [];
+    var _r = [];
+    var _seen = {};
+    var _pan = { x0: 0, y0: 0, x1: display_get_gui_width(), y1: display_get_gui_height() };
+
+    for (var _i = 0; _i < array_length(arg0); _i++)
+    {
+        var _a = arg0[_i];
+        var _key = _a.kind + _a.label + string(_a.x0) + "," + string(_a.y0) + "," + string(_a.x1) + "," + string(_a.y1);
+
+        if (variable_struct_exists(_seen, _key))
+            continue;  // drawn twice in the frame
+
+        variable_struct_set(_seen, _key, true);
+
+        if (_a.kind == "panel")
+            _pan = _a;
+        else
+            array_push(_r, _a);
+    }
+
+    for (var _i = 0; _i < array_length(_r); _i++)
+    {
+        var _a = _r[_i];
+
+        if (_a.x0 < _pan.x0 - 0.5 || _a.y0 < _pan.y0 - 0.5 || _a.x1 > _pan.x1 + 0.5 || _a.y1 > _pan.y1 + 0.5)
+            array_push(_out, "'" + _a.label + "' leaves the window");
+
+        for (var _j = _i + 1; _j < array_length(_r); _j++)
+        {
+            var _b = _r[_j];
+            var _ox = min(_a.x1, _b.x1) - max(_a.x0, _b.x0);
+            var _oy = min(_a.y1, _b.y1) - max(_a.y0, _b.y0);
+
+            if (_ox <= 1 || _oy <= 1)
+                continue;
+
+            var _a_holds = _a.kind == "box" && _b.x0 >= _a.x0 - 1 && _b.y0 >= _a.y0 - 1 && _b.x1 <= _a.x1 + 1 && _b.y1 <= _a.y1 + 1;
+            var _b_holds = _b.kind == "box" && _a.x0 >= _b.x0 - 1 && _a.y0 >= _b.y0 - 1 && _a.x1 <= _b.x1 + 1 && _a.y1 <= _b.y1 + 1;
+
+            if (!_a_holds && !_b_holds)
+                array_push(_out, "'" + _a.label + "' overlaps '" + _b.label + "' (" + string(_ox) + "x" + string(_oy) + ")");
+        }
+    }
+
+    return _out;
+}
