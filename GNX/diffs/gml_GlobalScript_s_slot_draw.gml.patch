+/// GNX-UG: draws the band floor (arg1) in place of the vanilla floor tile on a floor with an underground
+/// cell (arg0 = y of the floor tile, 174 + floor top). Tiled across the visible part of the room, one row:
+/// the sprite itself is as tall as the floor tile plus the extra band.
+function gnx_ug_draw_floor_band(arg0, arg1, arg2 = 0)
+{
+    var _spr = arg1;
+    var _w = gnx_sprite_get_width(_spr);
+    
+    // <= 0 : a broken sprite would make the loop below endless
+    if (_w <= 0)
+        exit;
+    
+    // GNX-FIX: the band has to reach the next floor's ceiling: 28 px of floor plus the extra band (arg2;
+    // the GNX band is 76 px for the default 48). A shorter one leaves a gap under it; the log says so
+    // once for each extra height, since a mod can give cells of other depths than the band was made for.
+    if (arg2 > 0 && gnx_sprite_get_height(_spr) < (28 + arg2))
+    {
+        if (!variable_global_exists("gnx_ug_band_warned") || !is_struct(global.gnx_ug_band_warned))
+            global.gnx_ug_band_warned = {};
+        
+        if (!variable_struct_exists(global.gnx_ug_band_warned, string(arg2)))
+        {
+            variable_struct_set(global.gnx_ug_band_warned, string(arg2), true);
+            var _bl = gnx_log_open();
+            gnx_log_write(_bl, "[GNX-UG] the floor band is " + string(gnx_sprite_get_height(_spr)) + " px tall, a floor with " + string(arg2) + " px extra needs " + string(28 + arg2) + " px (band_spr or gnx_ug_band.png); the rest stays uncovered\n");
+            gnx_log_close(_bl);
+        }
+    }
+    
+    var _vx = camera_get_view_x(view_camera[0]);
+    var _vy = camera_get_view_y(view_camera[0]);
+    var _vw = camera_get_view_width(view_camera[0]);
+    var _vh = camera_get_view_height(view_camera[0]);
+    
+    // floor far above or below the view: nothing to draw (150 px covers the sprite height)
+    if ((arg0 + 150) < _vy || arg0 > (_vy + _vh))
+        exit;
+    
+    // first tile column that touches the view (div = whole-number division)
+    var _x0 = max(0, (floor(_vx) div _w) * _w);
+    
+    for (var _xx = _x0; _xx < (_vx + _vw) && _xx < room_width; _xx += _w)
+        gnx_draw_sprite(_spr, 0, _xx, arg0);
+}
