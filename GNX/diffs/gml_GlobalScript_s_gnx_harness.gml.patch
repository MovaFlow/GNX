+// layout_check: GNX UI records the boxes it draws ("panel" = the window, "box" may hold others, "leaf" = text/icon)
+function gnx_ui_rect(arg0, arg1, arg2, arg3, arg4, arg5)  // kind, x0, y0, x1, y1, label
+{
+    if (is_array(global.gnx_ui_rects))
+        array_push(global.gnx_ui_rects, { kind: arg0, x0: arg1, y0: arg2, x1: arg3, y1: arg4, label: arg5 });
+}
