+
+            // POPRAWKA: nieznana cela -> komunikat zamiast blueprintu na nieistniejaca cele
+            if (_ht == -1 || !ds_map_exists(global.cell_registry, _ht))
+            {
+                scr_gnx_pop_up_create("Unknown cell (" + string(arg0.h_type) + "). Contact modder.");
+                break;
