+                        if (is_struct(_cs_v) && variable_struct_exists(_cs_v, "is_sprref"))
+                            _cs_t = "sprref";
+                        else if (!is_struct(_cs_v) && !is_array(_cs_v) && !is_string(_cs_v) && !is_undefined(_cs_v) && !is_bool(_cs_v) && sprite_exists(_cs_v))
+                            _cs_t = sprite_get_name(_cs_v);
+
+                        _cs_m += " " + _cs_k[_csi] + "=" + _cs_t;
+                    }
+                }
+
+                var _cs_near = "";
+
+                with (obj_mon)
+                {
+                    if (abs(x - (_cs_c.x + _cs_c.image_xscale * 0.5)) < 60 && abs(y - _cs_c.y) < 20)
+                        _cs_near += " [mon " + string(real(id)) + " type=" + string(mon_data.mon_type) + " state=" + string(variable_struct_exists(mon_data, "mon_state") ? mon_data.mon_state : -9) + " in_list=" + string(array_contains(_cs_c.h_unit_list, id)) + " spr=" + (sprite_exists(sprite_index) ? sprite_get_name(sprite_index) : "-") + " draw=" + string(scr_mon_draw) + " dx=" + string(floor(x - _cs_c.x)) + "]";
+                }
+
+                var _cs_cov = "";
+                var _cs_ck = ds_map_find_first(global.gnx_cov);
+
+                while (_cs_ck != undefined)
+                {
+                    _cs_cov += " " + string(_cs_ck) + "=" + string(ds_map_find_value(global.gnx_cov, _cs_ck));
+                    _cs_ck = ds_map_find_next(global.gnx_cov, _cs_ck);
+                }
+
+                gnx_scn_log("cell_state cov:" + _cs_cov);
+                gnx_scn_log("cell_state h=" + string(_st.cell_state) + " near:" + _cs_near);
+                gnx_scn_log("cell_state h=" + string(_st.cell_state) + " mon spr:" + _cs_m);
+
+                if (variable_struct_exists(_st, "hide_mons") && _st.hide_mons)  // screenshot without the cell's monsters
+                {
+                    for (var _csh = 0; _csh < array_length(_cs_c.h_unit_list); _csh++)
+                    {
+                        if (instance_exists(_cs_c.h_unit_list[_csh]))
+                            _cs_c.h_unit_list[_csh].visible = false;
+                    }
+                }
+                gnx_scn_log("cell_state h=" + string(_st.cell_state) + " char_state=" + string(_cs_c.slot_data.anim_struct.char_state) + " h_step=" + string(_cs_c.slot_data.h_step) + " spr_type=" + string(_cs_c.slot_data.anim_struct.spr_type) + " index=" + string_format(_cs_c.slot_data.anim_struct.index, 1, 2) + " mons=" + string(array_length(_cs_c.h_unit_list)) + " class=" + string(_cs_c.unit_data.class) + " leg=" + string(_cs_c.unit_data.leg) + " cov body.miss=" + string(ds_map_exists(global.gnx_cov, "body.miss") ? ds_map_find_value(global.gnx_cov, "body.miss") : 0) + " body.leg=" + string(ds_map_exists(global.gnx_cov, "body.leg") ? ds_map_find_value(global.gnx_cov, "body.leg") : 0) + " body.cls=" + string(ds_map_exists(global.gnx_cov, "body.cls") ? ds_map_find_value(global.gnx_cov, "body.cls") : 0));
+            }
+        }
+        else if (variable_struct_exists(_st, "log"))
+        {
+            gnx_scn_log("note " + string(_st.log));
+        }
+        else
+        {
+            scr_gnx_scn_check("step", false, "unknown step #" + string(_s.idx - 1) + " " + json_stringify(_st));
+        }
+    }
+
+    scr_gnx_scn_finish();
+}
