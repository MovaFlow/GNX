+        _sub = 0;
+        _sx = _f.x;
+        _sy = _f.y;
+        _w = _f.w;
+        _h = _f.h;
+        _xo = arg0.xo;
+        _yo = arg0.yo;
+    }
+    else
+    {
+        if (is_sprref(arg0))
+            _src = arg0.spr;
+
+        // ! = not, || = or: skip anything that is not an existing sprite
+        if ((!is_real(_src) && !is_handle(_src)) || !sprite_exists(_src))
+            exit;
+
+        _w = sprite_get_width(_src);
+        _h = sprite_get_height(_src);
+        _xo = sprite_get_xoffset(_src);
+        _yo = sprite_get_yoffset(_src);
