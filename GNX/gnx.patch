+{
+    if (!variable_instance_exists(id, "gnx_prop_react") || !is_struct(gnx_prop_react))
+        exit;
+    
+    var _r = gnx_prop_react;
+    // the side it listens to; 2 = "facing": right, or left while the prop is mirrored (image_xscale < 0)
+    var _want = _r.side;
+    
+    if (_want == 2)
+        _want = (image_xscale < 0) ? -1 : 1;
+    
+    // 0 = both sides; otherwise != = the event came from the other side
