+    var _seen = {};
+    var _cur = global.gnx_active_map;
+
+    if (!global.gnx_multimap_enabled)
+        return _out;
+
+    if (_cur != "vanilla")
+    {
+        var _home = "Village";
+
+        for (var _i = 0; _i < array_length(global.gnx_travel_locations); _i++)
+        {
+            var _r = global.gnx_travel_locations[_i];
