+        if (_homeless > 0)
+            scr_gnx_pop_up_create(string(_homeless) + " prisoner(s) had no free prison slot and were let go.");
+    }
+
+    global.gnx_carry_troops = -1;
+    global.gnx_carry_captives = -1;
