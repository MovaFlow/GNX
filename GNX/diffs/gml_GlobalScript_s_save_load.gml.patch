+            // potwor musi istniec i nalezec do tej celi (odpiety/odeslany gdzie indziej tez zwalnia miejsce)
+            if (!gnx_mon_ref_ok(_pm, id))
+            {
+                slot_data.mon_placement[_pi] = -1;
+                gnx_slot_reset_place_timer(_pi);
+            }
+        }
+    }
+
+    if (variable_instance_exists(id, "h_unit_list") && is_array(h_unit_list))
+    {
+        // od konca, bo array_delete przesuwa kolejne elementy
+        for (var _hi = array_length(h_unit_list) - 1; _hi >= 0; _hi--)
+        {
+            if (!gnx_is_live_inst(h_unit_list[_hi]))
+                array_delete(h_unit_list, _hi, 1);
+        }
+    }
+}
+
+// Zeruje licznik zwolnionego miejsca w celi (self = obj_slot), tak jak wanilowe scr_remove_mon. arg0 = numer miejsca.
+function gnx_slot_reset_place_timer(arg0)
+{
+    if (variable_struct_exists(slot_data, "mon_timer") && is_array(slot_data.mon_timer) && arg0 < array_length(slot_data.mon_timer))
+        slot_data.mon_timer[arg0] = 0;
+}
