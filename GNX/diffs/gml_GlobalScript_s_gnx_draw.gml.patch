+// GNX: draw wrappers (atlas-aware SprRefs), sprite helpers
+// (moved out of s_initials.gml; the functions are global, callable from any script)
+
+/// GNX-PROP: an origin given by name (arg0) for a frame arg1 px wide (arg2 = false) or tall (true), as a
+/// number: "left" / "top" 0, "center" / "middle" the middle pixel (floor of half), "right" / "bottom" the
+/// far edge. arg3 = the sprite's name for the mod error; an unknown name gives 0.
+function gnx_origin_named(arg0, arg1, arg2, arg3)
+{
+    var _n = string_lower(arg0);
+    
+    // || = or: both words mean the middle on either axis
+    if (_n == "center" || _n == "middle")
+        return floor(arg1 / 2);
+    
+    if (_n == (arg2 ? "top" : "left"))
+        return 0;
+    
+    if (_n == (arg2 ? "bottom" : "right"))
+        return arg1;
+    
+    gnx_report_mod_error("Sprite '" + string(arg3) + "': " + (arg2 ? "yorig" : "xorig") + " must be a number or " + (arg2 ? "\"top\", \"middle\", \"bottom\"" : "\"left\", \"center\", \"right\"") + ", not " + string(arg0) + "; 0 is used");
+    return 0;
+}
