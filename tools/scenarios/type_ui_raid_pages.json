{
  "about": "Custom types P3: the raid window's category column has pages of 4 with arrows (interact 9065) when a custom type is unlocked. Page 1 holds wolf bear boar fox (4-7); fox is picked and dragged into the front row; a page change keeps the category; the LOAD FORMATION hover draws a saved fox row through the custom head branch; reopening the raid shows the category's page.",
  "fixture": "mid",
  "mods": ["tools/scenarios/mods/harness_type_a", "tools/scenarios/mods/harness_type_b", "tools/scenarios/mods/harness_type_c"],
  "seed": 5,
  "steps": [
    {"wait": 60},
    {"do": {"type": "spawn_mon", "species": "wolf", "amount": 10, "class": 0}},
    {"do": {"type": "spawn_mon", "species": "bear", "amount": 10, "class": 0}},
    {"do": {"type": "spawn_mon", "species": "boar", "amount": 10, "class": 0}},
    {"do": {"type": "spawn_mon", "species": "fox", "amount": 10, "class": 0}},
    {"open_raid": true},
    {"wait": 5},
    {"assert": "fn", "name": "gnx_scn_raid_cat_page", "args": [], "is": 0, "why": "category 0 opens on page 0"},
    {"assert": "fn", "name": "gnx_scn_raid_cats", "args": [], "is": "0 1 2 3", "why": "page 0 = the vanilla set"},
    {"press": {"type": 9065, "num": 1}},
    {"wait": 2},
    {"assert": "fn", "name": "gnx_scn_raid_cat_page", "args": [], "is": 1, "why": "next arrow"},
    {"assert": "fn", "name": "gnx_scn_raid_cats", "args": [], "is": "4 5 6 7", "why": "page 1 = wolf bear boar fox"},
    {"assert": "fn", "name": "gnx_scn_raid_cat", "args": [], "is": "goblin", "why": "a page change keeps the category"},
    {"layout_check": "raid_p1"},
    {"screenshot": "raid_p1"},
    {"press": {"type": 39, "num": 7}},
    {"wait": 2},
    {"assert": "fn", "name": "gnx_scn_raid_cat", "args": [], "is": "fox"},
    {"raid_stage": 0},
    {"wait": 10},
    {"raid_clear_formation": true},
    {"raid_formation": {"front": [[0, 5]], "cat": {"mon": "fox"}}},
    {"wait": 5},
    {"assert": "fn", "name": "gnx_scn_row_num", "args": [{"mon": "fox"}, 0], "is": 5, "why": "a fox head dragged into the front row"},
    {"press": {"type": 9065, "num": 0}},
    {"wait": 2},
    {"assert": "fn", "name": "gnx_scn_raid_cat_page", "args": [], "is": 0, "why": "prev arrow"},
    {"assert": "fn", "name": "gnx_scn_raid_cats", "args": [], "is": "0 1 2 3"},
    {"assert": "fn", "name": "gnx_scn_raid_cat", "args": [], "is": "fox", "why": "the category stays fox on page 0"},
    {"assert": "fn", "name": "gnx_scn_set_saved_row", "args": ["fox", 0, 5], "is": 1, "why": "a saved formation with a fox row (what case 62 writes)"},
    {"assert": "fn", "name": "gnx_scn_loadform_spy", "args": [], "is": 1, "why": "the LOAD FORMATION hover draws the fox head through the custom head branch"},
    {"open_raid": false},
    {"wait": 5},
    {"open_raid": true},
    {"wait": 5},
    {"assert": "fn", "name": "gnx_scn_raid_cat_page", "args": [], "is": 1, "why": "the raid reopens on the category's page"},
    {"assert": "fn", "name": "gnx_scn_raid_cats", "args": [], "is": "4 5 6 7"},
    {"assert": "button_var", "type": 39, "num": 7, "field": "image_index", "is": 1, "why": "fox stays highlighted"},
    {"assert": "button_var", "type": 9065, "num": 1, "field": "button_num", "is": 1, "why": "arrows again after a reopen"},
    {"screenshot": "raid_reopen"}
  ]
}
