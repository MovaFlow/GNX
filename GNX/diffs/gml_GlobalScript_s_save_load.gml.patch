+        slot_data.load = false;
+        _cage_reset++;
+    }
+
+    global.gnx_last_cage_sweep = [_cage_kept, _cage_reset, _cage_dismissed];  // read by the scenario runner
+
+    if (_cage_kept + _cage_reset > 0)
+    {
+        if (_sweep_f == -1)
+            _sweep_f = file_text_open_append("gnx_debug.txt");
+
+        file_text_write_string(_sweep_f, "[GNX] SWEEP transfer cages: " + string(_cage_kept) + " kept, " + string(_cage_reset) + " restarted, " + string(_cage_dismissed) + " hobgoblin(s) dismissed");
+        file_text_writeln(_sweep_f);
+    }
+
+    var _carry_active = ds_map_create();
+
+    with (obj_mon)
+    {
+        if (variable_struct_exists(self, "mon_data") && is_struct(mon_data))
+        {
+            if (variable_struct_exists(mon_data, "carry_start_id") && mon_data.carry_start_id != -1 && instance_exists(mon_data.carry_start_id))
+                ds_map_add(_carry_active, mon_data.carry_start_id, true);
+
+            if (variable_struct_exists(mon_data, "carry_end_id") && mon_data.carry_end_id != -1 && instance_exists(mon_data.carry_end_id))
+                ds_map_add(_carry_active, mon_data.carry_end_id, true);
+        }
+    }
+
+    var _carry_reset = 0;
+
+    with (obj_slot)
+    {
+        if (variable_struct_exists(self, "slot_data") && is_struct(slot_data) && variable_struct_exists(slot_data, "carry") && (slot_data.carry || slot_data.load))
+        {
+            if (!ds_map_exists(_carry_active, id))
+            {
+                slot_data.carry = false;
+                slot_data.load = false;
+                _carry_reset++;
+            }
+        }
+    }
+
+    ds_map_destroy(_carry_active);
+
+    if (_carry_reset > 0)
+    {
+        if (_sweep_f == -1)
+            _sweep_f = file_text_open_append("gnx_debug.txt");
+
+        file_text_write_string(_sweep_f, "[GNX] SWEEP reset stale carry/load flags on " + string(_carry_reset) + " slots");
+        file_text_writeln(_sweep_f);
+    }
+
+    if (_sweep_f != -1)
+    {
+        file_text_write_string(_sweep_f, "[GNX] SWEEP complete: " + string(_sweep_n) + " detached");
+        file_text_writeln(_sweep_f);
+        file_text_close(_sweep_f);
+    }
+    
+    return _load;
+}
