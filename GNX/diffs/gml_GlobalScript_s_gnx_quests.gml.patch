+/// GNX-BUILD: a cell of type arg0 was just built (build menu, CUSTOM, COPY DOWN). Counts it, refreshes the
+/// progress of build_count quests, then runs the cell_built triggers and quest checks, as these places did
+/// before.
+function gnx_cell_built(arg0)
+{
+    var _c = gnx_build_counts();
+    var _k = string(arg0);
+    // ? : one more for this type, and one more of any type ("all")
+    variable_struct_set(_c, _k, (variable_struct_exists(_c, _k) ? variable_struct_get(_c, _k) : 0) + 1);
+    variable_struct_set(_c, "all", (variable_struct_exists(_c, "all") ? variable_struct_get(_c, "all") : 0) + 1);
+    
+    // ds_exists: the quest list is there (it always is in a running game)
+    if (ds_exists(global.quest_list, ds_type_list))
+    {
+        for (var _i = 0; _i < ds_list_size(global.quest_list); _i++)
+        {
+            var _q = ds_list_find_value(global.quest_list, _i);
+            
+            // a GNX quest (vanilla quests have no gnx_event) that is not done yet
+            if (is_struct(_q) && variable_struct_exists(_q, "gnx_event") && !_q.quest_clear)
+                gnx_quest_build_text(_q);
+        }
+    }
+    
+    scr_gnx_check_triggers("cell_built");
+    scr_gnx_check_quest_completion("cell_built");
+}
