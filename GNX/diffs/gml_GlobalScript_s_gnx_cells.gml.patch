+/// GNX-UGREQ: what is wrong with one strip reference arg0 (a milk_spr phase value or an infant_spr) of a
+/// cell whose "sprites" block is arg1, in mod folder arg2 (with "/" at the end); arg3 = the names of the
+/// mod's atlas entries ({ name: true }, also in lower case; gnx_ug_atlas_names), undefined without an atlas.
+/// It looks where gnx_resolve_sprite_raw loads from, in the same order: the atlas (the file name without
+/// extension), then strip, a frames list, path, folder, from_game, or a plain file name. Returns "" when
+/// the reference can load, else the problem as text. Read from the JSON before the mod loads.
+function gnx_ug_ref_problem(arg0, arg1, arg2, arg3)
+{
+    // is_real: a sprite written as a number, as gnx_resolve_layer_sprite takes it; -1 = none on purpose
+    if (is_real(arg0))
+        return (arg0 == -1 || sprite_exists(arg0)) ? "" : ("is " + string(arg0) + ", no sprite of the game");
+    
+    // ! = not: anything else must be text, "gnx:<key>" for the cell's own sprite or a game sprite's name
+    if (!is_string(arg0))
+        return "is " + string(arg0) + ", not a sprite name";
+    
+    // string_copy(text, 1, 4): its first 4 characters
+    if (string_copy(arg0, 1, 4) != "gnx:")
+    {
+        // asset_get_index: the game's own sprite of that name (-1 = none)
+        var _a = asset_get_index(arg0);
+        return (_a >= 0 && sprite_exists(_a)) ? "" : ("'" + arg0 + "' is no game sprite");
+    }
+    
+    // string_delete(text, 1, 4): the text without "gnx:"
+    var _k = string_delete(arg0, 1, 4);
+    
+    // || = or: no sprites block, or no such entry in it
+    if (!is_struct(arg1) || !variable_struct_exists(arg1, _k))
+        return "'" + arg0 + "' is not in the cell's sprites block";
+    
+    var _d = variable_struct_get(arg1, _k);
+    
+    // the atlas first, by the file name without extension, as gnx_atlas_resolve_ref finds it
+    if (arg3 != undefined)
+    {
+        var _stem = "";
+        
+        if (!is_struct(_d))
+            _stem = string(_d);
+        else if (variable_struct_exists(_d, "strip"))
+            _stem = string(_d.strip);
+        else if (variable_struct_exists(_d, "path"))
+            _stem = string(_d.path);
+        else if (variable_struct_exists(_d, "frames") && is_array(_d.frames) && array_length(_d.frames) > 0)
+            _stem = string(_d.frames[0]);
+        else if (variable_struct_exists(_d, "folder"))
+            _stem = string(_d.folder);
+        
+        if (_stem != "")
+        {
+            // filename_name: the name without folders; filename_change_ext(.., ""): without ".png"
+            _stem = filename_change_ext(filename_name(_stem), "");
+            
+            if (variable_struct_exists(arg3, _stem) || variable_struct_exists(arg3, string_lower(_stem)))
+                return "";
+        }
+    }
+    
+    // not in the atlas: the file on disk, in the loader's order
+    if (!is_struct(_d))
+        return file_exists(arg2 + string(_d)) ? "" : ("sprites." + _k + ": file '" + string(_d) + "' not found");
+    
+    if (variable_struct_exists(_d, "strip"))
+        return file_exists(arg2 + string(_d.strip)) ? "" : ("sprites." + _k + ": strip '" + string(_d.strip) + "' not found");
+    
+    // "frames": [files] = one PNG per frame
+    if (variable_struct_exists(_d, "frames") && is_array(_d.frames))
+    {
+        if (array_length(_d.frames) == 0)
+            return "sprites." + _k + ": the frames list is empty";
+        
+        for (var i = 0; i < array_length(_d.frames); i++)
+        {
+            if (!file_exists(arg2 + string(_d.frames[i])))
+                return "sprites." + _k + ": frame file '" + string(_d.frames[i]) + "' not found";
+        }
+        
+        return "";
+    }
+    
+    if (variable_struct_exists(_d, "path"))
+        return file_exists(arg2 + string(_d.path)) ? "" : ("sprites." + _k + ": path '" + string(_d.path) + "' not found");
+    
+    // "folder": numbered PNGs in that folder of the mod, else in strips/<folder>, as the loader looks
+    if (variable_struct_exists(_d, "folder"))
+    {
+        var _fdir = arg2 + string(_d.folder) + "/";
+        
+        if (!directory_exists(_fdir) && directory_exists(arg2 + "strips/" + string(_d.folder)))
+            _fdir = arg2 + "strips/" + string(_d.folder) + "/";
+        
+        // file_find_first gives the first .png there, "" = none
+        var _png = file_find_first(_fdir + "*.png", 0);
+        file_find_close();
+        return (_png != "") ? "" : ("sprites." + _k + ": folder '" + string(_d.folder) + "' has no .png frames");
+    }
+    
+    // "from_game" (+ "index"): a frame of a game sprite
+    if (variable_struct_exists(_d, "from_game"))
+    {
+        var _g = asset_get_index(string(_d.from_game));
+        return (_g >= 0 && sprite_exists(_g)) ? "" : ("sprites." + _k + ": from_game '" + string(_d.from_game) + "' is no game sprite");
+    }
+    
+    return "sprites." + _k + " has no strip, frames, path, folder or from_game";
+}
