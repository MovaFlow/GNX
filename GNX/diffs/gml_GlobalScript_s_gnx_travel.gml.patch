+            instance_destroy();
+    }
+
+    var _fx = instance_create_depth(0, 0, -9990, obj_empty);
+
+    with (_fx)
+    {
+        gnx_travel_fx = true;
+        persistent = true;
+        gui = true;
+        target = arg0;
+        label = arg1;
+        phase = 0;
+        t = 0;
+        walk = 0;
+        scr_empty_step = scr_gnx_travel_fx_step;
+        scr_empty_draw = scr_gnx_travel_fx_draw;
+    }
+
+    global.click_lock = true;
+}
