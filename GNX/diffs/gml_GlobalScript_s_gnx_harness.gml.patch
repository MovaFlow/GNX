+function scr_gnx_scn_state()
+{
+    var _hist = {};
+
+    with (obj_slot)
+    {
+        // not every slot kind carries h_type (e.g. stair/corridor slots)
+        var _k = "t" + string(variable_struct_exists(slot_data, "slot_type") ? slot_data.slot_type : "?") + "h" + string(variable_struct_exists(slot_data, "h_type") ? slot_data.h_type : "-");
+        variable_struct_set(_hist, _k, (variable_struct_exists(_hist, _k) ? variable_struct_get(_hist, _k) : 0) + 1);
+    }
+
+    var _names = variable_struct_get_names(_hist);
+    array_sort(_names, true);
+    var _hs = "";
+
+    for (var _i = 0; _i < array_length(_names); _i++)
+        _hs += (_names[_i] + "x" + string(variable_struct_get(_hist, _names[_i])) + " ");
+
+    var _gob = 0;  // goblin troops, summed like the travel selector does
+    
+    for (var _gi = 0; _gi < array_length(global.val.goblin.num); _gi++)
+    {
+        if (global.val.goblin.num[_gi] != -1)
+            _gob += global.val.goblin.num[_gi];
+    }
+    
+    var _prisoners = 0;
+
+    with (obj_slot)
+    {
+        if (is_struct(unit_data))
+            _prisoners++;
+    }
+
+    // interact_type 20 = unit button; follow=true while it sits in a cell (vanilla drag_type 2)
+    var _ubtn = 0;
+    var _ubtn_follow = 0;
+
+    with (obj_button)
+    {
+        if (interact_type == 20)
+        {
+            _ubtn++;
+
+            if (follow)
+                _ubtn_follow++;
+        }
+    }
+
+    // raid progress: per stage max/selected level and the class ids of each level's encounter
+    var _stg = "";
+
+    for (var _si = 0; _si < array_length(global.val.stage_info); _si++)
+    {
+        var _sti = global.val.stage_info[_si];
+        _stg += string(_si) + ":";
+
+        if (_sti == -1)
+        {
+            _stg += "- ";
+            continue;
+        }
+
+        _stg += string(_sti.max_lvl) + "/" + string(global.val.stage_lvl_sel[_si]) + "[";
+
+        for (var _li = 0; _li < array_length(_sti.info); _li++)
+        {
+            if (!is_struct(_sti.info[_li]))
+                continue;
+
+            var _ul = _sti.info[_li].unit_list;
+
+            for (var _ui = 0; _ui < array_length(_ul); _ui++)
+                _stg += string(_ul[_ui].class) + ",";
+
+            _stg += "|";
+        }
+
+        _stg += "] ";
+    }
+
+    return
+    {
+        active_map: global.gnx_active_map,
+        stages: _stg,
+        floor: global.val.floor,
+        slots: instance_number(obj_slot),
+        cells: _hs,
+        units: ds_list_size(global.unit_list),
+        prisoners: _prisoners,
+        unit_buttons: _ubtn,
+        unit_buttons_in_cells: _ubtn_follow,
+        mons: instance_number(obj_mon),
+        money: global.val.money,
+        food: global.val.food,
+        goblins: _gob,
+        day: global.val.day,
+        quests: ds_list_size(global.quest_list)
+    };
+}
+
+
+// Every follower must sit exactly where scr_main_end_step put it, on- or off-screen
+function scr_gnx_scn_follow_bad()
+{
+    var _bad = 0;
+    var _ex = "";
+
+    with (obj_button)
+    {
+        if (source_id != -1 && follow && instance_exists(source_id) && (abs(x - (source_id.x + shift_x)) > 1 || abs(y - (source_id.y + shift_y)) > 1))
+        {
+            _bad++;
+            _ex = "button it=" + string(interact_type) + " y=" + string(y) + " want=" + string(source_id.y + shift_y);
+        }
+    }
+
+    with (obj_mon)
+    {
+        if (mon_data.follow && mon_data.slot_id != -1 && instance_exists(mon_data.slot_id) && (abs(x - (mon_data.slot_id.x + (mon_data.x_shift * sign(image_xscale)))) > 1 || abs(y - (mon_data.slot_id.y + mon_data.y_shift)) > 1))
+        {
+            _bad++;
+            _ex = "mon y=" + string(y) + " want=" + string(mon_data.slot_id.y + mon_data.y_shift);
+        }
+    }
+
+    with (obj_tent)
+    {
+        if (instance_exists(source_id) && (abs(x - source_id.x) > 1 || abs(y - source_id.y) > 1))
+        {
+            _bad++;
+            _ex = "tent y=" + string(y) + " want=" + string(source_id.y);
+        }
+    }
+
+    with (obj_prop)
+    {
+        if (follow && slot_id != -1 && instance_exists(slot_id) && (abs(x - (slot_id.x + prop_data.shift_x)) > 1 || abs(y - (slot_id.y + prop_data.shift_y)) > 1))
+        {
+            _bad++;
+            _ex = "prop y=" + string(y) + " want=" + string(slot_id.y + prop_data.shift_y);
+        }
+    }
+
+    return [_bad, _ex];
+}
+
+
+// Progress signature of one occupied cell (call inside with(obj_slot)): everything slot step culling freezes
+function scr_gnx_scn_slot_sig()
+{
+    var _a = slot_data.anim_struct;
+    var _s = string(floor(_a.index)) + "|" + string(_a.char_state);
+
+    if (variable_struct_exists(slot_data, "h_step"))
+        _s += "|" + string(slot_data.h_step);
+
+    if (variable_struct_exists(slot_data, "h_loop"))
+        _s += "|" + string(slot_data.h_loop);
+
+    if (variable_struct_exists(unit_data, "preg_c"))
+        _s += "|" + string(unit_data.preg_c);
+
+    if (variable_struct_exists(unit_data, "milk"))
+        _s += "|" + string(unit_data.milk);
+
+    return _s;
+}
+
+
+// Occupied, animated cells outside the step-culling band (camera +-400), as {id: signature}
+function scr_gnx_scn_offscreen_sigs()
+{
+    var _vy = camera_get_view_y(view_camera[0]);
+    var _vh = camera_get_view_height(view_camera[0]);
+    var _out = {};
+
+    with (obj_slot)
+    {
+        if (is_struct(unit_data) && is_struct(slot_data.anim_struct) && (y < (_vy - 400) || y > (_vy + _vh + 400)))
+            variable_struct_set(_out, string(id), scr_gnx_scn_slot_sig());
+    }
+
+    return _out;
+}
