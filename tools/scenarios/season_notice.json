{
  "about": "A mod with active_dates and season_notice: until its first season it has no row in the MODS menu and is not counted, and its atlas is not loaded (it holds nothing but that art). The first season: the main menu shows the notice once; after it, also out of season, the row stays.",
  "start": "menu",
  "mods": [
    "tools/scenarios/mods/harness_season_notice",
    "tools/scenarios/mods/harness_req_base"
  ],
  "timeout": 120,
  "check_boot_suite": false,
  "steps": [
    {
      "menu_continue": 600
    },
    {
      "wait": 5
    },
    {
      "assert": "confirm",
      "open": false
    },
    {
      "assert": "fn",
      "name": "gnx_mods_on_text",
      "args": [],
      "is": " - 1 mod on",
      "why": "the hidden mod is not counted"
    },
    {
      "assert": "fn",
      "name": "gnx_scn_atlas_loaded",
      "args": [
        "harness_season_notice"
      ],
      "is": 0,
      "why": "out of season, nothing else in the mod uses it"
    },
    {
      "assert": "fn",
      "name": "gnx_scn_sprite_replaced",
      "args": [
        "spr_h_lilith_hand_c"
      ],
      "is": 0
    },
    {
      "assert": "fn",
      "name": "gnx_atlas_out_of_season",
      "args": [
        {
          "active_dates": [
            "02-29",
            "02-29"
          ],
          "_about": "x",
          "sprite_replace": {}
        },
        "x"
      ],
      "is": 1,
      "why": "only the art of its dates"
    },
    {
      "assert": "fn",
      "name": "gnx_atlas_out_of_season",
      "args": [
        {
          "active_dates": [
            "02-29",
            "02-29"
          ],
          "props": "props.json"
        },
        "x"
      ],
      "is": 0,
      "why": "other content may draw from the atlas"
    },
    {
      "press": {
        "type": 9070,
        "num": 0
      }
    },
    {
      "wait": 3
    },
    {
      "assert": "fn",
      "name": "gnx_scn_mod_row_text",
      "args": [
        "harness_season_notice"
      ],
      "is": "",
      "why": "no row before the first season"
    },
    {
      "assert": "fn",
      "name": "gnx_scn_mod_row_text",
      "args": [
        "harness_req_base"
      ],
      "is": "ON"
    },
    {
      "call": "gnx_scn_set_today",
      "args": [
        229
      ]
    },
    {
      "mod_toggle": "harness_req_base"
    },
    {
      "wait": 2
    },
    {
      "press": {
        "type": 9074,
        "num": 0
      }
    },
    {
      "wait": 120
    },
    {
      "menu_continue": 600
    },
    {
      "wait": 5
    },
    {
      "assert": "fn",
      "name": "gnx_scn_mod_row_text",
      "args": [
        "harness_season_notice"
      ],
      "is": "SEASON",
      "why": "in season: listed"
    },
    {
      "assert": "fn",
      "name": "gnx_scn_atlas_loaded",
      "args": [
        "harness_season_notice"
      ],
      "is": 1,
      "why": "in season: loaded"
    },
    {
      "assert": "fn",
      "name": "gnx_scn_sprite_replaced",
      "args": [
        "spr_h_lilith_hand_c"
      ],
      "is": 1
    },
    {
      "assert": "confirm",
      "open": false
    },
    {
      "press": {
        "type": 9075,
        "num": 0
      }
    },
    {
      "wait": 5
    },
    {
      "assert": "confirm",
      "open": true,
      "contains": "Art by nobody."
    },
    {
      "screenshot": "notice"
    },
    {
      "assert": "fn",
      "name": "gnx_scn_button_count",
      "args": [
        9070
      ],
      "is": 0,
      "why": "the menu's buttons wait for OK"
    },
    {
      "press": {
        "type": 9077,
        "num": 0
      }
    },
    {
      "wait": 5
    },
    {
      "assert": "confirm",
      "open": false
    },
    {
      "assert": "fn",
      "name": "gnx_scn_button_count",
      "args": [
        9070
      ],
      "is": 1,
      "why": "the menu is back"
    },
    {
      "press": {
        "type": 9070,
        "num": 0
      }
    },
    {
      "wait": 3
    },
    {
      "press": {
        "type": 9075,
        "num": 0
      }
    },
    {
      "wait": 5
    },
    {
      "assert": "confirm",
      "open": false,
      "why": "once only"
    },
    {
      "press": {
        "type": 9070,
        "num": 0
      }
    },
    {
      "wait": 3
    },
    {
      "call": "gnx_scn_set_today",
      "args": [
        601
      ]
    },
    {
      "mod_toggle": "harness_req_base"
    },
    {
      "wait": 2
    },
    {
      "press": {
        "type": 9074,
        "num": 0
      }
    },
    {
      "wait": 120
    },
    {
      "menu_continue": 600
    },
    {
      "wait": 5
    },
    {
      "assert": "fn",
      "name": "gnx_scn_mod_row_text",
      "args": [
        "harness_season_notice"
      ],
      "is": "SEASON",
      "why": "out of season again: the row stays, so it can be set to ALL YEAR"
    },
    {
      "assert": "fn",
      "name": "gnx_scn_sprite_replaced",
      "args": [
        "spr_h_lilith_hand_c"
      ],
      "is": 0
    },
    {
      "assert": "fn",
      "name": "gnx_mods_on_text",
      "args": [],
      "is": " - 2 mods on"
    },
    {
      "press": {
        "type": 9075,
        "num": 0
      }
    },
    {
      "wait": 5
    },
    {
      "assert": "confirm",
      "open": false
    },
    {
      "call": "gnx_scn_set_today",
      "args": [
        229
      ]
    },
    {
      "press": {
        "type": 9070,
        "num": 0
      }
    },
    {
      "wait": 3
    },
    {
      "mod_toggle": "harness_req_base"
    },
    {
      "wait": 2
    },
    {
      "press": {
        "type": 9074,
        "num": 0
      }
    },
    {
      "wait": 120
    },
    {
      "menu_continue": 600
    },
    {
      "wait": 5
    },
    {
      "assert": "fn",
      "name": "gnx_scn_sprite_replaced",
      "args": [
        "spr_h_lilith_hand_c"
      ],
      "is": 1
    },
    {
      "press": {
        "type": 9075,
        "num": 0
      }
    },
    {
      "wait": 5
    },
    {
      "assert": "confirm",
      "open": false,
      "why": "not shown again in the next season"
    }
  ]
}
