+// main menu (load_state 4, after the vanilla buttons): MODS goes third, the column moves up to fit five
+function scr_gnx_menu_add_mods_button()
+{
+    with (obj_button)
+    {
+        if (interact_type == 51)
+        {
+            var _dy = (button_num <= 1) ? -10 : 10;
+            y += _dy;
+
+            if (variable_instance_exists(id, "yto"))
+                yto += _dy;
+
+            if (variable_instance_exists(id, "ystart"))
+                ystart += _dy;
+        }
+    }
+
+    scr_create_button(240, 211, 0, spr_button_menu, 9070, id, scr_create_menu_button, -1, scr_gnx_draw_label_button, 0, 0);
+
+    with (obj_button)
+    {
+        if (interact_type == 9070)
+            text = "MODS";
+    }
+
+    if (variable_global_exists("gnx_reopen_mod_menu") && global.gnx_reopen_mod_menu)
+    {
+        global.gnx_reopen_mod_menu = false;
+        scr_gnx_open_mod_menu();
+    }
+}
