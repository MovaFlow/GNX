{
  "about": "The complex-tier travel selector driven like a player: the stand-in mouse (gnx_mx/gnx_my/gnx_mb) drags prisoners into the destination's free slots, clicks one, clicks a taken one back out, and tries to overfill; the troop amount goes through the game's own number pad (+10 x4, OK). layout_check records one frame of the selector's drawing on every tab and fails on overlapping text/icons or anything outside the window.",
  "fixture": "mid",
  "mods": [
    "tools/scenarios/mods/harness_map_c"
  ],
  "timeout": 120,
  "steps": [
    {
      "wait": 60
    },
    {
      "do": {
        "type": "spawn_mon",
        "species": 0,
        "class": 1,
        "amount": 60
      },
      "why": "enough goblins of kind 1 for the number pad's +10 x4 (the 'mid' fixture has few)"
    },
    {
      "open_selector": "harness_c"
    },
    {
      "wait": 3
    },
    {
      "assert": "selector",
      "tier": 2
    },
    {
      "layout_check": "basic"
    },
    {
      "screenshot": "basic"
    },
    {
      "press_travel_button": {
        "num": 41
      },
      "why": "TROOPS tab"
    },
    {
      "wait": 3
    },
    {
      "layout_check": "troops"
    },
    {
      "press_travel_button": {
        "num": 71
      },
      "why": "take goblin kind 1: the number pad"
    },
    {
      "wait": 3
    },
    {
      "press": {
        "type": 29,
        "num": 3
      }
    },
    {
      "press": {
        "type": 29,
        "num": 3
      }
    },
    {
      "press": {
        "type": 29,
        "num": 3
      }
    },
    {
      "press": {
        "type": 29,
        "num": 3
      }
    },
    {
      "press": {
        "type": 29,
        "num": 4
      },
      "why": "OK"
    },
    {
      "wait": 3
    },
    {
      "assert": "selector",
      "party": 40
    },
    {
      "layout_check": "troops_party"
    },
    {
      "screenshot": "troops_party"
    },
    {
      "press_travel_button": {
        "num": 42
      },
      "why": "CAPTIVES tab"
    },
    {
      "wait": 3
    },
    {
      "layout_check": "captives"
    },
    {
      "mouse_drag": {
        "from": {
          "captive": 0
        },
        "to": {
          "slot": 0
        },
        "frames": 8
      }
    },
    {
      "wait": 2
    },
    {
      "assert": "selector",
      "captives": 1,
      "why": "dragged into a slot"
    },
    {
      "mouse_drag": {
        "from": {
          "captive": 1
        },
        "to": [
          100,
          120
        ],
        "frames": 8
      }
    },
    {
      "wait": 2
    },
    {
      "assert": "selector",
      "captives": 1,
      "why": "dropped outside the slots: stays here"
    },
    {
      "mouse_click": {
        "captive": 2
      }
    },
    {
      "wait": 2
    },
    {
      "assert": "selector",
      "captives": 2,
      "why": "a click sends it to the next free slot"
    },
    {
      "mouse_click": {
        "slot": 0
      }
    },
    {
      "wait": 2
    },
    {
      "assert": "selector",
      "captives": 1,
      "why": "clicking a taken one puts it back"
    },
    {
      "mouse_drag": {
        "from": {
          "captive": 3
        },
        "to": {
          "slot": 1
        },
        "frames": 6
      }
    },
    {
      "mouse_drag": {
        "from": {
          "captive": 4
        },
        "to": {
          "slot": 2
        },
        "frames": 6
      }
    },
    {
      "mouse_drag": {
        "from": {
          "captive": 5
        },
        "to": {
          "slot": 3
        },
        "frames": 6
      }
    },
    {
      "mouse_drag": {
        "from": {
          "captive": 6
        },
        "to": {
          "slot": 4
        },
        "frames": 6
      }
    },
    {
      "mouse_drag": {
        "from": {
          "captive": 7
        },
        "to": {
          "slot": 4
        },
        "frames": 6
      }
    },
    {
      "wait": 2
    },
    {
      "assert": "selector",
      "captives": 5,
      "why": "a new map has 5 free slots: the sixth is refused"
    },
    {
      "layout_check": "captives_full"
    },
    {
      "screenshot": "captives_full"
    },
    {
      "press_travel_button": {
        "num": 20
      }
    },
    {
      "wait": 3
    },
    {
      "assert": "selector",
      "open": false
    }
  ]
}
