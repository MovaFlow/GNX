+            
+            // every digit gets the same width (the widest of 0-9), so the number does not jump about
+            for (var i = 0; i < 10; i++)
+            {
+                _c.dig_w = max(_c.dig_w, gnx_sprite_get_width(_ds, i));
+                _c.dig_h = max(_c.dig_h, gnx_sprite_get_height(_ds, i));
