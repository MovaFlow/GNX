+/// GNX-PROP: a 1 x 1 white sprite, made once: the "source" of a ringed point light (a disk grown from one
+/// pixel, just as a ring round a mask is grown from the mask)
+function gnx_pixel_sprite()
+{
+    if (variable_global_exists("gnx_px_spr") && sprite_exists(global.gnx_px_spr))
+        return global.gnx_px_spr;
+    
+    var _sf = surface_create(1, 1);
+    surface_set_target(_sf);
+    draw_clear_alpha(c_white, 1);
+    surface_reset_target();
+    global.gnx_px_spr = sprite_create_from_surface(_sf, 0, 0, 1, 1, false, false, 0, 0);
+    surface_free(_sf);
+    return global.gnx_px_spr;
+}
