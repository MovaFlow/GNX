+// buffered like the debug log (gnx_log_flush writes both once per frame and before game_end)
+function gnx_scn_log(arg0)
+{
+    if (!variable_global_exists("gnx_scn_buf"))
+        global.gnx_scn_buf = "";
+
+    global.gnx_scn_buf += "[GNX-SCN] " + string(arg0) + chr(10);
+}
+
+
+function scr_gnx_scn_start(arg0)
+{
+    if (file_exists("gnx_scenario.txt"))
+        file_delete("gnx_scenario.txt");
+
+    global.gnx_scn_buf = "";
+
+    var _path = program_directory + "GNX_scenarios/" + arg0 + ".json";
+    var _data = undefined;
+
+    if (file_exists(_path))
+    {
+        var _f = file_text_open_read(_path);
+        var _raw = "";
+
+        while (!file_text_eof(_f))
+            _raw += file_text_readln(_f);
+
+        file_text_close(_f);
+
+        try
+        {
+            _data = json_parse(_raw);
+        }
+        catch (_e)
+        {
+            _data = undefined;
+        }
+    }
+
+    if (!is_struct(_data) || !variable_struct_exists(_data, "steps") || !is_array(_data.steps))
+    {
+        gnx_scn_log("FAIL load cannot read steps from " + _path);
+        gnx_scn_log("DONE 0/1 passed");
+        gnx_log_flush();
+        game_end();
+        return false;
+    }
+
+    global.gnx_scn =
+    {
+        name: arg0,
+        steps: _data.steps,
+        idx: 0,
+        wait: 0,
+        awaiting: false,
+        prog_last: 0,
+        until_left: -1,
+        pass: 0,
+        fail: 0,
+        snaps: {},
+        frame_n: 0,
+        draw_always: variable_struct_exists(_data, "draw_always") && _data.draw_always
+    };
+    gnx_scn_log("START " + arg0 + " steps=" + string(array_length(_data.steps)));
+
+    // Frame-based game logic: uncap the frame rate so long waits finish fast
+    if (!variable_struct_exists(_data, "realtime") || !_data.realtime)
+        game_set_speed(1000, gamespeed_fps);
+
+    global.gnx_scn.seed = variable_struct_exists(_data, "seed") ? _data.seed : 1;
+    random_set_seed(global.gnx_scn.seed);
+    if (variable_struct_exists(_data, "start") && _data.start == "menu")  // menu scenarios (mod menu, load page)
+    {
+        global.load_file = -1;
+        room_goto(rm_menu);
+        return true;
+    }
+    
+    global.load_file = 9;
+    room_goto(rm_game);
+    return true;
+}
+
+
+function scr_gnx_scn_check(arg0, arg1, arg2)
+{
+    if (arg1)
+    {
+        global.gnx_scn.pass++;
+        gnx_scn_log("PASS  " + arg0 + " " + arg2);
+    }
+    else
+    {
+        global.gnx_scn.fail++;
+        gnx_scn_log("FAIL  " + arg0 + " " + arg2);
+    }
+}
