+
+function scr_gnx_scn_step()
+{
+    var _s = global.gnx_scn;
+
+    // after travel/reload, hold until the room has been rebuilt. obj_np is placed in the
+    // room editor, so it keeps the same instance id across room changes: tag it instead.
+    if (_s.awaiting)
+    {
+        if (variable_instance_exists(obj_np, "gnx_scn_old"))
+            exit;
+
+        _s.awaiting = false;
+        random_set_seed(_s.seed);  // travel/reload re-ran initials (randomize)
+        gnx_scn_log("loaded (map '" + global.gnx_active_map + "')");
+    }
+
+    _s.frame_n++;
+
+    // stand-in mouse: one queued frame per step event (GNX UI reads it through gnx_mx/gnx_my/gnx_mb)
+    if (variable_struct_exists(_s, "vm_queue") && is_array(_s.vm_queue))
+    {
+        if (array_length(_s.vm_queue) > 0)
+        {
+            var _vf = _s.vm_queue[0];
+            array_delete(_s.vm_queue, 0, 1);
+            var _was_down = is_struct(global.gnx_vmouse) && global.gnx_vmouse.down;
+            global.gnx_vmouse = { x: _vf.x, y: _vf.y, down: _vf.down, pressed: _vf.down && !_was_down };
+            exit;
+        }
+
+        global.gnx_vmouse = -1;
+        _s.vm_queue = -1;
+    }
+
+    // phase trace (step "trace"): every frame, the traced cell's phase changes and loops are recorded
+    if (variable_struct_exists(_s, "trace") && is_struct(_s.trace))
+        gnx_scn_trace_tick(_s.trace);
+
+    // nothing is looked at during a wait: skip the draw events (most of a busy nest's frame time) and turn them
+    // back on 2 frames before it ends, so screenshots and layout checks see a fresh frame
+    // ("draw_always": true keeps them on: soak runs that must include draw-side costs)
+    draw_enable_drawevent(_s.draw_always || _s.wait <= 2);
+
+    if (_s.wait > 0)
+    {
+        _s.wait--;
+        exit;
+    }
+
+    // step "until_phase": hold until the traced cell plays that phase (or the frame budget runs out: FAIL)
+    if (variable_struct_exists(_s, "until_phase") && is_struct(_s.until_phase))
+    {
+        if (is_struct(_s.trace) && _s.trace.last == _s.until_phase.phase)
+        {
+            gnx_scn_log("until_phase " + string(_s.until_phase.phase) + " reached");
+            _s.until_phase = -1;
+        }
+        else if (--_s.until_phase.left <= 0)
+        {
+            scr_gnx_scn_check("until_phase", false, "phase " + string(_s.until_phase.phase) + " not reached");
+            _s.until_phase = -1;
+        }
+        else
+        {
+            exit;
+        }
+    }
+
+    while (_s.idx < array_length(_s.steps))
+    {
+        var _st = _s.steps[_s.idx];
+        _s.idx++;
+        
+        if (_s.idx > _s.prog_last)  // progress for the harness's live display (steps that hold re-run their index)
+        {
+            _s.prog_last = _s.idx;
+            var _pf = file_text_open_write("gnx_scn_progress.txt");
+            file_text_write_string(_pf, string(_s.idx) + "/" + string(array_length(_s.steps)));
+            file_text_close(_pf);
+
+            // TIME lines: steps that took over 250 ms of real time (waits, travel and reload included)
+            var _tnow = get_timer();
+
+            if (variable_struct_exists(_s, "t_last") && (_tnow - _s.t_last) > 250000)
+                gnx_scn_log("TIME " + string(floor((_tnow - _s.t_last) / 1000)) + " ms step " + string(_s.t_idx) + " " + _s.t_label);
+
+            _s.t_last = _tnow;
+            _s.t_idx = _s.idx;
+            _s.t_label = string_copy(json_stringify(_st), 1, 70);
+        }
+
+        if (variable_struct_exists(_st, "wait"))
+        {
+            _s.wait = _st.wait;
+            exit;
+        }
+        else if (variable_struct_exists(_st, "do"))
+        {
+            var _act = variable_struct_get(_st, "do");  // "do" is a GML keyword; UTMT also lacks the [$ ] accessor
+            gnx_scn_log("do " + _act.type);
+            scr_gnx_exec_tool_action(_act, "_harness");
+        }
+        else if (variable_struct_exists(_st, "call"))
+        {
+            // any game/GNX function by name, e.g. {"call": "scr_swap_floors", "args": [0, 1]}
+            var _fn = gnx_resolve_script(_st.call);
+            var _a = variable_struct_exists(_st, "args") ? _st.args : [];
+
+            for (var _ai = 0; _ai < array_length(_a); _ai++)
+                _a[_ai] = gnx_scn_ref(_a[_ai]);
+
+            if (_fn < 0)
+            {
+                scr_gnx_scn_check("call", false, "no function '" + _st.call + "'");
+            }
+            else
+            {
+                gnx_scn_log("call " + _st.call + " " + json_stringify(_a));
+
+                switch (array_length(_a))
+                {
+                    case 0: script_execute(_fn); break;
+                    case 1: script_execute(_fn, _a[0]); break;
+                    case 2: script_execute(_fn, _a[0], _a[1]); break;
+                    case 3: script_execute(_fn, _a[0], _a[1], _a[2]); break;
+                    case 4: script_execute(_fn, _a[0], _a[1], _a[2], _a[3]); break;
+                    default: script_execute(_fn, _a[0], _a[1], _a[2], _a[3], _a[4]); break;
+                }
+            }
+        }
+        else if (variable_struct_exists(_st, "camera_y"))
+        {
+            with (obj_camera)
+                y = _st.camera_y;
+
+            gnx_scn_log("camera_y " + string(_st.camera_y));
+        }
+        else if (variable_struct_exists(_st, "trace"))
+        {
+            // {"trace": h_type}: from now on, record every phase change of the first occupied cell of that type
+            // (phase = anim_struct.spr_type, its frame_c, h_step) and how often each phase loops; read by assert "trace"
+            _s.trace = { h: gnx_scn_ref(_st.trace), cell: gnx_scn_occupied_cell(gnx_scn_ref(_st.trace)), events: [], wraps: {}, last: -99, last_index: 0 };
+            gnx_scn_log("trace h=" + string(_s.trace.h) + " cell " + string(_s.trace.cell));
+        }
+        else if (variable_struct_exists(_st, "until_phase"))
+        {
+            // {"until_phase": {"phase": 2, "max_frames": 3000}}: wait until the traced cell (step "trace") plays that phase
+            _s.until_phase = { phase: _st.until_phase.phase, left: variable_struct_exists(_st.until_phase, "max_frames") ? _st.until_phase.max_frames : 3000 };
+            exit;
+        }
+        else if (variable_struct_exists(_st, "mon_scan"))
+        {
+            // {"mon_scan": "label"}: logs every monster that cannot be seen (not visible, no valid sprite, alpha ~0,
+            // or no draw script while not inside a cell), with its state; "max": n fails above n such monsters
+            var _ms_n = 0;
+            var _ms_txt = "";
+
+            with (obj_mon)
+            {
+                if (!is_struct(mon_data) || !variable_struct_exists(mon_data, "mon_state"))
+                    continue;
+
+                var _ms_why = "";
+
+                if (!visible)
+                    _ms_why += " invisible";
+
+                if (!sprite_exists(sprite_index))
+                    _ms_why += " no-sprite";
+
+                if (image_alpha < 0.05)
+                    _ms_why += " alpha0";
+
+                // inside a cell (state 1) that is not running its scene: nothing draws the monster, only its mood shows
+                if (mon_data.mon_state == 1 && mon_data.slot_id != -1 && instance_exists(mon_data.slot_id) && is_struct(mon_data.slot_id.slot_data.anim_struct) && mon_data.slot_id.slot_data.anim_struct.char_state == 0)
+                    _ms_why += " in-idle-cell(h=" + string(mon_data.slot_id.slot_data.h_type) + ")";
+                else if (_ms_why == " invisible" && sprite_exists(sprite_index) && (mon_data.mon_state == 1 || mon_data.mon_state == 9))
+                    _ms_why = "";  // in a running cell (the cell draws it) or second carrier (its partner draws it): expected
+
+                if (_ms_why != "")
+                {
+                    _ms_n++;
