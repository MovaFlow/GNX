{
  "about": "Options a mod cell can offer in its MOD window (the window a click on a built cell opens): OPTIONS CELL (harness_scenes, h 9054) has a hand pose (layer type 2, true at [2]) and a leg pose (type 3) the player picks, and clothing overlays (spr_c_array) on the breast and legs, which give on/off switches. The window lists exactly those four rows, and its real buttons change the choices.",
  "mods": [
    "tools/scenarios/mods/harness_scenes"
  ],
  "check_boot_suite": false,
  "steps": [
    {
      "wait": 30
    },
    {
      "do": {
        "type": "unlock_cell",
        "h_type": 1
      }
    },
    {
      "open_build_menu": -1
    },
    {
      "wait": 2
    },
    {
      "press": {
        "type": 0,
        "num": 0
      },
      "why": "NEW"
    },
    {
      "wait": 2
    },
    {
      "press": {
        "type": 1,
        "num": 5
      },
      "why": "CUSTOM"
    },
    {
      "wait": 20
    },
    {
      "press": {
        "type": 95,
        "num": 9054
      }
    },
    {
      "wait": 10
    },
    {
      "assert": "has_cell",
      "h_type": 9054,
      "count": 1
    },
    {
      "occupy": {
        "h_type": 9054,
        "class": 0
      }
    },
    {
      "wait": 30
    },
    {
      "open_cell_menu": 9054
    },
    {
      "wait": 5
    },
    {
      "assert": "fn",
      "name": "gnx_scn_mod_rows",
      "args": [],
      "is": "2,3,6,8,off",
      "why": "hand pose, leg pose, breast clothing, leg clothing"
    },
    {
      "assert": "fn",
      "name": "gnx_scn_mod_index",
      "args": [
        9054,
        6
      ],
      "is": 0,
      "why": "clothing shown at first"
    },
    {
      "assert": "fn",
      "name": "gnx_scn_mod_index",
      "args": [
        9054,
        2
      ],
      "is": -1,
      "why": "no hand pose chosen yet"
    },
    {
      "press": {
        "type": 27,
        "num": 0
      },
      "why": "the breast clothing switch"
    },
    {
      "wait": 3
    },
    {
      "assert": "fn",
      "name": "gnx_scn_mod_index",
      "args": [
        9054,
        6
      ],
      "is": 1,
      "why": "the switch turned it"
    },
    {
      "press": {
        "type": 26,
        "num": 1
      },
      "why": "hand pose: next"
    },
    {
      "wait": 3
    },
    {
      "assert": "fn",
      "name": "gnx_scn_mod_index",
      "args": [
        9054,
        2
      ],
      "is": 0,
      "why": "the first hand pose"
    }
  ]
}