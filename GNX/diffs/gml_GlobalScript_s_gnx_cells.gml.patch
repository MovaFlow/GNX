+
+/// GNX-UGREQ: the names of the atlas entries of the mod in folder arg0 (with "/" at the end) that the atlas
+/// loader would register, read from atlas/uv.json: { name: true }, each name also in lower case (file names on
+/// Windows ignore case). An entry counts only when it passes the loader's frame check (gnx_atlas_frames_bad):
+/// a non-empty frames list, every frame an object with numbers atlas, x, y, w, h (missing ones are the
+/// loader's defaults), and every frame that is not empty (w and h above 0) on an existing page: a whole page
+/// number, a page file that is a PNG, the rectangle inside it (page size from the PNG header, gnx_png_size).
+/// undefined = no usable atlas (no uv.json, not JSON, or without atlas_files / entries).
+function gnx_ug_atlas_names(arg0)
+{
+    var _p = arg0 + "atlas/uv.json";
+    
+    if (!file_exists(_p))
+        return undefined;
+    
+    // buffer_load + buffer_read: the whole file as text, as the atlas loader reads it
+    var _b = buffer_load(_p);
+    
+    if (_b == -1)
+        return undefined;
+    
+    var _txt = buffer_read(_b, buffer_text);
+    buffer_delete(_b);
+    var _uv = undefined;
+    
+    try
+    {
+        _uv = json_parse(_txt);
+    }
+    catch (_e)
+    {
+        return undefined;
+    }
+    
+    // the loader skips an atlas without a non-empty atlas_files list or an entries object
+    if (!is_struct(_uv) || !variable_struct_exists(_uv, "atlas_files") || !is_array(_uv.atlas_files) || array_length(_uv.atlas_files) == 0 || !variable_struct_exists(_uv, "entries") || !is_struct(_uv.entries))
+        return undefined;
+    
+    // size of each page, [w, h], or undefined when its file is missing or no PNG (the loader cannot load it)
+    var _pages = [];
+    
+    for (var i = 0; i < array_length(_uv.atlas_files); i++)
+        array_push(_pages, gnx_png_size(arg0 + "atlas/" + string(_uv.atlas_files[i])));
+    
+    var _out = {};
+    var _keys = variable_struct_get_names(_uv.entries);
+    
+    for (var i = 0; i < array_length(_keys); i++)
+    {
+        var _en = variable_struct_get(_uv.entries, _keys[i]);
+        var _fr = (is_struct(_en) && variable_struct_exists(_en, "frames") && is_array(_en.frames)) ? _en.frames : [];
+        // == 0: no frames, the loader does not register it
+        var _ok = array_length(_fr) > 0;
+        
+        for (var f = 0; f < array_length(_fr) && _ok; f++)
+        {
+            var _f = _fr[f];
+            
+            if (!is_struct(_f))
+            {
+                _ok = false;
+                break;
+            }
+            
+            // ? : the value, else the loader's default
+            var _pg = variable_struct_exists(_f, "atlas") ? _f.atlas : -1;
+            var _x = variable_struct_exists(_f, "x") ? _f.x : -1;
+            var _y = variable_struct_exists(_f, "y") ? _f.y : -1;
+            var _w = variable_struct_exists(_f, "w") ? _f.w : 0;
+            var _h = variable_struct_exists(_f, "h") ? _f.h : 0;
+            
+            if (!is_real(_pg) || !is_real(_x) || !is_real(_y) || !is_real(_w) || !is_real(_h))
+            {
+                _ok = false;
+                break;
+            }
+            
+            // || = or: an empty frame draws nothing and needs no page, as in the loader
+            if (_w <= 0 || _h <= 0)
+                continue;
+            
+            // a whole page number of a page that loads
+            if (_pg != floor(_pg) || _pg < 0 || _pg >= array_length(_pages) || _pages[_pg] == undefined)
+            {
+                _ok = false;
+                break;
+            }
+            
+            // the rectangle inside the page
+            if (_x < 0 || _y < 0 || (_x + _w) > _pages[_pg][0] || (_y + _h) > _pages[_pg][1])
+            {
+                _ok = false;
+                break;
+            }
+        }
+        
+        if (_ok)
+        {
+            variable_struct_set(_out, _keys[i], true);
+            variable_struct_set(_out, string_lower(_keys[i]), true);
+        }
+    }
+    
+    return _out;
+}
+
+
+/// GNX-UGREQ (1.5.0.5): checks before mod arg0 (folder) with manifest arg1 loads that the milk and newborn
+/// strips its underground cells (category "ug_breed") declare can load. Both are optional: a captive art set
+/// without milk_spr has no milk drawn, one without infant_spr an invisible newborn (nobody else's is lent).
+/// What is declared must be right: milk_spr an object with at least one phase key, every reference loadable
+/// (gnx_ug_ref_problem). Checked: in a class_map cell every human_spr.classes entry, the default entry and
+/// the cell's own keys; in any other cell the cell's own keys. Each problem is one mod error; returns how
+/// many there are (0 = the mod may load). A missing or broken cells.json is left to the cells loader.
+function gnx_ug_strips_check(arg0, arg1)
+{
+    if (!is_struct(arg1) || !variable_struct_exists(arg1, "cells"))
+        return 0;
+    
+    var _dir = global.gnx_mods_root + arg0 + "/";
+    var _path = _dir + string(arg1.cells);
+    
+    if (!file_exists(_path))
+        return 0;
+    
+    var _f = file_text_open_read(_path);
+    var _raw = "";
+    
+    while (!file_text_eof(_f))
+        _raw += file_text_readln(_f);
+    
+    file_text_close(_f);
+    var _cells = undefined;
+    
+    try
+    {
+        _cells = json_parse(_raw);
+    }
+    catch (_e)
+    {
+        return 0;
+    }
+    
+    if (!is_array(_cells))
+        return 0;
+    
+    // the names in the mod's atlas (undefined = none): a strip found there needs no PNG of its own. Read
+    // once, at the first underground cell, since its pages are opened to measure them
+    var _atlas = undefined;
+    var _atlas_read = false;
+    var _bad = 0;
+    // milk phase keys, as gnx_milk_tables reads them
+    var _mk = ["start", "idle", "loop", "ej", "birth", "idle_start", "start_loop", "loop_ej", "ej_birth"];
+    
+    for (var c = 0; c < array_length(_cells); c++)
+    {
+        var _cell = _cells[c];
+        
+        // only underground cells; != = differs
+        if (!is_struct(_cell) || !variable_struct_exists(_cell, "category") || string(_cell.category) != "ug_breed")
+            continue;
+        
+        // ! = not: the first underground cell of the mod reads the atlas
+        if (!_atlas_read)
+        {
+            _atlas = gnx_ug_atlas_names(_dir);
+            _atlas_read = true;
+        }
+        
+        var _cn = variable_struct_exists(_cell, "name") ? string(_cell.name) : ("#" + string(c));
+        var _spr = variable_struct_exists(_cell, "sprites") ? _cell.sprites : undefined;
+        
+        // the places that may declare milk_spr / infant_spr: [label, object]; the cell itself always
+        var _sets = [["cell", _cell]];
+        var _hs = variable_struct_exists(_cell, "human_spr") ? _cell.human_spr : undefined;
+        
+        if (is_struct(_hs) && variable_struct_exists(_hs, "mode") && _hs.mode == "class_map")
+        {
+            if (variable_struct_exists(_hs, "classes") && is_struct(_hs.classes))
+            {
+                var _ck = variable_struct_get_names(_hs.classes);
+                
+                for (var k = 0; k < array_length(_ck); k++)
+                {
+                    var _ce = variable_struct_get(_hs.classes, _ck[k]);
+                    
+                    // objects only ("_comment" notes etc. are skipped)
+                    if (is_struct(_ce))
+                        array_push(_sets, ["class '" + _ck[k] + "'", _ce]);
+                }
+            }
+            
+            // variable_struct_get(.., "default"): default is a GML keyword, so it cannot be written as .default
+            if (variable_struct_exists(_hs, "default") && is_struct(variable_struct_get(_hs, "default")))
+                array_push(_sets, ["default", variable_struct_get(_hs, "default")]);
+        }
+        
+        for (var s = 0; s < array_length(_sets); s++)
+        {
+            var _who = "Mod '" + arg0 + "': underground cell '" + _cn + "', " + _sets[s][0] + ": ";
+            var _o = _sets[s][1];
+            
+            // optional: only a declared milk_spr is checked
+            if (variable_struct_exists(_o, "milk_spr"))
+            {
+                // ! = not: it must be an object of phase keys
+                if (!is_struct(_o.milk_spr))
+                {
+                    gnx_report_mod_error(_who + "milk_spr must be an object of phase keys (start, idle, loop, ej, birth or an intermission), not " + string(_o.milk_spr));
+                    _bad++;
+                }
+                else
+                {
+                    var _any = false;
+                    
+                    for (var m = 0; m < array_length(_mk); m++)
+                    {
+                        if (!variable_struct_exists(_o.milk_spr, _mk[m]))
+                            continue;
+                        
+                        _any = true;
+                        var _mp = gnx_ug_ref_problem(variable_struct_get(_o.milk_spr, _mk[m]), _spr, _dir, _atlas);
+                        
+                        // != "": there is a problem
+                        if (_mp != "")
+                        {
+                            gnx_report_mod_error(_who + "milk_spr." + _mk[m] + " " + _mp);
+                            _bad++;
+                        }
+                    }
+                    
+                    if (!_any)
+                    {
+                        gnx_report_mod_error(_who + "milk_spr is declared but has no phase key (start, idle, loop, ej, birth or an intermission); leave it out for no milk");
+                        _bad++;
+                    }
+                }
+            }
+            
+            // optional: only a declared infant_spr is checked
+            if (variable_struct_exists(_o, "infant_spr"))
+            {
+                var _ip = gnx_ug_ref_problem(_o.infant_spr, _spr, _dir, _atlas);
+                
+                if (_ip != "")
+                {
+                    gnx_report_mod_error(_who + "infant_spr " + _ip);
+                    _bad++;
+                }
+            }
+        }
+    }
+    
+    return _bad;
+}
