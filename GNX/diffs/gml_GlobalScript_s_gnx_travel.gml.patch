+
+        exit;
+    }
+
+    if (button_num >= 40 && button_num <= 42)  // tabs
+    {
+        _w.tab = button_num - 40;
+
+        with (_w)
+            scr_gnx_travel_selector_buttons();
+
+        exit;
+    }
+
+    if (button_num == 30 || button_num == 31 || (button_num >= 50 && button_num <= 55))  // BASIC rows
+    {
+        var _d = 0;
+
+        if (button_num >= 50)
+        {
+            var _steps = [-100, -10, -1, 1, 10, 100];
+            _d = _steps[button_num - 50];
+        }
+
+        switch (travel_row)
+        {
+            case 0:
+                _w.carry_gold = (button_num == 30) ? _w.max_gold : ((button_num == 31) ? 0 : clamp(_w.carry_gold + _d, 0, _w.max_gold));
+                break;
+
+            case 1:
