+    array_push(global.gnx_runtime_sprites, _spr);
+    
+    if (_n == 1)
+        return _spr;
+    
+    var _w = gnx_sprite_get_width(_spr);
+    var _h = gnx_sprite_get_height(_spr);
+    
+    for (var _i = 1; _i < _n; _i++)
+    {
+        var _tmp = sprite_add(arg0[_i], 1, false, false, 0, 0);
+        
+        if (_tmp == -1)
+            continue;
+        
+        var _surf = surface_create(_w, _h);
+        surface_set_target(_surf);
+        draw_clear_alpha(c_black, 0);
+        // POPRAWKA (GNX): bm_one/bm_zero = kopia 1:1; przy zwyklym mieszaniu polprzezroczyste piksele
