+function gnx_pool_pick()
+{
+    var _stage = argument[0];
+    var _level = argument[1];
+    var _exclude = (argument_count > 2 && is_array(argument[2])) ? argument[2] : -1;
+    var _key = (_stage * 100) + _level;
