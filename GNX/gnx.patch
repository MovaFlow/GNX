+// =====================================================================================
+// GNX-UG: scene scripts for cells with per-phase frame counts (physical.frames in cells.json).
+// Phases (spr_type): 0 start, 1 idle, 2 loop, 3 ej, 4 birth, 5 milk.
+// The scene runs on its own like a tentacle cell (no monsters are called). scr_h must list
+// exactly: [ug_start, ug_loop, ug_ej, ug_birth, ug_milk] because these scripts jump by index.
+// Other cells never call these scripts, so their timing and frames stay unchanged.
+// =====================================================================================
+
+/// GNX-FRAMES: the own frame table of the current cell (physical.frames): the base scene scripts play
+/// these frames at the vanilla speed per frame. undefined for vanilla cells and cells without frames:
+/// then every helper below returns the vanilla value and nothing changes.
+function gnx_cell_speed_frames()
+{
+    var _cell = ds_map_find_value(global.cell_registry, slot_data.h_type);
+    
+    // || = or: GameMaker stops at the first true part, so .physical is read only when the cell exists
+    if (_cell == undefined || !variable_struct_exists(_cell.physical, "gnx_phase_frames"))
+        return undefined;
+    
+    return _cell.physical.gnx_phase_frames;
+}
+
+/// GNX-LOOP: length of one loop part (arg0 = vanilla length in game frames, 360-420 = 6-7 s). A cell with
+/// physical.loop_scale true gets it longer in proportion to its loop frames: loop frames / 5 (the vanilla
+/// count), so it plays as many loop cycles as vanilla. 10 frames = twice as long. Otherwise arg0 as it is.
+function gnx_loop_time(arg0)
+{
+    var _cell = ds_map_find_value(global.cell_registry, slot_data.h_type);
+    
+    // ! = not: no cell, no switch, or the switch is off -> vanilla length
+    if (_cell == undefined || !variable_struct_exists(_cell.physical, "gnx_loop_scale") || !_cell.physical.gnx_loop_scale)
+        return arg0;
+    
+    var _n = 5;
+    
+    // underground cells keep their counts in gnx_frames, other mod cells in gnx_phase_frames (phase 2 = loop)
+    if (variable_struct_exists(_cell.physical, "gnx_frames"))
+        _n = _cell.physical.gnx_frames.loop;
+    else if (variable_struct_exists(_cell.physical, "gnx_phase_frames") && _cell.physical.gnx_phase_frames[2] >= 1)
+        _n = _cell.physical.gnx_phase_frames[2];
+    
+    return arg0 * (_n / 5);
+}
+
+/// GNX-EJ: how many holds the ej makes (scripts count h_loop down to 0). physical.ej_holds = a number
+/// from 1, or [min, max] for a random count. Without the key: arg0, the vanilla irandom_range(5, 7).
+function gnx_ej_holds(arg0)
+{
+    var _cell = ds_map_find_value(global.cell_registry, slot_data.h_type);
+    
+    if (_cell == undefined || !variable_struct_exists(_cell.physical, "gnx_ej_holds"))
+        return arg0;
+    
+    var _r = _cell.physical.gnx_ej_holds;
+    return irandom_range(_r[0], _r[1]);
+}
+
+/// GNX-START: how many more times the start plays after the first one (scripts count h_loop down and
+/// leave the start when it goes below 0). physical.start_loops = plays in all: a number, or [min, max]
+/// for a random count. Without the key: arg0, the script's own value (vanilla choose(2, 3, 4) = 3-5
+/// plays, underground cell 0 = once).
+function gnx_start_loops(arg0)
+{
+    var _cell = ds_map_find_value(global.cell_registry, slot_data.h_type);
+    
+    if (_cell == undefined || !variable_struct_exists(_cell.physical, "gnx_start_loops"))
+        return arg0;
+    
+    var _r = _cell.physical.gnx_start_loops;
+    // irandom_range(a, b) = a whole number from a to b; - 1 because the first play is not counted
