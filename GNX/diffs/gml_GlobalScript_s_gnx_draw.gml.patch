+function gnx_atlas_resolve_ref(arg0, arg1)
+{
+    if (!variable_global_exists("gnx_mod_atlases"))
+        return undefined;
+    
+    if (!ds_map_exists(global.gnx_mod_atlases, arg0))
+        return undefined;
+    
+    var _atlas = ds_map_find_value(global.gnx_mod_atlases, arg0);
+    
+    if (_atlas == undefined)
+        return undefined;
+    
+    var _stem = "";
+    
+    if (is_struct(arg1))
+    {
+        if (variable_struct_exists(arg1, "strip"))
+            _stem = arg1.strip;
+        else if (variable_struct_exists(arg1, "path"))
+            _stem = arg1.path;
+        else if (variable_struct_exists(arg1, "frames") && is_array(arg1.frames) && array_length(arg1.frames) > 0)
+            _stem = arg1.frames[0];
+        else if (variable_struct_exists(arg1, "folder"))
+            _stem = string(arg1.folder); // Mav (1.4.7.5): a "folder"-only entry can be in the atlas too
+        else
+            return undefined;
+    }
+    else
+    {
+        _stem = string(arg1);
+    }
+    
+    _stem = filename_change_ext(filename_name(_stem), "");
+    
+    
+    if (variable_struct_exists(_atlas.sprrefs, _stem))
+    return variable_struct_get(_atlas.sprrefs, _stem);
+    // Mav (1.4.7.5): file names on Windows ignore case, struct keys do not.
+    // "spr_h_Jezebel_x" in the JSON and "spr_h_jezebel_x" in uv.json are the same file.
+    if (variable_struct_exists(_atlas, "sprrefs_lower"))
+    {
+        var _ls = string_lower(_stem);
+        if (variable_struct_exists(_atlas.sprrefs_lower, _ls))
+            return variable_struct_get(_atlas.sprrefs_lower, _ls);
+    }
+    return undefined;
+}
+
+
+function gnx_load_atlas_mod(arg0, arg1)
+{
+    var _atlas_dir = arg0 + "atlas/";
+    var _uv_path = _atlas_dir + "uv.json";
+    
+    if (!file_exists(_uv_path))
+    {
+        show_debug_message("[GNX-ATLAS] no uv.json at " + _uv_path);
+        return undefined;
+    }
+    
+    var _t_read = get_timer();
+    var _buf = buffer_load(_uv_path);
+    
+    if (_buf == -1)
+    {
+        show_debug_message("[GNX-ATLAS] failed to buffer_load " + _uv_path);
+        return undefined;
+    }
+    
+    var _content = buffer_read(_buf, buffer_text);
+    buffer_delete(_buf);
+    var _t_parse = get_timer();
+    var _uv;
+    
+    try
+    {
+        _uv = json_parse(_content);
+    }
+    catch (_e)
+    {
+        show_debug_message("[GNX-ATLAS] malformed uv.json for " + arg1);
+        var _ef = gnx_log_open();
+        gnx_log_write(_ef, "[GNX-ATLAS] ERROR: malformed uv.json for " + arg1 + "\n");
+        gnx_log_close(_ef);
+        return undefined;
+    }
+    
+    var _t_after_parse = get_timer();
+    var _tl_r = gnx_log_open();
+    gnx_log_write(_tl_r, "[GNX-TIME] " + arg1 + " uv.json read = " + string((_t_parse - _t_read) / 1000) + " ms, parse = " + string((_t_after_parse - _t_parse) / 1000) + " ms\n");
+    gnx_log_close(_tl_r);
+    var _atlas_sprites = [];
+    
+    // GNX-FIX: a uv.json without its lists stopped the game; now the atlas is skipped with a log line
+    if (!is_struct(_uv) || !variable_struct_exists(_uv, "atlas_files") || !is_array(_uv.atlas_files) || array_length(_uv.atlas_files) == 0 || !variable_struct_exists(_uv, "entries") || !is_struct(_uv.entries))
+    {
+        var _ef0 = gnx_log_open();
+        gnx_log_write(_ef0, "[GNX-ATLAS] ERROR: " + arg1 + ": uv.json needs atlas_files (a list of PNGs) and entries; atlas not used, the mod's strips load one by one\n");
+        gnx_log_close(_ef0);
+        return undefined;
+    }
+    
+    var _files = _uv.atlas_files;
+    
+    for (var _i = 0; _i < array_length(_files); _i++)
+    {
+        var _atlas_path = _atlas_dir + _files[_i];
+        var _t_pre_add = get_timer();
+        var _spr = sprite_add(_atlas_path, 1, false, false, 0, 0);
+        var _t_add_ms = (get_timer() - _t_pre_add) / 1000;
+        
+        if (_spr == -1)
+        {
+            show_debug_message("[GNX-ATLAS] failed to load " + _atlas_path);
+            // Mav (1.4.7.5): keep a placeholder instead of skipping the page: frames on later pages would point at the wrong page
+            array_push(_atlas_sprites, -1);
+            var _ef2 = gnx_log_open();
+            gnx_log_write(_ef2, "[GNX-ATLAS] ERROR: " + arg1 + ": failed to load " + _files[_i] + "\n");
+            gnx_log_close(_ef2);
+        }
+        else
+        {
+            var _tl = gnx_log_open();
+            gnx_log_write(_tl, "[GNX-TIME] sprite_add " + _files[_i] + " = " + string(_t_add_ms) + " ms\n");
+            gnx_log_close(_tl);
+            array_push(_atlas_sprites, _spr);
+            array_push(global.gnx_runtime_sprites, _spr);
+        }
+    }
+    
+    var _t_build = get_timer();
+    var _sprrefs = {};
+    var _sprrefs_lower = {};
+    var _entries = _uv.entries;
+    var _keys = variable_struct_get_names(_entries);
+    // GNX-FIX: entries that would draw nothing are left out (logged; the first 20 one by one)
+    var _bad_n = 0;
+    
+    for (var _k = 0; _k < array_length(_keys); _k++)
+    {
+        var _key = _keys[_k];
+        var _entry = variable_struct_get(_entries, _key);
+        var _frames_raw = (is_struct(_entry) && variable_struct_exists(_entry, "frames") && is_array(_entry.frames)) ? _entry.frames : [];
+        var _frames = [];
+        
+        for (var _fi = 0; _fi < array_length(_frames_raw); _fi++)
+        {
+            var _fr = _frames_raw[_fi];
+            
+            // a frame that is no object is kept as it is, so the check below reports it
+            if (!is_struct(_fr))
+            {
+                array_push(_frames, _fr);
+                continue;
+            }
+            
+            array_push(_frames, 
+            {
+                atlas: variable_struct_exists(_fr, "atlas") ? _fr.atlas : -1,
+                x: variable_struct_exists(_fr, "x") ? _fr.x : -1,
+                y: variable_struct_exists(_fr, "y") ? _fr.y : -1,
+                w: variable_struct_exists(_fr, "w") ? _fr.w : 0,
+                h: variable_struct_exists(_fr, "h") ? _fr.h : 0
+            });
+        }
+        
+        // GNX-FIX: a missing page or a frame outside its page made the sprite invisible without a word.
+        // Such an entry is not registered, so the sprite falls back to its own strip PNG when the mod has
+        // one (gnx_resolve_sprite_raw), else the cell reports the missing sprite as before.
+        var _why = gnx_atlas_frames_bad(_atlas_sprites, _frames);
+        
+        if (_why != "")
+        {
+            _bad_n++;
+            
+            if (_bad_n <= 20)
+            {
+                var _bl = gnx_log_open();
+                gnx_log_write(_bl, "[GNX-ATLAS] INVALID: mod=" + arg1 + " entry=" + _key + ": " + _why + "; not used\n");
+                gnx_log_close(_bl);
+            }
+            
+            continue;
+        }
+        
+        var _xo = variable_struct_exists(_entry, "xo") ? _entry.xo : 0;
+        var _yo = variable_struct_exists(_entry, "yo") ? _entry.yo : 0;
+        var _sref = sprref_atlas_multi(_atlas_sprites, _frames, _xo, _yo);
+        variable_struct_set(_sprrefs, _key, _sref);
+        // lowercase index for case-insensitive lookups (the first entry wins)
+        var _lkey = string_lower(_key);
+        if (!variable_struct_exists(_sprrefs_lower, _lkey))
+            variable_struct_set(_sprrefs_lower, _lkey, _sref);
+    }
+    
+    var _tl_b = gnx_log_open();
+    gnx_log_write(_tl_b, "[GNX-TIME] " + arg1 + " sprref build = " + string((get_timer() - _t_build) / 1000) + " ms\n");
+    
+    if (_bad_n > 0)
+        gnx_log_write(_tl_b, "[GNX-ATLAS] " + arg1 + ": " + string(_bad_n) + " atlas entr(y/ies) left out (see INVALID lines above)\n");
+    
+    gnx_log_close(_tl_b);
+    show_debug_message("[GNX-ATLAS] loaded " + arg1 + ": " + string(array_length(_atlas_sprites)) + " atlas(es), " + string(array_length(_keys)) + " sprite entries");
+    // GNX-FIX: counts for the per-mod report in scr_gnx_load_mods ([GNX-PERF]): pages that failed to load,
+    // entries left out, and (filled later by gnx_resolve_sprite_raw) strips loaded outside the atlas
+    var _failed_pages = 0;
+    
+    for (var _fp = 0; _fp < array_length(_atlas_sprites); _fp++)
+    {
+        if (_atlas_sprites[_fp] == -1)
+            _failed_pages++;
+    }
+    
+    return 
+    {
+        atlas_sprites: _atlas_sprites,
+        sprrefs: _sprrefs,
+        sprrefs_lower: _sprrefs_lower,
+        failed_pages: _failed_pages,
+        skipped_entries: _bad_n,
+        strip_loads: 0
+    };
+}
