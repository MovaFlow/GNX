+	}
+	catch(err) {
+		_did_crash = true;
+		_crash_report = json_stringify(__reStruct(err));
+	}
+	
+	if (global.gCurrentTest != undefined) {
+		var _succeeded = (array_length(struct_get_names(global.gCurrentTest.getDiagnostics())) == 0);
