+// GNX-STAGE: mod raid stages (raids.json). Vanilla stages are 0-4; the stages of the mods loaded on this map
+// follow from 5, in load order (global.gnx_stage_registry[i] = stage 5 + i). The stage arrays in global.val
+// (stage_info, stage_lvl_sel, stage_item) are saved by position, so global.val.gnx_stage_keys names what sits
+// at 5, 6, ...; scr_gnx_stage_apply re-maps them by name after every boot and load, and keeps the stages of
+// mods that are gone in global.val.gnx_stage_orphans until they come back.
+function scr_gnx_init_stages()
+{
+    global.gnx_stage_registry = [];
+    global.gnx_stage_spawn_refs = [];  // raid_spawns naming a mod stage, waiting for that stage to load
+    global.gnx_stage_cart_origin = [200, 59];  // where the vanilla raid cart leaves from on the world map (the nest)
+}
+
+
+// the raid-map button picture of a stage: icon arg1 of mod arg0. A number 0-4 reuses that vanilla stage's button;
+// a PNG in the mod's sprites/ folder is one square frame (vanilla 27 x 27), or two side by side (normal, hover).
+// Returns { spr, frames, vanilla } (vanilla = the vanilla frame, or -1).
+function gnx_stage_load_icon(arg0, arg1)
+{
+    var _out = { spr: spr_button_stage, frames: 1, vanilla: 0 };
+
+    if (is_numeric(arg1))
+    {
+        _out.vanilla = clamp(floor(arg1), 0, 4);
+        return _out;
+    }
+
+    if (!is_string(arg1) || arg1 == "")
+        return _out;
+
+    var _path = global.gnx_mods_root + arg0 + "/sprites/" + arg1;
+    var _cache = _path + "#stage";
+    var _spr = -1;
+
+    if (ds_map_exists(global.gnx_sprite_cache, _cache) && gnx_sprite_exists(ds_map_find_value(global.gnx_sprite_cache, _cache)))
+    {
+        _spr = ds_map_find_value(global.gnx_sprite_cache, _cache);
+    }
+    else if (file_exists(_path))
+    {
+        // measured with one frame first: a strip twice as wide as high holds the hover frame
+        var _probe = sprite_add(_path, 1, false, false, 0, 0);
+
+        if (_probe != -1)
+        {
+            var _w = sprite_get_width(_probe);
+            var _h = sprite_get_height(_probe);
+            var _n = (_w >= 2 * _h) ? 2 : 1;
+            sprite_delete(_probe);
+            _spr = sprite_add(_path, _n, false, false, (_w div _n) div 2, _h div 2);
+
+            if (_spr != -1)
+            {
+                array_push(global.gnx_runtime_sprites, _spr);
+                ds_map_set(global.gnx_sprite_cache, _cache, _spr);
+            }
+        }
+    }
+
+    if (_spr == -1)
+    {
+        gnx_report_mod_error("Mod '" + arg0 + "': stage icon sprites/" + arg1 + " not found or not a PNG; the vanilla button is used");
+        return _out;
+    }
+
+    _out.spr = _spr;
+    _out.frames = sprite_get_number(_spr);
+    _out.vanilla = -1;
+    return _out;
+}
+
+
+// a [min, max] range from a number or a two-number list (mod JSON), else arg1 (the default range)
+function gnx_stage_range(arg0, arg1)
+{
+    if (is_array(arg0) && array_length(arg0) == 2)
+    {
+        var _a = gnx_json_num(arg0[0], arg1[0]);
+        var _b = gnx_json_num(arg0[1], arg1[1]);
+        return [min(_a, _b), max(_a, _b)];
+    }
+
+    if (is_numeric(arg0) || is_string(arg0))
+    {
+        var _n = gnx_json_num(arg0, arg1[0]);
+        return [_n, _n];
+    }
+
+    return arg1;
+}
+
+
+// field arg1 of struct arg0, or arg2 when missing
+function gnx_stage_field(arg0, arg1, arg2)
+{
+    return (is_struct(arg0) && variable_struct_exists(arg0, arg1)) ? variable_struct_get(arg0, arg1) : arg2;
+}
+
+
+// adds raid_spawns-style entry arg2 (class already resolved to arg3) of mod arg4 to the pool of stage arg0, level arg1
+function gnx_stage_pool_add(arg0, arg1, arg2, arg3, arg4)
+{
+    var _cond = gnx_stage_field(arg2, "condition", undefined);
+
+    if (_cond != undefined)
+        scr_gnx_resolve_condition_refs(_cond, arg4);
+
+    var _apo = gnx_stage_field(arg2, "ap_override", undefined);
+
+    if (!is_array(_apo) || array_length(_apo) != 2)
+        _apo = undefined;
+
+    gnx_pool_add(arg0, arg1, arg3, gnx_json_num(gnx_stage_field(arg2, "weight", 10), 10), clamp(floor(gnx_json_num(gnx_stage_field(arg2, "min_lvl", 0), 0)), 0, 7), clamp(floor(gnx_json_num(gnx_stage_field(arg2, "max_lvl", 1), 1)), 0, 7), _cond, arg4, gnx_stage_field(arg2, "max_per_encounter", undefined), _apo);
+}
+
+
+// level arg0 (raids.json) of mod arg1's stage number arg2 (key arg4, "folder.ID"), level number arg3, normalised for
+// the encounter code; its enemy pool goes into the encounter pools (key stage * 100 + level), its loot to the mod loot
+function gnx_stage_parse_level(arg0, arg1, arg2, arg3, arg4)
+{
+    var _who = "Stage '" + arg4 + "' level " + string(arg3);
+    var _l = is_struct(arg0) ? arg0 : {};
+    var _units = gnx_stage_field(_l, "units", {});
+    var _count = gnx_stage_range(gnx_stage_field(_units, "count", [1, 2]), [1, 2]);
+    var _out =
+    {
+        count: [clamp(floor(_count[0]), 0, 5), clamp(floor(_count[1]), 0, 5)],
+        hp: gnx_stage_range(gnx_stage_field(gnx_stage_field(_l, "enemy_ap", {}), "hp", 0), [0, 0]),
+        ap: gnx_stage_range(gnx_stage_field(gnx_stage_field(_l, "enemy_ap", {}), "ap", 0), [0, 0]),
+        drop_gold: gnx_stage_range(gnx_stage_field(gnx_stage_field(_l, "drops", {}), "gold", 0), [0, 0]),
+        drop_food: gnx_stage_range(gnx_stage_field(gnx_stage_field(_l, "drops", {}), "food", 0), [0, 0]),
+        reward_gold: max(0, floor(gnx_json_num(gnx_stage_field(gnx_stage_field(_l, "reward", {}), "gold", 0), 0))),
+        reward_food: max(0, floor(gnx_json_num(gnx_stage_field(gnx_stage_field(_l, "reward", {}), "food", 0), 0))),
+        no_capture: gnx_json_num(gnx_stage_field(_l, "no_capture", false), 0) != 0,
+        boss: undefined
+    };
+    var _pool = gnx_stage_field(_units, "pool", []);
+
+    if (!is_array(_pool))
+    {
+        gnx_report_mod_error(_who + ": units.pool must be a list; ignored");
+        _pool = [];
+    }
+
+    for (var _p = 0; _p < array_length(_pool); _p++)
+    {
