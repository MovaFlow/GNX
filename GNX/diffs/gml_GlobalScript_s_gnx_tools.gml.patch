+function scr_gnx_tool_show_nav()
+{
+    with (obj_button)
+    {
+        if (interact_type >= 9001 && interact_type <= 9006)
+            instance_destroy();
+    }
+    
+    scr_window_draw = scr_gnx_draw_tool_window;
+    var _depth = depth;
+    var _items = 0;
+    var _itype = 9001;
+    var _init = scr_gnx_create_tool_cat_button;
+    var _back_type = 9004;
+    var _back_init = scr_gnx_create_tool_back_settings;
+    
+    if (gnx_nav_current == -1)
+    {
+        _items = scr_gnx_tool_cat_count();
+        gnx_nav_title = "TOOLS";
+    }
+    else
+    {
+        var _node = gnx_nav_current;
+        gnx_nav_title = _node.label;
+        var _has_subs = variable_struct_exists(_node, "categories") && array_length(_node.categories) > 0;
+        var _has_btns = variable_struct_exists(_node, "buttons") && array_length(_node.buttons) > 0;
+        _back_type = 9003;
+        _back_init = scr_gnx_create_tool_back_cat;
+        
+        if (_has_subs)
+        {
+            _items = array_length(_node.categories);
+        }
+        else if (_has_btns)
+        {
+            _items = array_length(_node.buttons);
+            _itype = 9002;
+            _init = scr_gnx_create_tool_action_button;
+        }
+    }
+    
+    if (_items == 0)
+    {
+        scr_create_button(-97, 12, _depth - 1, spr_button_long, _back_type, id, _back_init, -1, scr_gnx_draw_tool_button, 0, 3);
+        exit;
+    }
+    
+    var _page_count = ceil(_items / 10);
+    gnx_page_count = _page_count;
+    
+    if (!variable_instance_exists(id, "gnx_page"))
+        gnx_page = 0;
+    
+    if (gnx_page >= _page_count)
+        gnx_page = 0;
+    
+    if (gnx_page < 0)
+        gnx_page = _page_count - 1;
+    
+    var _start = gnx_page * 10;
+    var _show = min(_items - _start, 10);
+    var _rows = ceil(_show / 2);
+    var _max_rows = ceil(5);
+    var _back_y = 12 + (17 * _max_rows);
+    scr_create_button_layout(-38, 12, _depth - 1, _show, 2, 53, 17, _start, spr_button_guide, _itype, id, false, _init, -1, scr_gnx_draw_tool_button);
+    gnx_page_arrow_y = _back_y + 2;
+    
+    if (_page_count > 1)
+        scr_create_button_layout(15, _back_y + 2, _depth - 1, 2, 2, 8, 0, 0, spr_button_arrow, 9005, id, false, scr_gnx_create_tool_page_button, -1, scr_draw_hover_button);
+    
+    scr_create_button(-97, _back_y, _depth - 1, spr_button_long, _back_type, id, _back_init, -1, scr_gnx_draw_tool_button, 0, 3);
+    gnx_show_rank = false;
+    
+    if (gnx_nav_current != -1 && variable_struct_exists(gnx_nav_current, "buttons"))
+    {
+        var _blist = gnx_nav_current.buttons;
+        
+        for (var _ri = 0; _ri < array_length(_blist); _ri++)
+        {
+            if (array_length(_blist[_ri].actions) > 0 && _blist[_ri].actions[0].type == "create_unit")
+            {
+                gnx_show_rank = true;
+                break;
+            }
+        }
+    }
+    
+    if (gnx_show_rank)
+        scr_create_button_layout(-101, 39, _depth - 1, 2, 2, 8, 0, 0, spr_button_arrow, 9006, id, false, scr_gnx_create_tool_page_button, -1, scr_draw_hover_button);
+}
