+    var _sc = 2;
+    var _gx = 150 + (walk * 1.2) + ((phase == 2) ? (t * t * 0.2) : 0);  // walks off, speeding up, once there
+    var _gy = 200;
+    var _frame = (phase == 0 || phase == 2) ? (floor(walk / ((phase == 2) ? 3 : 5)) mod 8) : 0;  // stands while loading
+    var _bob = [0, 1, 1, 0, 0, 1, 1, 0];
