{
  "about": "Unlocks are shared by every map (merged on arrival). A cell unlocked in the village is unlocked on map A too, and the other way round; a map mod's own cell (harness_map's 9001, only registered on its map) must not reach the village's build menu. Survives a save/reload.",
  "mods": [
    "tools/scenarios/mods/harness_map"
  ],
  "steps": [
    {
      "wait": 30
    },
    {
      "travel": "harness_map"
    },
    {
      "wait": 40
    },
    {
      "do": {
        "type": "unlock_cell",
        "h_type": 9001
      }
    },
    {
      "wait": 5
    },
    {
      "assert": "unlocked",
      "h_type": 9001,
      "is": true,
      "why": "the map mod's cell, unlocked on its map"
    },
    {
      "travel": "vanilla"
    },
    {
      "wait": 40
    },
    {
      "assert": "unlocked",
      "h_type": 9001,
      "is": false,
      "why": "harness_map's cell does not exist in the village"
    },
    {
      "assert": "unlocked",
      "h_type": 20,
      "is": false
    },
    {
      "do": {
        "type": "unlock_cell",
        "h_type": 20
      }
    },
    {
      "wait": 5
    },
    {
      "assert": "unlocked",
      "h_type": 20,
      "is": true
    },
    {
      "travel": "harness_map"
    },
    {
      "wait": 40
    },
    {
      "assert": "unlocked",
      "h_type": 20,
      "is": true,
      "why": "unlocked in the village, synced on arrival"
    },
    {
      "assert": "unlocked",
      "h_type": 22,
      "is": false
    },
    {
      "do": {
        "type": "unlock_cell",
        "h_type": 22
      }
    },
    {
      "wait": 5
    },
    {
      "travel": "vanilla"
    },
    {
      "wait": 40
    },
    {
      "assert": "unlocked",
      "h_type": 22,
      "is": true,
      "why": "unlocked on the map, synced back to the village"
    },
    {
      "assert": "unlocked",
      "h_type": 9001,
      "is": false
    },
    {
      "save": 9
    },
    {
      "reload": 9
    },
    {
      "wait": 30
    },
    {
      "assert": "unlocked",
      "h_type": 20,
      "is": true
    },
    {
      "assert": "unlocked",
      "h_type": 22,
      "is": true
    }
  ]
}