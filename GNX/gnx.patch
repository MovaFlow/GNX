+        gnx_prop_play -= 1;
+    }
+    
+    if (_a.flash_t > 0)
+    {
+        gnx_prop_flash = _a.flash_t;
+        gnx_prop_flash_max = _a.flash_t;
+        gnx_prop_flash_col = _a.flash_col;
+        gnx_prop_flash_a = _a.flash_a;
+    }
