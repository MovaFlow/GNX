+/// GNX-INTER: the strip rule for the declared intermissions (arg3 = gnx_inter, arg4 = frames of the phase
+/// each one leads into). arg0 = cell JSON, arg1 = cell name, arg2 = "sprites" block, arg5 = true for an
+/// underground scene, arg6 = base_body. Each intermission plays its own frames:
+/// - captive: human_spr.phase_<name> strips have them (or are marked "loop"); without such a table the
+///   captive is drawn with the art of the phase it leads into, so its count must then be the same
+///   (unless every strip of that art loops);
+/// - tentacle (tent_spr.<name>) and monsters (mon_spr.<name>, every set and placement) have exactly them;
+///   a monster set without its own <name> strips is drawn with the strips of the phase the intermission
+///   leads into, so then the counts must match too. milk_spr fits any count.
+function gnx_frames_check_inter(arg0, arg1, arg2, arg3, arg4, arg5, arg6, arg7)
+{
+    var _bad = 0;
+    var _names = gnx_inter_names();
+    var _hs = variable_struct_exists(arg0, "human_spr") ? arg0.human_spr : undefined;
+    // the captive table each main phase is drawn with (index = phase): start (phase_0, else the idle art),
+    // loop, ej (phase_3 only in underground scenes, else the loop art), birth; arg7 = next phase of each
+    var _big = arg5 || arg6 == "big";
+    var _pt = [(_big && _hs != undefined && gnx_json_has_key(_hs, "phase_0")) ? "phase_0" : "phase_1", "phase_1", "phase_2", (arg5 && _hs != undefined && gnx_json_has_key(_hs, "phase_3")) ? "phase_3" : "phase_2", "phase_4"];
+    var _nt = [_pt[arg7[0]], _pt[arg7[1]], _pt[arg7[2]], _pt[arg7[3]]];
+    // the monster strips used without mon_spr.<name>: start, loop, ej (birth: the ej ones)
+    var _mkp = ["start", "idle", "loop", "ej", "ej"];
+    var _mk = [_mkp[arg7[0]], _mkp[arg7[1]], _mkp[arg7[2]], _mkp[arg7[3]]];
+    
+    for (var k = 0; k < 4; k++)
+    {
+        if (!is_struct(arg3[k]))
+            continue;
+        
+        var _f = arg3[k].frames;
+        var _tn = "phase_" + _names[k];
+        
+        if (_hs != undefined && gnx_json_has_key(_hs, _tn))
+        {
+            _bad += gnx_frames_check_named_tables(_hs, _tn, _f, arg1, arg2);
+        }
+        else if (_hs != undefined && _f != arg4[k] && !gnx_frames_tables_loop(_hs, _nt[k], arg2))
+        {
+            gnx_report_mod_error("Cell '" + string(arg1) + "': intermission " + _names[k] + " has " + string(_f) + " frames but no " + _tn + " table, so the captive is drawn with the " + _nt[k] + " art (" + string(arg4[k]) + " frames); add " + _tn + ", give both the same count, or mark those strips \"loop\": true");
+            _bad++;
+        }
+        
+        if (arg5 && variable_struct_exists(arg0, "tent_spr") && is_struct(arg0.tent_spr) && variable_struct_exists(arg0.tent_spr, _names[k]))
+            _bad += gnx_frames_check_refs(variable_struct_get(arg0.tent_spr, _names[k]), _f, arg1, "tent_spr." + _names[k], arg2, false);
+        
+        // monsters: underground scenes have none
+        var _max_mon = variable_struct_exists(arg0, "physical") && variable_struct_exists(arg0.physical, "max_mon_num") ? gnx_json_num(arg0.physical.max_mon_num, 0) : 0;
+        
+        if (arg5 || _max_mon <= 0)
+            continue;
+        
+        var _sets = ["mon_spr", "mon_spr_hob", "mon_spr_ogr"];
+        var _any = false;
+        // frames of the monster strips used instead: the start ones, else loop / ej (both loop frames)
+        var _mf = (arg7[k] == 0) ? arg4[k] : arg4[1];
+        
+        for (var s = 0; s < 3; s++)
+        {
+            for (var p = -1; p < 3; p++)
+            {
+                var _sk = (p == -1) ? _sets[s] : (_sets[s] + "_p" + string(p));
+                
+                if (!variable_struct_exists(arg0, _sk) || !is_struct(variable_struct_get(arg0, _sk)))
+                    continue;
+                
+                _any = true;
+                var _set = variable_struct_get(arg0, _sk);
+                
+                if (variable_struct_exists(_set, _names[k]))
+                    _bad += gnx_frames_check_refs(variable_struct_get(_set, _names[k]), _f, arg1, _sk + "." + _names[k], arg2, false);
+                else if (_f != _mf)
+                {
+                    gnx_report_mod_error("Cell '" + string(arg1) + "': intermission " + _names[k] + " has " + string(_f) + " frames but " + _sk + " has no " + _names[k] + " strips, so its monsters use their " + _mk[k] + " strips (" + string(_mf) + " frames); add " + _sk + "." + _names[k] + " or give both the same count");
+                    _bad++;
+                }
+            }
+        }
+        
+        // no monster strips at all: monsters come from the vanilla sheets of the next phase
+        if (!_any && _f != ((arg7[k] == 0) ? 2 : 5))
+        {
+            gnx_report_mod_error("Cell '" + string(arg1) + "': intermission " + _names[k] + " has " + string(_f) + " frames but the cell has no mon_spr, so its monsters use the vanilla " + _mk[k] + " sheets (" + string((arg7[k] == 0) ? 2 : 5) + " frames)");
+            _bad++;
+        }
+    }
+    
+    gnx_frames_report_bad(arg1, _bad);
+}
