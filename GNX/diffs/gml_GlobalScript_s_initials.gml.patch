+/// GNX-PROP: runs in a cell after its scene script: arg0 / arg1 = scene state (char_state) and art phase
+/// (spr_type) before the script. What changed becomes events for the props next to the cell.
+function gnx_cell_state_events(arg0, arg1)
+{
+    // the script may have ended the scene for good (anim_struct = -1 without a captive)
+    if (!is_struct(slot_data.anim_struct))
+        exit;
+    
+    var _cs = slot_data.anim_struct.char_state;
+    
+    // char_state 0 = idle, 1 = scene running
+    if (arg0 == 0 && _cs == 1)
+        gnx_cell_event(id, "scene_start");
+    else if (arg0 == 1 && _cs == 0)
+        gnx_cell_event(id, "scene_end");
+    
+    var _ph = variable_struct_exists(slot_data.anim_struct, "spr_type") ? slot_data.anim_struct.spr_type : -1;
+    
+    // != = the art phase changed in this step
+    if (_ph != arg1)
+    {
+        var _ev = gnx_react_phase_event(_ph);
+        
+        if (_ev != "")
+            gnx_cell_event(id, _ev);
+    }
+}
