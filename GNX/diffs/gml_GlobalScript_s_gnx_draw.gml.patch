+/// GNX-FIX: the one-time check of a multi-page atlas sprite arg0: { ok, pages } with ok = its frames are
+/// fine (gnx_atlas_frames_bad) and pages = the page numbers its frames use.
+function gnx_atlas_check(arg0)
+{
+    var _ok = gnx_atlas_frames_bad(arg0.atlas_sprites, arg0.frames) == "";
+    var _pages = [];
+    
+    if (_ok)
+    {
+        for (var i = 0; i < array_length(arg0.frames); i++)
+        {
+            var _cf = arg0.frames[i];
+
+            // empty frames (w or h 0) draw nothing and need no page (|| = or, ! = not)
+            if (_cf.w <= 0 || _cf.h <= 0)
+                continue;
+
+            if (!array_contains(_pages, _cf.atlas))
+                array_push(_pages, _cf.atlas);
+        }
+    }
+    
+    return 
+    {
+        ok: _ok,
+        pages: _pages
+    };
+}
