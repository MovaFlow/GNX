+// =====================================================================================
+// GNX-PLACES: independent places. A mod cell whose scr_h is only ["scr_slot_h_gnx_places"] runs one small
+// scene per monster place instead of one scene for the whole cell. Each monster that arrives plays its own
+// start, slow loop, fast loop and ej on its own clock and leaves alone (payout, mon_exit for the props)
+// while the others go on. The captive shows her idle pictures while nobody is inside, her start pictures
+// while every monster inside is still starting, and her loop pictures as soon as one is past its start.
+// State per place in slot_data.gnx_pl (saved with the cell): st 0 empty, 1 start, 2 slow loop, 3 fast
+// loop, 4 ej, 5 idle_start, 6 start_loop, 7 loop_ej, 8 ej_end (5-8 GNX-PLACES-INTER, see
+// scr_slot_h_gnx_places); i = its frame; n = start plays / ej holds / intermission plays left; t = timer in
+// game frames; s = its speed in frames per second (varied by up to 10 % each cycle, so neighbours drift
+// apart); hold = waiting on the held ej frame; ek = its ej key frames; full = it plays start_loop.
+// The captive's phase is kept in slot_data.gnx_pl_cph and gnx_pl_cloop (true once she is in the loop).
+// GNX-PLACES-EJ (1.5.1): with one monster alone in the cell she plays its ej with it; gnx_pl_cej = the place
+// she follows (-1 = none), gnx_pl_cejf = the ej frame she shows (see scr_slot_h_gnx_places).
+// =====================================================================================
+
+/// GNX-PLACES: a fresh, empty place (st 0 = no monster inside)
+function gnx_places_blank()
+{
+    return 
+    {
+        st: 0,
+        i: 0,
+        n: 0,
+        t: 0,
+        s: 0,
+        hold: false,
+        ek: [2, 3, 4, 5, 2],
+        // GNX-PLACES-INTER: true = this monster plays start_loop after its start (the first of the scene)
+        full: false
+    };
+}
+
+/// GNX-PLACES: a frame number vanilla uses (arg0 of 5 frames) moved to a strip of arg1 frames, as
+/// gnx_key_frame does, but for the monster's own count (the captive may be in another phase)
+function gnx_places_key(arg0, arg1)
+{
+    // == 5 or < 1: vanilla strip (or nothing to scale), the frame stays
+    if (arg1 == 5 || arg1 < 1)
+        return arg0;
+    
+    // clamp keeps it inside the strip: 0 ... arg1 - 1
+    return clamp(round((arg0 * arg1) / 5), 0, arg1 - 1);
+}
+
+/// GNX-PLACES: ej key frames for a loop strip of arg0 frames: [first, held, after the hold, count,
+/// return], as gnx_ej_keys (physical.ej_start / ej_hold / ej_return, else 2 and 3 of 5 moved in
+/// proportion and back to the first frame; see gnx_ej_keys_make)
+function gnx_places_ej_keys(arg0)
+{
+    var _cell = ds_map_find_value(global.cell_registry, slot_data.h_type);
+    
+    // == undefined: no such cell, so no own key frames (vanilla ones moved in proportion)
+    if (_cell == undefined)
+        return gnx_ej_keys_make(undefined, arg0, "");
+    
+    // ? : the cell's name for the log, or its number when it has none
+    var _name = variable_struct_exists(_cell, "name") ? _cell.name : ("h_type " + string(slot_data.h_type));
+    return gnx_ej_keys_make(_cell.physical, arg0, _name);
+}
+
+/// GNX-PLACES: true when cell type arg0 runs independent places (physical scr_h ["scr_slot_h_gnx_places"])
+function gnx_cell_places(arg0)
+{
+    var _c = ds_map_find_value(global.cell_registry, arg0);
+    
+    // && = and: the cell exists, has the flag, and it is on
+    return _c != undefined && variable_struct_exists(_c.physical, "gnx_places") && _c.physical.gnx_places;
+}
+
+/// GNX-PLACES: sets the pictures of monster arg0 for phase arg1 (0 start, 2 loop, 3 ej) and its frame
+/// count arg2, which its own strip has (the cell's count would be the captive's, maybe another phase)
+function gnx_places_mon_spr(arg0, arg1, arg2)
+{
+    with (arg0)
+    {
+        scr_set_mon_spr_data(mon_data.slot_id, arg1);
+        
+        if (is_struct(mon_data.spr_data))
+        {
+            mon_data.spr_data.base_frame_c = arg2;
+            mon_data.spr_data.mon_frame_c = arg2;
+        }
+    }
+}
+
+/// GNX-PLACES: the scene of a cell with independent places (its only scr_h entry). Runs while at least
+/// one monster is inside; scr_slot_h_state_idle runs while none is.
+/// GNX-PLACES-INTER: each monster goes through [idle_start] -> start -> [start_loop] -> slow loop -> fast
+/// loop -> [loop_ej] -> ej -> [ej_end] -> leaves, on its own clock ([ ] = only when the cell declares it in
+/// physical.intermissions). The first monster of a scene plays them all. A monster that comes in while
+/// the scene is running plays its start and goes on to the loop without start_loop; with physical.join_skip
+/// true it begins where the captive is (loop, start_loop or start) instead. The captive follows the monster
+/// furthest on (idle_start, start, start_loop in step with it) until one reaches the loop; from then on she
+/// stays in the loop until the cell is empty (loop_ej, ej and ej_end are the monsters' own).
+/// GNX-PLACES-EJ (1.5.1): one exception. While a monster is alone in the cell and plays its ej, she plays the
+/// ej with it, frame by frame (phase_3, else her loop pictures). She finishes that ej with it even when
+/// another monster comes in meanwhile, keeps the frame the ej ended on during its ej_end, and goes back to
+/// her loop (or idle, when the cell is empty) once it has left.
+function scr_slot_h_gnx_places()
+{
+    var _np = slot_data.max_mon_num;
+    
+    // the places' state; a new scene, an older save or a changed cell has none yet (! = not, || = or)
+    if (!variable_struct_exists(slot_data, "gnx_pl") || !is_array(slot_data.gnx_pl) || array_length(slot_data.gnx_pl) != _np)
+    {
+        slot_data.gnx_pl = array_create(_np, 0);
+        
+        for (var p = 0; p < _np; p++)
+            slot_data.gnx_pl[p] = gnx_places_blank();
+    }
+    
+    // ff is set by every monster that arrives; here it only means "look again", nothing is restarted
+    slot_data.anim_struct.ff = false;
+    // a big cell (human_spr base_body "big") has start pictures of its own (phase_0); others start with idle
+    var _rc = ds_map_find_value(global.cell_registry, slot_data.h_type);
+    var _big = _rc != undefined && variable_struct_exists(_rc, "human_spr") && is_struct(_rc.human_spr) && variable_struct_exists(_rc.human_spr, "base_body") && _rc.human_spr.base_body == "big";
+    // frame counts of the monsters' strips: start (the idle count outside big cells) and loop
+    var _fs = gnx_cell_frames(0, 2);
+    var _fl = gnx_cell_frames(2, 5);
+    // GNX-PLACES-INTER: the cell's intermissions, and whether a late monster skips what the captive played
+    var _in = gnx_places_inters(_rc);
+    var _skip = _rc != undefined && variable_struct_exists(_rc.physical, "gnx_join_skip") && _rc.physical.gnx_join_skip;
+    // GNX-PLACES-SPEED: the cell's frames per second (physical.speed), else the ones it always had
+    var _sp_start = gnx_places_spd(_rc, "start", 2);
+    var _sp_loop = gnx_places_spd(_rc, "loop", 9);
+    var _sp_fast = gnx_places_spd(_rc, "loop_fast", 11);
