+    {
+        if (!array_contains(_names, _keys[i]))
+            gnx_report_mod_error("Cell '" + string(arg2) + "': unknown intermission '" + string(_keys[i]) + "' (known: idle_start, start_loop, loop_ej, ej_birth); ignored");
+    }
+    
+    for (var k = 0; k < 4; k++)
+    {
+        if (!variable_struct_exists(arg0, _names[k]))
