+            gnx_log_write(_cl, "[GNX-UG] a sprite of an underground cell is rotated or flipped upside down (angle " + string(arg6) + ", y scale " + string(arg5) + "): its part below the floor line is not drawn\n");
+            gnx_log_close(_cl);
+        }
+        
+        exit;
+    }
