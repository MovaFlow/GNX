{
  "about": "monster_art lifecycle: global, cell and list art are the same after a save and reload, and the fixture (a save from before monster_art, with no art_roll in any monster) loads with no migration. A real monster's saved art_roll is covered in art_site_lists (after_reload).",
  "fixture": "mid",
  "mods": [
    "tools/scenarios/mods/harness_art_cell",
    "tools/scenarios/mods/harness_art_global"
  ],
  "check_boot_suite": false,
  "steps": [
    {
      "wait": 60
    },
    {
      "assert": "fn",
      "name": "gnx_scn_art_pick",
      "args": [
        3,
        0,
        2,
        1,
        0,
        0,
        0,
        "body_b"
      ],
      "is": "spr_h_goblin_body_ej_alpha",
      "why": "global swap before the save"
    },
    {
      "assert": "fn",
      "name": "gnx_scn_art_pick",
      "args": [
        3,
        0,
        2,
        1,
        0,
        0,
        0,
        "pen"
      ],
      "is": "mod:g_pen",
      "why": "global strip before the save"
    },
    {
      "assert": "fn",
      "name": "gnx_scn_art_pick",
      "args": [
        9070,
        0,
        2,
        1,
        0,
        0,
        0,
        "body_b"
      ],
      "is": "mod:lp_fill",
      "why": "cell art before the save"
    },
    {
      "assert": "fn",
      "name": "gnx_scn_art_blocks",
      "args": [
        9070
      ],
      "is": 1,
      "why": "cell art blocks (one monster, goblin) before the save"
    },
    {
      "assert": "fn",
      "name": "gnx_scn_art_pick",
      "args": [
        9070,
        0,
        2,
        1,
        0,
        0,
        0,
        "head_b",
        -2,
        2
      ],
      "is": "mod:hd_a",
      "why": "list roll 0 before the save"
    },
    {
      "assert": "fn",
      "name": "gnx_scn_art_pick",
      "args": [
        9070,
        0,
        2,
        1,
        0,
        0,
        0,
        "head_b",
        -2,
        3
      ],
      "is": "mod:hd_f",
      "why": "list roll 1 before the save"
    },
    {
      "assert": "fn",
      "name": "gnx_scn_art_pick",
      "args": [
        9070,
        0,
        2,
        1,
        0,
        0,
        0,
        "head_l",
        -2,
        3
      ],
      "is": "mod:hd_l",
      "why": "list roll 1, its line before the save"
    },
    {
      "assert": "fn",
      "name": "gnx_scn_art_roll_same",
      "args": [
        9070,
        0,
        2,
        1,
        0,
        0,
        0
      ],
      "is": 1,
      "why": "one monster keeps its roll and its head through three calls before the save"
    },
    {
      "assert": "fn",
      "name": "gnx_scn_art_list_stable",
      "args": [
        9070,
        0,
        2,
        1,
        0,
        "head_b"
      ],
      "is": 1,
      "why": "one pick across phases before the save"
    },
    {
      "save": 9
    },
    {
      "reload": 9
    },
    {
      "wait": 60
    },
    {
      "assert": "fn",
      "name": "gnx_scn_art_pick",
      "args": [
        3,
        0,
        2,
        1,
        0,
        0,
        0,
        "body_b"
      ],
      "is": "spr_h_goblin_body_ej_alpha",
      "why": "global swap after the reload"
    },
    {
      "assert": "fn",
      "name": "gnx_scn_art_pick",
      "args": [
        3,
        0,
        2,
        1,
        0,
        0,
        0,
        "pen"
      ],
      "is": "mod:g_pen",
      "why": "global strip after the reload"
    },
    {
      "assert": "fn",
      "name": "gnx_scn_art_pick",
      "args": [
        9070,
        0,
        2,
        1,
        0,
        0,
        0,
        "body_b"
      ],
      "is": "mod:lp_fill",
      "why": "cell art after the reload"
    },
    {
      "assert": "fn",
      "name": "gnx_scn_art_blocks",
      "args": [
        9070
      ],
      "is": 1,
      "why": "cell art blocks (one monster, goblin) after the reload"
    },
    {
      "assert": "fn",
      "name": "gnx_scn_art_pick",
      "args": [
        9070,
        0,
        2,
        1,
        0,
        0,
        0,
        "head_b",
        -2,
        2
      ],
      "is": "mod:hd_a",
      "why": "list roll 0 after the reload"
    },
    {
      "assert": "fn",
      "name": "gnx_scn_art_pick",
      "args": [
        9070,
        0,
        2,
        1,
        0,
        0,
        0,
        "head_b",
        -2,
        3
      ],
      "is": "mod:hd_f",
      "why": "list roll 1 after the reload"
    },
    {
      "assert": "fn",
      "name": "gnx_scn_art_pick",
      "args": [
        9070,
        0,
        2,
        1,
        0,
        0,
        0,
        "head_l",
        -2,
        3
      ],
      "is": "mod:hd_l",
      "why": "list roll 1, its line after the reload"
    },
    {
      "assert": "fn",
      "name": "gnx_scn_art_roll_same",
      "args": [
        9070,
        0,
        2,
        1,
        0,
        0,
        0
      ],
      "is": 1,
      "why": "one monster keeps its roll and its head through three calls after the reload"
    },
    {
      "assert": "fn",
      "name": "gnx_scn_art_list_stable",
      "args": [
        9070,
        0,
        2,
        1,
        0,
        "head_b"
      ],
      "is": 1,
      "why": "one pick across phases after the reload"
    }
  ]
}
