+// travel carry of monsters and prisoners: arg0 = true on arrival (add / house them), false for a refund
+// (the travel was refused: back where they came from)
+function scr_gnx_apply_carry_units(arg0)
+{
+    if (variable_global_exists("gnx_carry_troops") && is_array(global.gnx_carry_troops))
+    {
+        for (var _i = 0; _i < array_length(global.gnx_carry_troops); _i++)
+            gnx_add_mons(global.gnx_carry_troops[_i].type, global.gnx_carry_troops[_i].class, global.gnx_carry_troops[_i].num);
+    }
+
+    if (variable_global_exists("gnx_carry_captives") && is_array(global.gnx_carry_captives))
+    {
+        var _homeless = 0;
+
+        for (var _i = 0; _i < array_length(global.gnx_carry_captives); _i++)
+        {
+            var _c = global.gnx_carry_captives[_i];
+            var _slot = arg0 ? ds_list_find_index(global.unit_list, -1) : _c.from;
+            
+            // GNX-SORT: her old place may hold another prisoner since (prison sorted or rearranged): the first free one
+            if (_slot >= 0 && _slot < ds_list_size(global.unit_list) && ds_list_find_value(global.unit_list, _slot) != -1)
+                _slot = ds_list_find_index(global.unit_list, -1);
+
+            if (_slot >= 0 && _slot < ds_list_size(global.unit_list) && ds_list_find_value(global.unit_list, _slot) == -1)
+                ds_list_set(global.unit_list, _slot, _c.unit);
+            else
+                _homeless++;
+        }
