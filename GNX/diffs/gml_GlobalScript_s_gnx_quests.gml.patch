--- gml_138/gml_GlobalScript_s_gnx_quests.gml	1970-01-01 01:00:00.000000000 +0100
+++ gml/gml_GlobalScript_s_gnx_quests.gml	1970-01-01 01:00:00.000000000 +0100
@@ -0,0 +1,974 @@
+// GNX: quests, triggers, dialogs, popups, rewards
+// (moved out of s_initials.gml; the functions are global, callable from any script)
+
+// Mav (1.4.7.5): re-resolves names in classes.json conditions (raid_spawns, cage_escape, tower_boss_condition).
+// No cell existed yet while classes loaded, so "h_type": "Mod.Cell" stayed a string.
+// Already resolved values (numbers) are skipped, so it is safe to call more than once.
+function scr_gnx_reresolve_class_conditions()
+{
+    if (variable_global_exists("gnx_encounter_pools") && ds_exists(global.gnx_encounter_pools, ds_type_map))
+    {
+        var _pk = ds_map_find_first(global.gnx_encounter_pools);
+        while (!is_undefined(_pk))
+        {
+            var _pool = ds_map_find_value(global.gnx_encounter_pools, _pk);
+            if (!is_undefined(_pool) && ds_exists(_pool, ds_type_list))
+            {
+                for (var _pi = 0; _pi < ds_list_size(_pool); _pi++)
+                {
+                    var _pe = ds_list_find_value(_pool, _pi);
+                    if (is_struct(_pe) && variable_struct_exists(_pe, "condition") && is_struct(_pe.condition) && variable_struct_exists(_pe, "mod_name"))
+                        scr_gnx_resolve_condition_refs(_pe.condition, _pe.mod_name);
+                }
+            }
+            _pk = ds_map_find_next(global.gnx_encounter_pools, _pk);
+        }
+    }
+    var _ck = ds_map_find_first(global.class_registry);
+    while (!is_undefined(_ck))
+    {
+        var _rc = ds_map_find_value(global.class_registry, _ck);
+        if (is_struct(_rc) && variable_struct_exists(_rc, "mod_name"))
+        {
+            if (variable_struct_exists(_rc, "post_raid") && is_struct(_rc.post_raid) && variable_struct_exists(_rc.post_raid, "cage_escape") && is_struct(_rc.post_raid.cage_escape) && variable_struct_exists(_rc.post_raid.cage_escape, "condition") && is_struct(_rc.post_raid.cage_escape.condition))
+                scr_gnx_resolve_condition_refs(_rc.post_raid.cage_escape.condition, _rc.mod_name);
+            if (variable_struct_exists(_rc, "tower_boss_condition") && is_struct(_rc.tower_boss_condition))
+                scr_gnx_resolve_condition_refs(_rc.tower_boss_condition, _rc.mod_name);
+        }
+        _ck = ds_map_find_next(global.class_registry, _ck);
+    }
+}
