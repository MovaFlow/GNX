+/// GNX-UG: y of floor arg0 counted from floor 0: 140 px per floor above it plus their extra bands.
+/// Without underground cells this is arg0 * 140, as in vanilla.
+function gnx_floor_off(arg0)
+{
+    var _o = arg0 * 140;
+    
+    for (var i = 0; i < arg0; i++)
+        _o += gnx_floor_extra(i);
