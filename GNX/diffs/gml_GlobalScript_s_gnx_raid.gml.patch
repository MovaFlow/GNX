+            var _tl = global.gnx_travel_locations[_i];
+
+            if (_tl.target == global.gnx_active_map && variable_struct_exists(_tl, "nest") && is_array(_tl.nest))
+                return _tl.nest;
+        }
+    }
+
+    return global.gnx_stage_cart_origin;
+}
+
+
+// the cart route of stage arg0 on this map: nest -> path points -> stage (2 px left of and 5 px below its button,
+// where the vanilla Village cart stops), straight legs or (curve) a Catmull-Rom curve through the points, sampled
+// into { pts: [[x, y]...], cum: [length up to each point], len }
+function gnx_stage_build_route(arg0)
+{
+    var _ctl = [gnx_stage_nest()];
+
+    for (var _i = 0; _i < array_length(arg0.path); _i++)
+        array_push(_ctl, arg0.path[_i]);
+
+    array_push(_ctl, [arg0.x - 2, arg0.y + 5]);
+    var _pts = [];
+    var _n = array_length(_ctl);
+
+    if (!arg0.curve || _n < 3)
+    {
+        _pts = _ctl;
+    }
+    else
+    {
+        for (var _i = 0; _i < _n - 1; _i++)
+        {
+            var _p0 = _ctl[max(0, _i - 1)];
+            var _p1 = _ctl[_i];
+            var _p2 = _ctl[_i + 1];
+            var _p3 = _ctl[min(_n - 1, _i + 2)];
+
+            for (var _k = 0; _k < 8; _k++)
+            {
+                var _t = _k / 8;
+                var _t2 = _t * _t;
+                var _t3 = _t2 * _t;
+                var _pt = [0, 0];
+
+                for (var _a = 0; _a < 2; _a++)
+                    _pt[_a] = 0.5 * ((2 * _p1[_a]) + ((-_p0[_a] + _p2[_a]) * _t) + (((2 * _p0[_a]) - (5 * _p1[_a]) + (4 * _p2[_a]) - _p3[_a]) * _t2) + ((-_p0[_a] + (3 * _p1[_a]) - (3 * _p2[_a]) + _p3[_a]) * _t3));
+
+                array_push(_pts, _pt);
+            }
+        }
+
+        array_push(_pts, _ctl[_n - 1]);
+    }
+
+    var _cum = [0];
+
+    for (var _i = 1; _i < array_length(_pts); _i++)
+        array_push(_cum, _cum[_i - 1] + point_distance(_pts[_i - 1][0], _pts[_i - 1][1], _pts[_i][0], _pts[_i][1]));
+
+    return { pts: _pts, cum: _cum, len: _cum[array_length(_cum) - 1] };
+}
+
+
+// the point at fraction arg1 (0 = nest, 1 = stage) of route arg0, at constant speed along its length
+function gnx_route_at(arg0, arg1)
+{
+    var _pts = arg0.pts;
+
+    if (array_length(_pts) == 1 || arg0.len <= 0)
+        return [_pts[0][0], _pts[0][1]];
+
+    var _d = clamp(arg1, 0, 1) * arg0.len;
+
+    for (var _i = 1; _i < array_length(_pts); _i++)
+    {
+        if (_d <= arg0.cum[_i])
+        {
+            var _seg = arg0.cum[_i] - arg0.cum[_i - 1];
+            var _f = (_seg > 0) ? ((_d - arg0.cum[_i - 1]) / _seg) : 1;
+            return [lerp(_pts[_i - 1][0], _pts[_i][0], _f), lerp(_pts[_i - 1][1], _pts[_i][1], _f)];
+        }
+    }
+
+    var _last = _pts[array_length(_pts) - 1];
+    return [_last[0], _last[1]];
+}
+
+
+// GNX DEBUG toggle RAID ROUTES: every mod stage's route (yellow), its path points (red) and button box (cyan)
+function gnx_draw_stage_routes()
+{
+    if (!global.gnx_raid_routes)
+        exit;
+
+    for (var _i = 0; _i < array_length(global.gnx_stage_registry); _i++)
+    {
+        var _def = global.gnx_stage_registry[_i];
+
+        if (!is_struct(_def.route))
+            continue;
+
+        var _pts = _def.route.pts;
+
+        for (var _k = 1; _k < array_length(_pts); _k++)
+            draw_line_color(_pts[_k - 1][0], _pts[_k - 1][1], _pts[_k][0], _pts[_k][1], c_yellow, c_yellow);
+
+        for (var _k = 0; _k < array_length(_def.path); _k++)
+            draw_rectangle_color(_def.path[_k][0] - 1, _def.path[_k][1] - 1, _def.path[_k][0] + 1, _def.path[_k][1] + 1, c_red, c_red, c_red, c_red, false);
+
+        draw_rectangle_color(_def.x - 13, _def.y - 13, _def.x + 13, _def.y + 13, c_aqua, c_aqua, c_aqua, c_aqua, true);
+    }
+}
+
+
+// where the raid cart is on the world map while a raid is out to a mod stage ([x, y]), else -1. Mod stages have no
+// cart sequence: the cart goes in a straight line from the nest to the stage and back, timed by the raid clock.
+function gnx_stage_cart_pos()
+{
+    if (!instance_exists(obj_np) || !instance_exists(obj_np.obj_raid))
+        return -1;
+
+    var _rd = obj_np.obj_raid.raid_data;
+    var _def = gnx_stage_def(_rd.stage);
+
+    if (_def == undefined || (_rd.raid_state != 1 && _rd.raid_state != 2) || _rd.max_time <= 0)
+        return -1;
+
+    var _half = _rd.max_time * 0.5;
+    // outbound: the clock runs from max_time down to half; back: from half down to 0
+    var _p = (_rd.raid_state == 1) ? clamp((_rd.max_time - _rd.time_left) / _half, 0, 1) : clamp(_rd.time_left / _half, 0, 1);
+    return gnx_route_at(_def.route, _p);
+}
+
+
+// Saves keep the vanilla shape (A1): the stage arrays hold the 5 vanilla stages only, and the mod stages' state
+// sits by name in global.val.gnx_stage_saved ({ "folder.ID": {info, sel, item} }), with the stages of mods that are
+// not loaded. A GNX or a game without mod stages then reads the save like any other. gnx_stage_pack turns a live
+// val (+ its raid_data) into that shape; scr_gnx_stage_apply turns it back (and reads the P1-P5 layout:
+// gnx_stage_keys + positions + gnx_stage_orphans).
+function gnx_stage_pack(arg0, arg1)
+{
+    var _v = arg0;
+    
+    if (!is_struct(_v) || !variable_struct_exists(_v, "stage_info"))
+        exit;
+    
+    var _saved = (variable_struct_exists(_v, "gnx_stage_saved") && is_struct(_v.gnx_stage_saved)) ? _v.gnx_stage_saved : {};
+    var _keys = (variable_struct_exists(_v, "gnx_stage_keys") && is_array(_v.gnx_stage_keys)) ? _v.gnx_stage_keys : [];
+    
+    if (variable_struct_exists(_v, "gnx_stage_orphans") && is_struct(_v.gnx_stage_orphans))
+    {
+        var _on = variable_struct_get_names(_v.gnx_stage_orphans);
+        
+        for (var _i = 0; _i < array_length(_on); _i++)
+        {
+            if (!variable_struct_exists(_saved, _on[_i]))
+                variable_struct_set(_saved, _on[_i], variable_struct_get(_v.gnx_stage_orphans, _on[_i]));
+        }
+        
+        variable_struct_remove(_v, "gnx_stage_orphans");
+    }
+    
+    for (var _i = 0; _i < array_length(_keys); _i++)
+    {
+        var _at = 5 + _i;
+        variable_struct_set(_saved, _keys[_i], 
+        {
+            info: (_at < array_length(_v.stage_info)) ? _v.stage_info[_at] : -1,
+            sel: (_at < array_length(_v.stage_lvl_sel)) ? _v.stage_lvl_sel[_at] : 0,
+            item: (_at < array_length(_v.stage_item)) ? _v.stage_item[_at] : []
+        });
+    }
+    
+    // the raid screen's stage by name; a save read without the mod sees no stage selected, or (a raid out there)
+    // the Village, so it never reads a stage it does not have
+    if (is_struct(arg1) && variable_struct_exists(arg1, "stage") && arg1.stage >= 5 && (arg1.stage - 5) < array_length(_keys))
+    {
+        arg1.gnx_stage_key = _keys[arg1.stage - 5];
+        arg1.stage = (arg1.raid_state == UnknownEnum.Value_0) ? -1 : 0;
+    }
+    
+    array_resize(_v.stage_info, min(5, array_length(_v.stage_info)));
+    array_resize(_v.stage_lvl_sel, min(5, array_length(_v.stage_lvl_sel)));
+    array_resize(_v.stage_item, min(5, array_length(_v.stage_item)));
+    
+    if (variable_struct_exists(_v, "gnx_stage_keys"))
+        variable_struct_remove(_v, "gnx_stage_keys");
+    
+    _v.gnx_stage_saved = _saved;
+}
+
+
+// Puts this map's mod stages at 5, 6, ... of the stage arrays, taking each stage's state by name from
+// gnx_stage_saved (or from a P1-P5 save's positions); a stage new to this save starts undiscovered, or
+// discovered at once, silently, when it has no unlock (A4). Stages whose mod is not loaded stay in gnx_stage_saved.
+// Also puts the raid screen's stage back. Run after every boot (fresh global.val), every load / travel arrival
+// (global.val from the save or the map snapshot) and after every save (which packed it).
+function scr_gnx_stage_apply()
+{
+    var _v = global.val;
+    var _rd = (instance_exists(obj_np) && variable_instance_exists(obj_np, "obj_raid") && instance_exists(obj_np.obj_raid)) ? obj_np.obj_raid.raid_data : undefined;
+    // whatever layout global.val is in (live, packed, P1-P5), packing first gives the one to read
+    gnx_stage_pack(_v, _rd);
+    var _saved = _v.gnx_stage_saved;
+    array_resize(global.base_raid_time, 5);
+    array_resize(global.reward, 5);
+    var _keys = [];
+    var _quiet = [];
+    var _log = gnx_log_open();
+    
+    for (var _i = 0; _i < array_length(global.gnx_stage_registry); _i++)
+    {
+        var _def = global.gnx_stage_registry[_i];
+        var _st = variable_struct_get(_saved, _def.key);
+        
+        if (_st != undefined)
+        {
+            variable_struct_remove(_saved, _def.key);
+            gnx_log_write(_log, "[GNX-STAGE] " + _def.key + " -> stage " + string(5 + _i) + "\n");
+        }
+        else
+        {
+            _st = { info: -1, sel: 0, item: [] };
+            
+            if (_def.unlock == undefined)
+                array_push(_quiet, 5 + _i);
+        }
+        
+        var _n = array_length(_def.levels);
+        var _item = is_array(_st.item) ? _st.item : [];
+        
+        // one loot list per level (a mod update may have added levels)
+        while (array_length(_item) < _n)
+            array_push(_item, []);
+        
+        // the fixed win reward of each level (vanilla global.reward[stage][level] = [gold, food])
+        var _rw = [];
+        
+        for (var _lv = 0; _lv < _n; _lv++)
+            array_push(_rw, [scr_set_item_data(UnknownEnum.Value_0, _def.levels[_lv].reward_gold, -1), scr_set_item_data(UnknownEnum.Value_1, _def.levels[_lv].reward_food, -1)]);
+        
+        array_push(_v.stage_info, _st.info);
+        array_push(_v.stage_lvl_sel, clamp(gnx_json_num(_st.sel, 0), 0, _n - 1));
+        array_push(_v.stage_item, _item);
+        array_push(global.base_raid_time, _def.raid_time);
+        array_push(global.reward, _rw);
+        array_push(_keys, _def.key);
+        _def.route = gnx_stage_build_route(_def);  // this map's nest
+    }
+    
+    _v.gnx_stage_keys = _keys;
+    
+    // A4: a stage without an unlock is simply there from the start, without a popup
+    for (var _q = 0; _q < array_length(_quiet); _q++)
+        scr_set_stage_data(_quiet[_q], 0, false);
+    
+    var _gone = variable_struct_get_names(_saved);
+    
+    if (array_length(_gone) > 0)
+        gnx_log_write(_log, "[GNX-STAGE] kept aside (mod not loaded here): " + string(_gone) + "\n");
+    
+    // the raid screen's stage, saved by name
+    if (is_struct(_rd) && variable_struct_exists(_rd, "gnx_stage_key"))
+    {
+        var _now = gnx_stage_index(_rd.gnx_stage_key);
+        
+        // nothing is lost: the troops stay in the formation, and the fight (losses, cage, loot) is settled when
+        // the cart reaches the stage; only the return's stage XP and events are skipped
+        if (_now == -1 && _rd.raid_state != UnknownEnum.Value_0)
+        {
+            gnx_log_write(_log, "[GNX-STAGE] WARN raid out to " + _rd.gnx_stage_key + ", which is not loaded: the raid is called off\n");
+            _rd.raid_state = UnknownEnum.Value_0;
+        }
+        
+        _rd.stage = _now;
+        variable_struct_remove(_rd, "gnx_stage_key");
+    }
+    
+    gnx_log_close(_log);
+}
+
+
+enum UnknownEnum
+{
+    Value_0,
+    Value_1,
+    Value_2,
+    Value_3,
+    Value_4,
+    Value_5,
+    Value_7 = 7,
+    Value_12 = 12,
+    Value_33 = 33,
+    Value_40 = 40,
+    Value_56 = 56
+}
