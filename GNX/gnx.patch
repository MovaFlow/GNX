+    var _a = _two ? gnx_json_num(arg0[0], -1) : gnx_json_num(arg0, -1);
+    var _b = _two ? gnx_json_num(arg0[1], -1) : _a;
+    
+    // && = and: every part must hold
+    if (_a >= 1 && _a <= 99 && _b >= _a && _b <= 99 && _a == floor(_a) && _b == floor(_b))
+        return [_a, _b];
