+function scr_gnx_travel_selector_activate()
+{
+    if (!instance_exists(source_id) || source_id.interact_type != 9060)
+        exit;
+    
+    var _w = source_id;
+    
+    if (button_num == 20)
+    {
+        global.w_spd = _w.prev_w_spd;
+
+        if (_w.reopen_raid)
+            obj_np.obj_raid.trans = true;
+        
+        with (obj_window)
+        {
+            if (interact_type == 1)
+                visible = true;
+        }
+        
+        with (obj_button)
+        {
+            if (interact_type == 9061)
+                instance_destroy();
+        }
+        
+        with (_w)
+            instance_destroy();
+        
+        exit;
+    }
+    
+    if (button_num == 21)
+    {
+        with (_w)
+            scr_gnx_travel_selector_enter();
+        
+        exit;
+    }
+    
+    var _d = 0;
+    
+    switch (button_num)
+    {
+        case 0:
+            _d = -1;
+            break;
+        
+        case 1:
+            _d = 1;
+            break;
+        
+        case 2:
+            _d = -10;
+            break;
+        
+        case 3:
+            _d = 10;
+            break;
+    }
+    
+    if (_d == 0)
+        exit;
+    
+    switch (travel_row)
+    {
+        case 0:
+            _w.carry_gold = clamp(_w.carry_gold + _d, 0, _w.max_gold);
+            break;
+        
+        case 1:
+            _w.carry_food = clamp(_w.carry_food + _d, 0, _w.max_food);
+            break;
+        
+        case 2:
+            _w.carry_goblins = clamp(_w.carry_goblins + _d, 0, _w.max_goblins);
+            break;
+    }
