+        array_push(_rows, { folder: _e.folder, name: _e.name, version: _e.version, status: _e.status, why: _e.why, installed: true, used: [], cells: 0, units: 0, requires: _e.requires, mod_id: _e.mod_id, description: variable_struct_exists(_e, "description") ? _e.description : "", author: variable_struct_exists(_e, "author") ? _e.author : "", adds: gnx_mod_adds(_e) });
