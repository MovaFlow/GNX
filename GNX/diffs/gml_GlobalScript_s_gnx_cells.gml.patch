+// an occupied cell to borrow for a probe: small (arg0 == -1) or of h_type arg0
+// a mod cell's monster sprite map (arg0) has a body sprite for leg suffix arg3 ("_leg1", "_any"...) in phase arg1 or its fallback arg2
+function gnx_ms_leg_has(arg0, arg1, arg2, arg3)
+{
+    var _v1 = variable_struct_get(arg0, arg1 + "_body_b" + arg3);
+    var _v2 = variable_struct_get(arg0, arg2 + "_body_b" + arg3);
