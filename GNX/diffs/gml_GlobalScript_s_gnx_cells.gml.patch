+/// GNX-UG: extra px of floor arg0's band (0 unless an underground cell stands on that floor).
+function gnx_floor_extra(arg0)
+{
+    // variable_global_exists: true once scr_gnx_load_mods has set the value
+    if (!variable_global_exists("gnx_floor_extra"))
