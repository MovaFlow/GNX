+    
+    // == 1: exactly one monster inside, so she follows it once it is in its ej. Only from the ej itself: a
+    // monster left alone in its ej_end keeps her in the loop, she never played that ej with it
+    if (_cej == -1 && _inside == 1)
+    {
+        for (var p = 0; p < _np; p++)
+        {
+            if (slot_data.gnx_pl[p].st == 4)
+                _cej = p;
+        }
+    }
+    
+    slot_data.gnx_pl_cej = _cej;
+    
+    if (_cej != -1)
+    {
+        // the ej pictures (phase_3, else her loop pictures) with the loop's frame count, as the monsters' ej
+        // strips; on the monster's frame during its ej, and on the frame the ej ended on during its ej_end
+        _ph = 3;
+        _cfc = _fl;
+        _cspd = 0;
+        
+        if (slot_data.gnx_pl[_cej].st == 4)
+            slot_data.gnx_pl_cejf = slot_data.gnx_pl[_cej].i;
+        
+        // ? : the frame kept, else the first one (a save from before this frame was kept)
+        _drive = variable_struct_exists(slot_data, "gnx_pl_cejf") ? slot_data.gnx_pl_cejf : 0;
+    }
+    else if (_cloop || _lead == -1)
+    {
+        _ph = 2;
+        _cfc = _fl;
+        _cspd = _fast ? _sp_fast : _sp_loop;
+    }
+    else
+    {
+        var _ls = slot_data.gnx_pl[_lead].st;
+        
+        if (_ls == 5 || _ls == 6)
+        {
+            // idle_start (phase 6) or start_loop (phase 7) frame by frame with the leading monster
+            _ph = (_ls == 5) ? 6 : 7;
+            _cfc = gnx_places_cnt(_ls, _fs, _fl, _in);
+            _cspd = 0;
+            _drive = slot_data.gnx_pl[_lead].i;
+        }
+        else
+        {
+            // the start: big cells draw it with phase_0 in step with the leading monster, the others with
+            // the idle pictures on their own clock (2 fps or physical.speed.start), as the vanilla base start
+            _ph = _big ? 0 : 1;
+            _cfc = _big ? _fs : gnx_cell_frames(1, 2);
+            _cspd = _big ? 0 : _sp_start;
+            
+            if (_big)
+                _drive = slot_data.gnx_pl[_lead].i;
+        }
+    }
+    
+    slot_data.gnx_pl_cph = _ph;
+    
+    if (slot_data.anim_struct.spr_type != _ph || slot_data.anim_struct.frame_c != _cfc)
+    {
+        scr_set_slot_spr_part(_ph);
+        slot_data.anim_struct.index = 0;
+        slot_data.anim_struct.frame_c = _cfc;
+        slot_data.anim_struct.spr_spd = _cspd;
+        slot_data.anim_struct.anim_spd = _cspd / 60;
+        
+        // into the loop: splash and squirt as the vanilla slow loop starts them
+        if (_ph == 2)
+        {
+            spawn_part[0] = true;
+            spawn_stream = true;
+            
+            if (slot_data.anim_struct.sp_state != -1 && floor(slot_data.anim_struct.sp_index) != 7)
+            {
+                slot_data.anim_struct.sp_index = 0;
+                slot_data.anim_struct.sp_timer = 0;
+                slot_data.anim_struct.sp_state = -1;
+                scr_create_sp_drip(slot_data, depth - 1, true);
+            }
+        }
+    }
+    else if (slot_data.anim_struct.spr_spd != _cspd)
+    {
+        slot_data.anim_struct.spr_spd = _cspd;
+        slot_data.anim_struct.anim_spd = _cspd / 60;
+    }
+    
+    // != -1: in step with the leading monster (its speed moves her, her own is 0)
+    if (_drive != -1)
+        slot_data.anim_struct.index = _drive;
+    
+    var _old_index = slot_data.anim_struct.index;
+    slot_data.anim_struct.index += slot_data.anim_struct.anim_spd * _w;
+    
+    // slap sound and squirt on the captive's loop, as the vanilla loops (GNX-PLACES-EJ: && _cej == -1 = not
+    // while she plays an ej with a monster)
+    if (_cloop && _cej == -1 && floor(_old_index) != floor(slot_data.anim_struct.index))
+    {
+        scr_play_slap_sfx(2);
+        scr_create_sq_effect(gnx_key_frame(2, 5), _fast ? 0.5 : 0.3, _fast ? 60 : 35, slot_data.slot_floor, 0);
+    }
+    
+    scr_animation_end(true, slot_data.anim_struct.frame_c);
+    
+    if (_cloop && _cej == -1 && animation_end && irandom_range(0, 100) < 15)
+        scr_create_sp_drip(slot_data, depth - 1, false);
+    
+    // a monster began its ej: its sound and a squirt now
+    if (_ej_now)
+    {
+        scr_create_sq_effect(floor(slot_data.anim_struct.index), 0.7, 100, slot_data.slot_floor, 0);
+        scr_play_ej_sfx();
+    }
+    
+    // one monster done: it alone leaves (payout, mon_exit); scr_unit_removal reads the place from
+    // gnx_leave_place and keeps the scene running for the others
+    if (_leave != -1)
+    {
+        slot_data.gnx_pl[_leave] = gnx_places_blank();
+        slot_data.gnx_leave_place = _leave;
+        scr_unit_removal(true, false, false, false, -1);
+        var _left = false;
+        
+        for (var p = 0; p < array_length(slot_data.mon_placement); p++)
+        {
+            if (slot_data.mon_placement[p] != -1)
+                _left = true;
+        }
+        
+        // the last one has left: the frog shrine may swap the captive now, as after a vanilla scene
+        if (!_left)
+            scr_check_frog_unit_swap(slot_data.h_type);
+    }
+    
+    scr_slot_call_mon(true);
 }
