--- gml_138/gml_GlobalScript_s_gnx_props.gml	1970-01-01 01:00:00.000000000 +0100
+++ gml/gml_GlobalScript_s_gnx_props.gml	1970-01-01 01:00:00.000000000 +0100
@@ -0,0 +1,2340 @@
+// GNX: props.json: registration, effects, reactions, counters, menu groups
+// (moved out of s_initials.gml; the functions are global, callable from any script)
+
+// GNX-FLOOR: prop arg2 in row arg1 (7 top, 8 mid, 9 bot) on every passage of floor arg0; when every one already
+// has it, it is taken off them all instead (the single passage's toggle, for the floor)
+function gnx_floor_toggle_prop(arg0, arg1, arg2)
+{
+    var _slots = gnx_floor_slots(arg0);
+    var _all = true;
+
+    for (var i = 0; i < array_length(_slots); i++)
+    {
+        if (!scr_check_prop_exists(_slots[i], arg1, arg2))
+            _all = false;
+    }
+
+    for (var i = 0; i < array_length(_slots); i++)
+    {
+        scr_clear_prop_pos(_slots[i], arg1);
+
+        if (!_all)
+            scr_create_prop(_slots[i], arg2, arg1, -1);
+    }
+}
+
+
+// GNX-PROPCAT: a prop's "category" (text, shown in capitals); "" when it has none or it is not text
+function gnx_prop_cat_key(arg0, arg1)
+{
+    if (!variable_struct_exists(arg0, "category"))
+        return "";
+    
+    if (!is_string(arg0.category) || string_length(arg0.category) == 0)
+    {
+        gnx_report_mod_error("Prop '" + arg1 + "': category must be text, not " + string(arg0.category) + "; the mod's name is used");
+        return "";
+    }
+    
+    return string_upper(arg0.category);
+}
+
+
+// GNX-PROPCAT: the group prop arg0 is listed under: its category, else its mod's name, else VANILLA
+function gnx_prop_cat_of(arg0)
+{
+    var _p = (arg0 >= 100) ? ds_map_find_value(global.prop_registry, arg0) : undefined;
+    
+    if (_p == undefined)
+        return "VANILLA";
+    
+    if (_p.category != "")
+        return _p.category;
+    
+    for (var i = 0; i < array_length(global.gnx_mod_list); i++)
+    {
+        var _e = global.gnx_mod_list[i];
+        
+        if (_e.folder == _p.mod_id || _e.mod_id == _p.mod_id)
+            return string_upper(_e.name);
+    }
+    
+    return string_upper(string(_p.mod_id));
+}
+
+
+// GNX-PROPCAT: the groups of a prop row (arg0 = global.unlock.edit_top / mid / bot), VANILLA first,
+// then in the order of the row
+function gnx_prop_cats(arg0)
+{
+    var _c = [];
+    var _v = false;
+    
+    for (var i = 0; i < array_length(arg0); i++)
+    {
+        var _k = gnx_prop_cat_of(arg0[i]);
+        
+        if (_k == "VANILLA")
+            _v = true;
+        else if (!array_contains(_c, _k))
+            array_push(_c, _k);
+    }
+    
+    if (_v)
+        array_insert(_c, 0, "VANILLA");
+    
+    return _c;
+}
+
+
+// GNX-PROPCAT: the props of row arg0 in group arg1, in the row's order
+function gnx_prop_in_cat(arg0, arg1)
+{
+    var _out = [];
+    
+    for (var i = 0; i < array_length(arg0); i++)
+    {
+        if (gnx_prop_cat_of(arg0[i]) == arg1)
+            array_push(_out, arg0[i]);
+    }
+    
+    return _out;
+}
+
+
+// GNX-PROPCAT: the props a prop list shows: the chosen group, else the whole row arg0
+function gnx_prop_row(arg0)
+{
+    return (variable_global_exists("gnx_prop_filter") && is_array(global.gnx_prop_filter)) ? global.gnx_prop_filter : arg0;
+}
+
+
+// GNX-PROPCAT: opens the props of row arg3 (list button type arg4: 7 top, 8 mid, 9 bot) for passage arg0 at
+// (arg1, arg2). A row whose props come from two groups or more first lists the groups (button type 9080).
+function gnx_open_prop_row(arg0, arg1, arg2, arg3, arg4)
+{
+    global.gnx_prop_filter = -1;
+    var _cats = gnx_prop_cats(arg3);
+    
+    if (array_length(_cats) >= 2)
+    {
+        global.gnx_prop_cat_open = { cats: _cats, row: arg3, type: arg4 };
+        scr_create_window_button_list(arg0, arg1, arg2, array_length(_cats), 0, 9080, scr_create_gnx_prop_cat_button, false);
+    }
+    else
+    {
+        scr_create_window_button_list(arg0, arg1, arg2, array_length(arg3), 0, arg4, scr_create_modify_prop, false);
+    }
+}
+
+
+// GNX-PROPCAT: the back arrow of a group's prop list (button type 9081: back to the groups)
+function scr_gnx_create_prop_back_button()
+{
+    scr_create_button_small();
+}
+
+
+// GNX-PROPCAT: one group button of the prop menu
+function scr_create_gnx_prop_cat_button()
+{
+    scr_create_button_slot(interact_type, button_num);
+    button_text = global.gnx_prop_cat_open.cats[button_num];
+    // the "new" dot while a prop of the group has not been seen yet, like the TOP / MID / BOT buttons
+    // (opening the group shows those props, which takes them off the new list)
+    var _ids = gnx_prop_in_cat(global.gnx_prop_cat_open.row, button_text);
+    
+    for (var i = 0; i < ds_list_size(global.new_button_list); i++)
+    {
+        var _nv = ds_list_find_value(global.new_button_list, i);
+        
+        if (_nv.prop_type != -1 && array_contains(_ids, _nv.prop_type))
+        {
+            spr_new_sel = spr_new_point;
+            break;
+        }
+    }
+    
+    // a long name (most often a mod's) is cut to the button's width, with ".." at the end, measured
+    // with the font the button draws in (scr_change_lang sets it per language)
+    scr_change_lang();
+    var _max = sprite_get_width(sprite_index) - 6;
+    
+    if (string_width(button_text) > _max)
+    {
+        while (string_length(button_text) > 1 && string_width(button_text + "..") > _max)
+            button_text = string_copy(button_text, 1, string_length(button_text) - 1);
+        
+        button_text += "..";
+    }
+    
+    draw_set_font(fnt_base_font_eng);
+}
+
+
+function scr_gnx_apply_prop_unlocks()
+{
+    var _n = array_length(global.gnx_registered_props);
+    
+    for (var _i = 0; _i < _n; _i++)
+    {
+        var _entry = global.gnx_registered_props[_i];
+        
+        if (variable_struct_exists(_entry, "locked") && _entry.locked == true)
+            continue;
+        
+        var _pid = _entry.prop_id;
+        var _pos = _entry.position;
+        var _unlock_key = (_pos == "top") ? "edit_top" : ((_pos == "mid") ? "edit_mid" : "edit_bot");
+        
+        if (!variable_struct_exists(global.unlock, _unlock_key))
+            continue;
+        
+        var _arr = variable_struct_get(global.unlock, _unlock_key);
+        
+        if (!is_array(_arr))
+            continue;
+        
+        var _found = false;
+        
+        for (var _j = 0; _j < array_length(_arr); _j++)
+        {
+            if (_arr[_j] == _pid)
+            {
+                _found = true;
+                break;
+            }
+        }
+        
+        if (!_found)
+            array_push(_arr, _pid);
+    }
+}
+
+
+function scr_gnx_migrate_prop_unlocks()
+{
+    var _cats = ["edit_top", "edit_mid", "edit_bot"];
+    var _ci = 0;
+    
+    repeat (array_length(_cats))
+    {
+        var _fname = _cats[_ci++];
+        
+        if (!variable_struct_exists(global.unlock, _fname))
+            continue;
+        
+        var _src = variable_struct_get(global.unlock, _fname);
+        
+        if (!is_array(_src))
+            continue;
+        
+        var _out = [];
+        var _si = 0;
+        
+        repeat (array_length(_src))
+        {
+            var _h = _src[_si++];
+            
+            if (_h < 100 || ds_map_exists(global.prop_registry, _h))
+                array_push(_out, _h);
+        }
+        
+        variable_struct_set(global.unlock, _fname, _out);
+    }
+    
+    scr_gnx_apply_prop_unlocks();
+}
+
+
+function scr_gnx_load_props(arg0, arg1)
+{
+    var _path = global.gnx_mods_root + arg0 + "/" + arg1;
+    
+    if (!file_exists(_path))
+    {
+        gnx_report_mod_error("Mod '" + arg0 + "': props file '" + arg1 + "' not found");
+        exit;
+    }
+    
+    var _f = file_text_open_read(_path);
+    var _raw = "";
+    
+    while (!file_text_eof(_f))
+        _raw += file_text_readln(_f);
+    
+    file_text_close(_f);
+    var _json;
+    
+    try
+    {
+        _json = json_parse(_raw);
+    }
+    catch (_e)
+    {
+        gnx_report_mod_error("Mod '" + arg0 + "': " + arg1 + " invalid (" + string(_e.message) + ")");
+        exit;
+    }
+    
+    var _sprites_dict = (is_struct(_json) && variable_struct_exists(_json, "sprites")) ? _json.sprites : undefined;
+    var _base_dir = global.gnx_mods_root + arg0 + "/";
+    var _props = (is_struct(_json) && variable_struct_exists(_json, "props")) ? _json.props : _json;
+    
+    if (!is_array(_props))
+    {
+        gnx_report_mod_error("Mod '" + arg0 + "': props must be an array or { props: [...] }");
+        exit;
+    }
+    
+    var _count = array_length(_props);
+    // GNX-FIX (audit 25): props really registered = how much the registry grew (skipped entries do not count)
+    var _reg0 = ds_map_size(global.prop_registry);
+    
+    for (var _i = 0; _i < _count; _i++)
+    {
+        // GNX-FIX: an entry that is no object (null, a number, text) stopped the game in
+        // scr_gnx_register_prop (audit P4); it is skipped with a mod error
+        if (!is_struct(_props[_i]))
+        {
+            gnx_report_mod_error("Mod '" + arg0 + "': props[" + string(_i) + "] must be an object like { \"id\": \"lamp\", ... }; skipped");
+            continue;
+        }
+        
+        scr_gnx_register_prop(_props[_i], arg0, _sprites_dict, _base_dir);
+    }
+    
+    var _reg_n = ds_map_size(global.prop_registry) - _reg0;
+    var _log = gnx_log_open();
+    // ? : the skipped ones are named only when there are some (< = fewer registered than listed)
+    gnx_log_write(_log, "[GNX] registered " + string(_reg_n) + " prop(s)" + ((_reg_n < _count) ? (", " + string(_count - _reg_n) + " skipped (see the mod errors)") : "") + "\n");
+    gnx_log_close(_log);
+}
+
+
+function scr_gnx_register_prop(arg0, arg1, arg2, arg3)
+{
+    var _id_str = variable_struct_exists(arg0, "id") ? arg0.id : "";
+    
+    if (!is_string(_id_str) || _id_str == "")
+    {
+        gnx_report_mod_error("Mod '" + arg1 + "': a prop has no \"id\" (or it is not text); skipped");
+        exit;
+    }
+    
+    var _full_id = arg1 + "." + _id_str;
+    
+    if (variable_global_exists("gnx_prop_name_to_id") && is_struct(global.gnx_prop_name_to_id) && variable_struct_exists(global.gnx_prop_name_to_id, _full_id))
+    {
+        gnx_report_mod_error("Prop '" + _full_id + "': this id is used twice in the mod; the second one is skipped");
+        exit;
+    }
+    
+    var _prop_id = gnx_hash_prop_id(_full_id);
+    var _hash_id = _prop_id;
+    var _tries = 0;
+    
+    // the next free number; at most 9900 tries (every number 100-9999 once), so it always ends
+    while (ds_map_exists(global.prop_registry, _prop_id) && _tries < 9900)
+    {
+        _prop_id = 100 + (((_prop_id - 100) + 1) % 9900);
+        _tries++;
+    }
+    
+    if (ds_map_exists(global.prop_registry, _prop_id))
+    {
+        gnx_report_mod_error("Prop '" + _full_id + "': no free prop number is left (100-9999); skipped");
+        exit;
+    }
+    
+    // GNX-PROP: two props whose names give the same number: the later one takes the next free number,
+    // so its number depends on the order the mods load in. Said in the log; quests and tools can use
+    // the name ("Mod.id") instead of the number, which stays right whatever the order.
+    if (_prop_id != _hash_id)
+    {
+        var _owner = ds_map_find_value(global.prop_registry, _hash_id);
+        // ? : the name of the prop that has the number, as far as its entry tells
+        var _owner_name = (is_struct(_owner) && variable_struct_exists(_owner, "gnx_name")) ? (string(_owner.mod_id) + "." + string(_owner.gnx_name)) : "another prop";
+        var _cl = gnx_log_open();
+        gnx_log_write(_cl, "[GNX-WARN] prop '" + _full_id + "': number " + string(_hash_id) + " is taken by '" + _owner_name + "', it gets " + string(_prop_id) + " (depends on the mod load order; refer to it by name)\n");
+        gnx_log_close(_cl);
+    }
+    
+    var _spr = -1;
+    
+    if (variable_struct_exists(arg0, "sprite"))
+    {
+        var _spr_ref = arg0.sprite;
+        
+        if (is_string(_spr_ref) && string_pos("gnx:", _spr_ref) == 1)
+        {
+            var _spr_key = string_delete(_spr_ref, 1, 4);
+            
+            if (arg2 != undefined)
+                _spr = gnx_resolve_sprite(arg2, _spr_key, arg3, -1);
+        }
+        else if (arg2 != undefined && is_string(_spr_ref))
+        {
+            _spr = gnx_resolve_sprite(arg2, _spr_ref, arg3, -1);
+        }
+    }
+    
+    // GNX-PROP: a prop without a usable sprite used to draw the first vanilla prop (spr_between_prop,
+    // frame 0) in its place; now it is a mod error and the prop draws nothing
+    if (_spr == -1)
+        gnx_report_mod_error("Prop '" + _full_id + "': sprite " + (variable_struct_exists(arg0, "sprite") ? ("'" + string(arg0.sprite) + "' was not found in the props file's \"sprites\", or its image file is missing") : "is missing") + "; the prop is drawn as nothing");
+    
+    var _position = variable_struct_exists(arg0, "position") ? arg0.position : "bot";
+    
+    // GNX-PROP: only top / mid / bot exist; anything else went to the bottom row with the top rows' depth
+    if (_position != "top" && _position != "mid" && _position != "bot")
+    {
+        gnx_report_mod_error("Prop '" + _full_id + "': position must be \"top\", \"mid\" or \"bot\", not " + string(_position) + "; \"bot\" is used");
+        _position = "bot";
+    }
+    
+    var _y_default = (_position == "top") ? -30 : ((_position == "mid") ? -10 : 0);
+    // GNX-PROP: "anchor": "center" puts the prop's x at the middle of the passage, as vanilla props are;
+    // "left" (the default, as before) at its left edge
+    var _anchor = variable_struct_exists(arg0, "anchor") ? string(arg0.anchor) : "left";
+    
+    if (_anchor != "left" && _anchor != "center")
+    {
+        gnx_report_mod_error("Prop '" + _full_id + "': anchor must be \"left\" or \"center\", not " + _anchor + "; \"left\" is used");
+        _anchor = "left";
+    }
+    
+    // GNX-PROP: animation: a sprite with 2 or more frames loops through all of them, at "speed" frames per
+    // second (0-60) or 8 when the key is left out ("speed": 0 keeps frame 0 only); a 1-frame sprite stays
+    // still. random_frame = each placed prop starts on a random frame, so neighbours are not in step.
+    // ? : picks the first value when the condition holds, else the second
+    var _spr_frames = (_spr != -1) ? gnx_sprite_get_number(_spr) : 1;
+    var _speed = variable_struct_exists(arg0, "speed") ? gnx_json_num_in(arg0.speed, 8, 0, 60, "prop " + _full_id, "speed") : ((_spr_frames >= 2) ? 8 : 0);
+    // GNX-FIX: JSON true arrives as 1, so it is read with gnx_json_bool (is_bool alone never saw it)
+    var _rand_frame = variable_struct_exists(arg0, "random_frame") && gnx_json_bool(arg0.random_frame, false, "prop " + _full_id, "random_frame");
+    // GNX-PROP: reactions to the cell next to the prop's passage (gnx_react_parse); undefined = none
+    var _react = variable_struct_exists(arg0, "react") ? gnx_react_parse(arg0.react, "prop " + _full_id, _spr_frames) : undefined;
+    
+    // && = and: frames that move on events do not loop by themselves, so a "speed" > 0 would do nothing
+    if (is_struct(_react) && _react.frames && variable_struct_exists(arg0, "speed") && _speed > 0)
+        gnx_report_mod_error("Prop '" + _full_id + "': speed does not loop a prop whose frames move on events (react); react.speed sets how fast \"play\" runs");
+    
+    // GNX-FIX (audit 25): the button text must be text; anything else is a mod error and the id is shown
+    var _disp = variable_struct_exists(arg0, "display_name_key") ? arg0.display_name_key : _id_str;
+    
+    if (!is_string(_disp))
+    {
+        gnx_report_mod_error("Prop '" + _full_id + "': display_name_key must be text, not " + string(_disp) + "; the id is shown");
+        _disp = _id_str;
+    }
+    
+    var _entry = 
+    {
+        prop_id: _prop_id,
+        display_name_key: _disp,
+        code_text: variable_struct_exists(arg0, "code_text") ? arg0.code_text : "?",
+        sprite: _spr,
+        position: _position,
+        // GNX-FIX: numbers and true / false checked (text or a list used to reach the placement maths)
+        price: variable_struct_exists(arg0, "price") ? floor(gnx_json_num_in(arg0.price, -1, -1, 99999999, "prop " + _full_id, "price")) : -1,
+        y_offset: variable_struct_exists(arg0, "y_offset") ? floor(gnx_json_num_in(arg0.y_offset, _y_default, -200, 200, "prop " + _full_id, "y_offset")) : _y_default,
+        x_random_range: variable_struct_exists(arg0, "x_random_range") ? floor(gnx_json_num_in(arg0.x_random_range, 0, 0, 64, "prop " + _full_id, "x_random_range")) : 0,
+        xscale_random: variable_struct_exists(arg0, "xscale_random") && gnx_json_bool(arg0.xscale_random, false, "prop " + _full_id, "xscale_random"),
+        locked: variable_struct_exists(arg0, "locked") && gnx_json_bool(arg0.locked, false, "prop " + _full_id, "locked"),
+        mod_id: arg1,
+        // GNX-PROPCAT: the group the prop is listed under in the edit menu ("" = its mod's name)
+        category: gnx_prop_cat_key(arg0, _full_id),
+        // GNX-PROP: the prop's own name (for the log), placement and animation
+        gnx_name: _id_str,
+        anchor: _anchor,
+        speed: _speed,
+        random_frame: _rand_frame,
+        // GNX-PROP: visual effects (pulse, float, rotate, color, glow), see gnx_fx_parse; undefined = none
+        fx: variable_struct_exists(arg0, "fx") ? gnx_fx_parse(arg0.fx, "prop " + _full_id, arg2, arg3, _spr) : undefined,
+        react: _react,
+        // GNX-PROP: a number drawn on the prop (gnx_counter_parse); undefined = none
+        counter: variable_struct_exists(arg0, "counter") ? gnx_counter_parse(arg0.counter, "prop " + _full_id, arg2, arg3, _spr) : undefined
+    };
+    ds_map_add(global.prop_registry, _prop_id, _entry);
+    
+    // a counter that no event changes stays at its start forever: most likely a forgotten "count"
+    if (is_struct(_entry.counter) && (!is_struct(_react) || !_react.counts))
+        gnx_report_mod_error("Prop '" + _full_id + "': counter: no react event has count or count_set, so it always shows 0");
+    
+    // GNX-PROP: counted, so cells only look for listening props when at least one mod has some
+    if (is_struct(_react))
+        global.gnx_react_props = (variable_global_exists("gnx_react_props") ? global.gnx_react_props : 0) + 1;
+    
+    if (!variable_global_exists("gnx_prop_name_to_id") || !is_struct(global.gnx_prop_name_to_id))
+        global.gnx_prop_name_to_id = {};
+    
+    variable_struct_set(global.gnx_prop_name_to_id, _full_id, _prop_id);
+    
+    // GNX-PROP: how many registered names hash to each number, so an older save is moved to names only where
+    // a number has a single possible owner (gnx_prop_restore, audit 18)
+    if (!variable_global_exists("gnx_prop_hash_count") || !is_struct(global.gnx_prop_hash_count))
+        global.gnx_prop_hash_count = {};
+    
+    var _hk = string(_hash_id);
+    variable_struct_set(global.gnx_prop_hash_count, _hk, (variable_struct_exists(global.gnx_prop_hash_count, _hk) ? variable_struct_get(global.gnx_prop_hash_count, _hk) : 0) + 1);
+    
+    if (_position == "top")
+        array_push(global.prop_order_top, _prop_id);
+    else if (_position == "mid")
+        array_push(global.prop_order_mid, _prop_id);
+    else
+        array_push(global.prop_order_bot, _prop_id);
+    
+    array_push(global.gnx_registered_props, _entry);
+    var _log = gnx_log_open();
+    // GNX-PROP: the name shown in the game too, so the log tells which prop is which
+    gnx_log_write(_log, "[GNX] prop '" + _full_id + "' -> id=" + string(_prop_id) + " pos=" + _position + " name=\"" + string(_entry.display_name_key) + "\"\n");
+    gnx_log_close(_log);
+}
+
+
+/// GNX-PROP: says which keys of block arg0 are not in the list arg1 (a typo would otherwise do nothing
+/// without a word). arg2 = who, arg3 = the block's name.
+function gnx_fx_check_keys(arg0, arg1, arg2, arg3)
+{
+    var _k = variable_struct_get_names(arg0);
+    
+    for (var i = 0; i < array_length(_k); i++)
+    {
+        if (!array_contains(arg1, _k[i]))
+            gnx_report_mod_error(gnx_err_who(arg2) + ": unknown key '" + _k[i] + "' in " + arg3 + " (known: " + string(arg1) + "); ignored");
+    }
+}
+
+
+/// GNX-PROP: reads a visual-effects block (arg0, the "fx" of a prop) into one struct the drawing reads
+/// every frame (arg1 = who, for the mod errors; arg2 / arg3 = the props file's sprites and folder, for glow
+/// masks; arg4 = the prop's sprite, to check a mask against it). Every part is optional:
+///   pulse  { scale 0-1 (default 0.05), alpha 0-1 (0), period s (2) }   size and fade breathe together
+///   float  { height px 0-64 (2), period s (3) }                         bobs up from its place and back
+///   rotate { speed deg/s -720..720 (0), swing deg 0-180 (0), period s (4) }  turns and/or swings
