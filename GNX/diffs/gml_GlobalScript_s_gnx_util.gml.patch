+function scr_gnx_watchdog()
+{
+    var _f = -1;
+    
+    with (obj_mon)
+    {
+        if (!variable_struct_exists(self, "mon_data"))
+            continue;
+        
+        if (!is_struct(mon_data))
+            continue;
+        
+        if (!variable_instance_exists(id, "scr_mon_draw") || scr_mon_draw == -1)
+        {
+            if (mon_data.mon_state != 1)
+                continue;
+            
+            if (mon_data.slot_id != -1 && instance_exists(mon_data.slot_id) && is_struct(mon_data.slot_id.unit_data) && variable_struct_exists(mon_data.slot_id, "slot_data") && mon_data.slot_id.slot_data.anim_struct != -1)
+            {
+                scr_set_mon_spr_data(mon_data.slot_id, -1);
+                
+                if (_f == -1)
+                    _f = gnx_log_open();
+                
+                gnx_log_write(_f, "[WATCHDOG] REPAIRED mon=" + string(id) + " slot=" + string(mon_data.slot_id) + " h=" + string(mon_data.slot_id.slot_data.h_type));
+                gnx_log_writeln(_f);
+            }
+            else if (mon_data.slot_id != -1 && instance_exists(mon_data.slot_id) && !is_struct(mon_data.slot_id.unit_data))
+            {
+                if (_f == -1)
+                    _f = gnx_log_open();
+                
+                gnx_log_write(_f, "[WATCHDOG] DETACH mon=" + string(id) + " slot=" + string(mon_data.slot_id) + " (no unit_data) state=" + string(mon_data.mon_state));
+                gnx_log_writeln(_f);
+                // POPRAWKA: usun z list celi i wyslij do drzwi (wczesniej zostawal niewidoczny potwor w stanie 1 bez celi)
+                gnx_mon_release_from_slot();
+                continue;
+            }
+        }
+        
+        if (visible && variable_struct_exists(mon_data, "slot_id"))
+        {
+            var _sid = mon_data.slot_id;
+            
+            if (_sid == -1 || !instance_exists(_sid))
+            {
+                if (_f == -1)
+                    _f = gnx_log_open();
+                
+                gnx_log_write(_f, "[WATCHDOG] obj_mon id=" + string(id) + " visible but slot_id destroyed");
+                gnx_log_writeln(_f);
+            }
+        }
+        
+        if (variable_struct_exists(mon_data, "spr_data") && is_struct(mon_data.spr_data) && variable_struct_exists(mon_data.spr_data, "h_type"))
+        {
+            var _ht = mon_data.spr_data.h_type;
+            
+            // POPRAWKA: is_numeric przepuszcza tez int64 (h_type celi z moda liczony przez gnx_hash_cell_id)
+            if (!is_numeric(_ht) || _ht < 0)
+            {
+                if (_f == -1)
+                    _f = gnx_log_open();
+                
+                gnx_log_write(_f, "[WATCHDOG] obj_mon id=" + string(id) + " spr_data.h_type invalid: " + string(_ht));
+                gnx_log_writeln(_f);
+            }
+        }
+    }
+    
+    with (obj_slot)
+    {
+        if (!variable_struct_exists(self, "slot_data"))
+            continue;
+        
+        if (!is_struct(slot_data))
+            continue;
+        
+        if (!variable_struct_exists(slot_data, "h_type"))
+            continue;
+        
+        if (is_struct(unit_data))
+        {
+            if (!is_struct(slot_data.anim_struct))
+            {
+                if (_f == -1)
+                    _f = gnx_log_open();
+                
+                gnx_log_write(_f, "[WATCHDOG] obj_slot id=" + string(id) + " has unit but no anim_struct, h_type=" + string(slot_data.h_type));
+                gnx_log_writeln(_f);
+            }
+        }
+    }
+    
+    if (_f != -1)
+        gnx_log_close(_f);
+}
+
+// ===== TEST EKONOMII (ECON PROBE) =====
+// Zdjecie stanu ekonomii: zloto, jedzenie, populacja potworow oraz ile cel z postacia jest w pasie, ktory dziala przy cullingu.
+function gnx_econ_snapshot()
+{
+    var _s =
+    {
+        money: global.val.money,
+        food: global.val.food,
+        day: global.val.day,
+        pop: 0,
+        cells: 0,
+        in_band: 0,
+        pregnant: 0,
+        t: current_time
+    };
+
+    // populacja: suma potworow wszystkich typow (-1 = typ zablokowany)
+    for (var _i = 0; _i < array_length(global.val.mon_num); _i++)
+    {
+        if (global.val.mon_num[_i] > 0)
+            _s.pop += global.val.mon_num[_i];
+    }
+
+    var _vy = camera_get_view_y(view_camera[0]);
+    var _vh = camera_get_view_height(view_camera[0]);
+
+    with (obj_slot)
+    {
+        if (!is_struct(unit_data))
+            continue;
+
+        _s.cells++;
+
+        // ten sam pas co culling krokow w obj_slot Step
+        if (y >= (_vy - 400) && y <= (_vy + _vh + 400))
+            _s.in_band++;
+
+        if (variable_struct_exists(unit_data, "preg") && unit_data.preg != -1)
+            _s.pregnant++;
+    }
+
+    return _s;
+}
+
+
+// Zapis jednej linii raportu do gnx_debug.txt
+function gnx_econ_log(arg0)
+{
+    var _f = gnx_log_open();
+    gnx_log_write(_f, arg0);
+    gnx_log_writeln(_f);
+    gnx_log_close(_f);
+}
