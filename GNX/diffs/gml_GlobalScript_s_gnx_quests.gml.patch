+
+    // && = and: a class number written as text ("9"), string_digits keeps only its digits
+    if (is_string(_ref) && _ref != "" && string_digits(_ref) == _ref)
+        _ref = real(_ref);
+
+    // gnx_tool_resolve_class: numbers stay, names are looked up (-1 = not found)
+    var _cls = (_ref == undefined) ? -1 : gnx_tool_resolve_class(_ref, arg2);
+    
+    // < 0 || !...: not found, or a number no class has
+    if (!is_numeric(_cls) || _cls < 0 || !ds_map_exists(global.class_registry, _cls))
+    {
+        gnx_report_mod_error("Mod '" + string(arg2) + "': create_unit / unit reward: class " + string(arg0) + " not found; no captive given");
+        return undefined;
+    }
+    
+    var _lvl = floor(arg1);
+    var _cr = ds_map_find_value(global.class_registry, _cls);
+    // && = and: the class is marked special
+    var _special = variable_struct_exists(_cr, "is_special") && _cr.is_special;
+    
+    // != && !=: special classes take 5, 6 or 7; the others at most 4, or 6
+    if (_special)
+    {
+        if (_lvl != 6 && _lvl != 7)
+            _lvl = 5;
+    }
+    else if (_lvl != 6 && _lvl > 4)
+    {
+        _lvl = 4;
+    }
+    
+    return scr_create_unit_base(_cls, max(0, _lvl));
+}
