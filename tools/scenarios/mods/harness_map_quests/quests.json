{
  "events": {
    "e_on_map": {
      "type": "notification",
      "side_effects": [
        {
          "type": "set_state",
          "key": "arrived_map",
          "value": 1
        }
      ],
      "next_event": null
    },
    "e_home": {
      "type": "notification",
      "side_effects": [
        {
          "type": "set_state",
          "key": "back_home",
          "value": 1
        },
        {
          "type": "unlock_map",
          "map": "harness_gated"
        }
      ],
      "next_event": null
    }
  },
  "triggers": [
    {
      "event": "e_on_map",
      "hook": "map_arrive",
      "conditions": [
        {
          "type": "on_map",
          "map": "harness_map"
        }
      ]
    },
    {
      "event": "e_home",
      "hook": "map_arrive",
      "conditions": [
        {
          "type": "on_map",
          "map": "vanilla"
        },
        {
          "type": "map_visited",
          "map": "harness_map"
        }
      ]
    }
  ]
}
