+            }
+            
+            if (_s.until_left == -1)
+                _s.until_left = _st.until_raid_idle;
+            
+            _s.until_left--;
+            
+            if (_s.until_left <= 0)
+            {
+                scr_gnx_scn_check("until_raid_idle", false, "raid still out (state " + string(_rs) + ") after " + string(_st.until_raid_idle) + " frames");
+                _s.until_left = -1;
+                continue;
+            }
+            
+            _s.idx--;  // re-run this step next frame
+            exit;
+        }
+        else if (variable_struct_exists(_st, "travel_with"))
+        {
+            // {"travel_with": {"to": "map", "gold": n, "food": n, "goblins": n}}: the real pre-travel selector,
+            // confirmed with those amounts (clamped to its maxima like the +/- buttons)
+            var _tw = _st.travel_with;
+            var _sel = scr_gnx_create_travel_selector({ target: _tw.to, label: _tw.to });
+            
+            if (_sel == -1)
+            {
+                gnx_scn_log("travel_with: selector refused to open");
+                continue;
+            }
+            
+            with (_sel)
+            {
+                carry_gold = clamp(variable_struct_exists(_tw, "gold") ? _tw.gold : 0, 0, max_gold);
+                carry_food = clamp(variable_struct_exists(_tw, "food") ? _tw.food : 0, 0, max_food);
+                carry_goblins = clamp(variable_struct_exists(_tw, "goblins") ? _tw.goblins : 0, 0, max_goblins);
+                gnx_scn_log("travel_with " + target_mod + " gold=" + string(carry_gold) + " food=" + string(carry_food) + " goblins=" + string(carry_goblins));
+                scr_gnx_travel_selector_enter();
+            }
+            
+            if (!scr_gnx_travel_pending())
+            {
+                gnx_scn_log("travel_with refused (no travel triggered)");
+                continue;  // still on the same map: don't wait for a reload that never comes
+            }
+            
+            obj_np.gnx_scn_old = true;
+            _s.awaiting = true;
+            exit;
+        }
+        else if (variable_struct_exists(_st, "reload"))
+        {
+            // same teardown as quit-to-menu, then load slot 9 instead of showing the menu
+            for (var i = 0; i <= global.val.floor; i++)
