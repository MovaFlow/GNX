{
  "about": "Custom types P2: declared range/skills/icon/heads/infant_head reach the raid tables (wolf), and a type without them copies its like's rows and art (bear like ogre).",
  "fixture": "mid",
  "mods": ["tools/scenarios/mods/harness_type_a", "tools/scenarios/mods/harness_type_b"],
  "steps": [
    {"wait": 30},
    {"assert": "fn", "name": "gnx_scn_mon_tables", "args": [{"mon": "wolf"}], "is": "range=[ [ 0,1 ],[ 1 ],[ 0 ],[ 1 ] ] skills=[ 0,5,2,1 ] icon=own heads=own infant=own"},
    {"assert": "fn", "name": "gnx_scn_mon_tables", "args": [{"mon": "bear"}], "is": "range=[ [ 1 ],[ 0 ],[ 0 ],[ 1 ] ] skills=[ 12,13,14,15 ] icon=like heads=like infant=like"},
    {"assert": "fn", "name": "gnx_scn_mon_tables", "args": [3], "is": "range=[ [ 1 ],[ 0 ],[ 0 ],[ 1 ] ] skills=[ 12,13,14,15 ] icon=like heads=like infant=like"},
    {"save": 9},
    {"reload": 9},
    {"wait": 30},
    {"assert": "fn", "name": "gnx_scn_mon_tables", "args": [{"mon": "wolf"}], "is": "range=[ [ 0,1 ],[ 1 ],[ 0 ],[ 1 ] ] skills=[ 0,5,2,1 ] icon=own heads=own infant=own"}
  ]
}
