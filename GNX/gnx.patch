+        var _inf = gnx_ug_infant();
+        _src = "prop";
+        _data = undefined;
+        
+        if (_inf != noone && variable_instance_exists(_inf, "prop_data") && is_struct(_inf.prop_data) && variable_struct_exists(_inf.prop_data, "mon_data"))
+            _data = _inf.prop_data.mon_data;
+    }
+    
