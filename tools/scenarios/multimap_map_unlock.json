{
  "about": "A map that unlocks later: harness_map_gated's map_button has \"unlock\": {\"type\": \"gold_gte\", \"value\": 5000}. Hidden in the travel menu and on the world map until the condition holds once; then a toast announces it, every map lists it (shared unlock), and it stays unlocked through a save/reload with the gold gone.",
  "mods": [
    "tools/scenarios/mods/harness_map",
    "tools/scenarios/mods/harness_map_gated"
  ],
  "timeout": 120,
  "steps": [
    {
      "wait": 30
    },
    {
      "open_raid": true
    },
    {
      "wait": 3
    },
    {
      "press_travel_hud": true
    },
    {
      "wait": 2
    },
    {
      "assert": "travel_menu",
      "targets": [
        "harness_map"
      ],
      "why": "Gated Map stays hidden below 5000 gold"
    },
    {
      "press_travel_menu": "close"
    },
    {
      "open_raid": false
    },
    {
      "wait": 3
    },
    {
      "do": {
        "type": "add_gold",
        "amount": 6000
      }
    },
    {
      "wait": 70
    },
    {
      "assert": "popup_shown",
      "contains": "New map"
    },
    {
      "open_raid": true
    },
    {
      "wait": 3
    },
    {
      "screenshot": "world_map_unlocked"
    },
    {
      "press_travel_hud": true
    },
    {
      "wait": 2
    },
    {
      "assert": "travel_menu",
      "targets": [
        "harness_map",
        "harness_gated"
      ]
    },
    {
      "press_travel_menu": "close"
    },
    {
      "open_raid": false
    },
    {
      "wait": 3
    },
    {
      "travel_with": {
        "to": "harness_map",
        "gold": 6000
      }
    },
    {
      "wait": 40
    },
    {
      "open_raid": true
    },
    {
      "wait": 3
    },
    {
      "press_travel_hud": true
    },
    {
      "wait": 2
    },
    {
      "assert": "travel_menu",
      "targets": [
        "vanilla",
        "harness_gated"
      ],
      "why": "the unlock is shared by every map"
    },
    {
      "press_travel_menu": "close"
    },
    {
      "open_raid": false
    },
    {
      "wait": 3
    },
    {
      "travel": "vanilla"
    },
    {
      "wait": 40
    },
    {
      "assert": "val",
      "key": "money",
      "is": 0,
      "why": "all the gold went to map A"
    },
    {
      "save": 9
    },
    {
      "reload": 9
    },
    {
      "wait": 30
    },
    {
      "open_raid": true
    },
    {
      "wait": 3
    },
    {
      "press_travel_hud": true
    },
    {
      "wait": 2
    },
    {
      "assert": "travel_menu",
      "targets": [
        "harness_map",
        "harness_gated"
      ],
      "why": "once unlocked, it stays unlocked (saved), even back under 5000 gold"
    },
    {
      "press_travel_menu": "harness_gated"
    },
    {
      "wait": 2
    },
    {
      "press_travel_button": {
        "num": 21
      }
    },
    {
      "wait": 40
    },
    {
      "assert": "active_map",
      "is": "harness_gated"
    }
  ]
}