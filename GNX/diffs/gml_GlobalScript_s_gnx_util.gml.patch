+// GNX: logging and small shared helpers
+// (moved out of s_initials.gml; the functions are global, callable from any script)
+
+/// GNX-PROP: a shallow copy of struct arg0 (the same keys and values; lists and structs inside are shared)
+function gnx_struct_copy(arg0)
+{
+    var _c = {};
+    var _k = variable_struct_get_names(arg0);
+    
+    for (var i = 0; i < array_length(_k); i++)
+        variable_struct_set(_c, _k[i], variable_struct_get(arg0, _k[i]));
+    
+    return _c;
+}
+
+
+// ---------------------------------------------------------------------------
+// GNX debug log, buffered. Opening gnx_debug.txt costs ~20 ms per open (GameMaker's text append), and the
+// loader alone writes ~600 lines on every load and every map change: that was the load / travel lag.
+// Lines collect in memory and are written with one open per frame (gnx_log_flush: end of each frame in
+// scr_room_step, end of the loader, before game_end). A crash loses at most its own frame's lines.
+// ---------------------------------------------------------------------------
+
+function gnx_log_open()
+{
+    if (!variable_global_exists("gnx_log_buf"))
+        global.gnx_log_buf = "";
+    
+    return 1;
+}
+
+
+function gnx_log_write(arg0, arg1)
+{
+    global.gnx_log_buf += string(arg1);
+}
+
+
+function gnx_log_writeln(arg0)
+{
+    global.gnx_log_buf += chr(10);
+}
+
+
+function gnx_log_close(arg0)
+{
+}
+
+
+function gnx_log_flush()
+{
+    if (variable_global_exists("gnx_scn_buf") && global.gnx_scn_buf != "")
+    {
+        var _sf = file_text_open_append("gnx_scenario.txt");
+        file_text_write_string(_sf, global.gnx_scn_buf);
+        file_text_close(_sf);
+        global.gnx_scn_buf = "";
+    }
+
+    if (!variable_global_exists("gnx_log_buf") || global.gnx_log_buf == "")
+        exit;
+    
+    var _f = file_text_open_append("gnx_debug.txt");
+    file_text_write_string(_f, global.gnx_log_buf);
+    file_text_close(_f);
+    global.gnx_log_buf = "";
+}
+
+
+// one "[GNX-TIME] label = N ms" line (arg1 = get_timer() at the start)
+function gnx_time_log(arg0, arg1)
+{
+    var _l = gnx_log_open();
+    gnx_log_write(_l, "[GNX-TIME] " + arg0 + " = " + string((get_timer() - arg1) / 1000) + " ms" + chr(10));
+    gnx_log_close(_l);
+}
+
+
+function gnx_array_has(arg0, arg1)
+{
+    for (var _i = 0; _i < array_length(arg0); _i++)
+    {
+        if (arg0[_i] == arg1)
+            return true;
+    }
+
+    return false;
+}
+
+
+// the numbers of version text arg0: "1.5.0" gives [1, 5, 0]. Parts are split on dots; letters before the first
+// digit are skipped ("v1.5") and the text stops at anything else after it ("1.5.0-beta" is 1.5.0)
+function gnx_version_parts(arg0)
+{
+    var _s = string(arg0);
+    var _parts = [];
+    var _cur = "";
+    var _started = false;
+    
+    for (var _i = 1; _i <= string_length(_s); _i++)
+    {
+        var _c = string_char_at(_s, _i);
+        
+        if (string_digits(_c) == _c)
+        {
+            _cur += _c;
+            _started = true;
+        }
+        else if (_c == "." && _started)
+        {
+            array_push(_parts, (_cur == "") ? 0 : real(_cur));
+            _cur = "";
+        }
+        else if (_started)
+        {
+            break;
+        }
+    }
+    
+    array_push(_parts, (_cur == "") ? 0 : real(_cur));
+    return _parts;
+}
+
+
+// true when version text arg0 is older than arg1 ("1.4.9" < "1.5" < "1.5.1"; missing parts count as 0)
+function gnx_version_less(arg0, arg1)
+{
+    var _a = gnx_version_parts(arg0);
+    var _b = gnx_version_parts(arg1);
+
+    for (var _i = 0; _i < max(array_length(_a), array_length(_b)); _i++)
+    {
+        var _x = (_i < array_length(_a)) ? _a[_i] : 0;
+        var _y = (_i < array_length(_b)) ? _b[_i] : 0;
+
+        if (_x != _y)
+            return _x < _y;
+    }
+
+    return false;
+}
+
+
+/// GNX-PROP: whole number arg0 as text, at least arg1 digits (leading zeros), built digit by digit, so
+/// the text never turns into "1e+09" or gets decimals whatever the number
+function gnx_int_text(arg0, arg1)
+{
+    var _n = max(0, floor(arg0));
+    var _s = "";
+    
+    // do ... until: runs at least once, so 0 gives "0"; mod 10 = the last digit, div 10 drops it
+    do
+    {
+        _s = chr(48 + (_n mod 10)) + _s;
+        _n = _n div 10;
+    }
+    until (_n <= 0);
+    
+    while (string_length(_s) < arg1)
+        _s = "0" + _s;
+    
+    return _s;
+}
+
+
+// 4629728 -> "4.6M", 18240 -> "18k" (short numbers for the selector's narrow columns)
+function gnx_short_num(arg0)
+{
+    if (arg0 < 10000)
+        return string(arg0);
+    
+    if (arg0 < 1000000)
+        return string(floor(arg0 / 1000)) + "k";
+    
+    return string_format(arg0 / 1000000, 1, 1) + "M";
+}
