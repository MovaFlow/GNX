+// map_start helpers: a monster type given as a name or a number (-1 = unknown)
+function gnx_mon_type_ref(arg0)
+{
+    if (is_real(arg0))
+        return (arg0 >= 0 && arg0 <= 3) ? arg0 : -1;
+
+    switch (arg0)
+    {
+        case "goblin": return 0;
+        case "hobgoblin": return 1;
+        case "tentacle": return 2;
+        case "ogre": return 3;
+    }
+
+    return -1;
+}
