+// Called at the end of scr_main_end_step, i.e. once per frame in rm_game after the load finished
+// removes every prop of type arg1 from the prop array arg0 (in place, back to front); returns how many are left
+function gnx_prop_array_remove_type(arg0, arg1)
+{
+    for (var _i = array_length(arg0) - 1; _i >= 0; _i--)
+    {
+        if (arg0[_i].prop_type == arg1)
+            array_delete(arg0, _i, 1);
+    }
+
+    return array_length(arg0);
+}
