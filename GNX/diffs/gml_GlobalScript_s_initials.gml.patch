+// "ok" when field arg0 of the prisoners never goes down (arg1 = 1) or never goes up (arg1 = -1) along the
+// prison; true / false count as 1 / 0. Reads the fields directly, independent of gnx_prison_sort_key.
+// arg2 = "fertile": only prisoners that can get pregnant now (not pregnant, preg_c > 0) are compared, and
+// they must all come before the others.
+function gnx_scn_prison_monotone(arg0, arg1, arg2)
+{
+    var _last = undefined;
+    var _past_fertile = false;
+    
+    for (var i = 0; i < ds_list_size(global.unit_list); i++)
+    {
+        var _v = ds_list_find_value(global.unit_list, i);
+        
+        if (!is_struct(_v))
+            continue;
+        
+        if (arg2 == "fertile")
+        {
+            var _fertile = _v.preg == -1 && _v.preg_c > 0;
+            
+            if (!_fertile)
+            {
+                _past_fertile = true;
+                continue;
+            }
+            
+            if (_past_fertile)
+                return "fertile prisoner after a non-fertile one at " + string(i);
+        }
+        
+        var _f = variable_struct_get(_v, arg0);
+        _f = is_bool(_f) ? (_f ? 1 : 0) : _f;
+        
+        if (!is_undefined(_last) && ((arg1 == 1 && _f < _last) || (arg1 == -1 && _f > _last)))
+            return arg0 + " out of order at " + string(i);
+        
+        _last = _f;
+    }
