+    var _cut = max(0, ceil((global.gnx_clip_top - _top) / arg5));
+
+    // >= : the whole sprite lies above the clip line
+    if (_cut >= _h)
+        exit;
+
+    draw_sprite_part_ext(_src, _sub, _sx, _sy + _cut, _w, _h - _cut, arg2 - (_xo * arg4), _top + (_cut * arg5), arg4, arg5, arg7, arg8);
+}
+
+
+function gnx_draw_sprite_part_ext(arg0, arg1, arg2, arg3, arg4, arg5, arg6, arg7, arg8, arg9, arg10, arg11)
+{
+    if (is_sprref(arg0) && arg0.kind == "atlas")
+    {
+        var _n = array_length(arg0.frames);
+        
+        if (_n == 0)
+            exit;
+        
+        var _i = arg1 % _n;
+        
+        if (_i < 0)
+            _i += _n;
+        
+        var _f = arg0.frames[_i];
+        
+        if (_f.w <= 0 || _f.h <= 0)
+            exit;
+        
+        var _atlas_spr = variable_struct_exists(arg0, "multi") ? arg0.atlas_sprites[_f.atlas] : arg0.atlas;
+        if (!sprite_exists(_atlas_spr))
+            exit;
+        var _al = clamp(arg2, 0, _f.w);
+        var _at = clamp(arg3, 0, _f.h);
+        var _aw = clamp(arg4, 0, _f.w - _al);
+        var _ah = clamp(arg5, 0, _f.h - _at);
+        draw_sprite_part_ext(_atlas_spr, 0, _f.x + _al, _f.y + _at, _aw, _ah, arg6, arg7, arg8, arg9, arg10, arg11);
+        exit;
+    }
+    
+    if (is_sprref(arg0) && arg0.kind == "legacy")
+    {
+        draw_sprite_part_ext(arg0.spr, arg1, arg2, arg3, arg4, arg5, arg6, arg7, arg8, arg9, arg10, arg11);
+        exit;
+    }
+    
+    draw_sprite_part_ext(arg0, arg1, arg2, arg3, arg4, arg5, arg6, arg7, arg8, arg9, arg10, arg11);
+}
