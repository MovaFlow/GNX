--- gml_138/gml_GlobalScript_s_gnx_quests.gml
+++ gml/gml_GlobalScript_s_gnx_quests.gml
@@ -0,0 +1,1798 @@
+// GNX: quests, triggers, dialogs, popups, rewards
+// (moved out of s_initials.gml; the functions are global, callable from any script)
+
+// Mav (1.4.7.5): re-resolves names in classes.json conditions (raid_spawns, cage_escape, tower_boss_condition).
+// No cell existed yet while classes loaded, so "h_type": "Mod.Cell" stayed a string.
+// Already resolved values (numbers) are skipped, so it is safe to call more than once.
+// GNX-FIX: map_info.unlock too: it is read with the manifest, in the same phase as the classes.
+function scr_gnx_reresolve_class_conditions()
+{
+    if (variable_global_exists("gnx_encounter_pools") && ds_exists(global.gnx_encounter_pools, ds_type_map))
+    {
+        var _pk = ds_map_find_first(global.gnx_encounter_pools);
+        while (!is_undefined(_pk))
+        {
+            var _pool = ds_map_find_value(global.gnx_encounter_pools, _pk);
+            if (!is_undefined(_pool) && ds_exists(_pool, ds_type_list))
+            {
+                for (var _pi = 0; _pi < ds_list_size(_pool); _pi++)
+                {
+                    var _pe = ds_list_find_value(_pool, _pi);
+                    if (is_struct(_pe) && variable_struct_exists(_pe, "condition") && is_struct(_pe.condition) && variable_struct_exists(_pe, "mod_name"))
+                        scr_gnx_resolve_condition_refs(_pe.condition, _pe.mod_name);
+                }
+            }
+            _pk = ds_map_find_next(global.gnx_encounter_pools, _pk);
+        }
+    }
+    var _ck = ds_map_find_first(global.class_registry);
+    while (!is_undefined(_ck))
+    {
+        var _rc = ds_map_find_value(global.class_registry, _ck);
+        if (is_struct(_rc) && variable_struct_exists(_rc, "mod_name"))
+        {
+            if (variable_struct_exists(_rc, "post_raid") && is_struct(_rc.post_raid) && variable_struct_exists(_rc.post_raid, "cage_escape") && is_struct(_rc.post_raid.cage_escape) && variable_struct_exists(_rc.post_raid.cage_escape, "condition") && is_struct(_rc.post_raid.cage_escape.condition))
+                scr_gnx_resolve_condition_refs(_rc.post_raid.cage_escape.condition, _rc.mod_name);
+            if (variable_struct_exists(_rc, "tower_boss_condition") && is_struct(_rc.tower_boss_condition))
+                scr_gnx_resolve_condition_refs(_rc.tower_boss_condition, _rc.mod_name);
+        }
+        _ck = ds_map_find_next(global.class_registry, _ck);
+    }
+    
+    // GNX-FIX: map_info.unlock was read with the manifest (phase 1), before any mod cell existed, and was never
+    // read again: a map whose unlock named a mod cell ("h_type": "Mod.Cell") never opened
+    if (variable_global_exists("gnx_travel_locations") && is_array(global.gnx_travel_locations))
+    {
+        for (var _ti = 0; _ti < array_length(global.gnx_travel_locations); _ti++)
+        {
+            var _tl = global.gnx_travel_locations[_ti];
+            
+            // || = or: an object or a list of them (any other value was reported when the manifest was read)
+            if (variable_struct_exists(_tl, "unlock") && variable_struct_exists(_tl, "mod_name") && (is_struct(_tl.unlock) || is_array(_tl.unlock)))
+            {
+                // ? : = the list itself, or the one object put in a list
+                var _ul = is_array(_tl.unlock) ? _tl.unlock : [_tl.unlock];
+                
+                for (var _ui = 0; _ui < array_length(_ul); _ui++)
+                {
+                    if (is_struct(_ul[_ui]))
+                        scr_gnx_resolve_condition_refs(_ul[_ui], _tl.mod_name);
+                }
+            }
+        }
+    }
+}
+
+
+// GNX-FIX: a map mod loaded late (scr_gnx_load_deferred_map_mods: a save loaded from the menu, RELOAD MODS) brings
+// cells that other mods' quests may name; those names were read before the cells existed and stayed text, so they
+// never matched, even on that map. Every trigger condition, quest completion and side effect is read again
+// (numbers are skipped, so it is safe to call more than once).
+function gnx_reresolve_quest_refs()
+{
+    for (var _i = 0; _i < array_length(global.gnx_quest_triggers); _i++)
+    {
+        var _t = global.gnx_quest_triggers[_i];
+        
+        // && = and: a trigger with a list of conditions
+        if (is_struct(_t) && variable_struct_exists(_t, "conditions") && is_array(_t.conditions))
+        {
+            // is_struct: a condition that is no object was reported when the quests loaded
+            for (var _c = 0; _c < array_length(_t.conditions); _c++)
+            {
+                if (is_struct(_t.conditions[_c]))
+                    scr_gnx_resolve_condition_refs(_t.conditions[_c], _t.mod_name);
+            }
+        }
+    }
+    
+    var _k = ds_map_find_first(global.gnx_quest_events);
+    
+    // != = not equal: until the map has no more keys
+    while (_k != undefined)
+    {
+        var _e = ds_map_find_value(global.gnx_quest_events, _k);
+        
+        if (is_struct(_e) && variable_struct_exists(_e, "mod_name"))
+        {
+            if (variable_struct_exists(_e, "completion") && is_struct(_e.completion))
+                scr_gnx_resolve_condition_refs(_e.completion, _e.mod_name);
+            
+            // GNX-MULTI: each objective of a list (is_struct: an entry that is no object was reported at loading)
+            if (variable_struct_exists(_e, "completion") && is_array(_e.completion))
+            {
+                for (var _o = 0; _o < array_length(_e.completion); _o++)
+                {
+                    if (is_struct(_e.completion[_o]))
+                        scr_gnx_resolve_condition_refs(_e.completion[_o], _e.mod_name);
+                }
+            }
+            
+            if (variable_struct_exists(_e, "side_effects") && is_array(_e.side_effects))
+            {
+                for (var _s = 0; _s < array_length(_e.side_effects); _s++)
+                {
+                    if (is_struct(_e.side_effects[_s]))
+                        scr_gnx_resolve_side_effect_refs(_e.side_effects[_s], _e.mod_name);
+                }
+            }
+        }
+        
+        _k = ds_map_find_next(global.gnx_quest_events, _k);
+    }
+}
+
+function scr_gnx_load_quests(arg0, arg1)
+{
+    var _path = global.gnx_mods_root + arg0 + "/" + arg1;
+    
+    if (!file_exists(_path))
+    {
+        gnx_report_mod_error("Mod '" + arg0 + "': quests file '" + arg1 + "' not found");
+        exit;
+    }
+    
+    var _f = file_text_open_read(_path);
+    var _raw = "";
+    
+    while (!file_text_eof(_f))
+        _raw += file_text_readln(_f);
+    
+    file_text_close(_f);
+    var _data;
+    
+    try
+    {
+        _data = json_parse(_raw);
+    }
+    catch (_e)
+    {
+        gnx_report_mod_error("Mod '" + arg0 + "': " + arg1 + " invalid (" + string(_e.message) + ")");
+        exit;
+    }
+    
+    var _base_dir = global.gnx_mods_root + arg0 + "/";
+    var _log = gnx_log_open();
+    var _portrait_count = 0;
+    var _popup_count = 0;
+    var _event_count = 0;
+    var _trigger_count = 0;
+    
+    if (variable_struct_exists(_data, "portraits"))
+    {
+        var _pkeys = variable_struct_get_names(_data.portraits);
+        
+        for (var _pi = 0; _pi < array_length(_pkeys); _pi++)
+        {
+            var _pk = _pkeys[_pi];
+            var _pdef = variable_struct_get(_data.portraits, _pk);
+            var _strip_path = _base_dir + "portraits/" + _pdef.strip;
+            var _frames = gnx_opt(_pdef, "frames", 1);
+            var _full_key = arg0 + "." + _pk;
+            
+            if (file_exists(_strip_path))
+            {
+                var _cache_key = _strip_path;
+                var _spr = ds_map_find_value(global.gnx_sprite_cache, _cache_key);
+                
+                if (_spr == undefined)
+                {
+                    _spr = sprite_add(_strip_path, _frames, false, false, 0, 0);
+                    
+                    if (_spr != -1)
+                    {
+                        array_push(global.gnx_runtime_sprites, _spr);
+                        ds_map_add(global.gnx_sprite_cache, _cache_key, _spr);
+                    }
+                }
+                
+                if (_spr != -1)
+                {
+                    ds_map_add(global.gnx_portraits, _full_key, _spr);
+                    _portrait_count++;
+                }
+                else
+                {
+                    gnx_log_write(_log, "[GNX] portrait '" + _full_key + "': sprite_add failed\n");
+                }
+            }
+            else
+            {
+                gnx_log_write(_log, "[GNX] portrait '" + _full_key + "': file not found (" + _strip_path + ")\n");
+            }
+        }
+    }
+    
+    if (variable_struct_exists(_data, "popups"))
+    {
+        var _pkeys = variable_struct_get_names(_data.popups);
+        
+        for (var _pi = 0; _pi < array_length(_pkeys); _pi++)
+        {
+            var _pk = _pkeys[_pi];
+            var _full_key = arg0 + "." + _pk;
+            var _text = variable_struct_get(_data.popups, _pk);
+            ds_map_add(global.gnx_popups, _full_key, _text);
+            gnx_log_write(_log, "[GNX] popup " + _full_key + " = \"" + string(_text) + "\"\n");
+            _popup_count++;
+        }
+    }
+    
+    if (variable_struct_exists(_data, "events"))
+    {
+        var _ekeys = variable_struct_get_names(_data.events);
+        
+        for (var _ei = 0; _ei < array_length(_ekeys); _ei++)
+        {
+            var _ek = _ekeys[_ei];
+            var _edef = variable_struct_get(_data.events, _ek);
+            var _full_id = arg0 + "." + _ek;
+            _edef.mod_name = arg0;
+            _edef.event_id = _full_id;
+            
+            if (variable_struct_exists(_edef, "dialog"))
+            {
+                var _dlines = _edef.dialog;
+                
+                for (var _di = 0; _di < array_length(_dlines); _di++)
+                {
+                    var _line = _dlines[_di];
+                    
+                    if (is_string(_line.portrait))
+                    {
+                        var _pref = arg0 + "." + _line.portrait;
+                        var _pspr = ds_map_find_value(global.gnx_portraits, _pref);
+                        _line.portrait_spr = (_pspr != undefined) ? _pspr : -1;
+                    }
+                    else
+                    {
+                        _line.portrait_spr = _line.portrait;
+                    }
+                }
+            }
+            
+            if (variable_struct_exists(_edef, "next_event") && is_string(_edef.next_event))
+                _edef.next_event = arg0 + "." + _edef.next_event;
+            
+            // GNX-FIX: only a completion that is an object goes to the resolver; any other value (text, number)
+            // is reported just below (&& = and)
+            if (variable_struct_exists(_edef, "completion") && is_struct(_edef.completion))
+                scr_gnx_resolve_condition_refs(_edef.completion, arg0);
+            
+            // GNX-MULTI: a list of objectives: each one is read (an entry that is no object is reported there)
+            if (variable_struct_exists(_edef, "completion") && is_array(_edef.completion))
+            {
+                for (var _oi = 0; _oi < array_length(_edef.completion); _oi++)
+                    scr_gnx_resolve_condition_refs(_edef.completion[_oi], arg0);
+            }
+            
+            // GNX-FIX: a quest needs a completion condition (an object, GNX-MULTI: or a list of them that is not
+            // empty), and completion_hook is a text ("frame", "cell_built", "post_raid" ...); && = and, || = or, ! = not
+            if (_edef.type == "quest" && !gnx_completion_ok(_edef))
+                gnx_report_mod_error("Mod '" + arg0 + "': quest event '" + string(_full_id) + "' has no completion condition, so it never completes");
+            
+            if (variable_struct_exists(_edef, "completion_hook") && !is_string(_edef.completion_hook))
+            {
+                gnx_report_mod_error("Mod '" + arg0 + "': event '" + string(_full_id) + "': completion_hook must be a text such as \"cell_built\", not " + string(_edef.completion_hook) + "; \"frame\" is used");
+                _edef.completion_hook = "frame";
+            }
+            
+            if (variable_struct_exists(_edef, "side_effects"))
+            {
+                var _se = _edef.side_effects;
+                
+                for (var _si = 0; _si < array_length(_se); _si++)
+                    scr_gnx_resolve_side_effect_refs(_se[_si], arg0);
+            }
+            
+            ds_map_add(global.gnx_quest_events, _full_id, _edef);
+            gnx_log_write(_log, "[GNX] event " + _full_id + " type=" + _edef.type);
+            
+            if (_edef.type == "quest")
+                gnx_log_write(_log, " text=\"" + string(_edef.quest_text) + "\"");
+            
+            if (variable_struct_exists(_edef, "dialog"))
+                gnx_log_write(_log, " dialog=" + string(array_length(_edef.dialog)) + " lines");
+            
+            if (variable_struct_exists(_edef, "next_event") && _edef.next_event != undefined)
+                gnx_log_write(_log, " next=" + string(_edef.next_event));
+            
+            gnx_log_write(_log, "\n");
+            _event_count++;
+        }
+    }
+    
+    if (variable_struct_exists(_data, "triggers"))
+    {
+        var _trigs = _data.triggers;
+        
+        for (var _ti = 0; _ti < array_length(_trigs); _ti++)
+        {
+            var _tdef = _trigs[_ti];
+            _tdef.mod_name = arg0;
+            
+            if (is_string(_tdef.event))
+                _tdef.event = arg0 + "." + _tdef.event;
+            
+            if (variable_struct_exists(_tdef, "conditions"))
+            {
+                var _conds = _tdef.conditions;
+                
+                for (var _ci = 0; _ci < array_length(_conds); _ci++)
+                    scr_gnx_resolve_condition_refs(_conds[_ci], arg0);
+            }
+            
+            array_push(global.gnx_quest_triggers, _tdef);
+            var _nconds = variable_struct_exists(_tdef, "conditions") ? array_length(_tdef.conditions) : 0;
+            gnx_log_write(_log, "[GNX] trigger hook=" + _tdef.hook + " event=" + string(_tdef.event) + " conditions=" + string(_nconds) + "\n");
+            _trigger_count++;
+        }
+    }
+    
+    gnx_log_write(_log, "[GNX] quests loaded: " + string(_event_count) + " events, " + string(_trigger_count) + " triggers, " + string(_portrait_count) + " portraits, " + string(_popup_count) + " popups\n");
+    gnx_log_close(_log);
+}
+
+
+function scr_gnx_resolve_condition_refs(arg0, arg1)
+{
+    // GNX-FIX: a condition (quests, triggers, raid spawns, cage escape, tower boss, map unlock) must be an object
+    // ({"type": ...}); a text, number or list is a mod error and never matches (scr_gnx_eval_condition). Reading
+    // keys of it could stop the game (! = not)
+    if (!is_struct(arg0))
+    {
+        gnx_report_mod_error("Mod '" + string(arg1) + "': a condition is " + string(arg0) + ", not an object like {\"type\": \"state_equals\", ...}; it never matches");
+        exit;
+    }
+    
+    // GNX-FIX: an object without "type" matches nothing either (! = not)
+    if (!variable_struct_exists(arg0, "type"))
+        gnx_report_mod_error("Mod '" + string(arg1) + "': a condition has no \"type\"; it never matches");
+    
+    // GNX-FIX: cell_built, cell_occupied and cell_count need the cell's h_type; without it the condition never
+    // matches (is_struct: a condition is an object; && = and, || = or, ! = not)
+    // GNX-CELLSET: or a category (a build tab), which names every cell of it
+    if (is_struct(arg0) && variable_struct_exists(arg0, "type") && (arg0.type == "cell_built" || arg0.type == "cell_occupied" || arg0.type == "cell_count") && !variable_struct_exists(arg0, "h_type") && !variable_struct_exists(arg0, "category"))
+        gnx_report_mod_error("Mod '" + string(arg1) + "': quest condition " + string(arg0.type) + " has no h_type or category, so it never matches");
+    
+    // GNX-CELLSET: a category must be a build tab of cells.json ("breed" ... "ug_breed"), one or a list of them
+    if (variable_struct_exists(arg0, "category"))
+    {
+        // ? : the list, or the one value put in a list
+        var _cats = is_array(arg0.category) ? arg0.category : [arg0.category];
+        
+        for (var _ci = 0; _ci < array_length(_cats); _ci++)
+        {
+            // ! = not: no such tab
+            if (!gnx_cat_known(_cats[_ci]))
+                gnx_report_mod_error("Mod '" + string(arg1) + "': condition " + (variable_struct_exists(arg0, "type") ? string(arg0.type) : "?") + ": category '" + string(_cats[_ci]) + "' is not a cell category (breed, utility, pleasure, b_breed, b_utility, b_other, t_breed, t_utility, xl_breed, ug_breed); it names no cell");
+        }
+    }
+    
+    // GNX-CELLSET: h_type as a list: each name is read like a single h_type (numbers are kept). A new list is
+    // written back, so the read never depends on how this game copies lists
+    if (variable_struct_exists(arg0, "h_type") && is_array(arg0.h_type))
+    {
+        var _hl = [];
+        
+        for (var _hi = 0; _hi < array_length(arg0.h_type); _hi++)
+        {
+            var _hv = arg0.h_type[_hi];
+            
+            // is_string: a name; a number stays as it is
+            if (is_string(_hv))
+            {
+                var _lref = _hv;
+                
+                // == 0: no dot, so a cell of the mod itself
+                if (string_pos(".", _lref) == 0)
+                    _lref = arg1 + "." + _lref;
+                
+                var _lid = ds_map_find_value(global.gnx_cell_name_to_id, _lref);
+                
+                // != undefined: the cell is loaded; else the name stays text and matches nothing
+                if (_lid != undefined)
+                    _hv = _lid;
+                else
+                    gnx_ref_missing("cell", _lref, arg1);
+            }
+            
+            array_push(_hl, _hv);
+        }
+        
+        arg0.h_type = _hl;
+    }
+    
+    if (variable_struct_exists(arg0, "class") && is_string(arg0.class))
+    {
+        var _ref = arg0.class;
+        
+        if (string_pos(".", _ref) == 0)
+            _ref = arg1 + "." + _ref;
+        
+        var _cid = ds_map_find_value(global.gnx_class_name_to_id, _ref);
+        
+        if (_cid != undefined)
+            arg0.class = _cid;
+        else if (!global.gnx_loading_classes)
+            gnx_ref_missing("class", _ref, arg1);
+    }
+    
+    if (variable_struct_exists(arg0, "h_type") && is_string(arg0.h_type))
+    {
+        var _ref = arg0.h_type;
+        
+        if (string_pos(".", _ref) == 0)
+            _ref = arg1 + "." + _ref;
+        
+        var _hid = ds_map_find_value(global.gnx_cell_name_to_id, _ref);
+        
+        if (_hid != undefined)
+            arg0.h_type = _hid;
+        else if (!global.gnx_loading_classes)
+            gnx_ref_missing("cell", _ref, arg1);
+    }
+}
+
+
+// GNX-FIX: a reference arg1 ("folder.NAME") in a condition of mod arg2 that names no loaded class or cell (arg0 =
+// "class" or "cell"). It stays text, so the condition never matches: before, without a word. A mod that is installed
+// but has no such name (or the mod's own cell written without its folder, e.g. "MILK BAR" from another mod) is a mod
+// error; a mod that is not installed is only logged, so a quest can name an optional mod's content and never match
+// without it. Not while classes load (callers check gnx_loading_classes): no cell exists yet, nor the classes of later
+// mods (scr_gnx_reresolve_class_conditions asks again).
+// GNX-FIX: nothing is reported in phase 1 of a staged load (classes and manifests, gnx_staged_load): no mod cell
+// exists yet, and scr_gnx_reresolve_class_conditions reads those conditions again once every cell is loaded. A map
+// mod that is not loaded on this map counts as not installed (its content is on its own map). While a late map mod
+// load reads every name again (gnx_ref_report_only = the folders it loaded), only names in those mods' files or of
+// those mods' content are reported: the others were reported when they first loaded.
+function gnx_ref_missing(arg0, arg1, arg2)
+{
+    if (variable_global_exists("gnx_staged_load") && global.gnx_staged_load)
+        exit;
+
+    var _folder = string_copy(arg1, 1, string_pos(".", arg1) - 1);
+
+    // && = and, || = or, ! = not: a re-read limited to some mods, and neither the mod naming the reference (arg2) nor
+    // the reference's own mod is one of them
+    if (variable_global_exists("gnx_ref_report_only") && is_array(global.gnx_ref_report_only) && !(array_contains(global.gnx_ref_report_only, arg2) || array_contains(global.gnx_ref_report_only, _folder)))
+        exit;
+
+    // a map mod deferred on this map: on the list of mods to load later, and not declared for the map the player is on
+    var _away = array_contains(global.gnx_map_deferred_mods, _folder) && !gnx_map_decl_has(variable_struct_get(global.gnx_mod_map_decl, _folder), global.gnx_active_map);
+
+    if (array_contains(global.gnx_indexed_mods, _folder) && !_away)
+    {
+        gnx_report_mod_error("Mod '" + string(arg2) + "': " + arg0 + " \"" + arg1 + "\" not found, so it never matches. Name a mod's " + arg0 + " as \"<its folder>.<its name>\" (e.g. \"py_more_cells_mod.MILK BAR\"), a vanilla one by its number (guide, Appendix A)");
+    }
+    else
+    {
+        var _l = gnx_log_open();
+        gnx_log_write(_l, "[GNX] Mod '" + string(arg2) + "': " + arg0 + " \"" + arg1 + "\" belongs to mod '" + _folder + "', which is not installed or not loaded on this map: it never matches here\n");
+        gnx_log_close(_l);
+    }
+}
+
+
+function scr_gnx_resolve_side_effect_refs(arg0, arg1)
+{
+    if (variable_struct_exists(arg0, "h_type") && is_string(arg0.h_type))
+    {
+        var _ref = arg0.h_type;
+        
+        if (string_pos(".", _ref) == 0)
+            _ref = arg1 + "." + _ref;
+        
+        var _hid = ds_map_find_value(global.gnx_cell_name_to_id, _ref);
+        
+        if (_hid != undefined)
+            arg0.h_type = _hid;
+        else
+            gnx_ref_missing("cell", _ref, arg1);
+    }
+    
+    if (variable_struct_exists(arg0, "class") && is_string(arg0.class))
+    {
+        var _ref = arg0.class;
+        
+        if (string_pos(".", _ref) == 0)
+            _ref = arg1 + "." + _ref;
+        
+        var _cid = ds_map_find_value(global.gnx_class_name_to_id, _ref);
+        
+        if (_cid != undefined)
+            arg0.class = _cid;
+    }
+}
+
+
+function scr_gnx_check_triggers(arg0)
+{
+    var _n = array_length(global.gnx_quest_triggers);
+    
+    for (var _i = 0; _i < _n; _i++)
+    {
