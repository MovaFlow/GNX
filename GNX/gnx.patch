+    gnx_fx_check_keys(arg0, ["frame", "step", "play", "flash", "count", "count_set", "chance"], arg1, arg2);
+    // frame -1 = no jump; moves = it changes the frame (so the prop no longer loops by itself)
+    var _a = 
+    {
+        frame: -1,
+        step: 0,
+        play: 0,
+        flash_t: 0,
+        flash_col: c_white,
+        flash_a: 0.6,
+        play_stop: false,
+        count: 0,
+        count_set: -1,
+        chance: 1,
+        moves: false
+    };
+    
+    if (variable_struct_exists(arg0, "frame"))
+        _a.frame = floor(gnx_json_num_in(arg0.frame, 0, 0, max(0, arg3 - 1), arg1, arg2 + ".frame"));
+    
+    if (variable_struct_exists(arg0, "step"))
