{
  "about": "F38: a crossed out frog right of the captive's head (the place of the loading icon, mirrored) on every cell kept out of the frog shrine, by its floor or by itself, full or empty, on floors with an F.SHRINE; hidden with the heads. The cell window's frog row shows the crossed out frog while the swap is off.",
  "fixture": "mid",
  "check_boot_suite": false,
  "timeout": 150,
  "steps": [
    {
      "wait": 30
    },
    {
      "occupy": {
        "h_type": 12,
        "class": 0,
        "level": 1
      }
    },
    {
      "assert": "fn",
      "name": "gnx_scn_frog_set",
      "args": [
        true
      ],
      "is": 1
    },
    {
      "assert": "fn",
      "name": "gnx_scn_frog_marks",
      "args": [
        true
      ],
      "is": "0 0 0",
      "why": "no shrine on the floor"
    },
    {
      "assert": "fn",
      "name": "gnx_scn_frog_set",
      "args": [
        false
      ],
      "is": 1
    },
    {
      "assert": "fn",
      "name": "gnx_scn_frog_shrine",
      "args": [],
      "is": 1
    },
    {
      "assert": "fn",
      "name": "gnx_scn_frog_marks",
      "args": [
        true
      ],
      "is": "0 0 0",
      "why": "nothing is off"
    },
    {
      "call": "gnx_scn_open_occupied_window"
    },
    {
      "wait": 3
    },
    {
      "assert": "fn",
      "name": "gnx_scn_frog_icon2",
      "args": [],
      "is": "spr_gnx_frog_icon"
    },
    {
      "assert": "fn",
      "name": "gnx_scn_press_frog_row",
      "args": [],
      "is": 1
    },
    {
      "wait": 3
    },
    {
      "assert": "fn",
      "name": "gnx_scn_frog_icon2",
      "args": [],
      "is": "spr_gnx_frog_off_icon",
      "why": "crossed out at once"
    },
    {
      "assert": "fn",
      "name": "gnx_scn_frog_marks",
      "args": [
        true
      ],
      "is": "1 1 0",
      "why": "this cell only"
    },
    {
      "assert": "fn",
      "name": "gnx_scn_frog_marks",
      "args": [
        false
      ],
      "is": "0 0 0",
      "why": "heads hidden"
    },
    {
      "call": "gnx_scn_open_occupied_window"
    },
    {
      "wait": 3
    },
    {
      "assert": "fn",
      "name": "gnx_scn_frog_icon2",
      "args": [],
      "is": "spr_gnx_frog_off_icon",
      "why": "crossed out when opened"
    },
    {
      "assert": "fn",
      "name": "gnx_scn_frog_menu",
      "args": [
        true
      ],
      "is": "FROG: ON"
    },
    {
      "wait": 3
    },
    {
      "assert": "fn",
      "name": "gnx_scn_frog_menu_press",
      "args": [
        6
      ],
      "is": 1,
      "why": "the floor off"
    },
    {
      "wait": 3
    },
    {
      "assert": "fn",
      "name": "gnx_scn_frog_kept",
      "args": [],
      "is": 15
    },
    {
      "assert": "fn",
      "name": "gnx_scn_frog_marks",
      "args": [
        true
      ],
      "is": "15 1 0",
      "why": "every cell the shrine could swap"
    },
    {
      "call": "gnx_scn_open_occupied_window"
    },
    {
      "wait": 3
    },
    {
      "assert": "fn",
      "name": "gnx_scn_press_frog_row",
      "args": [],
      "is": 1,
      "why": "this cell on again"
    },
    {
      "wait": 3
    },
    {
      "assert": "fn",
      "name": "gnx_scn_frog_icon2",
      "args": [],
      "is": "spr_gnx_frog_icon"
    },
    {
      "assert": "fn",
      "name": "gnx_scn_frog_marks",
      "args": [
        true
      ],
      "is": "14 0 0",
      "why": "all but this one"
    },
    {
      "assert": "fn",
      "name": "gnx_scn_frog_menu",
      "args": [
        true
      ],
      "is": "FROG: OFF"
    },
    {
      "wait": 3
    },
    {
      "assert": "fn",
      "name": "gnx_scn_frog_menu_press",
      "args": [
        6
      ],
      "is": 1,
      "why": "the floor on"
    },
    {
      "wait": 3
    },
    {
      "assert": "fn",
      "name": "gnx_scn_frog_marks",
      "args": [
        true
      ],
      "is": "0 0 0",
      "why": "none"
    }
  ]
}