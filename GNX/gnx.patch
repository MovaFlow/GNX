+
+// Travel transition: the screen fades to black while a goblin with a backpack walks across, then the travel
+// runs (the load happens behind the black screen), then it fades back in on the destination map. One
+// persistent obj_empty (gnx_travel_fx) carries it through the room change.
+// phase 0 = fading out, 1 = travelling (black until the new map is up), 2 = fading in
+function scr_gnx_travel_fx_start(arg0, arg1)
+{
+    with (obj_empty)
+    {
+        if (variable_instance_exists(id, "gnx_travel_fx"))
+            instance_destroy();
+    }
+
+    var _fx = instance_create_depth(0, 0, -9990, obj_empty);
+
+    with (_fx)
+    {
+        gnx_travel_fx = true;
+        persistent = true;
+        gui = true;
+        target = arg0;
+        label = arg1;
+        phase = 0;
+        t = 0;
+        walk = 0;
+        scr_empty_step = scr_gnx_travel_fx_step;
+        scr_empty_draw = scr_gnx_travel_fx_draw;
+    }
+
+    global.click_lock = true;
+}
+
+// True while a travel has been confirmed but the destination is not loaded yet (scenario runner waits on it)
+function scr_gnx_travel_pending()
+{
+    if (variable_global_exists("gnx_trigger_load") && global.gnx_trigger_load)
+        return true;
+
+    var _p = false;
+
+    with (obj_empty)
+    {
+        if (variable_instance_exists(id, "gnx_travel_fx") && phase == 0)
+            _p = true;
+    }
+
+    return _p;
+}
+
+function scr_gnx_travel_fx_step()
+{
+    t++;
+    walk++;
+
+    switch (phase)
+    {
+        case 0:
+            global.click_lock = true;
+
+            if (t >= 40)
+            {
+                if (scr_gnx_travel(target))
+                {
+                    phase = 1;
+                    t = 0;
+                }
+                else
+                {
+                    // refused at the last moment (scr_gnx_travel logged why): give back what the selector took
+                    global.val.money += max(0, global.gnx_carry_gold);
+                    global.val.food += max(0, global.gnx_carry_food);
+
+                    if (global.gnx_carry_goblins > 0)
+                    {
+                        scr_mon_num_edit(0, 0, global.gnx_carry_goblins, true);
+                        global.val.nest_num[0] = scr_all_mon_num_cal();
+                    }
+
+                    global.gnx_carry_day = -1;
+                    global.gnx_carry_gold = -1;
+                    global.gnx_carry_food = -1;
+                    global.gnx_carry_goblins = -1;
+                    global.click_lock = false;
+                    scr_gnx_pop_up_create("Couldn't travel right now.");
+                    instance_destroy();
+                }
+            }
+
+            break;
+
+        case 1:
+            // hold black until the new map runs, plus a few frames for map_start / travel carry
+            if (room == rm_game && obj_np.load_state == 1 && instance_exists(obj_slot) && !global.gnx_trigger_load)
+            {
+                if (t > 10)
+                {
+                    phase = 2;
+                    t = 0;
+                }
+            }
+            else
+            {
+                t = 0;
+            }
+
+            global.click_lock = true;
+            break;
+
+        case 2:
+            if (t >= 30)
+            {
+                global.click_lock = false;
+                instance_destroy();
+            }
+
+            break;
+    }
+}
+
+function scr_gnx_travel_fx_draw()
+{
+    var _a = 1;
+
+    if (phase == 0)
+        _a = min(1, t / 14);
+    else if (phase == 2)
+        _a = 1 - (t / 30);
+
+    draw_set_alpha(_a);
+    draw_rectangle_color(0, 0, 480, 270, c_black, c_black, c_black, c_black, false);
+
+    // a goblin with a backpack walking along a dotted route (vanilla walk cycle + GNX backpack overlay)
+    var _sc = 2;
+    var _gx = 150 + (walk * 1.2);
+    var _gy = 200;
+    var _frame = floor(walk / 5) mod 8;
+    var _bob = [0, 1, 1, 0, 0, 1, 1, 0];
+
+    var _dot = make_color_rgb(255, 209, 34);
+    
+    for (var _dx = 90; _dx < (_gx - 24); _dx += 10)
+        draw_rectangle_color(_dx, _gy + 1, _dx + 2, _gy + 3, _dot, _dot, _dot, _dot, false);
+
+    draw_sprite_ext(spr_goblin_walk, _frame, _gx, _gy, _sc, _sc, 0, c_white, _a);
+    var _pack = asset_get_index("spr_gnx_travel_pack");
+
+    if (_pack >= 0 && sprite_exists(_pack))
+        draw_sprite_ext(_pack, 0, _gx + ((-3 - 14) * _sc), _gy + ((18 + _bob[_frame] - 45) * _sc), _sc, _sc, 0, c_white, _a);
+
+    draw_set_font(fnt_base_font_eng);
+    draw_set_halign(fa_center);
+    draw_set_color(c_white);
+    draw_text(240, 70, "Travelling to " + label + "...");
+    draw_set_halign(fa_left);
+    draw_set_alpha(1);
+}
+
+// Every map the player can travel to from the current one: the village plus each declared map, minus the
+// current map. [{target, label}]
+function scr_gnx_travel_destinations()
+{
+    var _out = [];
+    var _seen = {};
+    var _cur = global.gnx_active_map;
+
+    if (!global.gnx_multimap_enabled)
+        return _out;
+
+    if (_cur != "vanilla")
+    {
+        var _home = "Village";
+
+        for (var _i = 0; _i < array_length(global.gnx_travel_locations); _i++)
+        {
+            var _r = global.gnx_travel_locations[_i];
+
+            if (_r.target == "vanilla" && _r.show_on == _cur)
+                _home = _r.label;
+        }
+
+        array_push(_out, { target: "vanilla", label: _home });
+        variable_struct_set(_seen, "vanilla", true);
+    }
+
+    for (var _i = 0; _i < array_length(global.gnx_travel_locations); _i++)
+    {
+        var _tl = global.gnx_travel_locations[_i];
+
+        if (_tl.target == "vanilla" || _tl.target == _cur || variable_struct_exists(_seen, _tl.target))
+            continue;
+
+        variable_struct_set(_seen, _tl.target, true);
+        array_push(_out, { target: _tl.target, label: _tl.label });
+    }
+
+    return _out;
+}
