+// Travel menu: one button per destination, then Close. A destination opens the pre-travel selector.
+function scr_gnx_open_travel_menu()
+{
+    var _open = -1;
+
+    with (obj_window)
+    {
+        if (interact_type == 9062)
+            _open = id;
+    }
+
+    if (_open != -1)
+    {
+        scr_gnx_close_travel_menu();
+        return -1;
+    }
+
+    var _blocked = scr_gnx_travel_blocked();
+
+    if (_blocked != "")
+    {
+        scr_gnx_pop_up_create(_blocked);
+        return -1;
+    }
+
+    var _dest = scr_gnx_travel_destinations();
+    var _n = array_length(_dest);
+    var _row = 18;
+    var _h = 30 + ((_n + 1) * _row);
+    var _w = instance_create_depth(240, 135, -2700, obj_window);
+
+    with (_w)
+    {
+        interact_type = 9062;
+        gui = true;
+        sprite_index = spr_sure_window;
+        dest = _dest;
+        menu_h = _h;
+        scr_window_draw = scr_gnx_draw_travel_menu;
+        var _top = (-_h / 2) + 28;
+
+        for (var _i = 0; _i <= _n; _i++)
+            scr_create_button(0, _top + (_i * _row), depth - 1, spr_button_menu, 9063, id, scr_gnx_travel_menu_btn_init, -1, scr_gnx_draw_travel_menu_button, (_i < _n) ? _i : 99, 0);
+    }
+
+    var _l = gnx_log_open();
+    gnx_log_write(_l, "[GNX-MAP] travel menu opened on '" + global.gnx_active_map + "': " + string(_n) + " destination(s)\n");
+    gnx_log_close(_l);
+    return _w;
+}
+
+
+function scr_gnx_close_travel_menu()
+{
+    with (obj_button)
+    {
+        if (interact_type == 9063)
+            instance_destroy();
+    }
+
+    with (obj_window)
+    {
+        if (interact_type == 9062)
+            instance_destroy();
+    }
+}
