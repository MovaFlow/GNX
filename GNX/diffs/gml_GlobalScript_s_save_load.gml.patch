+// Sprawdza, czy arg0 to istniejaca instancja (a nie -1, indeks obiektu albo uszkodzony wpis z zapisu). Zwraca true/false.
+function gnx_is_live_inst(arg0)
+{
+    // tekst / struktura / tablica = uszkodzony wpis z zapisu
+    if (is_string(arg0) || is_struct(arg0) || is_array(arg0) || is_undefined(arg0))
+        return false;
+    
+    // ID instancji zaczynaja sie od 100000. Mniejsze liczby to -1 (puste) albo indeksy obiektow,
+    // a instance_exists(-1) to instance_exists(self) - zawsze true, wiec trzeba je odsiac wczesniej.
+    if (is_numeric(arg0) && arg0 < 100000)
+        return false;
+    
+    return instance_exists(arg0);
+}
+
+// Sprawdza, czy wpis z mon_placement celi (arg1) to zywy potwor, ktory naprawde nalezy do tej celi.
+// arg0 = wpis z listy, arg1 = cela (obj_slot). Zwraca true/false.
+function gnx_mon_ref_ok(arg0, arg1)
+{
+    if (!gnx_is_live_inst(arg0))
+        return false;
+    
+    if (arg0.object_index != obj_mon || !variable_instance_exists(arg0, "mon_data") || !is_struct(arg0.mon_data))
+        return false;
+    
+    return arg0.mon_data.slot_id == arg1;
+}
+
+// Odpina potwora (wywolywac jako self = obj_mon) od jego celi: usuwa go z list celi i wysyla do najblizszych drzwi,
+// tak jak robi to wanilowe usuwanie z celi. Zamiast niewidocznego "ducha" w stanie 1 i martwego wpisu w celi.
+function gnx_mon_release_from_slot()
+{
+    var _me = id;
+    var _sid = mon_data.slot_id;
+
+    if (gnx_is_live_inst(_sid) && _sid.object_index == obj_slot)
+    {
+        with (_sid)
+        {
+            if (variable_struct_exists(slot_data, "mon_placement") && is_array(slot_data.mon_placement))
+            {
+                for (var _pi = 0; _pi < array_length(slot_data.mon_placement); _pi++)
+                {
+                    if (slot_data.mon_placement[_pi] == _me)
+                    {
+                        slot_data.mon_placement[_pi] = -1;
+                        gnx_slot_reset_place_timer(_pi);
+                    }
+                }
+            }
+
+            if (is_array(h_unit_list))
+            {
+                for (var _hi = array_length(h_unit_list) - 1; _hi >= 0; _hi--)
+                {
+                    if (h_unit_list[_hi] == _me)
+                        array_delete(h_unit_list, _hi, 1);
+                }
+            }
+        }
+    }
+
+    // to samo, co ustawia wanilowe scr_remove_mon przy wyjsciu z celi
+    visible = true;
+    scr_mon_draw = -1;
+    mon_data.spr_data = -1;
+    mon_data.mood_slot_shift_x = 0;
+    mon_data.mood_slot_shift_y = 0;
+    mon_data.placement_num = -1;
+    mon_data.follow = false;
+    mon_data.removed_set = 1;
+    mon_data.slot_id = scr_find_nearest_door(x, y, mon_data.mon_floor);
+    mon_data.mon_state = 6;
+    mon_data.ff = true;
+}
+
+// Usuwa z list celi (self = obj_slot) wpisy po potworach, ktorych juz nie ma. Wywolywac jako with (cela).
+function gnx_slot_purge_dead_refs()
+{
+    if (variable_instance_exists(id, "slot_data") && is_struct(slot_data) && variable_struct_exists(slot_data, "mon_placement") && is_array(slot_data.mon_placement))
+    {
+        for (var _pi = 0; _pi < array_length(slot_data.mon_placement); _pi++)
+        {
+            var _pm = slot_data.mon_placement[_pi];
+
+            // -1 = puste miejsce
+            if (is_numeric(_pm) && _pm == -1)
+                continue;
+
+            // potwor musi istniec i nalezec do tej celi (odpiety/odeslany gdzie indziej tez zwalnia miejsce)
+            if (!gnx_mon_ref_ok(_pm, id))
+            {
+                slot_data.mon_placement[_pi] = -1;
+                gnx_slot_reset_place_timer(_pi);
+            }
+        }
+    }
+
+    if (variable_instance_exists(id, "h_unit_list") && is_array(h_unit_list))
+    {
+        // od konca, bo array_delete przesuwa kolejne elementy
+        for (var _hi = array_length(h_unit_list) - 1; _hi >= 0; _hi--)
+        {
+            if (!gnx_is_live_inst(h_unit_list[_hi]))
+                array_delete(h_unit_list, _hi, 1);
+        }
+    }
+}
+
+// Zeruje licznik zwolnionego miejsca w celi (self = obj_slot), tak jak wanilowe scr_remove_mon. arg0 = numer miejsca.
+function gnx_slot_reset_place_timer(arg0)
+{
+    if (variable_struct_exists(slot_data, "mon_timer") && is_array(slot_data.mon_timer) && arg0 < array_length(slot_data.mon_timer))
+        slot_data.mon_timer[arg0] = 0;
+}
