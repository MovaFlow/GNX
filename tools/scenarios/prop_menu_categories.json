    },
    {
      "wait": 10
    },
    {
      "press": {
        "type": 2,
        "num": 3
      },
      "why": "the real BOTTOM button"
    },
    {
      "wait": 20
    },
    {
      "assert": "fn",
      "name": "gnx_scn_button_texts",
      "args": [
        9080
      ],
