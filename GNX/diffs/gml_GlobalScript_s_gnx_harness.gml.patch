+// GNX: scenario runner of tools/gnx_test.py (steps, asserts, probes); never used by players
+// (moved out of s_initials.gml; the functions are global, callable from any script)
+
+// one frame of a phase trace (scenario step "trace"): a new entry when the cell's phase changes, and a loop
+// count per phase when its frame index goes back down while the phase stays the same
+function gnx_scn_trace_tick(arg0)
+{
+    if (!instance_exists(arg0.cell))
+        arg0.cell = gnx_scn_occupied_cell(arg0.h);  // after a reload the cell is a new instance
+
+    if (arg0.cell == -1 || !instance_exists(arg0.cell) || !is_struct(arg0.cell.slot_data.anim_struct))
+        exit;
+
+    var _a = arg0.cell.slot_data.anim_struct;
+    // idle (char_state 0) is phase 1 whatever spr_type still says; a scene drawn with the idle art (the start of a
+    // small cell) is phase 0, the start
+    var _ph = (_a.char_state == 0) ? 1 : ((_a.spr_type == 1) ? 0 : _a.spr_type);
+
+    if (_ph != arg0.last)
+    {
+        array_push(arg0.events, { phase: _ph, frame_c: _a.frame_c, h_step: arg0.cell.slot_data.h_step });
+        arg0.last = _ph;
+    }
+    else if (_a.index < arg0.last_index - 0.5)
+    {
+        var _k = string(_ph);
+        variable_struct_set(arg0.wraps, _k, (variable_struct_exists(arg0.wraps, _k) ? variable_struct_get(arg0.wraps, _k) : 0) + 1);
+    }
+
+    arg0.last_index = _a.index;
+}
