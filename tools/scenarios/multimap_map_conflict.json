{
  "about": "Two mods claim the same map with a button and map_start. The first in load order (harness_map) owns it: one travel button, the owner's map_start. The other's are ignored and the conflict is reported in the mod-problems popup exactly once per session (not again on every travel).",
  "mods": [
    "tools/scenarios/mods/harness_map",
    "tools/scenarios/mods/harness_map_dup"
  ],
  "expect_dialog": "also declares map 'harness_map'",
  "steps": [
    {
      "wait": 30
    },
    {
      "assert": "travel_location",
      "to": "harness_map",
      "why": "one button, not two"
    },
    {
      "travel": "harness_map"
    },
    {
      "wait": 30
    },
    {
      "assert": "val",
      "key": "money",
      "is": 1234,
      "why": "owner's map_start (the dup's 9999 is ignored)"
    },
    {
      "assert": "travel_location",
      "to": "vanilla"
    },
    {
      "travel": "vanilla"
    },
    {
      "wait": 30
    },
    {
      "travel": "harness_map"
    },
    {
      "wait": 30
    },
    {
      "assert": "active_map",
      "is": "harness_map",
      "why": "two more loader runs, popup must not come back"
    }
  ]
}