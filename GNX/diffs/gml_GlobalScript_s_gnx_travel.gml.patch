+
+function scr_gnx_travel_fx_step()
+{
+    t++;
+    
+    // the goblin walks in (phase 0) and out (phase 2) only; it stands still while the map loads. The load runs
+    // in single frames (GameMaker has one thread), so it freezes the picture: on a still picture that shows
+    // as a pause, not a stutter.
+    if (phase == 0 || phase == 2)
+        walk++;
+
+    switch (phase)
+    {
+        case 0:
+            global.click_lock = true;
+
+            if (t >= 40)
+            {
+                phase = 3;  // stop walking and let a few still frames show before the heavy part
+                t = 0;
+            }
+
+            break;
+
+        case 3:
+            global.click_lock = true;
+
+            if (t >= 3)
+            {
+                if (scr_gnx_travel(target))
+                {
+                    phase = 1;
+                    t = 0;
+                }
+                else
+                {
+                    // refused at the last moment (scr_gnx_travel logged why): give back what the selector took
+                    global.val.money += max(0, global.gnx_carry_gold);
+                    global.val.food += max(0, global.gnx_carry_food);
+
+                    if (is_struct(global.gnx_trip_cost))  // the trip's own cost too
+                    {
+                        global.val.money += global.gnx_trip_cost.gold;
+                        global.val.food += global.gnx_trip_cost.food;
+                        global.gnx_trip_cost = -1;
+                    }
+
+                    scr_gnx_apply_carry_units(false);  // troops and prisoners back where they were
+                    global.gnx_carry_day = -1;
+                    global.gnx_carry_gold = -1;
+                    global.gnx_carry_food = -1;
+                    global.click_lock = false;
+                    scr_gnx_pop_up_create("Couldn't travel right now.");
+                    instance_destroy();
+                }
+            }
+
+            break;
+
+        case 1:
+            // hold black until the new map runs, plus a few frames for map_start / travel carry
+            if (room == rm_game && obj_np.load_state == 1 && instance_exists(obj_slot) && !global.gnx_trigger_load)
+            {
+                if (t > 10)
+                {
+                    phase = 2;
+                    t = 0;
+                }
+            }
+            else
+            {
+                t = 0;
+            }
+
+            global.click_lock = true;
+            break;
+
+        case 2:
+            if (t >= 40)
+            {
+                global.click_lock = false;
+                instance_destroy();
+            }
+
+            break;
+    }
+}
