+                    break;
+                }
+
+                gnx_mod_set_off(_w, _row.folder, true);
+            }
+            else
+            {
+                gnx_mod_set_off(_w, _row.folder, false);
+            }
+
+            with (_w)
+                scr_gnx_mod_menu_buttons();
+
+            break;
+
+        case 9073:
+            var _w = source_id;
+            _w.page += (button_num == 0) ? -1 : 1;
+
+            with (_w)
+                scr_gnx_mod_menu_buttons();
+
+            break;
+
+        case 9074:
+            var _w = source_id;
+
+            if (gnx_same_set(_w.pending, scr_gnx_read_mods_off()))
+                break;
+
+            scr_gnx_mod_menu_apply(_w);
+            break;
+
+        case 9075:
+            if (instance_exists(source_id) && variable_instance_exists(source_id, "dirty") && source_id.dirty)
+            {
+                scr_gnx_mod_confirm(["Leave without applying?", "Your changes to the mod list are not applied yet.", "APPLY loads the mods you chose; DISCARD forgets them."], ["APPLY", "STAY", "DISCARD"], "back", source_id);
+                break;
+            }
+
+            gnx_mod_menu_leave();
+            break;
+
+        case 9077:
+            var _c = source_id;
+            var _act = _c.action;
+            var _asker = _c.asker;
+            var _btn = button_num;
+            gnx_close_mod_confirm();
+
+            if (_btn == 1)
+                break;
+
+            if (_act == "back")  // leaving the mod page with changes: 0 APPLY, 2 DISCARD (1 STAY returned above)
+            {
+                if (_btn == 0)
+                    scr_gnx_mod_menu_apply(_asker);
+                else
+                    gnx_mod_menu_leave();
+
+                break;
+            }
