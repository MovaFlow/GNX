+        if (_state == 0 || _state == undefined)
+        {
+            for (var _i = 0; _i < array_length(arg0.actions); _i++)
+                scr_gnx_exec_tool_action(arg0.actions[_i], arg1);
+            
+            scr_gnx_set_state(arg1, arg0.toggle, 1);
