+/// GNX-LOOP-STRIP: the frame to draw of sprite arg0 when the cell asks for frame arg1 (row * frame count
+/// + frame of the phase). A strip marked "loop" in its JSON shows its own frames in a loop instead:
+/// on a 2-frame strip phase frames 0-10 become 0, 1, 0, 1 ... Every other sprite gets arg1 unchanged.
+function gnx_loop_index(arg0, arg1)
+{
+    var _n = gnx_loop_frames(arg0);
+    
+    if (_n < 1)
+        return arg1;
+    
+    var _fc = max(1, slot_data.anim_struct.frame_c);
+    var _row = floor(arg1 / _fc);
+    var _i = floor(arg1 - (_row * _fc));
+    // mod = remainder of a division: 5 mod 2 = 1, so the strip starts over
+    return (_row * _n) + (_i mod _n);
+}
+
+/// GNX-WALL: the wall this cell draws behind everything (arg0 = its registry entry): the second wall
+/// (sprites.wall_2) when the cell's swap button chose it (slot_data.gnx_wall_v 1), else the first;
+/// -1 when the cell has no wall of its own.
+function gnx_cell_wall(arg0)
+{
+    if (arg0 == undefined || !variable_struct_exists(arg0, "gnx_spr_wall"))
+        return -1;
+    
+    // && = and: the second wall only when the cell has one and the button picked it
+    if (variable_struct_exists(slot_data, "gnx_wall_v") && slot_data.gnx_wall_v == 1 && variable_struct_exists(arg0, "gnx_spr_wall2") && arg0.gnx_spr_wall2 != -1)
+        return arg0.gnx_spr_wall2;
+    
+    return arg0.gnx_spr_wall;
+}
+
+/// GNX-WALL: true when the current slot holds a cell whose own wall replaces the slot background
+/// (underground cells and cells with two walls), so the vanilla back is not drawn behind the wall.
+function gnx_slot_hides_back()
+{
+    if (!variable_struct_exists(slot_data, "h_type"))
+        return false;
+    
+    var _c = ds_map_find_value(global.cell_registry, slot_data.h_type);
+    return _c != undefined && variable_struct_exists(_c, "gnx_hide_back") && _c.gnx_hide_back;
+}
+
+/// GNX-WALL: true when slot arg0 holds a mod cell with two walls, so its swap button switches walls.
+function gnx_slot_has_wall2(arg0)
+{
+    if (!instance_exists(arg0) || !variable_instance_exists(arg0, "slot_data") || !variable_struct_exists(arg0.slot_data, "h_type"))
+        return false;
+    
+    var _c = ds_map_find_value(global.cell_registry, arg0.slot_data.h_type);
+    return _c != undefined && variable_struct_exists(_c, "gnx_spr_wall2") && _c.gnx_spr_wall2 != -1;
 }
 
