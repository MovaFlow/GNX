+// Travel transition: the screen fades to black while a goblin with a backpack walks across, then the travel
+// runs (the load happens behind the black screen), then it fades back in on the destination map. One
+// persistent obj_empty (gnx_travel_fx) carries it through the room change.
+// phase 0 = fading out, 1 = travelling (black until the new map is up), 2 = fading in
+function scr_gnx_travel_fx_start(arg0, arg1)
+{
+    with (obj_empty)
+    {
+        if (variable_instance_exists(id, "gnx_travel_fx"))
+            instance_destroy();
+    }
+
+    var _fx = instance_create_depth(0, 0, -9990, obj_empty);
+
+    with (_fx)
+    {
+        gnx_travel_fx = true;
+        persistent = true;
+        gui = true;
+        target = arg0;
+        label = arg1;
+        phase = 0;
+        t = 0;
+        walk = 0;
+        scr_empty_step = scr_gnx_travel_fx_step;
+        scr_empty_draw = scr_gnx_travel_fx_draw;
+    }
+
+    global.click_lock = true;
+}
+
+
+// True while a travel has been confirmed but the destination is not loaded yet (scenario runner waits on it)
+function scr_gnx_travel_pending()
+{
+    if (variable_global_exists("gnx_trigger_load") && global.gnx_trigger_load)
+        return true;
+
+    var _p = false;
+
+    with (obj_empty)
+    {
+        if (variable_instance_exists(id, "gnx_travel_fx") && (phase == 0 || phase == 3))  // before scr_gnx_travel ran
+            _p = true;
+    }
+
+    return _p;
+}
