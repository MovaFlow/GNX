+/// GNX-UG: gnx_floor_off for every floor (index = floor), used to move things when the bands change.
+function gnx_ug_floor_offsets()
+{
+    var _n = global.val.floor + 1;
+    var _out = array_create(_n, 0);
+    var _o = 0;
+    
+    for (var i = 0; i < _n; i++)
+    {
+        _out[i] = _o;
+        _o += 140 + gnx_floor_extra(i);
+    }
+    
+    return _out;
+}
