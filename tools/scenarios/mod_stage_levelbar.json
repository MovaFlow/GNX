{
  "about": "A mod stage with more than 3 levels (BOG, 5) draws one level-bar slot per open level, centred under its button, instead of overflowing the 3-slot bar; the selected mod stage shows its name next to its button (A7). Screenshots.",
  "mods": [
    "tools/scenarios/mods/harness_raid_b"
  ],
  "steps": [
    {
      "wait": 30
    },
    {
      "call": "gnx_scn_stage_open",
      "args": [
        "harness_raid_b.BOG",
        3
      ]
    },
    {
      "call": "gnx_scn_set_stage_sel",
      "args": [
        "harness_raid_b.BOG",
        2
      ]
    },
    {
      "open_raid": true
    },
    {
      "wait": 5
    },
    {
      "raid_stage": 5
    },
    {
      "wait": 20
    },
    {
      "assert": "raid",
      "stage": 5
    },
    {
      "screenshot": "bog_five_levels"
    }
  ]
}