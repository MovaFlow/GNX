+    for (var _i = 0; _i < array_length(party); _i++)
+        array_push(_troops, party[_i]);
+
+    if (carry_goblins > 0)
+        array_push(_troops, { type: 0, class: 0, num: carry_goblins });
+
+    global.val.money -= _cg;
+    global.val.food -= _cf;
+
+    for (var _i = 0; _i < array_length(_troops); _i++)
+        gnx_add_mons(_troops[_i].type, _troops[_i].class, -_troops[_i].num);
+
+    var _caps = [];
+
+    for (var _i = 0; _i < array_length(captives); _i++)
+    {
+        var _u = ds_list_find_value(global.unit_list, captives[_i]);
+
+        if (is_struct(_u))
+        {
+            array_push(_caps, { unit: _u, from: captives[_i] });
+            ds_list_set(global.unit_list, captives[_i], -1);
+        }
