    {"open_build_menu": -1},
    {"wait": 2},
    {"press": {"type": 0, "num": 0}, "why": "NEW"},
    {"wait": 2},
    {"press": {"type": 1, "num": 0}, "why": "NEW > SMALL: an empty small slot"},
    {"wait": 2},
    {"open_slot_menu": true},
    {"wait": 2},
    {"press": {"type": 3, "num": 0}, "why": "BREED list"},
    {"wait": 2},
    {"press": {"type": 10, "num": 1}, "why": "WALL 1"},
    {"wait": 10},
    {"assert": "has_cell", "h_type": 1, "count": 1},
    {"do": {"type": "spawn_mon", "species": 0, "amount": 3}},
    {"occupy": {"h_type": 1, "class": {"class": "harness_swap.BARE CLASS"}}, "why": "used to crash here"},
    {"wait": 900, "why": "idle, then a goblin's scene"},
    {"screenshot": "bare_class"}
  ]
