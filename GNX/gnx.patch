+
+    for (var i = 0; i < ds_list_size(_a); i++)
+    {
+        var _x = ds_list_find_value(_a, i).slot_data;
+        var _y = ds_list_find_value(_b, i).slot_data;
+
+        if (_x.slot_type != _y.slot_type)
+            return "type at " + string(i);
+
+        if (variable_struct_exists(_x, "h_type") && _x.h_type != _y.h_type)
+            return "cell at " + string(i);
+
+        if ((_x.slot_type == 4 || _x.slot_type == 5) && _x.between_type != _y.between_type)
+            return "style at " + string(i);
+
+        // placed props live on passages and the entrance; a cell's props are its own (a newborn ...)
+        if (_x.slot_type != 4 && _x.slot_type != 5)
+            continue;
+
+        if (array_length(_x.prop) != array_length(_y.prop))
+            return "props at " + string(i) + " (type " + string(_x.slot_type) + ")";
+
+        for (var p = 0; p < array_length(_x.prop); p++)
+        {
+            if (!scr_check_prop_exists(ds_list_find_value(_b, i), _x.prop[p].prop_pos, _x.prop[p].prop_type))
