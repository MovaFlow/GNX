{
  "about": "Without a map mod, multimap stays out of the way: a game with only a non-map mod has no map button on the raid world map, the travel menu cannot open, no travel destination exists and the game stays on the village. The guide's RAIDING tab has no TRAVEL entry. Uses the 'modded' fixture (raids unlocked) loaded with one non-map mod.",
  "fixture": "modded",
  "timeout": 120,
  "mods": [
    "tools/scenarios/mods/harness_req_base"
  ],
  "steps": [
    {
      "wait": 60
    },
    {
      "assert": "active_map",
      "is": "vanilla"
    },
    {
      "open_raid": true
    },
    {
      "wait": 5
    },
    {
      "assert": "button_var",
      "type": 45,
      "num": 999,
      "field": "button_num",
      "absent": true,
      "why": "no map button without a map mod"
    },
    {
      "screenshot": "raid_map"
    },
    {
      "press_travel_hud": true
    },
    {
      "wait": 3
    },
    {
      "assert": "travel_menu",
      "open": false
    },
    {
      "assert": "selector",
      "open": false
    },
    {
      "open_raid": false
    },
    {
      "wait": 3
    },
    {
      "assert": "active_map",
      "is": "vanilla"
    },
    {
      "wait": 30
    },
    {
      "press": {
        "type": 32,
        "num": 4,
        "defer": true
      },
      "why": "settings"
    },
    {
      "wait": 10
    },
    {
      "press": {
        "type": 31,
        "num": 14,
        "defer": true
      },
      "why": "guide"
    },
    {
      "wait": 10
    },
    {
      "press": {
        "type": 54,
        "num": 1,
        "defer": true
      },
      "why": "RAIDING tab"
    },
    {
      "wait": 10
    },
    {
      "assert": "button_var",
      "type": 55,
      "num": 7,
      "field": "guide_text",
      "why": "the RAIDING tab is open"
    },
    {
      "assert": "button_var",
      "type": 55,
      "num": 8,
      "field": "guide_text",
      "absent": true,
      "why": "no TRAVEL guide entry without a map mod"
    },
    {
      "screenshot": "guide_raiding"
    }
  ]
}
