+// The inventory is shared by every map: the items carried from the map we left (an array) are added to this
+// map's. Milk stacks by grade, torn blueprint pieces go through the game's own combine (pieces found on two maps
+// complete a blueprint), other items stack by type like scr_add_item. Returns how many entries were merged.
+function gnx_merge_inventory(arg0)
+{
+    if (!is_array(arg0))
+        return 0;
+
+    for (var _i = 0; _i < array_length(arg0); _i++)
+    {
+        var _it = arg0[_i];
+
+        if (!is_struct(_it) || !variable_struct_exists(_it, "item_type"))
+            continue;
+
+        if (_it.item_type == 4)
+        {
+            scr_add_item(_it);
+        }
+        else if (_it.item_type == 5)
+        {
+            scr_combine_print(_it);
+        }
+        else
+        {
+            var _found = false;
+
+            for (var _j = 0; _j < ds_list_size(global.inv_list); _j++)
+            {
+                var _have = ds_list_find_value(global.inv_list, _j);
+
+                if (_have.item_type == _it.item_type)
+                {
+                    _have.num += _it.num;
+                    _have.num_draw = _have.num;
+                    _found = true;
+                    break;
+                }
+            }
+
+            if (!_found)
+                ds_list_add(global.inv_list, _it);
+        }
+    }
+
+    with (obj_np.obj_raid)
+        extra_row_num = scr_set_inventory_row();
+
+    return array_length(arg0);
+}
