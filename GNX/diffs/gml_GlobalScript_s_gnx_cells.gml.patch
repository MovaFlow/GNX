+/// GNX-UG: GNX's own underground cell graphics, imported by G3M from GNX_assets as spr_gnx_ug_*.
+/// G3M gives imported sprites the origin (0, 0); the cell sprites (161 px canvas) get theirs moved to
+/// the floor line, 75 px above the bottom. A missing file gives -1 and that part is simply not drawn.
+function gnx_ug_load_assets()
+{
+    var _a = 
+    {
+        wall: asset_get_index("spr_gnx_ug_wall_1"),
+        wall2: asset_get_index("spr_gnx_ug_wall_2"),
+        top: asset_get_index("spr_gnx_ug_floor"),
+        tent: asset_get_index("spr_gnx_ug_tent_ready"),
+        band: asset_get_index("spr_gnx_ug_band")
+    };
+    
+    // GNX-WALL: the single wall file of earlier builds (gnx_ug_wall.png) still works as the first wall
+    if (_a.wall == -1)
+        _a.wall = asset_get_index("spr_gnx_ug_wall");
+    
+    var _cell_sprs = [_a.wall, _a.wall2, _a.top, _a.tent];
+    
+    for (var i = 0; i < array_length(_cell_sprs); i++)
+    {
+        var _s = _cell_sprs[i];
+        
+        // != -1 && sprite_exists: the asset was imported
+        if (_s != -1 && sprite_exists(_s))
+            sprite_set_offset(_s, 0, sprite_get_height(_s) - 75);
+    }
+    
+    return _a;
+}
