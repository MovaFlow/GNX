+// true, gdy kursor jest nad widocznym paskiem przewijania albo pasek jest przeciagany
+function gnx_scrollbar_blocks_click()
+{
+    if (global.gnx_scrollbar_dragging)
+    {
+        if (mouse_check_button(global.val.select_click))
+            return true;
+
+        // przycisk puszczony - koniec przeciagania (inaczej flaga mogla zostac na zawsze i blokowac kazdy klik)
+        global.gnx_scrollbar_dragging = false;
+    }
+
+    if (!is_array(global.gnx_scrollbar_rect) || global.camera_lock)
+        return false;
+
+    // obj_gui jest niewidoczny przy zoomie 0.5 - wtedy pasek sie nie rysuje
+    if (!instance_exists(obj_gui) || !obj_gui.visible)
+        return false;
+
+    var _mx = device_mouse_x_to_gui(0);
+    var _my = device_mouse_y_to_gui(0);
+    var _r = global.gnx_scrollbar_rect;
+
+    if (!(_mx >= _r[0] && _mx <= _r[2] && _my >= _r[1] && _my <= _r[3]))
+        return false;
+
+    // przycisk GUI pod kursorem ma pierwszenstwo - nie blokujemy go
+    return !gnx_gui_under_mouse();
+}
+
+// true, gdy pod kursorem jest aktywny element GUI (przycisk, okno)
+function gnx_gui_under_mouse()
+{
+    var _ui = scr_mouse_least_depth_obj(device_mouse_x_to_gui(0), device_mouse_y_to_gui(0), -1);
+    return _ui != -1 && _ui.gui;
 }
