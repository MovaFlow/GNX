+function scr_gnx_resolve_condition_refs(arg0, arg1)
+{
+    if (variable_struct_exists(arg0, "class") && is_string(arg0.class))
+    {
+        var _ref = arg0.class;
+        
+        if (string_pos(".", _ref) == 0)
+            _ref = arg1 + "." + _ref;
+        
+        var _cid = ds_map_find_value(global.gnx_class_name_to_id, _ref);
+        
+        if (_cid != undefined)
+            arg0.class = _cid;
+    }
+    
+    if (variable_struct_exists(arg0, "h_type") && is_string(arg0.h_type))
+    {
+        var _ref = arg0.h_type;
+        
+        if (string_pos(".", _ref) == 0)
+            _ref = arg1 + "." + _ref;
+        
+        var _hid = ds_map_find_value(global.gnx_cell_name_to_id, _ref);
+        
+        if (_hid != undefined)
+            arg0.h_type = _hid;
+    }
+}
+
+
+function scr_gnx_resolve_side_effect_refs(arg0, arg1)
+{
+    if (variable_struct_exists(arg0, "h_type") && is_string(arg0.h_type))
+    {
+        var _ref = arg0.h_type;
+        
+        if (string_pos(".", _ref) == 0)
+            _ref = arg1 + "." + _ref;
+        
+        var _hid = ds_map_find_value(global.gnx_cell_name_to_id, _ref);
+        
+        if (_hid != undefined)
+            arg0.h_type = _hid;
+    }
+    
+    if (variable_struct_exists(arg0, "class") && is_string(arg0.class))
+    {
+        var _ref = arg0.class;
+        
+        if (string_pos(".", _ref) == 0)
+            _ref = arg1 + "." + _ref;
+        
+        var _cid = ds_map_find_value(global.gnx_class_name_to_id, _ref);
+        
+        if (_cid != undefined)
+            arg0.class = _cid;
+    }
+}
+
+
+function scr_gnx_check_triggers(arg0)
+{
+    var _n = array_length(global.gnx_quest_triggers);
+    
+    for (var _i = 0; _i < _n; _i++)
+    {
+        var _trig = global.gnx_quest_triggers[_i];
+        
+        if (_trig.hook != arg0)
+            continue;
+        
+        var _pass = true;
+        
+        if (variable_struct_exists(_trig, "conditions"))
+        {
+            var _conds = _trig.conditions;
+            
+            for (var _ci = 0; _ci < array_length(_conds); _ci++)
+            {
+                if (!scr_gnx_eval_condition(_conds[_ci], _trig.mod_name))
+                {
+                    _pass = false;
+                    break;
+                }
+            }
+        }
+        
+        if (_pass)
+            scr_gnx_fire_event(_trig.event);
+    }
+}
+
+
+function scr_gnx_eval_condition(arg0, arg1)
+{
+    var _type = arg0.type;
+    
+    switch (_type)
+    {
+        case "state_equals":
+            return scr_gnx_get_state(arg1, arg0.key) == arg0.value;
+        
+        case "state_gte":
+            var _v = scr_gnx_get_state(arg1, arg0.key);
+            return _v != undefined && _v >= arg0.value;
+        
+        case "state_lte":
+            _v = scr_gnx_get_state(arg1, arg0.key);
+            return _v != undefined && _v <= arg0.value;
+        
+        case "day_gte":
+            return global.val.day >= gnx_json_num(arg0.value, 1);
+
+        case "day_every":
+            // GNX-DAY: every value days (day 0, n, 2n... shifted by offset); value 1 = every day
+            var _every = max(1, floor(gnx_json_num(arg0.value, 1)));
+            var _off = variable_struct_exists(arg0, "offset") ? floor(gnx_json_num(arg0.offset, 0)) : 0;
+            return ((global.val.day - _off) mod _every) == 0;
+
+        case "stage_discovered":
+            var _s = arg0.stage;
+            return global.val.stage_info[_s] != -1;
+        
+        case "stage_cleared":
+            _s = arg0.stage;
+            var _ml = arg0.min_level;
+            return global.val.stage_info[_s] != -1 && global.val.stage_info[_s].max_lvl >= _ml;
+        
+        case "class_unlocked":
+            return gnx_class_unlocked(arg0.class);
+
+        case "boss_captured":
+            var _cls = arg0.class;
+            var _cage = global.val.cage;
+            
+            for (var _ci = 0; _ci < array_length(_cage); _ci++)
+            {
+                if (_cage[_ci] != -1 && is_struct(_cage[_ci]) && variable_struct_exists(_cage[_ci], "class") && _cage[_ci].class == _cls)
+                    return true;
+            }
+            
+            return false;
+        
+        case "cell_built":
+            var _h = arg0.h_type;
+            
+            if (instance_exists(obj_slot))
+            {
+                with (obj_slot)
+                {
+                    if (slot_data.h_type == _h)
+                        return true;
+                }
+            }
+            
+            return false;
+        
+        case "cell_occupied":
+            _h = arg0.h_type;
+            
+            if (instance_exists(obj_slot))
+            {
+                with (obj_slot)
+                {
+                    if (slot_data.h_type == _h && unit_data != -1)
+                        return true;
+                }
+            }
+            
+            return false;
+        
+        case "unit_count":
+            var _need = variable_struct_exists(arg0, "value") ? arg0.value : 1;
+            
+            if (variable_struct_exists(arg0, "class"))
+            {
+                var _cls_ref = arg0.class;
+                
+                if (is_string(_cls_ref))
+                {
+                    var _resolved = ds_map_find_value(global.gnx_class_name_to_id, _cls_ref);
+                    
+                    if (_resolved != undefined)
+                        _cls_ref = _resolved;
+                    else
+                        return false;
+                }
+                
+                _count = 0;
+                var _unum = ds_list_size(global.unit_list);
+                
+                for (var _ui = 0; _ui < _unum; _ui++)
+                {
+                    var _ud = ds_list_find_value(global.unit_list, _ui);
+                    
+                    if (_ud != -1 && is_struct(_ud) && variable_struct_exists(_ud, "class") && _ud.class == _cls_ref)
+                        _count++;
+                }
+                
+                return _count >= _need;
+            }
+            
+            return scr_all_mon_num_cal() >= _need;
+        
+        case "raid_won":
+            return true;
+        
+        case "gold_gte":
+            return global.val.money >= arg0.value;
+
+        case "has_item":  // {"type": "has_item", "item": "MOON SHARD", "value": 3}: at least that many in the inventory
+            var _hit = variable_struct_exists(arg0, "item") ? gnx_item_resolve(arg0.item, arg1) : -1;
+            return _hit != -1 && gnx_item_count(_hit) >= (variable_struct_exists(arg0, "value") ? arg0.value : 1);
+        
+        case "floor_gte":
+            return global.val.floor >= arg0.value;
+        
+        case "on_map":  // {"type": "on_map", "map": "outpost"}: the player is on that map ("vanilla" = the village)
+            return variable_struct_exists(arg0, "map") && global.gnx_active_map == arg0.map;
+        
+        case "map_visited":  // {"type": "map_visited", "map": "outpost"}: the player has been there (or is there now)
+            return variable_struct_exists(arg0, "map") && gnx_map_visited(arg0.map);
+        
+        case "map_unlocked":  // {"type": "map_unlocked", "map": "outpost"}: the map can be travelled to
+            return variable_struct_exists(arg0, "map") && gnx_map_is_unlocked(arg0.map);
+        
+        case "cell_count":
+            _h = arg0.h_type;
+            _need = variable_struct_exists(arg0, "value") ? arg0.value : 1;
+            var _count = 0;
+            
+            if (instance_exists(obj_slot))
+            {
+                with (obj_slot)
+                {
+                    if (slot_data.h_type == _h)
+                        _count++;
+                }
+            }
+            
+            return _count >= _need;
+    }
+    
+    return false;
+}
