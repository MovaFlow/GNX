+function scr_gnx_mod_menu_activate()
+{
+    switch (interact_type)
+    {
+        case 9070:
+            scr_gnx_open_mod_menu();
+            break;
+
+        case 9072:
+            var _w = source_id;
+            var _row = _w.rows[button_num];
+
+            if (gnx_mod_row_on(_w, _row))
+            {
+                var _lines = scr_gnx_mod_off_impact(_w, _row);
