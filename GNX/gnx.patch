+            {
+                _data.slot_data = slot_data;
+
+                if (_slot_hold_id == _slot_id)
+                {
+                    _data.unit_data = _hold_id.unit_data;
+                    _data.slot_data.anim_struct.spr_type = UnknownEnum.Value_1;
+                }
+                else
+                {
+                    _data.unit_data = unit_data;
+                }
