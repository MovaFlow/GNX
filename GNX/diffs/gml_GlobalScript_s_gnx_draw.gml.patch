+/// GNX-FIX: checks the frames arg1 of an atlas sprite against its pages arg0 (the sprites of the atlas
+/// PNGs, -1 where one failed to load). Returns "" when every frame has numbers x, y, w, h, points to a
+/// loaded page and lies inside it, else the first problem as text (for the log).
+function gnx_atlas_frames_bad(arg0, arg1)
+{
+    // ! = not, || = or
+    if (!is_array(arg0) || !is_array(arg1) || array_length(arg1) == 0)
+        return "no frames";
+    
+    for (var i = 0; i < array_length(arg1); i++)
+    {
+        var _f = arg1[i];
+        
+        if (!is_struct(_f) || !variable_struct_exists(_f, "atlas") || !variable_struct_exists(_f, "x") || !variable_struct_exists(_f, "y") || !variable_struct_exists(_f, "w") || !variable_struct_exists(_f, "h"))
+            return "frame " + string(i) + " lacks atlas / x / y / w / h";
+        
+        if (!is_real(_f.atlas) || !is_real(_f.x) || !is_real(_f.y) || !is_real(_f.w) || !is_real(_f.h))
+            return "frame " + string(i) + " has a value that is no number";
+
+        // w or h 0 = an empty frame (a fully transparent picture): drawn as nothing, as GNX always did,
+        // so its page and place are not checked (|| = or)
+        if (_f.w <= 0 || _f.h <= 0)
+            continue;
+
+        var _p = _f.atlas;
+        
+        // _p != floor(_p): not a whole page number
+        if (_p != floor(_p) || _p < 0 || _p >= array_length(arg0))
+            return "frame " + string(i) + " points to page " + string(_p) + ", the atlas has " + string(array_length(arg0));
+        
+        var _spr = arg0[_p];
+        
+        if (_spr == -1 || !sprite_exists(_spr))
+            return "frame " + string(i) + " is on page " + string(_p) + ", which did not load";
+        
+        if (_f.x < 0 || _f.y < 0 || _f.w <= 0 || _f.h <= 0 || (_f.x + _f.w) > sprite_get_width(_spr) || (_f.y + _f.h) > sprite_get_height(_spr))
+            return "frame " + string(i) + " (" + string(_f.x) + "," + string(_f.y) + " " + string(_f.w) + "x" + string(_f.h) + ") lies outside page " + string(_p);
+    }
+    
+    return "";
+}
