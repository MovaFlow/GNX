+
+function gnx_cli_has(arg0)
+{
+    // parameter_string(0) is the exe; user args are 1..parameter_count()
+    for (var _i = 1; _i <= parameter_count(); _i++)
+    {
+        if (parameter_string(_i) == arg0)
+            return true;
+    }
+
+    return false;
+}
+
+
+function gnx_cli_value(arg0)
+{
+    for (var _i = 1; _i < parameter_count(); _i++)
+    {
+        if (parameter_string(_i) == arg0)
+            return parameter_string(_i + 1);
+    }
+
+    return "";
+}
