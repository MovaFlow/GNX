+                        _fail++;
+                    }
+                }
+            }
+            else
+            {
+                var _bb = variable_struct_exists(_rule, "base_body") ? _rule.base_body : "";
+                var _clsi = 0;
+                
+                repeat (array_length(_classes))
+                {
+                    var _c = _classes[_clsi++];
+                    
+                    if (_c == 11 && _bb != "standard")
+                    {
+                        gnx_log_write(_log, "[GNX-TEST] SKIP  DROUTE h=" + string(_h) + " c=11 Giant/" + _bb + "\n");
+                        _skip++;
+                    }
+                    // POPRAWKA (GNX): klasa z "only_listed_cells" i tak nie wejdzie do tej celi
+                    else if (!gnx_class_cell_listed_ok(_h, _c))
+                    {
+                        gnx_log_write(_log, "[GNX-TEST] SKIP  DROUTE h=" + string(_h) + " c=" + string(_c) + " only_listed_cells\n");
+                        _skip++;
+                    }
+                    else
+                    {
+                        var _rclass = ds_map_find_value(global.class_registry, _c);
+                        
+                        if (_rclass == undefined)
+                        {
+                            gnx_log_write(_log, "[GNX-TEST] FAIL  DROUTE h=" + string(_h) + " c=" + string(_c) + " NO_CLASS\n");
