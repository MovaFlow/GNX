+/// GNX-UNIT: the quest reward for captive arg0 (unit data): the game's captive item (type 9), drawn as her head in
+/// the quest log; no number on it, her class as its name
+function gnx_unit_reward_item(arg0)
+{
+    // -1: no number drawn on the item
+    var _it = scr_set_item_data(UnknownEnum.Value_9, -1, arg0);
+    _it.item_name = variable_struct_exists(arg0, "class_name") ? string(arg0.class_name) : -1;
+    return _it;
+}
