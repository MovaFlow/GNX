+function scr_gnx_travel(arg0)
+{
+    if (!global.gnx_multimap_enabled)
+        return false;
+    
+    if (global.gnx_active_map == arg0)
+    {
+        var _l = gnx_log_open();
+        gnx_log_write(_l, "[GNX-MAP] travel skipped: already on " + arg0 + "\n");
+        gnx_log_close(_l);
+        return true;
+    }
+    
+    if (scr_gnx_travel_blocked() != "")
+        return false;
+    
+    var _log = gnx_log_open();
+    gnx_log_write(_log, "[GNX-MAP] travel: " + global.gnx_active_map + " -> " + arg0 + "\n");
+    gnx_log_close(_log);
+    var _gnx_st0 = get_timer();
+    // the inventory is shared: it leaves with the player, so the map left keeps none (merged on arrival)
+    global.gnx_carry_inv = [];
+
+    for (var _ii = 0; _ii < ds_list_size(global.inv_list); _ii++)
+        array_push(global.gnx_carry_inv, ds_list_find_value(global.inv_list, _ii));
+
+    ds_list_clear(global.inv_list);
+    var _snapshot = scr_gnx_snapshot_map();
+    if (variable_global_exists("gnx_scn") && global.gnx_scn != -1)
+        gnx_scn_log("TIME travel snapshot = " + string((get_timer() - _gnx_st0) / 1000) + " ms");
+    variable_struct_set(global.gnx_inactive_maps, global.gnx_active_map, _snapshot);
+    var _target_snapshot = variable_struct_get(global.gnx_inactive_maps, arg0);
+    global.gnx_active_map = arg0;
+    
+    if (_target_snapshot != undefined)
+    {
+        variable_struct_remove(global.gnx_inactive_maps, arg0);
+        global.gnx_travel_data = _target_snapshot;
+    }
+    else
+    {
+        global.gnx_travel_data = -1;
+    }
+    
+    global.gnx_carry_day = global.val.day + (is_struct(global.gnx_trip_cost) ? global.gnx_trip_cost.days : 0);  // travel_cost days pass
+    global.gnx_trip_cost = -1;
+    global.gnx_carry_timer = global.val.day_timer;
+    global.gnx_carry_unlock = json_parse(json_stringify(global.unlock));  // unlocks are shared by every map
+    global.gnx_trigger_load = true;
+    return true;
+}
