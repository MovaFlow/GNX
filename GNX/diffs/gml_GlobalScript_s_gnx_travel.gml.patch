+
+function scr_gnx_draw_travel_menu()
+{
+    scr_draw_backdrop();
+    var _wscale = 1.8;
+
+    with (obj_button)
+    {
+        if (interact_type == 9063)
+            _wscale = max(_wscale, ((sprite_get_width(spr_button_menu) * image_xscale) + 24) / sprite_get_width(spr_sure_window));
