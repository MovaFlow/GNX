{
  "about": "Pre-travel selector tiers. harness_map_b is 'advanced' (BASIC + TROOPS), harness_map_c 'complex' (+ CAPTIVES). Troops taken along leave this map and arrive there kind by kind (hobgoblins included); prisoners move into the destination's free prison slots, never more than it has. Uses the rich 'modded' fixture; screenshots of each tab.",
  "fixture": "modded",
  "mods": [
    "tools/scenarios/mods/harness_map_b",
    "tools/scenarios/mods/harness_map_c"
  ],
  "timeout": 180,
  "steps": [
    {
      "wait": 60
    },
    {
      "open_selector": "harness_map_b"
    },
    {
      "wait": 3
    },
    {
      "assert": "selector",
      "tier": 1,
      "why": "harness_map_b is an advanced map"
    },
    {
      "screenshot": "advanced_basic"
    },
    {
      "press_travel_button": {
        "num": 41
      },
      "why": "TROOPS tab"
    },
    {
      "wait": 3
    },
    {
      "screenshot": "advanced_troops"
    },
    {
      "press_travel_button": {
        "num": 61
      },
      "why": "hobgoblins"
    },
    {
      "wait": 3
    },
    {
      "screenshot": "advanced_troops_hob"
    },
    {
      "press_travel_button": {
        "num": 20
      }
    },
    {
      "wait": 3
    },
    {
      "assert": "selector",
      "open": false
    },
    {
      "assert": "mons",
      "type": 0,
      "class": 1,
      "min": 40
    },
    {
      "snapshot": "village"
    },
    {
      "travel_with": {
        "to": "harness_map_b",
        "gold": 100,
        "troops": [
          [
            0,
            1,
            40
          ],
          [
            1,
            1,
            10
          ],
          [
            3,
            0,
            5
          ]
        ]
      }
    },
    {
      "wait": 60
    },
    {
      "assert": "active_map",
      "is": "harness_map_b"
    },
    {
      "assert": "mons",
      "type": 0,
      "class": 1,
      "is": 40,
      "why": "40 goblins of kind 1 taken along (a kind this new map did not have)"
    },
    {
      "assert": "mons",
      "type": 1,
      "class": 1,
      "is": 10
    },
    {
      "assert": "mons",
      "type": 3,
      "class": 0,
      "is": 5,
      "why": "ogres too"
    },
    {
      "travel": "vanilla"
    },
    {
      "wait": 60
    },
    {
      "assert": "mons",
      "type": 0,
      "class": 1,
      "is": 827,
      "why": "867 - 40: they left the village"
    },
    {
      "open_selector": "harness_c"
    },
    {
      "wait": 3
    },
    {
      "assert": "selector",
      "tier": 2
    },
    {
      "press_travel_button": {
        "num": 42
      },
      "why": "CAPTIVES tab"
    },
    {
      "wait": 3
    },
    {
      "screenshot": "complex_captives"
    },
    {
      "press_travel_button": {
        "num": 20
      }
    },
    {
      "wait": 3
    },
    {
      "assert": "prison",
      "min": 8
    },
    {
      "travel_with": {
        "to": "harness_c",
        "captives": 9,
        "why": "only 5 free slots on a new map"
      }
    },
    {
      "wait": 60
    },
    {
      "assert": "active_map",
      "is": "harness_c"
    },
    {
      "assert": "prison",
      "is": 5,
      "why": "a new map's prison has 5 slots: 5 of the 9 could come"
    },
    {
      "save": 9
    },
    {
      "reload": 9
    },
    {
      "wait": 40
    },
    {
      "assert": "prison",
      "is": 5
    },
    {
      "open_selector": "vanilla"
    },
    {
      "wait": 3
    },
    {
      "press_travel_button": {
        "num": 42
      }
    },
    {
      "wait": 3
    },
    {
      "screenshot": "complex_back"
    },
    {
      "press_travel_button": {
        "num": 20
      }
    }
  ]
}