+    for (var _i = 0; _i < array_length(arg0); _i++)
+    {
+        var _a = arg0[_i];
+        var _key = _a.kind + _a.label + string(_a.x0) + "," + string(_a.y0) + "," + string(_a.x1) + "," + string(_a.y1);
+
+        if (variable_struct_exists(_seen, _key))
+            continue;  // drawn twice in the frame
+
+        variable_struct_set(_seen, _key, true);
