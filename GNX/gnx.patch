+function scr_gnx_exec_tool_action(arg0, arg1)
+{
+    var _type = arg0.type;
+    
+    switch (_type)
+    {
+        case "add_gold":
+            global.val.money = max(0, global.val.money + arg0.amount);
+            break;
+        
+        case "add_food":
+            global.val.food = max(0, global.val.food + arg0.amount);
+            break;
+        
+        case "add_milk":
+            var _rarity = variable_struct_exists(arg0, "rarity") ? arg0.rarity : -1;
+            var _amt = variable_struct_exists(arg0, "amount") ? arg0.amount : 1;
+            
+            if (_rarity == -1)
+            {
+                for (var _r = 0; _r <= 4; _r++)
+                    scr_add_milk_item(_r, _amt);
+            }
+            else
+            {
+                scr_add_milk_item(_rarity, _amt);
+            }
+            
+            break;
+        
+        case "add_orbs":
+            global.val.orb_num = max(0, global.val.orb_num + arg0.amount);
+            break;
+        
+        case "give_item":
+            scr_set_item_data(arg0.item_type, arg0.data, arg0.level);
+            scr_add_item();
+            break;
+        
+        case "give_blueprint":
+            var _ht = gnx_tool_resolve_cell(arg0.h_type, arg1);
+
+            // POPRAWKA: nieznana cela -> komunikat zamiast blueprintu na nieistniejaca cele
+            if (_ht == -1 || !ds_map_exists(global.cell_registry, _ht))
+            {
+                scr_gnx_pop_up_create("Unknown cell (" + string(arg0.h_type) + "). Contact modder.");
+                break;
+            }
+            var _frag = variable_struct_exists(arg0, "fragment") ? arg0.fragment : false;
+            var _lvl = _frag ? (variable_struct_exists(arg0, "lvl") ? arg0.lvl : 1) : 3;
+            scr_set_item_data(5, _ht, _lvl);
+            scr_add_item();
+            break;
+        
+        case "give_prop":
+            scr_add_new_prop_type(arg0.prop_id, true);
+            break;
+        
+        case "spawn_mon":
+            var _sp = arg0.species;
+            var _amt = arg0.amount;
+            var _sp_struct;
+            
+            switch (_sp)
+            {
+                case 0:
+                    _sp_struct = global.val.goblin;
+                    break;
+                
+                case 1:
+                    _sp_struct = global.val.hobgoblin;
+                    break;
+                
+                case 2:
+                    _sp_struct = global.val.tentacle;
+                    break;
+                
+                case 3:
+                    _sp_struct = global.val.ogre;
+                    break;
+                
+                default:
+                    exit;
+            }
+            
+            var _gc_start = 0;
+            var _gc_end = 3;
+            
+            if (variable_struct_exists(arg0, "class"))
+            {
+                _gc_start = arg0.class;
+                _gc_end = arg0.class;
+            }
+            
+            for (var _gc = _gc_start; _gc <= _gc_end; _gc++)
+            {
+                if (_sp_struct.num[_gc] == -1)
+                {
+                    scr_mon_num_edit(_sp, _gc, 1, true);
+                    
+                    if (_amt > 1)
+                        scr_mon_num_edit(_sp, _gc, _amt - 1, true);
+                }
+                else
+                {
+                    scr_mon_num_edit(_sp, _gc, _amt, true);
+                }
+            }
+            
+            // POPRAWKA: populacja (nest_num[0]) liczona od nowa z mon_num - inaczej licznik goni dopiero po rajdzie albo wczytaniu
+            global.val.nest_num[0] = scr_all_mon_num_cal();
+            break;
+        
+        case "set_troop_level":
+            var _sp_struct;
+            
+            switch (arg0.species)
+            {
+                case 0:
+                    _sp_struct = global.val.goblin;
+                    break;
+                
+                case 1:
+                    _sp_struct = global.val.hobgoblin;
+                    break;
+                
+                case 2:
+                    _sp_struct = global.val.tentacle;
+                    break;
+                
+                case 3:
+                    _sp_struct = global.val.ogre;
+                    break;
+                
+                default:
+                    exit;
+            }
+            
+            _sp_struct.lvl[arg0.class] = arg0.value;
+            break;
+        
+        case "add_troop_exp":
+            scr_mon_exp_edit(arg0.species, arg0.class, 99, arg0.amount, false);
+            break;
+        
+        case "set_skill_level":
+            var _sp_struct;
+            
+            switch (arg0.species)
+            {
+                case 0:
+                    _sp_struct = global.val.goblin;
+                    break;
+                
+                case 1:
+                    _sp_struct = global.val.hobgoblin;
+                    break;
+                
+                case 2:
+                    _sp_struct = global.val.tentacle;
+                    break;
+                
+                case 3:
+                    _sp_struct = global.val.ogre;
+                    break;
+                
+                default:
+                    exit;
+            }
+            
+            _sp_struct.skill_lvl[arg0.class] = arg0.value;
+            break;
+        
+        case "set_troop_size":
+            global.val.troop_size = clamp(arg0.value, 0, 7);
+            break;
+        
+        case "create_unit":
+            var _cls = gnx_tool_resolve_class(arg0.class_id, arg1);
+            
+            // POPRAWKA: nieznana nazwa klasy -> komunikat (wczesniej tylko wpis w logu)
+            if (_cls < 0)
+            {
+                scr_gnx_pop_up_create("Unknown class (" + string(arg0.class_id) + "). Contact modder.");
+                break;
+            }
+            
+            var _lvl = variable_struct_exists(arg0, "level") ? arg0.level : -1;
+            
+            if (_lvl <= 0)
+                _lvl = variable_global_exists("gnx_spawn_rank") ? global.gnx_spawn_rank : 0;
+            
+            var _is_special = false;
+            
+            if (ds_map_exists(global.class_registry, _cls))
+            {
+                var _cr = ds_map_find_value(global.class_registry, _cls);
+                
+                if (variable_struct_exists(_cr, "is_special"))
+                    _is_special = _cr.is_special;
+            }
+            
+            if (_is_special)
+            {
+                if (_lvl != 6 && _lvl != 7)
+                    _lvl = 5;
+            }
+            else if (_lvl != 6 && _lvl > 4)
+            {
+                _lvl = 4;
+            }
+            
+            if (!ds_map_exists(global.class_registry, _cls))
+            {
+                scr_gnx_pop_up_create("Unknown class (id=" + string(_cls) + "). Contact modder.");
+                break;
+            }
+            
+            var _unit = scr_create_unit_base(_cls, _lvl);
+            var _placed = false;
+            
+            for (var _ui = 0; _ui < ds_list_size(global.unit_list); _ui++)
+            {
+                if (ds_list_find_value(global.unit_list, _ui) == -1)
+                {
+                    ds_list_set(global.unit_list, _ui, _unit);
+                    _placed = true;
+                    break;
+                }
+            }
+            
+            if (_placed)
+            {
+                var _uname = "";
+                
+                if (ds_map_exists(global.class_registry, _cls))
+                    _uname = ds_map_find_value(global.class_registry, _cls).name;
+                
+                scr_gnx_pop_up_create((_uname != "") ? (_uname + " added!") : "Unit added!");
+                
+                if (variable_instance_exists(obj_np, "unit_button") && obj_np.unit_button.child_window != -1)
