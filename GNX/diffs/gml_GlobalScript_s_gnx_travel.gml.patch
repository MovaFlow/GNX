+function scr_gnx_travel_menu_btn_init()
+{
+    fail_shake = false;
+    hover = false;
+    gui = true;
+    act_resize = false;  // the press animation resets image_xscale, which is stretched to fit the label
+    spr_sel = spr_button_menu_sel;
+
+    if (button_num == 99)
+        text = "CLOSE";
+    else
+        text = source_id.dest[button_num].label + "  (" + source_id.dest[button_num].note + ")";
