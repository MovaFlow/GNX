+// cached parse of a save file for the menus (mod page + load page parse each save once per change)
+function gnx_save_info_cached(arg0)
+{
+    if (!variable_global_exists("gnx_save_info_cache") || !is_struct(global.gnx_save_info_cache))
+        global.gnx_save_info_cache = {};
