+/// GNX-BYCLASS: the newborn sprite for a mother of class arg1 in cell arg0 (a cell_registry entry). A
+/// class_map cell: her class's own (infant_spr in her human_spr.classes entry), else the default entry's,
+/// else none; never the cell's own infant_spr. Any other cell: the cell's. -1 = none (invisible newborn,
+/// the birth still completes).
+function gnx_infant_for(arg0, arg1)
+{
+    if (variable_struct_exists(arg0, "gnx_milk_cmap") && arg0.gnx_milk_cmap)
+    {
+        var _s = variable_struct_get(arg0.gnx_infant_bc, string(arg1));
+
+        // == undefined: the class has no entry of its own, so the default entry's (if any)
+        if (_s == undefined)
+            _s = variable_struct_get(arg0.gnx_infant_bc, "default");
+
+        return (_s != undefined) ? _s : -1;
+    }
+
+    return variable_struct_exists(arg0, "gnx_infant") ? arg0.gnx_infant : -1;
+}
