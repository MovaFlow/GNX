+    var _y_def = (arg4 != -1) ? (-gnx_sprite_get_yoffset(arg4) - 2) : -12;
+    // align: -1 left, 0 center, 1 right; valign: -1 top, 0 middle, 1 bottom; outline -1 = none; digits -1 = the game font; max_n = the JSON
+    // "max" (a field cannot be called max, the name of a function)
+    var _c = 
+    {
+        x: 0,
+        y: _y_def,
+        align: 0,
+        valign: 1,
+        angle: 0,
+        follow_fx: true,
+        turn_digits: true,
+        color: c_white,
+        scale: 1,
+        max_n: 9999,
+        loop: false,
+        pad: 0,
+        show_hover: false,
+        prefix: "",
+        suffix: "",
+        outline: -1,
+        digits: -1,
+        spacing: 1,
+        dig_w: 0,
+        dig_h: 0,
+        dig_xo: 0,
+        dig_yo: 0
