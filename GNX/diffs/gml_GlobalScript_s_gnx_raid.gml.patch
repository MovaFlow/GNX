+// GNX-STAGE: mod raid stages (raids.json). Vanilla stages are 0-4; the stages of the mods loaded on this map
+// follow from 5, in load order (global.gnx_stage_registry[i] = stage 5 + i). The stage arrays in global.val
+// (stage_info, stage_lvl_sel, stage_item) are saved by position, so global.val.gnx_stage_keys names what sits
+// at 5, 6, ...; scr_gnx_stage_apply re-maps them by name after every boot and load, and keeps the stages of
+// mods that are gone in global.val.gnx_stage_orphans until they come back.
+function scr_gnx_init_stages()
+{
+    global.gnx_stage_registry = [];
+    global.gnx_stage_spawn_refs = [];  // raid_spawns naming a mod stage, waiting for that stage to load
+    global.gnx_stage_trade_refs = [];  // trade_stage naming a stage ({stage, class_id, mod_name})
+    global.gnx_stage_cart_origin = [200, 59];
+
+    if (!variable_global_exists("gnx_raid_routes"))
+        global.gnx_raid_routes = false;  // GNX DEBUG toggle RAID ROUTES  // where the vanilla raid cart leaves from on the world map (the nest)
+}
+
+
+// the raid-map button picture of a stage: icon arg1 of mod arg0. A number 0-4 reuses that vanilla stage's button;
+// a PNG in the mod's sprites/ folder is one square frame (vanilla 27 x 27), or two side by side (normal, hover).
+// Returns { spr, frames, vanilla } (vanilla = the vanilla frame, or -1).
+function gnx_stage_load_icon(arg0, arg1)
+{
+    var _out = { spr: spr_button_stage, frames: 1, vanilla: 0 };
+
+    if (is_numeric(arg1))
+    {
+        _out.vanilla = clamp(floor(arg1), 0, 4);
+        return _out;
+    }
+
+    if (!is_string(arg1) || arg1 == "")
+        return _out;
+
+    var _path = global.gnx_mods_root + arg0 + "/sprites/" + arg1;
+    var _cache = _path + "#stage";
+    var _spr = -1;
+
+    if (ds_map_exists(global.gnx_sprite_cache, _cache) && gnx_sprite_exists(ds_map_find_value(global.gnx_sprite_cache, _cache)))
+    {
+        _spr = ds_map_find_value(global.gnx_sprite_cache, _cache);
+    }
+    else if (file_exists(_path))
+    {
+        // measured with one frame first: a strip twice as wide as high holds the hover frame
+        var _probe = sprite_add(_path, 1, false, false, 0, 0);
+
+        if (_probe != -1)
+        {
+            var _w = sprite_get_width(_probe);
+            var _h = sprite_get_height(_probe);
+            var _n = (_w >= 2 * _h) ? 2 : 1;
+            sprite_delete(_probe);
+            _spr = sprite_add(_path, _n, false, false, (_w div _n) div 2, _h div 2);
+
+            if (_spr != -1)
+            {
+                array_push(global.gnx_runtime_sprites, _spr);
+                ds_map_set(global.gnx_sprite_cache, _cache, _spr);
+            }
+        }
+    }
+
+    if (_spr == -1)
+    {
+        gnx_report_mod_error("Mod '" + arg0 + "': stage icon sprites/" + arg1 + " not found or not a PNG; the vanilla button is used");
+        return _out;
+    }
+
+    _out.spr = _spr;
+    _out.frames = sprite_get_number(_spr);
+    _out.vanilla = -1;
+    return _out;
+}
