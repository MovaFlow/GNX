+        // [SHELVED 1.3.11] case "gml" removed (GMLC not shipped)
+        case "gml":
+            break;
+
+        default:
+        {
+            var _log = file_text_open_append(GNX_LOG);
+            file_text_write_string(_log, "[GNX-TOOL] unknown action type: " + _type + "\n");
+            file_text_close(_log);
+            break;
+        }
+    }
+}
