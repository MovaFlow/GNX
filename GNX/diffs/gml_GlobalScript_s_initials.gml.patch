+
+        for (var _j = _i + 1; _j < array_length(_r); _j++)
+        {
+            var _b = _r[_j];
+            var _ox = min(_a.x1, _b.x1) - max(_a.x0, _b.x0);
+            var _oy = min(_a.y1, _b.y1) - max(_a.y0, _b.y0);
+
+            if (_ox <= 1 || _oy <= 1)
+                continue;
+
+            var _a_holds = _a.kind == "box" && _b.x0 >= _a.x0 - 1 && _b.y0 >= _a.y0 - 1 && _b.x1 <= _a.x1 + 1 && _b.y1 <= _a.y1 + 1;
+            var _b_holds = _b.kind == "box" && _a.x0 >= _b.x0 - 1 && _a.y0 >= _b.y0 - 1 && _a.x1 <= _b.x1 + 1 && _a.y1 <= _b.y1 + 1;
