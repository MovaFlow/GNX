+/// GNX-FRAMES: the own frame table of the current cell (physical.frames): the base scene scripts play
+/// these frames at the vanilla speed per frame. undefined for vanilla cells and cells without frames:
+/// then every helper below returns the vanilla value and nothing changes.
+function gnx_cell_speed_frames()
+{
+    var _cell = ds_map_find_value(global.cell_registry, slot_data.h_type);
+    
+    // || = or: GameMaker stops at the first true part, so .physical is read only when the cell exists
+    if (_cell == undefined || !variable_struct_exists(_cell.physical, "gnx_phase_frames"))
+        return undefined;
+    
+    return _cell.physical.gnx_phase_frames;
