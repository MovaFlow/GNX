{
  "about": "GNX DEBUG > RELOAD MODS (tool action reload_mods): the game is autosaved, every mod's files are read again and the autosave is loaded back. A mod item renamed in memory gets its items.json name back; the inventory (2 shards) survives.",
  "mods": [
    "tools/scenarios/mods/harness_cells",
    "tools/scenarios/mods/harness_items"
  ],
  "check_boot_suite": false,
  "steps": [
    {
      "wait": 30
    },
    {
      "do": {
        "type": "give_item",
        "item": "harness_items.MOON SHARD",
        "amount": 2
      }
    },
    {
      "call": "gnx_scn_tamper_item",
      "args": [
        "harness_items.MOON SHARD"
      ]
    },
    {
      "assert": "fn",
      "name": "gnx_scn_item_name",
      "args": [
        "harness_items.MOON SHARD"
      ],
      "is": "TAMPERED"
    },
    {
      "do": {
        "type": "reload_mods"
      }
    },
    {
      "wait": 60
    },
    {
      "assert": "fn",
      "name": "gnx_scn_item_name",
      "args": [
        "harness_items.MOON SHARD"
      ],
      "is": "MOON SHARD",
      "why": "items.json read again"
    },
    {
      "assert": "fn",
      "name": "gnx_scn_item_count",
      "args": [
        "harness_items.MOON SHARD"
      ],
      "is": 2,
      "why": "the game came back from the autosave"
    }
  ]
}