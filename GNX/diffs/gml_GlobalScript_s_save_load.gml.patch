+// Sprawdza, czy arg0 to istniejaca instancja (a nie -1, indeks obiektu albo uszkodzony wpis z zapisu). Zwraca true/false.
+function gnx_is_live_inst(arg0)
+{
+    // tekst / struktura / tablica = uszkodzony wpis z zapisu
+    if (is_string(arg0) || is_struct(arg0) || is_array(arg0) || is_undefined(arg0))
+        return false;
+    
+    // ID instancji zaczynaja sie od 100000. Mniejsze liczby to -1 (puste) albo indeksy obiektow,
+    // a instance_exists(-1) to instance_exists(self) - zawsze true, wiec trzeba je odsiac wczesniej.
+    if (is_numeric(arg0) && arg0 < 100000)
+        return false;
+    
+    return instance_exists(arg0);
