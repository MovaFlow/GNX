--- gml_138/gml_Object_obj_control_Step_0.gml	2026-09-02 08:45:16.157546500 +0200
+++ gml/gml_Object_obj_control_Step_0.gml	2026-10-27 11:30:57.447243300 +0100
@@ -1 +1,134 @@
-scr_mouse_control();
+if (global.gnx_multimap_enabled && variable_global_exists("gnx_trigger_load") && global.gnx_trigger_load)
+{
+    global.gnx_trigger_load = false;
+    global.click_lock = true;
+    
+    if (instance_exists(obj_p) && audio_is_playing(obj_p.game_bgm))
+        audio_stop_sound(obj_p.game_bgm);
+    
+    with (obj_slot)
+        instance_destroy();
+    
+    with (obj_mon)
+        instance_destroy();
+    
+    with (obj_button)
+        instance_destroy();
+    
+    with (obj_window)
+        instance_destroy();
+    
+    if (instance_exists(obj_empty))
+    {
+        with (obj_empty)
+        {
+            if (!variable_instance_exists(id, "gnx_travel_fx"))  // the travel transition outlives the load
+                instance_destroy();
+        }
+    }
+    
+    if (instance_exists(obj_pop_up))
+    {
+        with (obj_pop_up)
+            instance_destroy();
+    }
+    
+    global.gnx_in_travel = true;
+    var _gnx_it0 = get_timer();
+    scr_create_initials();
+    gnx_time_log("travel: re-initialise (loader + boot tests)", _gnx_it0);
+    global.gnx_in_travel = false;
+    
+    // carried day/gold/food/goblins are applied after the destination map has loaded (see below)
+    
+    if (global.gnx_travel_data == -1 && variable_struct_exists(global.gnx_map_start_decl, global.gnx_active_map))
+        global.gnx_pending_map_start = global.gnx_active_map;
+    
+    if (variable_global_exists("gnx_travel_data") && global.gnx_travel_data != -1)
+        global.load_file = 0;
+    
+    obj_np.load_state = 6;
+    exit;
+}
+
+scr_mouse_control();
+
+if (variable_global_exists("gnx_pending_notice") && global.gnx_pending_notice != "" && instance_exists(obj_slot))
+{
+    scr_gnx_pop_up_create(global.gnx_pending_notice);
+    global.gnx_pending_notice = "";
+}
+
+if (global.gnx_multimap_enabled && global.gnx_pending_map_start != "" && instance_exists(obj_slot))
+{
+    var _msm = global.gnx_pending_map_start;
+    global.gnx_pending_map_start = "";
+    scr_gnx_apply_map_start(_msm);
+}
+
+// Travel carry (pre-travel selector + shared day counter). Applied only once the destination map is in
+// place, after its map_start: applying it before the map loads let the load / map_start overwrite it.
+if (global.gnx_multimap_enabled && global.gnx_pending_map_start == "" && instance_exists(obj_slot) && !scr_gnx_travel_pending() && (global.gnx_carry_day != -1 || global.gnx_carry_gold > 0 || global.gnx_carry_food > 0 || is_array(global.gnx_carry_troops) || is_array(global.gnx_carry_captives)))
+{
+    if (global.gnx_carry_day != -1)
+    {
+        global.val.day = global.gnx_carry_day;
+        global.val.day_timer = global.gnx_carry_timer;
+    }
+    
+    if (global.gnx_carry_gold > 0)
+        global.val.money += global.gnx_carry_gold;
+    
+    if (global.gnx_carry_food > 0)
+        global.val.food += global.gnx_carry_food;
+    
+    scr_gnx_apply_carry_units(true);  // monsters and prisoners taken along
+    global.gnx_carry_day = -1;
+    global.gnx_carry_timer = -1;
+    global.gnx_carry_gold = -1;
+    global.gnx_carry_food = -1;
+}
+
+// Unlocks are shared by every map: merged in once the destination is up (see scr_gnx_merge_unlocks)
+if (global.gnx_multimap_enabled && is_struct(global.gnx_carry_unlock) && global.gnx_pending_map_start == "" && instance_exists(obj_slot) && !scr_gnx_travel_pending())
+{
+    scr_gnx_merge_unlocks(global.gnx_carry_unlock);
+    global.gnx_carry_unlock = -1;
+    gnx_merge_inventory(global.gnx_carry_inv);  // the inventory is shared too
+    global.gnx_carry_inv = -1;
+    scr_gnx_check_triggers("map_arrive");  // quest triggers on arrival (conditions: on_map, map_visited...)
+}
+
+global.gnx_map_unlock_tick++;
+
+if (global.gnx_multimap_enabled && instance_exists(obj_slot) && (global.gnx_map_unlock_tick mod 60) == 0)  // maps whose unlock condition was just met
+    scr_gnx_check_map_unlocks();
+
+if (instance_exists(obj_slot) && (global.gnx_map_unlock_tick mod 60) == 0)  // mod raid loot this save has not had yet
+    gnx_loot_sync();
+
+if (global.gnx_perf_enabled)
+{
+    global.gnx_perf_frame++;
+    
+    if (global.gnx_perf_frame >= 120)
+    {
+        var _sd = global.gnx_perf_slots_drawn;
+        var _st = instance_number(obj_slot) * 120;
+        var _md = global.gnx_perf_mons_drawn;
+        var _mt = instance_number(obj_mon) * 120;
+        var _pct = (_st > 0) ? string(round(((_st - _sd) / _st) * 100)) : "0";
+        var _f = gnx_log_open();
+        gnx_log_write(_f, "[GNX-PERF] slots=" + string(_sd) + "/" + string(_st) + " culled=" + _pct + "% mons=" + string(_md) + "/" + string(_mt) + " fps=" + string(fps) + " fps_real=" + string(fps_real) + " inst=" + string(instance_count) + " slot=" + string(instance_number(obj_slot)) + " mon=" + string(instance_number(obj_mon)) + " btn=" + string(instance_number(obj_button)) + " empty=" + string(instance_number(obj_empty)));
+        gnx_log_writeln(_f);
+        gnx_log_close(_f);
+        global.gnx_perf_slots_drawn = 0;
+        global.gnx_perf_mons_drawn = 0;
+        global.gnx_perf_frame = 0;
+    }
+}
+
+scr_gnx_check_quest_completion("frame");
+scr_gnx_check_keybinds();
+scr_gnx_apply_continuous_effects();
+scr_gnx_goblin_ambient_step();
