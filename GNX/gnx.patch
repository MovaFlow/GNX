+    if (!_a.moves && _a.flash_t <= 0 && _a.count == 0 && _a.count_set < 0)
+    {
+        gnx_report_mod_error(gnx_err_who(arg1) + ": " + arg2 + " does nothing (it needs frame, step, play, flash, count or count_set); ignored");
