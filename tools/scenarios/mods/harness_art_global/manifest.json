{
  "mod_id": "harness_art_global",
  "name": "GNX Harness harness_art_global",
  "version": "1.0.0",
  "_about": "Test mod for the monster_art scenarios. Not for players.",
  "compatible_game_versions": [
    "1.40"
  ],
  "monster_art": {
    "sprites": {
      "g_pen": {
        "strip": "strips/g_pen.png",
        "frames": 75
      },
      "g_walk": {
        "strip": "strips/g_walk.png",
        "frames": 8
      }
    },
    "goblin": {
      "standard": {
        "loop": {
          "body": {
            "any": {
              "fill": "spr_h_goblin_body_ej_alpha",
              "line": "spr_h_goblin_body_ej_line"
            }
          },
          "pen": "gnx:g_pen"
        }
      },
      "shrine": {
        "loop": {
          "touch": "spr_h_goblin_shrine_enter"
        }
      },
      "world": {
        "walk": {
          "strip": "world/walk.png",
          "frames": 10,
          "xorig": 32,
          "yorig": 72
        }
      }
    },
    "hobgoblin": {
      "shrine": {
        "start": {
          "body": "spr_h_goblin_shrine_start_body_alpha"
        }
      }
    },
    "ogre": {
      "carry": {
        "walk": "gnx:g_walk"
      },
      "shrine": {
        "start": {
          "pen": "spr_h_goblin_shrine_start_pen"
        }
      }
    }
  }
}