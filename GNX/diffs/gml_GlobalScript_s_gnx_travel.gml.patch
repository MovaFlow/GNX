+// ---------------------------------------------------------------------------
+// Pre-travel selector (window 9060, buttons 9061). Tabs by tier: BASIC (gold, food; goblins too on simple maps),
+// TROOPS (advanced: monsters by kind, raid-formation style, vanilla number pad), CAPTIVES (complex: prisoners
+// dragged into the destination's free prison slots). A map mod sets its tier with map_button.travel.
+// Button numbers: 20 cancel, 21 travel, 30/31 ALL/NONE (travel_row), 40+tab, 50-55 steps -100..+100
+// (travel_row), 60+type monster category, 70+class take (number pad), 80+i party entry, 90/91 captive page.
+// ---------------------------------------------------------------------------
+
+// 0 simple, 1 advanced, 2 complex: the highest tier of the map left and the map reached
+// what a trip to arg0 costs: map_info.travel_cost {gold, food, days} of the destination and of the map we are
+// on, the higher of each (like the selector tier); the village costs nothing
+function gnx_travel_cost(arg0)
+{
+    var _c = { gold: 0, food: 0, days: 0 };
+
+    for (var _i = 0; _i < array_length(global.gnx_travel_locations); _i++)
+    {
+        var _tl = global.gnx_travel_locations[_i];
+
+        if ((_tl.target == arg0 || _tl.target == global.gnx_active_map) && _tl.target != "vanilla" && variable_struct_exists(_tl, "cost"))
+        {
+            _c.gold = max(_c.gold, _tl.cost.gold);
+            _c.food = max(_c.food, _tl.cost.food);
+            _c.days = max(_c.days, _tl.cost.days);
+        }
+    }
+
+    return _c;
+}
+
+
+// "Trip: 50 gold, 10 food, 1 day" ("" when free)
+function gnx_travel_cost_text(arg0)
+{
+    var _parts = [];
+
+    if (arg0.gold > 0)
+        array_push(_parts, gnx_short_num(arg0.gold) + " gold");
+
+    if (arg0.food > 0)
+        array_push(_parts, gnx_short_num(arg0.food) + " food");
+
+    if (arg0.days > 0)
+        array_push(_parts, string(arg0.days) + ((arg0.days == 1) ? " day" : " days"));
+
+    var _t = "";
+
+    for (var _i = 0; _i < array_length(_parts); _i++)
+        _t += ((_i > 0) ? ", " : "") + _parts[_i];
+
+    return (_t == "") ? "" : ("Trip: " + _t);
+}
+
+
+function gnx_travel_tier(arg0)
+{
+    var _tier = 0;
+    var _names = ["simple", "advanced", "complex"];
+
+    for (var _i = 0; _i < array_length(global.gnx_travel_locations); _i++)
+    {
+        var _tl = global.gnx_travel_locations[_i];
+
+        if ((_tl.target == arg0 || _tl.target == global.gnx_active_map) && _tl.target != "vanilla" && variable_struct_exists(_tl, "travel"))
+        {
+            for (var _k = 0; _k < 3; _k++)
+            {
+                if (_names[_k] == _tl.travel)
+                    _tier = max(_tier, _k);
+            }
+        }
+    }
+
+    return _tier;
