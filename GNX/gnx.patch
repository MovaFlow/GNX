+    // == 5 or < 1: vanilla strip (or nothing to scale), the frame stays
+    if (arg1 == 5 || arg1 < 1)
+        return arg0;
+    
+    // clamp keeps it inside the strip: 0 ... arg1 - 1
+    return clamp(round((arg0 * arg1) / 5), 0, arg1 - 1);
+}
+
+/// GNX-PLACES: ej key frames for a loop strip of arg0 frames: [first, held, after the hold, count], as
+/// gnx_ej_keys (physical.ej_start / ej_hold, else 2 and 3 of 5 moved in proportion)
+function gnx_places_ej_keys(arg0)
+{
+    var _cell = ds_map_find_value(global.cell_registry, slot_data.h_type);
+    var _n = max(1, arg0);
+    // ? : the cell's own key frame when it has one, else -1 (= move vanilla's in proportion)
+    var _es = (_cell != undefined && variable_struct_exists(_cell.physical, "gnx_ej_start")) ? _cell.physical.gnx_ej_start : -1;
+    var _eh = (_cell != undefined && variable_struct_exists(_cell.physical, "gnx_ej_hold")) ? _cell.physical.gnx_ej_hold : -1;
+    var _s = (_es >= 0) ? _es : round((2 * _n) / 5);
+    var _h = (_eh >= 0) ? _eh : round((3 * _n) / 5);
