+
+/// GNX-UG: checks the strips under every key named arg1 anywhere in arg0 (a human_spr block) against arg2
+/// frames per row; captive strips may loop. arg3 = cell name, arg4 = "sprites" block. Returns the problems.
+function gnx_frames_check_named_tables(arg0, arg1, arg2, arg3, arg4)
+{
+    var _bad = 0;
+    
+    if (is_array(arg0))
+    {
+        for (var i = 0; i < array_length(arg0); i++)
+            _bad += gnx_frames_check_named_tables(arg0[i], arg1, arg2, arg3, arg4);
+        
+        return _bad;
+    }
+    
+    if (!is_struct(arg0))
+        return 0;
+    
+    var _names = variable_struct_get_names(arg0);
+    
+    for (var i = 0; i < array_length(_names); i++)
+    {
+        var _v = variable_struct_get(arg0, _names[i]);
+        
+        // == arg1: the table we look for; anything else may hold it further down
+        if (_names[i] == arg1)
+            _bad += gnx_frames_check_refs(_v, arg2, arg3, "human_spr." + arg1, arg4, true);
+        else
+            _bad += gnx_frames_check_named_tables(_v, arg1, arg2, arg3, arg4);
+    }
+    
+    return _bad;
+}
+
+
+/// GNX-FRAMES: walks a human_spr block (arg0) and checks the strips under every key phase_0 ... phase_4
+/// with that phase's count (arg3), skipping phases the cell never draws (arg4[phase] false).
+/// arg1 = cell name, arg2 = "sprites" block. Returns the number of problems.
+function gnx_frames_check_phase_tables(arg0, arg1, arg2, arg3, arg4)
+{
+    var _bad = 0;
+    
+    if (is_array(arg0))
+    {
+        for (var i = 0; i < array_length(arg0); i++)
+            _bad += gnx_frames_check_phase_tables(arg0[i], arg1, arg2, arg3, arg4);
+        
+        return _bad;
+    }
+    
+    if (!is_struct(arg0))
+        return 0;
+    
+    var _names = variable_struct_get_names(arg0);
+    
+    for (var i = 0; i < array_length(_names); i++)
+    {
+        var _k = _names[i];
+        var _v = variable_struct_get(arg0, _k);
+        
+        // string_copy(text, 1, 6) = the first 6 characters; "phase_" + one digit 0-4
+        if (string_length(_k) == 7 && string_copy(_k, 1, 6) == "phase_" && string_digits(_k) != "" && real(string_digits(_k)) <= 4)
+        {
+            var _pn = real(string_digits(_k));
+            
+            // a table the cell never draws cannot show wrong frames
+            if (arg4[_pn])
+                _bad += gnx_frames_check_refs(_v, arg3[_pn], arg1, "human_spr." + _k, arg2, true);
+        }
+        else
+        {
+            _bad += gnx_frames_check_phase_tables(_v, arg1, arg2, arg3, arg4);
+        }
+    }
+    
+    return _bad;
+}
+
+
+/// GNX-FRAMES: checks every "gnx:<name>" sprite under arg0 against arg1 frames per row. arg2 = cell name,
+/// arg3 = where it is (for the message), arg4 = "sprites" block. Game sprites (no "gnx:") are not checked.
+/// Fewer frames than one row = mod error; frames left over after the last full row = log line only.
+/// arg5 = true for the captive's strips: those may be marked "loop" (they loop their own frames inside
+/// the phase, so any count fits). Monsters and the tentacle / milk overlays have no loop: they always
+/// need the phase's count. Returns the number of strips with too few frames.
+function gnx_frames_check_refs(arg0, arg1, arg2, arg3, arg4, arg5)
+{
+    var _bad = 0;
+    
+    if (is_string(arg0))
+    {
+        if (string_copy(arg0, 1, 4) != "gnx:" || !is_struct(arg4))
+            return 0;
+        
+        var _name = string_delete(arg0, 1, 4);
+        
+        if (!variable_struct_exists(arg4, _name))
+            return 0;
+        
+        var _def = variable_struct_get(arg4, _name);
+        var _n = -1;
+        
+        // "frames": a number (frames in the strip) or a list (atlas frames); a single image has 1
+        if (is_struct(_def) && variable_struct_exists(_def, "frames"))
+            _n = is_array(_def.frames) ? array_length(_def.frames) : floor(gnx_json_num(_def.frames, -1));
+        else if (is_struct(_def) || is_string(_def))
+            _n = 1;
+        
+        // GNX-LOOP-STRIP: a looping captive strip fits any phase length
+        var _is_loop = is_struct(_def) && variable_struct_exists(_def, "loop") && !(is_numeric(_def.loop) && _def.loop == 0);  // GNX: false arrives as 0
+        
+        if (_is_loop && arg5)
+            return 0;
+        
+        if (_is_loop && _n > 1 && _n < arg1)
+        {
+            gnx_report_mod_error("Cell '" + string(arg2) + "': strip '" + _name + "' (" + arg3 + ") is marked loop, but only the captive's strips can loop: it needs " + string(arg1) + " frames per row, like the captive's phase");
+            return 1;
+        }
+        
+        // too few frames for one row: the animation would run past the strip -> mod error
+        // (1 frame = a still image, it always fits)
+        if (_n > 1 && _n < arg1)
+        {
+            gnx_report_mod_error("Cell '" + string(arg2) + "': strip '" + _name + "' (" + arg3 + ") has " + string(_n) + " frames, it needs " + string(arg1) + " per row");
+            return 1;
+        }
+        
+        // % = remainder: 10 frames are 2 full rows of 5 (10 % 5 == 0); 12 leave 2 frames that are never
+        // shown. That can be on purpose (a strip shared with a longer phase), so it is only a log line.
+        if (_n > 1 && (_n % arg1) != 0)
+        {
+            var _wl = gnx_log_open();
+            gnx_log_write(_wl, "[GNX-FRAMES] " + string(arg2) + ": strip '" + _name + "' (" + arg3 + ") has " + string(_n) + " frames, the phase uses " + string(arg1) + " per row; the last " + string(_n % arg1) + " are not shown\n");
+            gnx_log_close(_wl);
+        }
+        
+        return 0;
+    }
+    
+    if (is_array(arg0))
+    {
+        for (var i = 0; i < array_length(arg0); i++)
+            _bad += gnx_frames_check_refs(arg0[i], arg1, arg2, arg3, arg4, arg5);
+    }
+    else if (is_struct(arg0))
+    {
+        var _names = variable_struct_get_names(arg0);
+        
+        for (var i = 0; i < array_length(_names); i++)
+        {
+            var _v = variable_struct_get(arg0, _names[i]);
+            
+            // GNX-FIX: in a captive table the hand (place 3 of spr_array / spr_c_array) is no animation:
+            // its strip holds hand poses per skin (hand_frames picks them), so its frame count is not the
+            // phase's. Every other place is checked.
+            if ((_names[i] == "spr_array" || _names[i] == "spr_c_array") && is_array(_v))
+            {
+                for (var j = 0; j < array_length(_v); j++)
+                {
+                    if (j != 3)
+                        _bad += gnx_frames_check_refs(_v[j], arg1, arg2, arg3, arg4, arg5);
+                }
+                
+                continue;
+            }
+            
+            _bad += gnx_frames_check_refs(_v, arg1, arg2, arg3, arg4, arg5);
+        }
+    }
+    
+    return _bad;
+}
+
+
+/// GNX-PLACES: whether a cell runs independent places: its scene list (arg0, the names from the JSON) holds
+/// "scr_slot_h_gnx_places". arg1 = max_mon_num, arg2 = the cell's name for mod errors. Other entries next to
+/// it are a mod error and are not run: the caller then keeps the places script alone (audit 25), so the cell
+/// never runs a half places, half vanilla scene. A cell without room for a monster is a mod error (it gets
+/// no monsters, so no scene ever starts).
+function gnx_places_check(arg0, arg1, arg2)
+{
+    if (!is_array(arg0))
+        return false;
+    
+    var _hits = 0;
+    
+    for (var i = 0; i < array_length(arg0); i++)
+    {
+        // == : this entry is the places script
+        if (is_string(arg0[i]) && arg0[i] == "scr_slot_h_gnx_places")
+            _hits++;
+    }
+    
+    if (_hits == 0)
+        return false;
+    
+    // < 1: no room for a monster, so no place to run (the cell calls no monster, its scene never starts)
+    if (gnx_json_num(arg1, 0) < 1)
+    {
+        gnx_report_mod_error("Cell '" + string(arg2) + "': scr_slot_h_gnx_places needs max_mon_num 1 or more; the cell gets no monsters");
+        return false;
+    }
+    
+    // != 1: the places script runs the whole scene; the other entries are left out by the caller
+    if (array_length(arg0) != 1)
+        gnx_report_mod_error("Cell '" + string(arg2) + "': scr_slot_h_gnx_places runs the whole scene, so it must be the only entry of scr_h; the other entries are left out");
+    
+    return true;
+}
