+                    if (_dst[_d] == _v)
+                    {
+                        _have = true;
+                        break;
+                    }
+                }
+                
+                if (_have || (_is_cells && is_real(_v) && _v >= 43 && !ds_map_exists(global.cell_registry, _v)))
+                    continue;
+                
+                array_push(_dst, _v);
+                _n++;
+            }
+        }
+        else if (!is_array(_src) && !is_struct(_src) && _src && !_dst)
+        {
+            variable_struct_set(global.unlock, _k, true);
+            _n++;
+        }
+    }
+    
+    var _l = gnx_log_open();
+    gnx_log_write(_l, "[GNX-MAP] unlocks synced on arrival at '" + global.gnx_active_map + "': " + string(_n) + " added" + chr(10));
+    gnx_log_close(_l);
+    return _n;
+}
+
+
+// is cell h_type arg0 in any build-menu unlock list (scenario checks, map_start)
+function gnx_cell_unlocked(arg0)
+{
+    // GNX-UG: ug_breed too, so map_start unlock_cells does not add an underground cell twice
+    var _cats = ["breed", "utility", "pleasure", "b_breed", "b_utility", "b_other", "t_breed", "t_utility", "xl_breed", "ug_breed"];
+    
+    for (var _i = 0; _i < array_length(_cats); _i++)
+    {
+        if (variable_struct_exists(global.unlock, _cats[_i]) && array_contains(variable_struct_get(global.unlock, _cats[_i]), arg0))
+            return true;
+    }
+
+    return false;
+}
+
+
+// monster type using the cell arg0 now: the first monster in its places, tentacle cells = 2, -1 = none
+function gnx_cell_mon_type(arg0)
+{
+    if (variable_struct_exists(arg0.slot_data, "mon_placement") && is_array(arg0.slot_data.mon_placement))
+    {
+        for (var _i = 0; _i < array_length(arg0.slot_data.mon_placement); _i++)
+        {
+            var _m = arg0.slot_data.mon_placement[_i];
