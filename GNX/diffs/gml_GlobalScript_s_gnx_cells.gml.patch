+// GNX: cell runtime: scene frames, intermissions, underground cells, monster places
+// (moved out of s_initials.gml; the functions are global, callable from any script)
+
+/// GNX-LOOP-STRIP: arg0 = a resolved sprite (a sprite or a GNX sprite struct), arg1 = its JSON
+/// definition. "loop": true = the whole strip is one row that loops; "loop": n = n frames per row
+/// (a strip with several rows, e.g. one per skin). Sprites are remembered in global.gnx_loop_strips,
+/// GNX sprite structs carry the count themselves.
+function gnx_loop_mark(arg0, arg1, arg2 = "")
+{
+    // == -1: nothing was loaded
+    if (!is_struct(arg0) && arg0 == -1)
+        exit;
+    
+    // frames per row of the loop; -1 = this definition does not loop
+    var _n = -1;
+    
+    if (is_struct(arg1) && variable_struct_exists(arg1, "loop"))
+    {
+        var _lv = arg1.loop;
+        
+        // GNX-FIX: JSON true / false arrive as 1 / 0 (not as booleans), so: 1 (= true) loops the whole strip,
+        // 0 (= false) does not loop, 2 or more is the frames per row (a row of 1 frame could not loop anyway)
+        var _lnum = floor(gnx_json_num(_lv, -1));
+        
+        if (_lnum == 1)
+            _n = variable_struct_exists(arg1, "frames") ? (is_array(arg1.frames) ? array_length(arg1.frames) : floor(gnx_json_num(arg1.frames, 1))) : 1;
+        else
+            _n = _lnum;
+        
+        if (_n < 1)
+            _n = -1;
+    }
+    
+    if (!variable_global_exists("gnx_loop_strips") || !is_struct(global.gnx_loop_strips))
+        global.gnx_loop_strips = {};
+    
+    if (!variable_global_exists("gnx_loop_seen") || !is_struct(global.gnx_loop_seen))
+        global.gnx_loop_seen = {};
+    
+    // GNX-FIX: the same PNG with the same frames and origin is loaded once and shared (sprite cache, atlas
+    // entries), and the loop belongs to that shared sprite. Two definitions that disagree (loop 2 and
+    // loop 5, or a loop and none) used to leave the last one in force for both, silently. Now the first
+    // definition stays and the clash is a mod error.
+    var _key = is_struct(arg0) ? "" : string(arg0);
+    var _seen = is_struct(arg0) ? variable_struct_exists(arg0, "gnx_loop_seen") : variable_struct_exists(global.gnx_loop_seen, _key);
+    
+    if (_seen)
+    {
+        var _prev = gnx_loop_frames(arg0);
+        
+        // != : this definition wants another loop than the first one did
+        if (_prev != _n)
+        {
+            var _where = (is_struct(arg1) && variable_struct_exists(arg1, "strip")) ? ("strip '" + string(arg1.strip) + "'") : ("sprite '" + string(arg2) + "'");
+            gnx_report_mod_error(_where + " is shared with another definition that has " + ((_prev >= 1) ? ("\"loop\": " + string(_prev)) : "no loop") + "; this one asks for " + ((_n >= 1) ? ("\"loop\": " + string(_n)) : "no loop") + ". The first one is kept; give both the same loop or use separate PNGs");
+        }
+        
+        exit;
+    }
+    
+    if (is_struct(arg0))
+    {
+        arg0.gnx_loop_seen = true;
+        
+        if (_n >= 1)
+            arg0.gnx_loop = _n;
+    }
+    else
+    {
+        variable_struct_set(global.gnx_loop_seen, _key, true);
+        
+        if (_n >= 1)
+            variable_struct_set(global.gnx_loop_strips, _key, _n);
+    }
+}
+
+
+/// GNX-LOOP-STRIP: frames per row of a looping strip (arg0 = the sprite as stored in a layer), or -1.
+function gnx_loop_frames(arg0)
+{
+    if (is_struct(arg0))
+        return variable_struct_exists(arg0, "gnx_loop") ? arg0.gnx_loop : -1;
+    
+    if (arg0 == -1 || !variable_global_exists("gnx_loop_strips") || !is_struct(global.gnx_loop_strips))
+        return -1;
+    
+    var _k = string(arg0);
+    return variable_struct_exists(global.gnx_loop_strips, _k) ? variable_struct_get(global.gnx_loop_strips, _k) : -1;
+}
+
+
+function gnx_load_sprite_frames(arg0, arg1, arg2)
+{
+    var _n = array_length(arg0);
+    
+    if (_n == 0)
+        return -1;
+    
+    var _spr = sprite_add(arg0[0], 1, false, false, arg1, arg2);
+    
+    if (_spr == -1)
+        return -1;
+    
+    array_push(global.gnx_runtime_sprites, _spr);
+    
+    if (_n == 1)
+        return _spr;
+    
+    var _w = gnx_sprite_get_width(_spr);
+    var _h = gnx_sprite_get_height(_spr);
+    
+    for (var _i = 1; _i < _n; _i++)
+    {
+        var _tmp = sprite_add(arg0[_i], 1, false, false, 0, 0);
+        
+        if (_tmp == -1)
+            continue;
+        
+        var _surf = surface_create(_w, _h);
+        surface_set_target(_surf);
+        draw_clear_alpha(c_black, 0);
+        // POPRAWKA (GNX): bm_one/bm_zero = kopia 1:1; przy zwyklym mieszaniu polprzezroczyste piksele
+        // klatek 1+ wychodzily inne niz w klatce 0 (wczytanej wprost z pliku)
+        gpu_set_blendmode_ext(bm_one, bm_zero);
+        gnx_draw_sprite(_tmp, 0, 0, 0);
+        gpu_set_blendmode(bm_normal);
+        surface_reset_target();
+        sprite_add_from_surface(_spr, _surf, 0, 0, _w, _h, false, false);
+        surface_free(_surf);
+        sprite_delete(_tmp);
+    }
+    
+    return _spr;
+}
+
+
+function gnx_merge_patch_phase(arg0, arg1, arg2, arg3, arg4)
+{
+    var _new = gnx_resolve_special_phase(arg2, arg3, arg4);
+    var _old = variable_struct_exists(arg0, arg1) ? variable_struct_get(arg0, arg1) : undefined;
+    
+    if (is_struct(_old))
+    {
+        if (!variable_struct_exists(arg2, "spr_array") && variable_struct_exists(_old, "spr_array"))
+            _new.spr_array = _old.spr_array;
+        
+        if (!variable_struct_exists(arg2, "spr_c_array") && variable_struct_exists(_old, "spr_c_array"))
+            _new.spr_c_array = _old.spr_c_array;
+        
+        if (variable_struct_exists(_old, "by_class"))
+        {
+            if (!variable_struct_exists(_new, "by_class"))
+                _new.by_class = {};
+            
+            var _old_keys = variable_struct_get_names(_old.by_class);
+            
+            for (var _k = 0; _k < array_length(_old_keys); _k++)
+            {
+                if (!variable_struct_exists(_new.by_class, _old_keys[_k]))
+                    variable_struct_set(_new.by_class, _old_keys[_k], variable_struct_get(_old.by_class, _old_keys[_k]));
+            }
+        }
+    }
+    
+    variable_struct_set(arg0, arg1, _new);
+}
+
+
+/// GNX-INTER: copies every entry of struct arg0 named arg1 + "_..." to the same name with prefix arg2.
+function gnx_mspr_copy_prefix(arg0, arg1, arg2)
+{
+    var _names = variable_struct_get_names(arg0);
+    var _pre = arg1 + "_";
+    var _n = string_length(_pre);
+    
+    for (var i = 0; i < array_length(_names); i++)
+    {
+        // string_copy(text, 1, n) = the first n characters
+        if (string_copy(_names[i], 1, _n) == _pre)
+            variable_struct_set(arg0, arg2 + "_" + string_delete(_names[i], 1, _n), variable_struct_get(arg0, _names[i]));
+    }
+}
+
+
+/// GNX-PROP: runs in a cell: true when the monster in place arg0 is really inside it (it arrived,
+/// mon_state 1), false for one still walking there or for an empty place. Matches the monster the way
+/// scr_remove_mon does: the first one of h_unit_list in that place.
+function gnx_mon_inside_at(arg0)
+{
+    if (!is_array(h_unit_list))
+        return false;
+    
+    for (var i = 0; i < array_length(h_unit_list); i++)
+    {
+        var _u = h_unit_list[i];
+        
+        // && = and: a monster that still exists, with its data, in this place
+        if (gnx_is_live_inst(_u) && variable_instance_exists(_u, "mon_data") && is_struct(_u.mon_data) && _u.mon_data.placement_num == arg0)
+            return _u.mon_data.mon_state == 1;
+    }
+    
+    return false;
+}
+
+
+/// GNX-FIX: runs in a cell: calls off the monster in place arg0 that is still on its way (not inside),
+/// in one go and without the side effects of scr_remove_mon (which is made for monsters leaving the cell):
+/// no move to the cell, no mood bubble or nest mood change from an old removed_set, no mon_exit. The monster
+/// loses its cell and place, is taken off h_unit_list, the place's timer and seat are freed, and it wanders
+/// on from where it stands (mon_state 5; wandering ends at a door, as for any idle monster). Only for a plain
+/// call (task 0); other tasks keep their own clean-up: returns -2 for them, -1 when no monster has that
+/// place, else the monster. (audit 18) Its removed_set is left as it is: scr_unit_removal sets it for the
+/// mood vanilla gave in the same case (audit 19).
+function gnx_cancel_mon_assignment(arg0)
+{
+    if (!is_array(h_unit_list))
+        return -1;
+    
+    for (var i = 0; i < array_length(h_unit_list); i++)
+    {
+        var _u = h_unit_list[i];
+        
+        if (!gnx_is_live_inst(_u) || !variable_instance_exists(_u, "mon_data") || !is_struct(_u.mon_data) || _u.mon_data.placement_num != arg0)
+            continue;
+        
+        // != 0: carry, drink and other tasks have their own clean-up in scr_remove_mon
+        if (_u.mon_data.task != 0)
+            return -2;
+        
+        var _st0 = _u.mon_data.mon_state;
+        
+        with (_u)
+        {
+            visible = true;
+            scr_mon_draw = -1;
+            mon_data.slot_id = -1;
+            mon_data.placement_num = -1;
+            mon_data.follow = false;
+            mon_data.spr_data = -1;
+            mon_data.mood_slot_shift_x = 0;
+            mon_data.mood_slot_shift_y = 0;
+            mon_data.ff = true;
+            mon_data.mon_state = 5;
+        }
+        
+        // the place in the cell is free again (only places the cell has)
+        if (variable_struct_exists(slot_data, "mon_timer") && is_array(slot_data.mon_timer) && arg0 >= 0 && arg0 < array_length(slot_data.mon_timer))
+            slot_data.mon_timer[arg0] = 0;
+        
+        if (variable_struct_exists(slot_data, "mon_placement") && is_array(slot_data.mon_placement) && arg0 >= 0 && arg0 < array_length(slot_data.mon_placement))
+            slot_data.mon_placement[arg0] = -1;
+        
+        array_delete(h_unit_list, i, 1);
+        
+        // verbose log: what the monster was and is now, to check that it walks on normally (audit 18, P4)
+        if (variable_global_exists("gnx_debug_verbose") && global.gnx_debug_verbose)
+        {
+            var _l = gnx_log_open();
+            gnx_log_write(_l, "[MON:" + string(_u) + "] CALLED OFF from h_type=" + string(slot_data.h_type) + " place=" + string(arg0) + " task=0 state " + string(_st0) + " -> 5 at x=" + string(_u.x) + " y=" + string(_u.y) + "\n");
+            gnx_log_close(_l);
+        }
+        
+        return _u;
+    }
+    
+    return -1;
+}
+
+
+/// GNX-FIX: runs in a cell: [x, y] of the monster in place arg0 (the one scr_remove_mon would take), or -1
+function gnx_mon_pos_at(arg0)
+{
+    if (!is_array(h_unit_list))
+        return -1;
+    
+    for (var i = 0; i < array_length(h_unit_list); i++)
+    {
+        var _u = h_unit_list[i];
+        
+        if (gnx_is_live_inst(_u) && variable_instance_exists(_u, "mon_data") && is_struct(_u.mon_data) && _u.mon_data.placement_num == arg0)
+            return [_u.x, _u.y];
+    }
+    
+    return -1;
+}
