+    if (!gnx_ug_child_data_ok(_data) && is_struct(unit_data))
+    {
+        _src = "mother";
+        _data = 
+        {
+            mon_type: gnx_ug_child_type(),
+            class: unit_data.class,
+            lvl: unit_data.lvl
+        };
+    }
+    
+    if (!gnx_ug_child_data_ok(_data))
+    // ! = not, || = or: no data, or a field missing
