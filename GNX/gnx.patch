+
+/// GNX-FRAMES: true when a key named arg1 appears anywhere in the JSON value arg0 (structs and lists
+/// are searched all the way down), e.g. whether any human_spr table has a phase_3.
+function gnx_json_has_key(arg0, arg1)
+{
+    if (is_array(arg0))
+    {
+        for (var i = 0; i < array_length(arg0); i++)
+        {
+            if (gnx_json_has_key(arg0[i], arg1))
+                return true;
+        }
+        
+        return false;
+    }
+    
+    if (!is_struct(arg0))
+        return false;
+    
+    if (variable_struct_exists(arg0, arg1))
+        return true;
+    
+    var _names = variable_struct_get_names(arg0);
+    
+    for (var i = 0; i < array_length(_names); i++)
+    {
+        if (gnx_json_has_key(variable_struct_get(arg0, _names[i]), arg1))
+            return true;
+    }
+    
+    return false;
+}
+
+
+/// GNX-FIX: a number from a cell's JSON (arg0), read like gnx_json_num (numbers as text too), kept within
+/// arg2 ... arg3. arg1 = the value used when arg0 is no number. A value that is no number or lies outside
+/// the range is a mod error that names cell arg4 and key arg5; one outside the range is pulled to the limit.
+/// One rule for every number of an underground cell and the intermissions, so a typo cannot make huge
+/// frame counts, zero speeds (a phase that never ends) or negative timers.
+function gnx_json_num_in(arg0, arg1, arg2, arg3, arg4, arg5)
+{
+    // -1234567 is a marker: gnx_json_num gives it back only when arg0 holds no number
+    var _v = gnx_json_num(arg0, -1234567);
+    
+    if (_v == -1234567)
+    {
+        gnx_report_mod_error(gnx_err_who(arg4) + ": " + string(arg5) + " must be a number (" + string(arg0) + "); " + string(arg1) + " is used");
+        return arg1;
+    }
+    
+    // || = or: below the lowest or above the highest allowed value
+    if (_v < arg2 || _v > arg3)
+    {
+        gnx_report_mod_error(gnx_err_who(arg4) + ": " + string(arg5) + " must be " + string(arg2) + "-" + string(arg3) + " (" + string(arg0) + "); " + string(clamp(_v, arg2, arg3)) + " is used");
+        return clamp(_v, arg2, arg3);
+    }
+    
+    return _v;
+}
+
+
+/// GNX-FIX: who a mod error is about, from the name a reader was given (arg0): "prop MyMod.lamp" gives
+/// Prop 'MyMod.lamp', any other name is a cell (Cell 'UNDERCELL').
+function gnx_err_who(arg0)
+{
+    var _s = string(arg0);
+    
+    // string_pos == 1: the name starts with "prop "; string_delete takes those 5 characters off
+    if (string_pos("prop ", _s) == 1)
+        return "Prop '" + string_delete(_s, 1, 5) + "'";
+    
+    return "Cell '" + _s + "'";
+}
+
+
+/// GNX-FIX: checks a mod cell's monster rules once at registration (arg0 = the cell, arg1 = its name):
+/// mon_types and every mon_placements entry must be species 0-3 (goblin, hobgoblin, tentacle, ogre);
+/// anything else is dropped with a mod error. A place left with no species gets the cell's mon_types (or
+/// goblins), since an empty place stopped the game when a monster was called. A mon_placements list of
+/// another length than max_mon_num is cut or filled to max_mon_num places, with a log line. (audit P5, 16 B)
+function gnx_cell_mon_check(arg0, arg1, arg2 = "")
+{
+    // arg2 = the mod, named in the log lines with the cell (audit 17)
+    var _who = (arg2 != "") ? (string(arg1) + "' of mod '" + string(arg2)) : string(arg1);
+    var _cp = arg0.physical;
+    var _mt = undefined;
+    
+    if (variable_struct_exists(arg0, "mon_types"))
+    {
+        var _new_mt = [];
+        
+        if (is_array(arg0.mon_types))
+        {
+            for (var i = 0; i < array_length(arg0.mon_types); i++)
+            {
+                var _v = gnx_json_num(arg0.mon_types[i], -1);
+                
+                // a species is a whole number 0-3
+                if (_v >= 0 && _v <= 3 && _v == floor(_v))
+                    array_push(_new_mt, _v);
+                else
+                    gnx_report_mod_error("Cell '" + string(arg1) + "': mon_types entry " + string(arg0.mon_types[i]) + " is no species (0-3); left out");
+            }
+        }
+        else
+        {
+            gnx_report_mod_error("Cell '" + string(arg1) + "': mon_types must be a list like [0, 1]; left out");
+        }
+        
+        if (array_length(_new_mt) > 0)
+        {
+            arg0.mon_types = _new_mt;
+            _mt = _new_mt;
+        }
+        else
+        {
+            variable_struct_remove(arg0, "mon_types");
+        }
+    }
+    
+    if (!variable_struct_exists(_cp, "mon_placements"))
+        exit;
+    
+    if (!is_array(_cp.mon_placements))
+    {
+        gnx_report_mod_error("Cell '" + string(arg1) + "': mon_placements must be a list of lists like [[0], [1]]; left out");
+        variable_struct_remove(_cp, "mon_placements");
+        exit;
+    }
+    
+    var _mp = [];
+    
+    for (var p = 0; p < array_length(_cp.mon_placements); p++)
+    {
+        var _e = _cp.mon_placements[p];
+        var _ok = [];
+        
+        if (is_array(_e))
+        {
+            for (var i = 0; i < array_length(_e); i++)
+            {
+                var _v = gnx_json_num(_e[i], -1);
+                
+                if (!(_v >= 0 && _v <= 3 && _v == floor(_v)))
+                    gnx_report_mod_error("Cell '" + string(arg1) + "': mon_placements[" + string(p) + "] entry " + string(_e[i]) + " is no species (0-3); left out");
+                else if (is_array(_mt) && !array_contains(_mt, _v))
+                    gnx_report_mod_error("Cell '" + string(arg1) + "': mon_placements[" + string(p) + "] has species " + string(_v) + ", which is not in mon_types (it would be invisible); left out");
+                else
+                    array_push(_ok, _v);
+            }
+        }
+        
+        if (array_length(_ok) == 0)
+        {
+            _ok = is_array(_mt) ? _mt : [0];
+            gnx_report_mod_error("Cell '" + string(arg1) + "': mon_placements[" + string(p) + "] has no species; " + string(_ok) + " is used");
+        }
+        
+        array_push(_mp, _ok);
+    }
+    
+    var _max = max(0, floor(gnx_json_num(_cp.max_mon_num, 1)));
+    
+    // GNX-FIX: exactly one place per monster the cell takes: places past max_mon_num were chosen but never
+    // counted as arrived (scr_mon_contact counts 0 .. max_mon_num - 1), so the cell could wait for good;
+    // missing places get mon_types (or goblins). Both said in the log (audit 16, B)
+    if (array_length(_mp) != _max)
+    {
+        var _was = array_length(_mp);
+        
+        if (_was > _max)
+            array_resize(_mp, _max);
+        
+        while (array_length(_mp) < _max)
+            array_push(_mp, is_array(_mt) ? _mt : [0]);
+        
+        var _l = gnx_log_open();
+        gnx_log_write(_l, "[GNX-WARN] cell '" + _who + "': mon_placements has " + string(_was) + " places, max_mon_num is " + string(_max) + "; " + ((_was > _max) ? ("places " + string(_max) + "-" + string(_was - 1) + " are left out") : ("places " + string(_was) + "-" + string(_max - 1) + " take " + string(is_array(_mt) ? _mt : [0]))) + "\n");
+        gnx_log_close(_l);
+    }
+    
+    _cp.mon_placements = _mp;
+}
+
+
+/// GNX-FIX: a true / false from JSON (arg0). This game's json_parse gives JSON true and false as the
+/// numbers 1 and 0, not as GML booleans, so is_bool() is false for them; this accepts a boolean, 1 / 0, or
+/// the text "true" / "false". Anything else is a mod error naming arg2 (who) and arg3 (key) and gives arg1.
+function gnx_json_bool(arg0, arg1, arg2, arg3)
+{
+    // is_numeric is also true for a GML boolean; == 1 / == 0 then match true / false
+    if (is_numeric(arg0))
+    {
+        if (arg0 == 1)
+            return true;
+        
+        if (arg0 == 0)
+            return false;
+    }
+    else if (is_string(arg0))
+    {
+        var _l = string_lower(arg0);
+        
+        if (_l == "true")
+            return true;
+        
+        if (_l == "false")
+            return false;
+    }
+    
+    gnx_report_mod_error(gnx_err_who(arg2) + ": " + string(arg3) + " must be true or false, not " + string(arg0) + "; " + (arg1 ? "true" : "false") + " is used");
+    return arg1;
+}
+
+
+/// GNX-FIX: reads a number from a JSON value. A number stays as it is, a number written as text
+/// ("5", "-2.5") becomes a number, anything else (other text, a list, a struct, undefined) gives arg1.
+/// Used wherever a mod JSON value goes into arithmetic, so a typo logs instead of stopping the game.
+function gnx_json_num(arg0, arg1)
+{
+    // is_numeric = a real, an int or a bool; real() turns it into a plain number
+    if (is_numeric(arg0))
+        return real(arg0);
+    
+    // ! = not: anything that is not text has no number in it
+    if (!is_string(arg0))
+        return arg1;
+    
+    var _n = string_length(arg0);
+    var _digits = 0;
+    var _dots = 0;
+    
+    for (var i = 1; i <= _n; i++)
+    {
+        var _c = string_char_at(arg0, i);
+        
+        // || = or: a minus sign is allowed only as the first character
+        if (_c == "-" && i == 1)
+            continue;
+        
+        if (_c == ".")
+        {
+            _dots++;
+            continue;
+        }
+        
+        if (ord(_c) < ord("0") || ord(_c) > ord("9"))
+            return arg1;
+        
+        _digits++;
+    }
+    
+    // && = and: at least one digit and at most one dot, otherwise real() would stop the game
+    if (_digits > 0 && _dots <= 1)
+        return real(arg0);
+    
+    return arg1;
+}
+
+
+/// GNX-FIX: birth_classes after its names were resolved (arg0 = list, arg1 = class id for the log).
+/// scr_mon_birth reads entry [monster type] as the monster class 0-3, so the list is made 4 long
+/// (missing entries 0) and every entry that is not a number 0-3 (a class id, an unknown name) becomes 0.
+function gnx_birth_list_fix(arg0, arg1)
+{
+    var _out = [0, 0, 0, 0];
+    var _bad = "";
+    
+    if (!is_array(arg0))
+        _bad = "not a list";
+    else if (array_length(arg0) != 4)
+        _bad = string(array_length(arg0)) + " entries instead of 4";
+    
+    for (var i = 0; i < 4; i++)
+    {
+        if (!is_array(arg0) || i >= array_length(arg0))
+            continue;
+        
+        var _v = gnx_json_num(arg0[i], -1);
+        
+        // a monster class is 0-3; a class id (14+) or text that is no number does not fit
+        if (_v >= 0 && _v <= 3)
+            _out[i] = floor(_v);
+        else
+            _bad += ((_bad == "") ? "" : ", ") + "entry " + string(i) + " = " + string(arg0[i]);
+    }
+    
+    if (_bad != "")
+    {
+        var _l = gnx_log_open();
+        gnx_log_write(_l, "[GNX-WARN] class " + string(arg1) + " birth_classes: " + _bad + " (entries are monster classes 0-3); now " + string(_out) + "\n");
+        gnx_log_close(_l);
+    }
+    
+    return _out;
+}
+
+
+enum UnknownEnum
+{
+    Value_0,
+    Value_1,
+    Value_2,
+    Value_3,
+    Value_4,
+    Value_5,
+    Value_7 = 7,
+    Value_12 = 12,
+    Value_33 = 33,
+    Value_40 = 40,
+    Value_56 = 56
+}
