+    var _n = 5;
+    
+    // underground cells keep their counts in gnx_frames, other mod cells in gnx_phase_frames (phase 2 = loop)
+    if (variable_struct_exists(_cell.physical, "gnx_frames"))
+        _n = _cell.physical.gnx_frames.loop;
+    else if (variable_struct_exists(_cell.physical, "gnx_phase_frames") && _cell.physical.gnx_phase_frames[2] >= 1)
