+/// GNX-PROP: the shared clock of mod props in seconds of game time (advanced once per step in
+/// scr_main_end_step, stops while paused); 0 before the first step
+function gnx_scene_time()
+{
+    return variable_global_exists("gnx_scene_t") ? global.gnx_scene_t : 0;
+}
