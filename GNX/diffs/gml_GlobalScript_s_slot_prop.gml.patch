+/// GNX-PROP: the Step of a reacting mod prop (called for every prop from scr_main_end_step): the play
+/// queued by its events runs at react.speed frames per second and its flash fades. In Step, not in Draw,
+/// so both go on while the prop is off screen (Draw is skipped there) and it shows where the game is.
+/// Not hooked through prop_data.scr_prop_step: prop_data is saved, and a script reference has no place
+/// in a save. (audit P8)
+function gnx_prop_step()
+{
+    if (variable_instance_exists(id, "gnx_prop_react") && is_struct(gnx_prop_react) && gnx_prop_react.frames && gnx_prop_play > 0)
+    {
+        var _r = gnx_prop_react;
+        // min = the smaller one, so the end of a play never runs past where it should stop
+        var _adv = min(gnx_prop_play, (_r.speed / 60) * global.w_spd);
+        gnx_prop_play -= _adv;
+        gnx_prop_t += _adv;
+        
+        // the play is over: land on a whole frame (many small steps add up to 2.9999 instead of 3)
+        if (gnx_prop_play <= 0.0001)
+        {
+            gnx_prop_play = 0;
+            gnx_prop_t = round(gnx_prop_t);
+        }
+        
+        gnx_prop_t = gnx_prop_wrap(gnx_prop_t, gnx_prop_frames, _r.hold);
+    }
+    
+    if (variable_instance_exists(id, "gnx_prop_flash") && gnx_prop_flash > 0)
+        gnx_prop_flash = max(0, gnx_prop_flash - (global.w_spd / 60));
+}
