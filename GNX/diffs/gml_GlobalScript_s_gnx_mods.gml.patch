+        draw_text(_px + 12, 205, gnx_fit(_l1, _pw - 24));
+        draw_set_color(make_color_rgb(170, 140, 120));
+        draw_text(_px + 12, 215, gnx_fit(_l2, _pw - 24));
+    }
+    else
+    {
+        draw_text(_px + 12, 210, "Point at a mod for details.");
