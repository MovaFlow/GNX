+function scr_gnx_trace(arg0, arg1, arg2)
+{
+    if (!global.gnx_trace_entities)
+        exit;
+    
+    var _f = gnx_log_open();
+    gnx_log_write(_f, "[TRACE:" + string(current_time) + ":" + string(arg0) + "] id=" + string(arg1) + " " + arg2);
+    gnx_log_writeln(_f);
+    gnx_log_close(_f);
+}
