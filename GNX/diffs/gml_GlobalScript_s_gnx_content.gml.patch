--- gml_138/gml_GlobalScript_s_gnx_content.gml	1970-01-01 01:00:00.000000000 +0100
+++ gml/gml_GlobalScript_s_gnx_content.gml	1970-01-01 01:00:00.000000000 +0100
@@ -0,0 +1,4012 @@
+// GNX: content registries: class/cell loading and resolving, hashes, JSON readers, unlocks
+// (moved out of s_initials.gml; the functions are global, callable from any script)
+
+function gnx_resolve_script(arg0)
+{
+    var _idx = asset_get_index(arg0);
+    
+    if (_idx < 0)
+    {
+        var _log = gnx_log_open();
+        gnx_log_write(_log, "[GNX] WARNING: script not found: " + arg0 + "\n");
+        gnx_log_close(_log);
+    }
+    
+    return _idx;
+}
+
+
+function gnx_resolve_layer_sprite(arg0, arg1, arg2)
+{
+    if (is_real(arg0))
+        return arg0;
+    
+    if (!is_string(arg0))
+        return -1;
+    
+    if (string_copy(arg0, 1, 4) == "gnx:")
+    {
+        var _key = string_delete(arg0, 1, 4);
+        
+        if (arg1 != undefined && variable_struct_exists(arg1, _key))
+            return gnx_resolve_sprite(arg1, _key, arg2, -1);
+        
+        return -1;
+    }
+    
+    var _idx = asset_get_index(arg0);
+    return (_idx >= 0) ? _idx : -1;
+}
+
+
+function gnx_resolve_sprite(arg0, arg1, arg2, arg3)
+{
+    var _r = gnx_resolve_sprite_raw(arg0, arg1, arg2, arg3);
+    
+    if (is_struct(arg0) && variable_struct_exists(arg0, arg1))
+        gnx_loop_mark(_r, variable_struct_get(arg0, arg1), arg1);
+    
+    return _r;
+}
+
+
+function gnx_resolve_sprite_raw(arg0, arg1, arg2, arg3)
+{
+    if (!variable_struct_exists(arg0, arg1))
+        return arg3;
+    
+    var _s = variable_struct_get(arg0, arg1);
+    var _xo = (is_struct(_s) && variable_struct_exists(_s, "xorig")) ? _s.xorig : 0;
+    var _yo = (is_struct(_s) && variable_struct_exists(_s, "yorig")) ? _s.yorig : 0;
+    
+    // GNX-PROP: an origin by name ("xorig": "center", "yorig": "bottom") needs the sprite's size: it is
+    // loaded once with origin 0 to measure it (that copy stays cached for other entries of the same PNG),
+    // then loaded with the worked-out numbers
+    if (is_struct(_s) && (is_string(_xo) || is_string(_yo)))
+    {
+        var _probe_e = gnx_struct_copy(_s);
+        _probe_e.xorig = is_string(_xo) ? 0 : _xo;
+        _probe_e.yorig = is_string(_yo) ? 0 : _yo;
+        var _probe_d = {};
+        variable_struct_set(_probe_d, arg1, _probe_e);
+        var _probe = gnx_resolve_sprite_raw(_probe_d, arg1, arg2, arg3);
+        
+        if (_probe == arg3 || !gnx_sprite_exists(_probe))
+            return arg3;
+        
+        var _num_e = gnx_struct_copy(_s);
+        _num_e.xorig = is_string(_xo) ? gnx_origin_named(_xo, gnx_sprite_get_width(_probe), false, arg1) : _xo;
+        _num_e.yorig = is_string(_yo) ? gnx_origin_named(_yo, gnx_sprite_get_height(_probe), true, arg1) : _yo;
+        var _num_d = {};
+        variable_struct_set(_num_d, arg1, _num_e);
+        return gnx_resolve_sprite_raw(_num_d, arg1, arg2, arg3);
+    }
+    var _gnx_org_from = false;
+
+    // POPRAWKA (GNX): "origin_from" = nazwa wanilowego sprite'a, z ktorego bierzemy xorig/yorig
+    if (is_struct(_s) && variable_struct_exists(_s, "origin_from") && is_string(_s.origin_from))
+    {
+        var _ofs = asset_get_index(_s.origin_from);
+
+        if (_ofs >= 0 && sprite_exists(_ofs))
+        {
+            _xo = sprite_get_xoffset(_ofs);
+            _yo = sprite_get_yoffset(_ofs);
+            _gnx_org_from = true;
+        }
+        else
+        {
+            var _oflog = gnx_log_open();
+            gnx_log_write(_oflog, "[GNX-WARN] " + arg1 + ": origin_from '" + _s.origin_from + "' is not a game sprite - using xorig/yorig\n");
+            gnx_log_close(_oflog);
+        }
+    }
+
+    if (variable_global_exists("gnx_current_loading_mod") && global.gnx_current_loading_mod != "" && ds_map_exists(global.gnx_mod_atlases, global.gnx_current_loading_mod))
+    {
+        var _atref = gnx_atlas_resolve_ref(global.gnx_current_loading_mod, _s);
+        
+        if (_atref != undefined)
+        {
+            // Mav (1.4.7.5): the JSON origin (origin_from or a non-zero xorig/yorig) wins over uv.json.
+            // Returns a copy instead of overwriting the shared atlas entry (the first JSON entry using the file used to win).
+            if ((_gnx_org_from || _xo != 0 || _yo != 0) && (_atref.xo != _xo || _atref.yo != _yo))
+                return gnx_sprref_with_origin(_atref, _xo, _yo);
+            
+            return _atref;
+        }
+    }
+    
+    var _cache_key;
+    
+    if (is_struct(_s) && variable_struct_exists(_s, "strip"))
+    {
+        _cache_key = arg2 + _s.strip;
+    }
+    else if (is_struct(_s) && variable_struct_exists(_s, "frames") && is_array(_s.frames))
+    {
+        _cache_key = arg2;
+        
+        for (var _ci = 0; _ci < array_length(_s.frames); _ci++)
+            _cache_key += ("|" + string(_s.frames[_ci]));
+    }
+    else if (is_struct(_s) && variable_struct_exists(_s, "path"))
+    {
+        _cache_key = arg2 + _s.path;
+    }
+    else if (is_struct(_s) && variable_struct_exists(_s, "folder"))
+    {
+        _cache_key = arg2 + "folder:" + string(_s.folder);
+    }
+    else if (is_struct(_s) && variable_struct_exists(_s, "from_game"))
+    {
+        _cache_key = "game:" + string(_s.from_game) + "#" + string(variable_struct_exists(_s, "index") ? _s.index : 0);
+    }
+    else if (!is_struct(_s))
+    {
+        _cache_key = arg2 + string(_s);
+    }
+    else
+    {
+        _cache_key = arg2 + arg1;
+    }
+
+    // the same file with another frame count or origin is another sprite (sprite_add bakes both in)
+    if (is_struct(_s) && !variable_struct_exists(_s, "from_game"))
+        _cache_key += "#" + string((variable_struct_exists(_s, "frames") && is_real(_s.frames)) ? _s.frames : 1) + "@" + string(_xo) + "," + string(_yo);
+
+    if (ds_map_exists(global.gnx_sprite_cache, _cache_key))
+    {
+        var _cached = ds_map_find_value(global.gnx_sprite_cache, _cache_key);
+        
+        if (gnx_sprite_exists(_cached))
+            return _cached;
+        
+        ds_map_delete(global.gnx_sprite_cache, _cache_key);
+    }
+    
+    if (is_struct(_s) && variable_struct_exists(_s, "strip"))
+    {
+        var _path = arg2 + _s.strip;
+        var _n_imgs = is_real(_s.frames) ? _s.frames : 1;
+        
+        // GNX-FIX: a mod with an atlas loads this strip on its own (not in the atlas, or its entry was
+        // left out): counted for the [GNX-PERF] report, each one is an extra texture
+        if (variable_global_exists("gnx_current_loading_mod") && global.gnx_current_loading_mod != "" && ds_map_exists(global.gnx_mod_atlases, global.gnx_current_loading_mod))
+        {
+            var _am = ds_map_find_value(global.gnx_mod_atlases, global.gnx_current_loading_mod);
+            
+            if (is_struct(_am) && variable_struct_exists(_am, "strip_loads"))
+                _am.strip_loads++;
+        }
+        
+        _loaded = sprite_add(_path, _n_imgs, false, false, _xo, _yo);
+        
+        if (_loaded != -1)
+        {
+            array_push(global.gnx_runtime_sprites, _loaded);
+            ds_map_set(global.gnx_sprite_cache, _cache_key, _loaded);
+        }
+        
+        _log = gnx_log_open();
+        gnx_log_write(_log, "[GNX] " + arg1 + ": strip frames=" + string(_n_imgs) + " idx=" + string(_loaded) + "\n");
+        gnx_log_close(_log);
+        return (_loaded != -1) ? _loaded : arg3;
+    }
+    
+    var _fps = [];
+    
+    if (!is_struct(_s))
+    {
+        array_push(_fps, arg2 + string(_s));
+    }
+    else if (variable_struct_exists(_s, "frames") && is_array(_s.frames))
+    {
+        var _fa = _s.frames;
+        
+        for (var _fi = 0; _fi < array_length(_fa); _fi++)
+            array_push(_fps, arg2 + _fa[_fi]);
+    }
+    else if (variable_struct_exists(_s, "path"))
+    {
+        array_push(_fps, arg2 + _s.path);
+    }
+    // POPRAWKA (GNX): "folder" = katalog z klatkami (np. "strips/spr_giant_idle_head").
+    // Bierzemy wszystkie .png z numerem na koncu nazwy (x_0.png, x_1.png ... albo 0.png, 1.png ...),
+    // sortujemy po tym numerze, wiec liczbe klatek wyznacza sam folder.
+    else if (variable_struct_exists(_s, "folder"))
+    {
+        var _fdir = arg2 + string(_s.folder) + "/";
+
+        // ! = "nie"; jesli podano sama nazwe folderu, szukamy jej jeszcze w strips/
+        if (!directory_exists(_fdir) && directory_exists(arg2 + "strips/" + string(_s.folder)))
+            _fdir = arg2 + "strips/" + string(_s.folder) + "/";
+
+        var _flist = [];
+        var _fnum_c = 0;
+        var _fname = file_find_first(_fdir + "*.png", 0);
+
+        while (_fname != "")
+        {
+            var _fnum = gnx_trailing_number(_fname);
+            array_push(_flist, { file: _fname, num: _fnum });
+
+            if (_fnum >= 0)
+                _fnum_c++;
+
+            _fname = file_find_next();
+        }
+
+        file_find_close();
+        array_sort(_flist, method(undefined, gnx_cmp_frame_num));
+
+        for (var _fi = 0; _fi < array_length(_flist); _fi++)
+        {
+            // pliki bez numeru pomijamy, chyba ze w folderze nie ma zadnego z numerem (sprite 1-klatkowy)
+            if (_fnum_c == 0 || _flist[_fi].num >= 0)
+                array_push(_fps, _fdir + _flist[_fi].file);
+        }
+
+        if (array_length(_fps) == 0)
+        {
+            _log = gnx_log_open();
+            gnx_log_write(_log, "[GNX-WARN] " + arg1 + ": folder '" + _fdir + "' has no .png frames, returning fallback\n");
+            gnx_log_close(_log);
+            return arg3;
+        }
+    }
+    // POPRAWKA (GNX): "from_game" + "index" = jedna klatka wanilowego sprite'a jako osobny sprite (np. ikona)
+    else if (variable_struct_exists(_s, "from_game"))
+    {
+        var _gs = asset_get_index(string(_s.from_game));
+        var _gi = variable_struct_exists(_s, "index") ? _s.index : 0;
+
+        if (_gs < 0 || !sprite_exists(_gs))
+        {
+            _log = gnx_log_open();
+            gnx_log_write(_log, "[GNX-WARN] " + arg1 + ": from_game '" + string(_s.from_game) + "' is not a game sprite, returning fallback\n");
+            gnx_log_close(_log);
+            return arg3;
+        }
+
+        var _gw = sprite_get_width(_gs);
+        var _gh = sprite_get_height(_gs);
+        var _gxo = sprite_get_xoffset(_gs);
+        var _gyo = sprite_get_yoffset(_gs);
+        var _gsurf = surface_create(_gw, _gh);
+        surface_set_target(_gsurf);
+        draw_clear_alpha(c_black, 0);
+        // bm_one/bm_zero = kopiujemy piksele 1:1, bez mieszania przezroczystosci z tlem
+        gpu_set_blendmode_ext(bm_one, bm_zero);
+        draw_sprite(_gs, _gi, _gxo, _gyo);
+        gpu_set_blendmode(bm_normal);
+        surface_reset_target();
+        var _gnew = sprite_create_from_surface(_gsurf, 0, 0, _gw, _gh, false, false, _gxo, _gyo);
+        surface_free(_gsurf);
+
+        if (_gnew != -1)
+        {
+            array_push(global.gnx_runtime_sprites, _gnew);
+            ds_map_set(global.gnx_sprite_cache, _cache_key, _gnew);
+        }
+
+        _log = gnx_log_open();
+        gnx_log_write(_log, "[GNX] " + arg1 + ": from_game " + string(_s.from_game) + "[" + string(_gi) + "] idx=" + string(_gnew) + "\n");
+        gnx_log_close(_log);
+        return (_gnew != -1) ? _gnew : arg3;
+    }
+    else
+    {
+        _log = gnx_log_open();
+        gnx_log_write(_log, "[GNX] WARN " + arg1 + ": no strip/path/frames/folder, returning fallback\n");
+        gnx_log_close(_log);
+        return arg3;
+    }
+    
+    var _loaded = gnx_load_sprite_frames(_fps, _xo, _yo);
+    
+    if (_loaded != -1)
+        ds_map_set(global.gnx_sprite_cache, _cache_key, _loaded);
+    
+    var _log = gnx_log_open();
+    gnx_log_write(_log, "[GNX] " + arg1 + ": frames=" + string(array_length(_fps)) + " idx=" + string(_loaded) + " xo=" + string(_xo) + " yo=" + string(_yo) + "\n");
+    gnx_log_close(_log);
+    return (_loaded != -1) ? _loaded : arg3;
+}
+
+
+/// GNX-FIX: a cell's spawn_info as the game reads it: an object with all four fields (coin, mood, coin_mul, mood_mul,
+/// missing ones get 0 / false), or -1 (none) when it is not an object. The build menu and the payout read the four
+/// fields directly, so text or a missing field there was a GameMaker error. arg1 = the cell's name, for the error.
+function gnx_spawn_info_norm(arg0, arg1)
+{
+    if (!is_struct(arg0))
+    {
+        gnx_report_mod_error("Cell '" + string(arg1) + "': spawn_info must be an object like { \"coin\": 2, \"mood\": 1 }, not " + string(arg0) + "; left out");
+        return -1;
+    }
+
+    var _who = "Cell '" + string(arg1) + "' spawn_info";
+    return {
+        coin: variable_struct_exists(arg0, "coin") ? gnx_json_num(arg0.coin, 0) : 0,
+        mood: variable_struct_exists(arg0, "mood") ? gnx_json_num(arg0.mood, 0) : 0,
+        coin_mul: variable_struct_exists(arg0, "coin_mul") && gnx_json_bool(arg0.coin_mul, false, _who, "coin_mul"),
+        mood_mul: variable_struct_exists(arg0, "mood_mul") && gnx_json_bool(arg0.mood_mul, false, _who, "mood_mul")
+    };
+}
+
+
+function gnx_report_mod_error(arg0)
+{
+    if (!variable_global_exists("gnx_mod_errors") || !is_array(global.gnx_mod_errors))
+        global.gnx_mod_errors = [];
+    
+    array_push(global.gnx_mod_errors, arg0);
+    var _log = gnx_log_open();
+    gnx_log_write(_log, "[GNX] ERROR: " + arg0 + "\n");
+    gnx_log_close(_log);
+}
+
+
+function scr_gnx_resolve_birth_classes()
+{
+    var _key = ds_map_find_first(global.class_registry);
+    
+    repeat (ds_map_size(global.class_registry))
+    {
+        var _rc = ds_map_find_value(global.class_registry, _key);
+        
+        // GNX-FIX: birth_classes that is not a list becomes the 4-entry default list (all 0)
+        if (is_struct(_rc) && variable_struct_exists(_rc, "birth_classes") && !is_array(_rc.birth_classes))
+            _rc.birth_classes = gnx_birth_list_fix([], _key);
+        
+        if (is_struct(_rc) && variable_struct_exists(_rc, "birth_classes"))
+        {
+            var _bc = _rc.birth_classes;
+            var _bc_len = array_length(_bc);
+            var _bc_out = [];
+            
+            for (var _bi = 0; _bi < _bc_len; _bi++)
+            {
+                var _bv = _bc[_bi];
+                
+                if (is_string(_bv))
+                {
+                    var _bm = ds_map_find_value(global.gnx_class_name_to_id, _bv);
+                    array_push(_bc_out, (_bm != undefined) ? real(_bm) : _bv);
+                }
+                else
+                {
+                    array_push(_bc_out, _bv);
+                }
+            }
+            
+            _rc.birth_classes = gnx_birth_list_fix(_bc_out, _key);
+        }
+        
+        _key = ds_map_find_next(global.class_registry, _key);
+    }
+}
+
+
+function scr_gnx_apply_unlocks()
+{
+    // GNX-UG: saves and map snapshots from before the underground cell have no ug_breed list
+    if (!variable_struct_exists(global.unlock, "ug_breed"))
+        global.unlock.ug_breed = [];
+    
+    var _n = array_length(global.gnx_registered_cells);
+    
+    for (var _i = 0; _i < _n; _i++)
+    {
+        var _entry = global.gnx_registered_cells[_i];
+        
+        if (variable_struct_exists(_entry, "locked") && _entry.locked == true)
+            continue;
+        
+        var _h = _entry.h_type;
+        var _cat = _entry.category;
+        
+        if (!variable_struct_exists(global.unlock, _cat))
+            continue;
+        
+        var _arr = variable_struct_get(global.unlock, _cat);
+        
+        if (!is_array(_arr))
+            continue;
+        
+        var _found = false;
+        
+        for (var _j = 0; _j < array_length(_arr); _j++)
+        {
+            if (_arr[_j] == _h)
+            {
+                _found = true;
+                break;
+            }
+        }
+        
+        if (!_found)
+            array_push(_arr, _h);
+    }
+}
+
+
+function scr_gnx_migrate_unlocks()
+{
+    var _cats = ["breed", "utility", "pleasure", "b_breed", "b_utility", "b_other", "t_breed", "t_utility", "xl_breed", "ug_breed"];
+    var _ci = 0;
+    
+    repeat (array_length(_cats))
+    {
+        var _fname = _cats[_ci++];
+        var _src = variable_struct_get(global.unlock, _fname);
+        
+        if (!is_array(_src))
+            continue;
+        
+        var _out = [];
+        var _si = 0;
+        
+        repeat (array_length(_src))
+        {
+            var _h = _src[_si++];
+            
+            if (ds_map_find_value(global.cell_registry, _h) != undefined)
+                array_push(_out, _h);
+        }
+        
+        variable_struct_set(global.unlock, _fname, _out);
+    }
+    
+    scr_gnx_apply_unlocks();
+}
+
+
+function scr_gnx_load_cells(arg0, arg1)
+{
+    var _path = global.gnx_mods_root + arg0 + "/" + arg1;
+    
+    if (!file_exists(_path))
+    {
+        gnx_report_mod_error("Mod '" + arg0 + "': cells file '" + arg1 + "' not found");
+        exit;
+    }
+    
+    var _f = file_text_open_read(_path);
+    var _raw = "";
+    
+    while (!file_text_eof(_f))
+        _raw += file_text_readln(_f);
+    
+    file_text_close(_f);
+    var _cells;
+    
+    try
+    {
+        _cells = json_parse(_raw);
+    }
+    catch (_e)
+    {
+        gnx_report_mod_error("Mod '" + arg0 + "': " + arg1 + " invalid (" + string(_e.message) + ")");
+        exit;
+    }
+    
+    var _count = array_length(_cells);
+    
+    for (var _i = 0; _i < _count; _i++)
+        scr_gnx_register_cell(_cells[_i], arg0);
+    
+    var _log = gnx_log_open();
+    gnx_log_write(_log, "[GNX] registered " + string(_count) + " cell(s)\n");
+    gnx_log_close(_log);
+}
+
+
+function scr_gnx_register_cell(arg0, arg1)
+{
+    var _h;
+    
+    if (variable_struct_exists(arg0, "h_type"))
+    {
+        _h = arg0.h_type;
+    }
+    else
+    {
+        var _cname = variable_struct_exists(arg0, "name") ? arg0.name : "";
+        _h = gnx_hash_cell_id(arg1 + "." + _cname);
+        
+        while (ds_map_exists(global.cell_registry, _h))
+            _h = 100 + (((_h - 100) + 1) % 9900);
+    }
+    
+    if (ds_map_find_value(global.cell_registry, _h) != undefined)
+    {
+        scr_gnx_patch_cell(_h, arg0, arg1);
+        exit;
+    }
+    
+    // GNX-UG: an underground cell gets GNX's own values for everything it leaves out
+    if (variable_struct_exists(arg0, "category") && string(arg0.category) == "ug_breed")
+        gnx_ug_fill_defaults(arg0, arg1);
+    
+    // A new cell (not a vanilla patch) needs a complete physical block; reject it instead of crashing
+    var _req = ["allow_preg", "max_mon_num", "anal", "slot_dirt_init", "scr_idle", "scr_h", "scr_draw", "hand_x", "hand_y", "hand_xscale", "hand_angle", "sq_x", "sq_y", "sp_x", "sp_y", "sp_anim_x", "sp_anim_y"];
+    var _cn = variable_struct_exists(arg0, "name") ? arg0.name : ("h_type " + string(_h));
+
+    if (!variable_struct_exists(arg0, "category"))
+    {
+        gnx_report_mod_error("Mod '" + arg1 + "': cell '" + _cn + "' has no category (build menu tab, see GNX_MODDING.md) - cell skipped");
+        exit;
+    }
+
+    if (!variable_struct_exists(arg0, "physical") || !is_struct(arg0.physical))
+    {
+        gnx_report_mod_error("Mod '" + arg1 + "': cell '" + _cn + "' has no physical block (required for new cells, see GNX_MODDING.md section 7) - cell skipped");
+        exit;
+    }
+
+    var _missing = "";
+
+    for (var _ri = 0; _ri < array_length(_req); _ri++)
+    {
+        if (!variable_struct_exists(arg0.physical, _req[_ri]))
+            _missing += (" " + _req[_ri]);
+    }
+
+    if (_missing != "")
+    {
+        gnx_report_mod_error("Mod '" + arg1 + "': cell '" + _cn + "' physical is missing:" + _missing + " - cell skipped");
+        exit;
+    }
+
+    if (variable_struct_exists(arg0, "name"))
+        ds_map_add(global.gnx_cell_name_to_id, arg1 + "." + arg0.name, _h);
