{
  "about": "Mod raid stages across maps: a stage mod with no \"map\" belongs to the village. On harness_map it is not loaded (no mod stages there), and the village's stage state must survive the trip in the village snapshot, then a save/reload.",
  "mods": [
    "tools/scenarios/mods/harness_map",
    "tools/scenarios/mods/harness_raid_a"
  ],
  "steps": [
    {
      "wait": 30
    },
    {
      "call": "gnx_scn_set_stage_sel",
      "args": [
        "harness_raid_a.CRYPT",
        1
      ]
    },
    {
      "travel": "harness_map"
    },
    {
      "wait": 30
    },
    {
      "assert": "active_map",
      "is": "harness_map"
    },
    {
      "assert": "fn",
      "name": "gnx_stage_index",
      "args": [
        "harness_raid_a.CRYPT"
      ],
      "is": -1,
      "why": "a village mod's stage is not on harness_map"
    },
    {
      "assert": "fn",
      "name": "gnx_scn_stage_sel",
      "args": [
        "harness_raid_a.CRYPT"
      ],
      "is": -1,
      "why": "so it has no state there"
    },
    {
      "assert": "fn",
      "name": "gnx_scn_stage_lens",
      "args": [],
      "is": "5 5 5 5 5 0 0",
      "why": "the map has only the vanilla stages"
    },
    {
      "travel": "vanilla"
    },
    {
      "wait": 30
    },
    {
      "assert": "active_map",
      "is": "vanilla"
    },
    {
      "assert": "fn",
      "name": "gnx_scn_stage_sel",
      "args": [
        "harness_raid_a.CRYPT"
      ],
      "is": 1,
      "why": "the village's marker came back with its snapshot"
    },
    {
      "save": 9
    },
    {
      "reload": 9
    },
    {
      "wait": 20
    },
    {
      "assert": "fn",
      "name": "gnx_scn_stage_sel",
      "args": [
        "harness_raid_a.CRYPT"
      ],
      "is": 1,
      "why": "and survives save/reload"
    },
    {
      "assert": "fn",
      "name": "gnx_scn_stage_lens",
      "args": [],
      "is": "6 6 6 6 6 1 0",
      "why": "arrays agree after reload"
    }
  ]
}