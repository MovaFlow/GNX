+    if (!variable_struct_exists(global.unlock, "gnx_maps"))
+        global.unlock.gnx_maps = [];
+    
+    for (var _i = 0; _i < array_length(global.unlock.gnx_maps); _i++)
+    {
+        if (global.unlock.gnx_maps[_i] == arg0.target)
