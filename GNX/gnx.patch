+        return -1;
+    
+    var _sub = variable_struct_get(arg0, arg1);
+    
+    // Mav (1.4.7.5): an atlas sprite is a struct, but a ready sprite, not a species map
+    if (!is_struct(_sub) || is_sprref(_sub))
+        return _sub;
+    
+    var _species = ["goblin", "hobgoblin", "tentacle", "ogre"];
+    var _mt = clamp(floor(arg2), 0, 3);
+    
+    if (variable_struct_exists(_sub, _species[_mt]))
+        return variable_struct_get(_sub, _species[_mt]);
+    
+    return -1;
+}
