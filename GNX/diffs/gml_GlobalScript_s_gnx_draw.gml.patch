+function sprref_atlas_multi(arg0, arg1, arg2, arg3)
+{
+    return 
+    {
+        kind: "atlas",
+        atlas: arg0[0],
+        atlas_sprites: arg0,
+        frames: arg1,
+        xo: arg2,
+        yo: arg3,
+        multi: true
+    };
+}
