+function scr_create_mod_button()
+{
+    follow = true;
+    act_resize = true;
+    fail_shake = false;
+    
+    if ((button_num % 2) != 0)
+        image_xscale = -1;
+    
+    var _leg_pos = -1;
+    var _leg_part_pos = -1;
+    var _icon_array = source_id.icon_array;
+    var _pos_array = source_id.pos_array;
+    var _slot_id = source_id.source_id;
+    var _button_pos = floor(button_num * 0.5);
+    var _mod_type = _icon_array[_button_pos];
+    var _mod_pos = _pos_array[_button_pos];
+    
+    with (_slot_id)
+    {
+        var _spr_num = gnx_sprite_get_number(spr_slot[_mod_pos][UnknownEnum.Value_1]) - 1;  // Mav (1.4.7.5): atlas-safe
+        var _shift_min, _shift_max;
+        
+        switch (_mod_type)
+        {
+            case UnknownEnum.Value_1:
+                _shift_min = 0;
+                _shift_max = 2;
+                break;
+            
+            case UnknownEnum.Value_2:
+                _shift_min = -1;
+                _shift_max = _spr_num;
+                break;
+            
+            case UnknownEnum.Value_3:
+                _shift_min = -1;
+                _shift_max = _spr_num;
+                break;
+            
+            case UnknownEnum.Value_5:
+                _shift_min = 0;
+                _shift_max = _spr_num;
+                break;
+            
+            case UnknownEnum.Value_4:
+                _shift_min = 0;
+                _shift_max = 1;
+                break;
+        }
+        
+        if ((other.image_xscale == 1 && slot_data.mod_index[_mod_pos] == _shift_min) || (other.image_xscale == -1 && slot_data.mod_index[_mod_pos] == _shift_max))
+            other.sprite_index = spr_button_arrow_2;
+    }
+}
+
+function scr_create_mod_button_circle()
+{
+    follow = true;
+    act_resize = true;
+    var _pos_array = source_id.pos_array;
+    var _mod_pos = _pos_array[button_num + source_id.skip_row];
+    
+    if (_mod_pos == -1)  // GNX-OFF: the on/off row
+        sprite_index = gnx_slot_off(source_id.source_id) ? spr_button_oval_2 : spr_button_oval;
+    else if (source_id.source_id.slot_data.mod_index[_mod_pos] == 1)
+        sprite_index = spr_button_oval_2;
+    else
+        sprite_index = spr_button_oval;
+}
+
+function scr_create_mod_icon()
+{
+    follow = true;
+    var _array = source_id.icon_array;
+    image_index = _array[button_num];
+
+    // GNX-OFF: the on/off row of a utility cell shows the power icon (GNX asset), not the breeding icon
+    if (source_id.pos_array[button_num] == -1 && gnx_cell_off_power(source_id.source_id.slot_data.h_type))
+    {
+        var _gnx_pw = asset_get_index("spr_gnx_power_icon");
+
+        if (sprite_exists(_gnx_pw))
+        {
+            sprite_index = _gnx_pw;
+            image_index = 0;
+        }
+    }
+    
+    if (source_id.skip_row > 0 && button_num >= source_id.skip_row)
+    {
+        y += 4;
+        shift_y += 4;
+    }
+    
+    activate = false;
+}
+
+enum UnknownEnum
+{
+    Value_1 = 1,
+    Value_2,
+    Value_3,
+    Value_4,
+    Value_5
+}
