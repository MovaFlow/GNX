+        var _def = _defs[_i++];
+        if (variable_struct_exists(_def, "class_name") && variable_struct_exists(_def, "birth_classes"))
+        {
+            var _cname = _def.class_name;
+            var _cid = global.gnx_class_name_to_id[? (arg0 + "." + _cname)];
+            if (_cid != undefined)
