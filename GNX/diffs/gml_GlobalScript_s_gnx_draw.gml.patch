+function gnx_draw_sprite_ext(arg0, arg1, arg2, arg3, arg4, arg5, arg6, arg7, arg8)
+{
+    if (is_array(global.gnx_draw_spy))
+        array_push(global.gnx_draw_spy, arg0);
+
+    // GNX-UG: while the part below the floor line is drawn, only rows at or below the clip line are drawn
+    if (global.gnx_clip_top != undefined)
+    {
+        gnx_draw_sprite_clip(arg0, arg1, arg2, arg3, arg4, arg5, arg6, arg7, arg8);
+        exit;
+    }
+
+    if (is_sprref(arg0))
+    {
+        if (arg0.kind == "legacy")
+        {
+            draw_sprite_ext(arg0.spr, arg1, arg2, arg3, arg4, arg5, arg6, arg7, arg8);
+            exit;
+        }
+        
+        var _n = array_length(arg0.frames);
+        
+        if (_n == 0)
+            exit;
+        
+        var _i = arg1 % _n;
+        
+        if (_i < 0)
+            _i += _n;
+        
+        var _f = arg0.frames[_i];
+        
+        if (_f.w <= 0 || _f.h <= 0)
+            exit;
+        
+        var _atlas_spr = variable_struct_exists(arg0, "multi") ? arg0.atlas_sprites[_f.atlas] : arg0.atlas;
+        // Mav (1.4.7.5): an atlas page that failed to load draws nothing
+        if (!sprite_exists(_atlas_spr))
+            exit;
+        var _dx = arg2 - (arg0.xo * arg4);
+        var _dy = arg3 - (arg0.yo * arg5);
+        
+        if (arg6 == 0)
+        {
+            draw_sprite_part_ext(_atlas_spr, 0, _f.x, _f.y, _f.w, _f.h, _dx, _dy, arg4, arg5, arg7, arg8);
+        }
+        else
+        {
+            // Mav (1.4.7.5): draw_sprite_general rotates around the part's top-left corner, draw_sprite_ext around the origin.
+            // Move the corner so the rotation is around the origin (dcos/dsin = cos/sin in degrees).
+            var _vx = -arg0.xo * arg4;
+            var _vy = -arg0.yo * arg5;
+            var _ca = dcos(arg6);
+            var _sa = dsin(arg6);
+            _dx = arg2 + (_vx * _ca) + (_vy * _sa);
+            _dy = (arg3 - (_vx * _sa)) + (_vy * _ca);
+            draw_sprite_general(_atlas_spr, 0, _f.x, _f.y, _f.w, _f.h, _dx, _dy, arg4, arg5, arg6, arg7, arg7, arg7, arg7, arg8);
+        }
+        
+        exit;
+    }
+    
+    // a sprite that never loaded (missing mod file) is skipped, not a crash; logged once per value
+    if (!is_real(arg0) && !is_handle(arg0) || !sprite_exists(arg0))
+    {
+        gnx_warn_bad_draw(arg0);
+        exit;
+    }
+    
+    draw_sprite_ext(arg0, arg1, arg2, arg3, arg4, arg5, arg6, arg7, arg8);
+}
+
+
+function gnx_warn_bad_draw(arg0)
