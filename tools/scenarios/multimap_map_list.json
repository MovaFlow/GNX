{
  "about": "A mod's 'map' can be a list. harness_map_list ([\"vanilla\", \"harness_map\"]) is on the village and harness_map, not on harness_map_b. harness_map_list_two lists two mod maps with a map_info: the map_info is ignored and reported, its content still loads on both maps, and it adds no travel entry. harness_map_list_own owns its map through a list: a save made there reloads there (it is not taken for an orphan map).",
  "mods": [
    "tools/scenarios/mods/harness_map",
    "tools/scenarios/mods/harness_map_b",
    "tools/scenarios/mods/harness_map_list",
    "tools/scenarios/mods/harness_map_list_two",
    "tools/scenarios/mods/harness_map_list_own"
  ],
  "expect_dialog": "lists 2 mod maps in 'map'",
  "steps": [
    {
      "wait": 30
    },
    {
      "assert": "cell_registered",
      "name": "LIST CELL",
      "is": true,
      "why": "listed: vanilla"
    },
    {
      "assert": "cell_registered",
      "name": "LIST TWO CELL",
      "is": false,
      "why": "not listed: vanilla"
    },
    {
      "assert": "travel_location",
      "to": "harness_map"
    },
    {
      "assert": "travel_location",
      "to": "harness_map_b"
    },
    {
      "open_raid": true
    },
    {
      "wait": 2
    },
    {
      "press_travel_hud": true
    },
    {
      "wait": 3
    },
    {
      "assert": "travel_menu",
      "targets": [
        "harness_map",
        "harness_map_b",
        "harness_list_own"
      ],
      "why": "the two-map list's map_info adds no entry"
    },
    {
      "press_travel_menu": "close"
    },
    {
      "wait": 3
    },
    {
      "open_raid": false
    },
    {
      "wait": 3
    },
    {
      "travel": "harness_map"
    },
    {
      "wait": 30
    },
    {
      "assert": "active_map",
      "is": "harness_map"
    },
    {
      "assert": "cell_registered",
      "name": "LIST CELL",
      "is": true,
      "why": "listed: harness_map"
    },
    {
      "assert": "cell_registered",
      "name": "LIST TWO CELL",
      "is": true
    },
    {
      "travel": "harness_map_b"
    },
    {
      "wait": 30
    },
    {
      "assert": "active_map",
      "is": "harness_map_b"
    },
    {
      "assert": "cell_registered",
      "name": "LIST CELL",
      "is": false,
      "why": "not listed: harness_map_b"
    },
    {
      "assert": "cell_registered",
      "name": "LIST TWO CELL",
      "is": true
    },
    {
      "travel": "vanilla"
    },
    {
      "wait": 30
    },
    {
      "assert": "cell_registered",
      "name": "LIST CELL",
      "is": true
    },
    {
      "assert": "cell_registered",
      "name": "LIST TWO CELL",
      "is": false
    },
    {
      "travel": "harness_list_own"
    },
    {
      "wait": 30
    },
    {
      "assert": "active_map",
      "is": "harness_list_own"
    },
    {
      "assert": "val",
      "key": "money",
      "is": 2468,
      "why": "its map_start"
    },
    {
      "save": 9
    },
    {
      "reload": 9
    },
    {
      "wait": 30
    },
    {
      "assert": "active_map",
      "is": "harness_list_own",
      "why": "not taken for an orphan map"
    }
  ]
}
