+// True while a travel has been confirmed but the destination is not loaded yet (scenario runner waits on it)
+function scr_gnx_travel_pending()
+{
+    if (variable_global_exists("gnx_trigger_load") && global.gnx_trigger_load)
+        return true;
+
+    var _p = false;
+
+    with (obj_empty)
+    {
+        if (variable_instance_exists(id, "gnx_travel_fx") && (phase == 0 || phase == 3))  // before scr_gnx_travel ran
+            _p = true;
+    }
