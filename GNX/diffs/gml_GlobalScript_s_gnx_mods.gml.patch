+    if (variable_struct_exists(global.gnx_save_info_cache, arg0))
+        return variable_struct_get(global.gnx_save_info_cache, arg0);
+    
+    var _info = scr_gnx_read_save_mod_info(arg0);
+    variable_struct_set(global.gnx_save_info_cache, arg0, _info);
+    return _info;
+}
