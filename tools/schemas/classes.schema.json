{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/MovaFlow/GNX/main/tools/schemas/classes.schema.json",
  "title": "GNX classes.json",
  "description": "A list of classes (captive types). Modding guide sections 6, 7, 13-16.",
  "type": "array",
  "items": {
    "$ref": "#/definitions/class"
  },
  "definitions": {
    "spr": {
      "type": [
        "string",
        "integer"
      ],
      "description": "A sprite: \"gnx:<key>\" of this entry's sprites, a vanilla sprite name, or -1 for none (guide 5.4)."
    },
    "class": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Class name: used in refs (\"my_mod.Witch\"), for the hash ID and in game."
        },
        "sprite_prefix": {
          "type": "string",
          "description": "Used by the tools (scaffold_class.py, gnx_pack_strips.py); the game ignores it."
        },
        "class_name": {
          "type": "string",
          "description": "Old name of name (birth_classes of old mods)."
        },
        "override": {
          "type": [
            "boolean",
            "integer"
          ],
          "description": "true = change an existing class or create one at a fixed class_id (guide 6.2)."
        },
        "class_id": {
          "type": "integer",
          "description": "ID number, read only with \"override\": true."
        },
        "is_special": {
          "type": [
            "boolean",
            "integer"
          ],
          "description": "One skin tone and its own clothing format, like Lilith or Nyx (guide 16)."
        },
        "has_hair": {
          "type": [
            "boolean",
            "integer"
          ],
          "description": "true = 3 hair variants from the hair sprites; false = no hair layer."
        },
        "hand_color": {
          "$ref": "#/definitions/spr"
        },
        "icon": {
          "$ref": "#/definitions/spr"
        },
        "icon_hair": {
          "$ref": "#/definitions/spr"
        },
        "default_leg": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2,
          "description": "Fixed leg pose: 1 or 2, or 0 (kneeling)."
        },
        "scr_unit": {
          "type": "integer",
          "description": "Passive effect in a cell: 0 = milk refills like Hathor, 1 = pregnancies refill (guide 6.6)."
        },
        "only_listed_cells": {
          "type": [
            "boolean",
            "integer"
          ],
          "description": "true = enters only cells whose required_class lists it."
        },
        "voice": {
          "type": "object",
          "properties": {
            "bank": {
              "type": "string"
            },
            "pitch": {
              "type": "number"
            },
            "by_mon_type": {
              "$ref": "sounds.schema.json#/definitions/by_mon_type"
            }
          },
          "patternProperties": {
            "^_": {}
          },
          "additionalProperties": false,
          "description": "Fixed moan voice with a bank of your own sounds.json (guide 18.3)."
        },
        "fap_mul": {
          "type": "number",
          "description": "Enemy HP the class adds to a raid encounter: fap_mul x unit level."
        },
        "bap_mul": {
          "type": "number",
          "description": "Enemy AP added: bap_mul x unit level."
        },
        "preg_c_override": {
          "type": "integer",
          "minimum": -1,
          "description": "How many times a unit can get pregnant; -1 = unlimited."
        },
        "preg_mon_type_override": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3,
          "description": "Species of every child: 0 goblin, 1 hobgoblin, 2 tentacle, 3 ogre."
        },
        "sprites": {
          "$ref": "common.schema.json#/definitions/sprites"
        },
        "clothing_standard": {
          "type": "object",
          "description": "Look in standard cells (guide 7.3): phase_1 idle, phase_2 loop (normal and special classes).",
          "properties": {
            "max_row": {
              "type": "integer",
              "description": "Special classes only (guide 16.2)."
            }
          },
          "patternProperties": {
            "^phase_[12]$": {
              "$ref": "#/definitions/phase_std"
            },
            "^_": {}
          },
          "additionalProperties": false
        },
        "clothing_big": {
          "type": "object",
          "description": "Look in big cells (guide 7.4): start / idle / loop (normal class) or phase_0 / phase_1 / phase_2 (special class).",
          "properties": {
            "start": {
              "$ref": "#/definitions/phase_big"
            },
            "idle": {
              "$ref": "#/definitions/phase_big"
            },
            "loop": {
              "$ref": "#/definitions/phase_big"
            }
          },
          "patternProperties": {
            "^phase_[0-2]$": {
              "$ref": "#/definitions/phase_big"
            },
            "^_": {}
          },
          "additionalProperties": false
        },
        "clothing_tent": {
          "type": "object",
          "description": "Look in tentacle cells (guide 7.5): phase_1 idle, phase_2 loop, phase_4 birth.",
          "properties": {
            "max_row": {
              "type": "integer",
              "description": "Special classes only (guide 16.2)."
            }
          },
          "patternProperties": {
            "^phase_[124]$": {
              "$ref": "#/definitions/phase_std"
            },
            "^_": {}
          },
          "additionalProperties": false
        },
        "clothing_giant": {
          "type": "object",
          "description": "Look in the vanilla GIANT cell (guide 7.6): phase_0 / 1 / 2 / 4 tables.",
          "patternProperties": {
            "^phase_[0124]$": {
              "type": "object",
              "properties": {
                "spr_array": {
                  "type": "array",
                  "maxItems": 7,
                  "items": {
                    "$ref": "#/definitions/spr"
                  },
                  "description": "Special-class table: the full body, slot by slot (guide 7.7): [0] unused, [1] head, [2] breast, [3] hand, [4] leg, [5] leg part, [6] cape."
                },
                "spr_c_array": {
                  "type": "array",
                  "maxItems": 7,
                  "items": {
                    "$ref": "#/definitions/spr"
                  },
                  "description": "Special-class table: the clothes (guide 7.7): [0] hair, [1] head overlay, [2] breast, [3] hand, [4] leg, [5] leg part."
                }
              },
              "patternProperties": {
                "^_": {}
              },
              "additionalProperties": false
            },
            "^_": {}
          },
          "additionalProperties": false
        },
        "naked_standard": {
          "type": "object",
          "description": "Bare body under the clothes in standard cells (guide 7.8): hand + phase_1 / phase_2 leg entries.",
          "properties": {
            "hand": {
              "$ref": "#/definitions/spr"
            }
          },
          "patternProperties": {
