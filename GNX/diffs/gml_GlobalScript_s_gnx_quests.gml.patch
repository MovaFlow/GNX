+    
+    var _e = arg0.gnx_event;
+    var _c = _e.completion;
+    // ? : the list, or the one condition put in a list
+    var _list = is_array(_c) ? _c : [_c];
+    var _txt = "";
+    
+    for (var k = 0; k < array_length(_list); k++)
+    {
+        // ? : its place in a list, -1 for a single completion
