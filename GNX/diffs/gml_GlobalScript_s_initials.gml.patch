+// Wywolywane co klatke. Po wlaczeniu ECON PROBE: start, raport po kazdym dniu gry, podsumowanie po wylaczeniu.
+function gnx_econ_probe_tick()
+{
+    if (!global.gnx_econ_on)
+    {
+        // wylaczono w trakcie pomiaru -> podsumowanie calego testu
+        if (is_struct(global.gnx_econ))
+        {
+            var _e = global.gnx_econ;
+            var _d = max(1, _e.days);
+            gnx_econ_log("[ECON] SUMMARY cull=" + (_e.cull ? "ON" : "OFF") + " days=" + string(_e.days) + " gold/day=" + string(round(_e.gold_sum / _d)) + " food/day=" + string(round(_e.food_sum / _d)) + " pop/day=" + string(_e.pop_sum / _d) + " avg_in_band=" + string(round(_e.band_sum / _d)) + "%");
+            global.gnx_econ = -1;
+        }
+
+        exit;
+    }
+
+    if (!instance_exists(obj_camera) || !instance_exists(obj_slot) || !variable_struct_exists(global.val, "day"))
+        exit;
+
+    var _cull = !global.gnx_cull_step_off;
+
+    if (!is_struct(global.gnx_econ))
+    {
+        var _s0 = gnx_econ_snapshot();
+        global.gnx_econ =
+        {
+            last: _s0,
+            days: 0,
+            cull: _cull,
+            gold_sum: 0,
+            food_sum: 0,
+            pop_sum: 0,
+            band_sum: 0
+        };
+        gnx_econ_log("[ECON] START cull=" + (_cull ? "ON" : "OFF") + " day=" + string(_s0.day) + " floors=" + string(global.val.floor + 1) + " cells_with_unit=" + string(_s0.cells) + " in_band=" + string(_s0.in_band) + " (" + string(round((_s0.in_band / max(1, _s0.cells)) * 100)) + "%) cam_y=" + string(round(camera_get_view_y(view_camera[0]))) + " zoom=" + string(obj_camera.zoom_num) + " speed=" + string(global.w_spd));
+        exit;
+    }
+
+    var _e = global.gnx_econ;
+
+    // zmiana przelacznika cullingu w trakcie psuje porownanie - zaczynamy pomiar od nowa
+    if (_e.cull != _cull)
+    {
+        gnx_econ_log("[ECON] culling toggled during probe - restarting measurement");
+        global.gnx_econ = -1;
+        exit;
+    }
+
+    if (global.val.day == _e.last.day)
+        exit;
+
+    var _now = gnx_econ_snapshot();
+    var _l = _e.last;
+    var _gold = _now.money - _l.money;
+    var _food = _now.food - _l.food;
+    var _pop = _now.pop - _l.pop;
+    var _band = round((_now.in_band / max(1, _now.cells)) * 100);
+    gnx_econ_log("[ECON] day " + string(_l.day) + "->" + string(_now.day) + " cull=" + (_cull ? "ON" : "OFF") + " gold=" + string(_gold) + " food=" + string(_food) + " pop=" + string(_pop) + " pregnant=" + string(_now.pregnant) + " cells_with_unit=" + string(_now.cells) + " in_band=" + string(_now.in_band) + " (" + string(_band) + "%) real_s=" + string(round((_now.t - _l.t) / 1000)) + " fps=" + string(round(fps_real)));
+    _e.days++;
+    _e.gold_sum += _gold;
+    _e.food_sum += _food;
+    _e.pop_sum += _pop;
+    _e.band_sum += _band;
+    _e.last = _now;
+}
