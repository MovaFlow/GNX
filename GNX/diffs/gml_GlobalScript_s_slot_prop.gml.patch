+function scr_draw_gnx_prop(arg0)
+{
+    // GNX-PROP: a prop without its sprite draws nothing (it used to draw the first vanilla prop; the mod
+    // error at registration names it)
+    if (!variable_instance_exists(id, "gnx_prop_spr") || gnx_prop_spr == -1)
+        exit;
+    
+    // GNX-PROP: the frame of an animated prop: its clock runs at speed frames per second, scaled by the
+    // game speed (global.w_spd; 0 while paused); mod = remainder, so it starts over after the last frame
+    var _f = 0;
+    var _r = variable_instance_exists(id, "gnx_prop_react") ? gnx_prop_react : undefined;
+    
+    // GNX-PROP: frames moved by events: gnx_prop_step runs the play in Step; here only the frame is read
+    if (is_struct(_r) && _r.frames)
+    {
+        _f = floor(gnx_prop_t);
+    }
+    else if (variable_instance_exists(id, "gnx_prop_speed") && gnx_prop_speed > 0)
+    {
+        // GNX-PROP: a looping prop shows the frame the shared clock is on (gnx_scene_time, seconds) at its
+        // speed, from its own start frame (gnx_prop_t); mod = what is left after whole rounds of the frames.
+        // Worked out from the clock, not counted up in Draw, so it keeps time off screen (audit 16)
+        _f = floor(((gnx_scene_time() * gnx_prop_speed) + gnx_prop_t) mod gnx_prop_frames);
+    }
+    
+    // GNX-PROP: the effects time: the shared clock plus this prop's own start in the cycle (gnx_prop_fx_t,
+    // random with random_phase); then one drawing path that adds the effects and the hover highlight
+    var _fx = variable_instance_exists(id, "gnx_prop_fx") ? gnx_prop_fx : undefined;
+    var _fxt = is_struct(_fx) ? (gnx_scene_time() + gnx_prop_fx_t) : 0;
