{
  "about": "A mod cell with its own art (class_map / fixed) and its own goblin sprites keeps them: players saw a second, vanilla goblin drawn over the captive's face in such cells (Py's SERVICE 1). Two causes, both checked here with the test mod harness_own_art (goblin sprites for leg poses 1 and 2 only, spr_sp_drip_1 standing in, \"anal\": false = rolled): an anal scene swapped a vanilla captive's goblin for the vanilla one (rolls forced to 100 %), and a kneeling captive (leg pose 0: Shaman) found no goblin sprites for her pose. Both must keep the mod's sprites.",
  "mods": [
    "tools/scenarios/mods/harness_own_art"
  ],
  "check_boot_suite": false,
  "steps": [
    {
      "wait": 30
    },
    {
      "do": {
        "type": "unlock_cell",
        "h_type": 1
      }
    },
    {
      "open_build_menu": -1
    },
    {
      "wait": 2
    },
    {
      "press": {
        "type": 0,
        "num": 0
      },
      "why": "NEW"
    },
    {
      "wait": 2
    },
    {
      "press": {
        "type": 1,
        "num": 5
      },
      "why": "CUSTOM"
    },
    {
      "wait": 20
    },
    {
      "press": {
        "type": 95,
        "num": 9040
      }
    },
    {
      "wait": 10
    },
    {
      "assert": "has_cell",
      "h_type": 9040,
      "count": 1
    },
    {
      "do": {
        "type": "spawn_mon",
        "species": 0,
        "amount": 3
      }
    },
    {
      "set_global": {
        "name": "gnx_anal_chance",
        "value": 100
      }
    },
    {
      "set_global": {
        "name": "gnx_anal_chance_preg",
        "value": 100
      }
    },
    {
      "occupy": {
        "h_type": 9040,
        "class": 2
      },
      "why": "Knight: leg pose 1 or 2, anal scene"
    },
    {
      "wait": 900
    },
    {
      "assert": "mon_spr",
      "h_type": 9040,
      "key": "body_b",
      "is": "spr_sp_drip_1"
    },
    {
      "swap_unit": {
        "h_type": 9040,
        "class": 6
      },
      "why": "Shaman: kneeling, leg pose 0"
    },
    {
      "wait": 400
    },
    {
      "assert": "mon_spr",
      "h_type": 9040,
      "key": "body_b",
      "is": "spr_sp_drip_1"
    }
  ]
}