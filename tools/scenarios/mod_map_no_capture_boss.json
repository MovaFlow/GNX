{
  "about": "map_info.no_capture keeps bosses capturable (their capture records the boss's defeat): with a boss (class 9) among stage 0's enemies on harness_map_nocap's map, a won raid captures the boss and nobody else, records its defeat, and tells the player.",
  "fixture": "mid",
  "fixture_on_map": "harness_nocap",
  "mods": [
    "tools/scenarios/mods/harness_map_nocap"
  ],
  "seed": 3,
  "timeout": 120,
  "steps": [
    {
      "wait": 60
    },
    {
      "assert": "fn",
      "name": "gnx_no_capture_here",
      "args": [
        0,
        2
      ],
      "is": 1,
      "why": "listed: stage 0, level 2"
    },
    {
      "assert": "fn",
      "name": "gnx_no_capture_here",
      "args": [
        1,
        2
      ],
      "is": 0,
      "why": "not listed: stage 1 still captures on this map"
    },
    {
      "assert": "fn",
      "name": "gnx_no_capture_here",
      "args": [
        7,
        1
      ],
      "is": 0,
      "why": "the bad entry was left out"
    },
    {
      "do": {
        "type": "set_var",
        "key": "gnx_force_capture_100",
        "value": 1
      },
      "why": "GNX DEBUG CAPTURE100: every capture roll succeeds"
    },
    {
      "assert": "active_map",
      "is": "harness_nocap"
    },
    {
      "assert": "raid",
      "state": 0
    },
    {
      "open_raid": true
    },
    {
      "wait": 5
    },
    {
      "raid_stage": 0
    },
    {
      "wait": 10
    },
    {
      "assert": "raid",
      "state": 0,
      "stage": 0
    },
    {
      "raid_clear_formation": true
    },
    {
      "wait": 2
    },
    {
      "assert": "raid",
      "troops": 0,
      "why": "the fixture comes with a saved formation"
    },
    {
      "raid_formation": {
        "front": [
          [
            0,
            40
          ]
        ],
        "back": [
          [
            1,
            20
          ]
        ]
      }
    },
    {
      "wait": 3
    },
    {
      "assert": "raid",
      "troops": 60
    },
    {
      "call": "gnx_scn_encounter_unit",
      "args": [
        0,
        9,
        0
      ],
      "why": "a boss (class 9) among the stage's enemies"
    },
    {
      "wait": 2
    },
    {
      "raid_go": true
    },
    {
      "wait": 5
    },
    {
      "assert": "raid",
      "state": 1
    },
    {
      "raid_finish": 1200
    },
    {
      "wait": 5
    },
    {
      "assert": "raid",
      "state": 0,
      "cage": 1,
      "why": "only the boss is captured"
    },
    {
      "screenshot": "back_home"
    },
    {
      "assert": "global",
      "name": "gnx_last_popup",
      "is": "Only the boss could be captured here.",
      "why": "the note says so"
    },
    {
      "assert": "fn",
      "name": "gnx_scn_boss_unlock",
      "args": [
        0
      ],
      "is": 1,
      "why": "the boss's defeat is recorded on this map"
    }
  ],
  "expect_dialog": "no_capture entry 3 needs"
}