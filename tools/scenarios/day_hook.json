{
  "about": "Daily hook: day_start triggers run when a new day starts (before its autosave). Test mod harness_day: day_every 2 gives a harness_items shard on even days, day_gte 5 sets a state flag once (guarded by the flag).",
  "mods": [
    "tools/scenarios/mods/harness_cells",
    "tools/scenarios/mods/harness_items",
    "tools/scenarios/mods/harness_day"
  ],
  "check_boot_suite": false,
  "steps": [
    {
      "wait": 30
    },
    {
      "call": "gnx_scn_start_time"
    },
    {
      "assert": "fn",
      "name": "gnx_scn_day",
      "args": [],
      "is": 1
    },
    {
      "call": "gnx_scn_end_day"
    },
    {
      "wait": 3
    },
    {
      "assert": "fn",
      "name": "gnx_scn_day",
      "args": [],
      "is": 2
    },
    {
      "assert": "fn",
      "name": "gnx_scn_item_count",
      "args": [
        "harness_items.MOON SHARD"
      ],
      "is": 1,
      "why": "a shard on even days"
    },
    {
      "call": "gnx_scn_end_day"
    },
    {
      "wait": 3
    },
    {
      "assert": "fn",
      "name": "gnx_scn_day",
      "args": [],
      "is": 3
    },
    {
      "assert": "fn",
      "name": "gnx_scn_item_count",
      "args": [
        "harness_items.MOON SHARD"
      ],
      "is": 1,
      "why": "a shard on even days"
    },
    {
      "call": "gnx_scn_end_day"
    },
    {
      "wait": 3
    },
    {
      "assert": "fn",
      "name": "gnx_scn_day",
      "args": [],
      "is": 4
    },
    {
      "assert": "fn",
      "name": "gnx_scn_item_count",
      "args": [
        "harness_items.MOON SHARD"
      ],
      "is": 2,
      "why": "a shard on even days"
    },
    {
      "assert": "fn",
      "name": "gnx_scn_mod_state",
      "args": [
        "harness_day",
        "reached"
      ],
      "is": 0,
      "why": "day_gte 5"
    },
    {
      "call": "gnx_scn_end_day"
    },
    {
      "wait": 3
    },
    {
      "assert": "fn",
      "name": "gnx_scn_day",
      "args": [],
      "is": 5
    },
    {
      "assert": "fn",
      "name": "gnx_scn_item_count",
      "args": [
        "harness_items.MOON SHARD"
      ],
      "is": 2,
      "why": "a shard on even days"
    },
    {
      "assert": "fn",
      "name": "gnx_scn_mod_state",
      "args": [
        "harness_day",
        "reached"
      ],
      "is": 1,
      "why": "day_gte 5"
    },
    {
      "call": "gnx_scn_end_day"
    },
    {
      "wait": 3
    },
    {
      "assert": "fn",
      "name": "gnx_scn_day",
      "args": [],
      "is": 6
    },
    {
      "assert": "fn",
      "name": "gnx_scn_item_count",
      "args": [
        "harness_items.MOON SHARD"
      ],
      "is": 3,
      "why": "a shard on even days"
    }
  ]
}