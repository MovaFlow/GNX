+// GNX: multi-map travel: maps, selector, carry, troops
+// (moved out of s_initials.gml; the functions are global, callable from any script)
+
+// The mod list entry for a folder / mod id, or undefined
+// A map's name for players: its travel label when its mod is loaded, else the name of the mod that made it
+// (from a save's mod record, arg1), else the map id
+function gnx_map_display_name(arg0, arg1)
+{
+    if (arg0 == "vanilla")
+        return "Village";
+    
+    for (var _i = 0; _i < array_length(global.gnx_travel_locations); _i++)
+    {
+        if (global.gnx_travel_locations[_i].target == arg0)
+            return global.gnx_travel_locations[_i].label;
+    }
+    
+    if (is_array(arg1))
+    {
+        for (var _i = 0; _i < array_length(arg1); _i++)
+        {
+            if (is_struct(arg1[_i]) && variable_struct_exists(arg1[_i], "maps") && gnx_array_has(arg1[_i].maps, arg0))
+                return arg1[_i].name;
+        }
+    }
+    
+    return arg0;
+}
+
+
+// a mod's manifest "map": one map ID ("vanilla", "all", a map) or a list of them
+function gnx_map_decl_list(arg0)
+{
+    return is_array(arg0) ? arg0 : [arg0];
+}
+
+
+// does a mod declared for arg0 load on map arg1
+function gnx_map_decl_has(arg0, arg1)
+{
+    var _l = gnx_map_decl_list(arg0);
+
+    for (var _i = 0; _i < array_length(_l); _i++)
+    {
+        if (_l[_i] == arg1 || _l[_i] == "all")
+            return true;
+    }
+
+    return false;
+}
+
+
+// the mod maps (not "vanilla" / "all") a declaration names
+function gnx_map_decl_mod_maps(arg0)
+{
+    var _out = [];
+    var _l = gnx_map_decl_list(arg0);
+
+    for (var _i = 0; _i < array_length(_l); _i++)
+    {
+        if (is_string(_l[_i]) && _l[_i] != "vanilla" && _l[_i] != "all" && _l[_i] != "")
+            array_push(_out, _l[_i]);
+    }
+
+    return _out;
+}
