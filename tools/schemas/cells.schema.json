            "mode": {
              "enum": [
                "base+class",
                "fixed",
                "class_map"
              ]
            },
            "base_body": {
              "enum": [
                "standard",
                "big",
                "tent"
              ]
            },
            "default": {
              "type": "object",
              "description": "class_map: the phases for classes not listed.",
              "properties": {
                "milk_spr": {
                  "description": "Underground cells: this class's own strips, written as the cell's own.",
                  "type": [
                    "object",
                    "string",
                    "integer"
                  ]
                },
                "infant_spr": {
                  "description": "Underground cells: this class's own strips, written as the cell's own.",
                  "type": [
                    "object",
                    "string",
                    "integer"
                  ]
                }
              },
              "patternProperties": {
                "^phase_([0-5]|idle_start|start_loop|loop_ej|ej_birth)$": {
                  "$ref": "#/definitions/hum_phase"
                },
                "^_": {}
              },
              "additionalProperties": false
            },
            "classes": {
