+            if (variable_struct_exists(prop_data, "gnx_t") && variable_struct_exists(prop_data, "gnx_play"))
+            {
+                gnx_prop_t = clamp(gnx_json_num(prop_data.gnx_t, 0), 0, max(0, gnx_prop_frames - 1));
+                gnx_prop_play = clamp(gnx_json_num(prop_data.gnx_play, 0), 0, 999);
+            }
+            else if (variable_struct_exists(prop_data, "gnx_f"))
+            {
+                gnx_prop_t = clamp(floor(gnx_json_num(prop_data.gnx_f, 0)), 0, max(0, gnx_prop_frames - 1));
+            }
+        }
+
+        
+        // GNX-PROP: the counter, kept within the max the JSON has now
+        if (variable_instance_exists(id, "gnx_prop_count") && is_struct(prop_data) && variable_struct_exists(prop_data, "gnx_count"))
+        {
+            var _max = (variable_instance_exists(id, "gnx_prop_counter") && is_struct(gnx_prop_counter)) ? gnx_prop_counter.max_n : 999999999;
+            gnx_prop_count = clamp(floor(gnx_json_num(prop_data.gnx_count, 0)), 0, _max);
+        }
+    }
+}
+
+/// GNX-PROP: runs in a prop while the mouse is over its passage: outlines the cell(s) it listens to, so
+/// the player sees what it is linked with (arg0 = the prop's react struct).
+function gnx_prop_draw_link(arg0)
+{
+    var _p = slot_id;
+    
+    if (!instance_exists(_p) || !is_array(global.slot_list))
+        exit;
+    
+    var _fl = _p.slot_data.slot_floor;
+    
+    if (_fl < 0 || _fl >= array_length(global.slot_list))
+        exit;
+    
+    var _list = global.slot_list[_fl];
+    var _i = ds_list_find_index(_list, _p);
+    
+    if (_i < 0)
+        exit;
+    
+    var _want = arg0.side;
+    
+    if (_want == 2)
+        _want = (image_xscale < 0) ? -1 : 1;
+    
+    for (var d = -1; d <= 1; d += 2)
+    {
+        var _j = _i + d;
+        
+        if (_j < 0 || _j >= ds_list_size(_list))
+            continue;
+        
+        var _c = ds_list_find_value(_list, _j);
+        
+        if (!instance_exists(_c) || !variable_instance_exists(_c, "slot_data") || !is_struct(_c.slot_data))
+            continue;
+        
+        // only cells: slot types 0 (cell), 1 (big), 2 (tentacle) and 6 (XL); the entrance (3) never sends events
+        var _st = _c.slot_data.slot_type;
+        
+        if (_st != 0 && _st != 1 && _st != 2 && _st != 6)
+            continue;
+        
+        var _side = (_c.x > _p.x) ? 1 : -1;
+        
+        if (_want != 0 && _want != _side)
+            continue;
+        
+        // the cell's box: image_xscale wide, and image_yscale (negative) tall above its floor line y
+        var _x1 = _c.x;
+        var _x2 = (_c.x + abs(_c.image_xscale)) - 1;
+        var _y1 = _c.y - abs(_c.image_yscale);
+        var _y2 = _c.y - 1;
+        // a faint yellow fill (added light) and a clearer outline, like the vanilla hover yellow (65535)
+        gpu_set_blendmode(bm_add);
+        draw_set_alpha(0.08);
+        draw_rectangle_colour(_x1, _y1, _x2, _y2, 65535, 65535, 65535, 65535, false);
+        gpu_set_blendmode(bm_normal);
+        draw_set_alpha(0.6);
+        draw_rectangle_colour(_x1, _y1, _x2, _y2, 65535, 65535, 65535, 65535, true);
+        draw_set_alpha(1);
+    }
+}
